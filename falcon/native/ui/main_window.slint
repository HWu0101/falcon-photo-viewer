import { AboutCard } from "about.slint";
// v0.9.6 (ui.rs extraction series complete): MainWindow — the whole app window —
// extracted VERBATIM from the slint! macro in src/ui.rs (already `export component`).
// The macro imports AND re-exports it, so the generated Rust API (main.rs's
// ui::MainWindow) is unchanged. Imports = the 44 names the wave-1 macro stub held,
// now same-dir (this file lives beside its siblings in native/ui/).

import { Theme, Tip } from "theme.slint";
import { CacheBar, Star, StarBulkPill, Chip, ChipRole, MiniVBar } from "widgets.slint";
import { AaHairline, MagnifierIcon, MinimizeIcon, CloseGlyph, UnsupportedGlyph, CloudGlyph, ChevronGlyph, EllipsisGlyph, FlagGlyph, LeafGlyph } from "glyphs.slint";
import { FilmItem, SelTileRow, ExifRow, ExifBrief, KeybindRow, NotifRow, CopyPrefRow, MacAssocRow, WmFontRow, DisplaySection, FloatExifPanel, PresetBrief } from "structs.slint";
import { IconBtn, PillBtn, TextField, ActionBtn, FocusBadge } from "controls.slint";
import { GlassPanel, SolidPanel, SettingsGroup, SectionLabel, PanelHeader, HRule, PanelBottomFade, PanelRightFade, ExifRowsView, FloatingExif, HoverPreview } from "panels.slint";
import { MenuItem, MenuSep, MenuHeader } from "menu.slint";
import { HudChip, SectionChip, CacheMeter, DropZone, ComparePinLabel, CullActionRow } from "hud.slint";
import { SegPill, Seg, CustomSeg } from "segs.slint";
import { ToggleRow, ToggleTrack, OptionChip, SelectedChip, CopyRankList } from "settings.slint";
import { FilmThumb, BriefCell, BriefSep, SelTile } from "filmstrip.slint";
import { GridThumb } from "grid.slint";
import { EdgePillBottom, EdgePillLeft } from "edges.slint";
import { MainToolbar, ToolbarState } from "toolbar.slint";
import { MacExperimentPopup, MacExperimentStatus } from "mac_experiment.slint";

    // ── v0.8.67 (D): welcome-panel helpers (verified against Figma 262:3) ──
    // KeyHint = one read-only keycap, the shared Chip's quiet HINT dialect (these rows are hints,
    // not controls — the prominent KEYCAP dialect stays reserved for the Settings rebind control
    // per the G10 role split). The VerticalLayout wrapper is the established centre-in-row idiom.
    component KeyHint inherits VerticalLayout {
        in property <string> text;
        alignment: center;
        Chip { text: root.text; }
    }
    // One welcome key row: leading keycaps (@children KeyHints, 4px apart per the mock's Keys
    // group) + a fixed 4px spacer (bounded — never a bare stretch leak) + the description, so the
    // caps→label gap lands on the mock's 8px. v0.8.77 (owner spacing pass): NO fixed height — the
    // row hugs its 18px caps (Figma 262:17's rows are 19px tall on the card's 12px gap → pitch 31;
    // the old fixed 26px inflated the list's line spacing to 38), and a label that wraps at a
    // narrow width now GROWS the row instead of painting past it (layouts don't clip).
    component WkRow inherits HorizontalLayout {
        in property <string> label;
        spacing: Theme.space-1;
        @children
        Rectangle { width: Theme.space-1; }
        Text {
            text: root.label; color: Theme.text-dim; font-size: Theme.font-md;
            vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap;
        }
    }
    // v0.8.81 (owner direction): one welcome COLUMN — the Settings section grammar. The "N · TITLE"
    // SectionLabel floats ABOVE the card(s) as a plain sibling on the panel base (outside any card,
    // flush with the card's left edge — exactly how "INPUT" sits in the Settings body), and this
    // column's spacing is the Settings body rhythm VERBATIM (the setflick body's literal 8px:
    // label→card 8, card→card 8).
    // v0.8.81 hotfix (owner ruling): the column is the Settings section WIDTH too — Theme.section-w,
    // the SAME single source the Settings panel derives its own width from (never a copied 320).
    // The mock's flex-[1_0_0] equal-split guard (preferred-width 0 + stretch 1) is RETIRED with the
    // stretch itself: three FIXED equal widths need no split guard — no column's long single-line
    // preferred can inflate it or crush a sibling by definition (the guard's whole job), and the
    // width no longer tracks the panel/window at all.
    component WcCol inherits Rectangle {
        width: Theme.section-w; // the Settings body width — single-sourced (owner ruling)
        VerticalLayout {
            spacing: 8px; // the Settings body spacing (setflick body, ~2914) — never a welcome-local value
            alignment: start;
            @children
        }
    }
    // v0.8.116 (D-B, owner ruling): `WcCard` RETIRES with its last consumers. It was the welcome's
    // own copy of the Settings card (Theme.block + radius-ctrl, its own 16/14/16 insets), and columns
    // 1 and 3 were the only two surfaces in the app that used it — column 2 moved to the real
    // `SettingsGroup` in v0.8.81. Both columns are on the shared component now, so the imitation goes
    // with them rather than waiting to drift again (the v0.8.79 pad-h precedent: a helper retires WITH
    // its sole consumer). `WcCol` and `WkRow` stay: they are layout scaffolding the mock needs and the
    // Settings body has no equivalent of.

    // ── v0.8.156 (C2, owner ruling Q3): THE BENCH RECOMMENDATION CARD, ONE SHAPE ──
    // Q3 adds this card to Settings → PERFORMANCE → Fast View, beside the raw numbers.
    // It already existed on the welcome (v0.8.67, Figma 262:80), whose comment recorded
    // the nesting as welcome-only *because* "Settings has NO recommendation-card grammar
    // at all". Settings has one now — so the shape becomes a COMPONENT used by both,
    // rather than a second copy free to drift from the first (the `gamut-labels` answer
    // to "one option, three surfaces", applied to a card).
    //
    // ONE SOURCE for the recommendation itself, which is the ruling's actual weight: both
    // instances READ `bench-rec-text` (composed by support::bench_rec_text) and INVOKE
    // `apply-bench-rec` (which re-runs support::bench_recommendation — the same pure fn
    // that composed the text). Nothing here derives a second opinion about the machine.
    //
    // FIRST RUN (L15): with no benchmark ever run `bench-rec-text` is "" — restore_bench_ui
    // returns before writing it unless a schema-matching record exists — so the value reads
    // an em dash, Apply is disabled, and the bare muted "shown after the run" (L8: no chip,
    // no container) names what fills it. Both hosts are cards whose own "Run benchmark"
    // button IS that run, directly above.
    component BenchRecCard inherits Rectangle {
        in property <string> rec-text;
        in property <bool> applied;
        // v0.9.60 (W2-5d) / v0.9.66 (the round-7 sync): the placeholder line is COMPOSED IN RUST
        // (`support::bench_rec_card`), by the same producer as `rec-text`, so the card cannot show
        // an empty recommendation beside a sentence that explains a different reason for it. The
        // default is the literal this row carried before the hint existed, so the Windows
        // rendering is byte-identical in every state; on macOS a synthetic run replaces it.
        in property <string> hint: @tr("falcon" => "shown after the run");
        callback apply();
        // one surface step back DOWN (base-on-block) + the hairline rim — 262:80, verbatim
        background: Theme.base;
        border-radius: Theme.radius-ctrl;
        border-width: 1px; border-color: Theme.border-strong;
        VerticalLayout {
            padding-left: 12px; padding-right: 12px; padding-top: 10px; padding-bottom: 12px;
            spacing: Theme.space-1h;
            alignment: start;
            // font-xs is legitimate HERE and nowhere near it: this is a small-caps CARD
            // LABEL, the one role L9 exempts — the explanatory line below it is font-sm.
            Text { text: @tr("falcon" => "RECOMMENDED FOR THIS MACHINE"); color: Theme.text-mute;
                   font-size: Theme.font-xs; font-weight: 600; }
            Text {
                text: root.rec-text == "" ? "—" : root.rec-text;
                color: root.rec-text == "" ? Theme.text-mute : Theme.text;
                font-size: Theme.font-body; font-weight: 600; wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: Theme.space-2;
                // L5, widest state: the card's inner width is 272px in BOTH hosts (a 320px
                // Theme.section-w column → a SettingsGroup → its children's 12px sides → the
                // card at 296 → its own 12px sides), against 88 + 8 + ~90 ("shown after the
                // run" at font-sm) ≈ 186px, and the two strings are literals — the trailing
                // spacer absorbs the rest.
                ActionBtn {
                    width: 88px;
                    label: root.applied ? @tr("falcon" => "Applied") : @tr("falcon" => "Apply");
                    variant: 0;
                    enabled: root.rec-text != "" && !root.applied;
                    clicked => { root.apply(); }
                }
                if root.rec-text == "" : Text { text: root.hint;
                       color: Theme.text-mute; font-size: Theme.font-sm;
                       vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
            }
        }
    }

    // ───────────────────────────── main window ─────────────────────────────
    export component MainWindow inherits Window {
        // ── v0.9.11 native traffic lights (macOS) ──────────────────────────────────────────
        // no-frame is the INVERSE of native-window-controls: Windows keeps no-frame TRUE
        // byte-identically (the property defaults false — undecorated, Falcon draws min/max/
        // close). macOS boots with native-window-controls true (main.rs sets it before
        // app.run(), i.e. before the winit window exists), so Slint creates a DECORATED
        // window; the winit window-attributes hook (main.rs mac_titlebar_window_attributes)
        // adds transparent-titlebar + hidden-title + fullSizeContentView, so the system draws
        // ONLY the red/yellow/green buttons over Falcon's own 44px bar (the Safari/VS Code
        // pattern). The winit backend re-reads no-frame LIVE on every window-property pass,
        // so this binding (not the hook) is what keeps decorations stable per-OS.
        no-frame: !native-window-controls;
        resize-border-width: 8px; // borderless-only (the backend gates on !is_decorated) — inert on the decorated Mac window, where the OS owns edge resize
        // TRUE on macOS only: the OS draws the window controls — Falcon's custom min/max/close
        // cluster unmounts (mount-culled, so no invisible TouchArea can steal clicks) and the
        // title-bar content shifts right past the traffic-light zone by titlebar-leading-inset.
        in property <bool> native-window-controls: false;
        // Leading title-bar inset reserving the macOS traffic-light zone. 80px logical on Mac:
        // the standard lights end ≈72px from the left window edge; +8px = the bar chips'
        // Theme.space-2 breathing gap. 0px (no inset) on Windows.
        in property <length> titlebar-leading-inset: 0px;
        // v0.9.21 (item 3): THE title-bar height — the ONE named source the Rust traffic-light
        // centering reads (get_titlebar_h; cross-crate rule: never hand-mirror 44 into Rust).
        // The bar's layout slot + the hoisted bar overlay bind to it; the in-file 44px OFFSET
        // literals remain governed by the v0.7.2 title-bar geometry contract (recompute together).
        out property <length> titlebar-h: 44px;
        // Native accessory may overlap the content view or sit above it. AppKit's
        // measured overlap is the only extra inset; never reserve a second toolbar row.
        in property <length> native-toolbar-inset: 44px;
        out property <length> content-top: root.immersive ? 0px :
            (root.mac-experiment-host ? root.native-toolbar-inset : root.titlebar-h);
        out property <ToolbarState> toolbar-state: {
            cache-frac-after: root.cache-frac-after,
            cache-frac-before: root.cache-frac-before,
            cache-len-after: root.cache-len-after,
            cache-len-before: root.cache-len-before,
            cache-meter-hover: root.cache-meter-hover,
            cache-meter-show: root.cache-meter-show,
            chrome-eff: root.chrome-eff,
            compare: root.compare,
            count-all: root.count-all,
            count-picks: root.count-picks,
            count-rejects: root.count-rejects,
            dbg-chrome: root.dbg-chrome,
            efficiency-leaf: root.efficiency-leaf,
            empty-state: root.empty-state,
            film-visible: root.film-visible,
            grid-open: root.grid-open,
            hud-pos: root.hud-pos,
            hud-pos-widest-a: root.hud-pos-widest-a,
            hud-pos-widest-b: root.hud-pos-widest-b,
            immersive: root.immersive,
            loading-open: root.loading-open,
            maximized: root.maximized,
            modal-blocking: root.modal-blocking,
            motion-ui: root.motion-ui,
            native-window-controls: root.native-window-controls,
            notif-open: root.notif-open,
            notif-unread: root.notif-unread,
            path-dir: root.path-dir,
            path-mid: root.path-mid,
            path-text: root.path-text,
            sel-open: root.sel-open,
            settings-open: root.settings-open,
            titlebar-h: root.titlebar-h,
            titlebar-leading-inset: root.titlebar-leading-inset,
        };
        in-out property <length> cache-meter-cy: 47px;
        in-out property <length> sort-menu-y: 3px;
        callback toolbar-action(string, length, length);
        toolbar-action(action, x, y) => {
            if root.immersive { return; }
            // Recheck live state after cross-window dispatch; native snapshots may be a frame old.
            if root.modal-blocking && (action == "settings" || action == "speed" || action == "open" || action == "review" || action == "compare" || action == "notifications" || action == "picks" || action == "rejects" || action == "sort") { return; }
            if action == "drag" { root.titlebar-pressed(); }
            else if action == "settings" { root.close-bar-menus(); root.welcome-open = false; root.panel-switch = root.loading-open || root.sel-open; root.settings-open = !root.settings-open; root.loading-open = false; root.sel-open = false; }
            else if action == "speed" { root.close-bar-menus(); root.welcome-open = false; root.panel-switch = root.settings-open || root.sel-open; root.loading-open = !root.loading-open; root.settings-open = false; root.sel-open = false; }
            else if action == "open" {
                            root.open-menu-x = x;
                            root.open-menu-y = y - root.content-top + 3px;
                            // v0.8.120 (Y75): this button was one of the two sites that carried the
                            // invariant by hand; it now TOGGLES through the shared function (which
                            // closes all three flags), so the rule has exactly one implementation.
                            if (root.open-menu-open) { root.close-bar-menus(); }
                            else { root.close-bar-menus(); root.open-menu-open = true; }
                        }
            else if action == "review" { root.close-bar-menus(); root.welcome-open = false; root.toggle-sel-panel(); }
            else if action == "compare" { root.close-bar-menus(); root.toggle-compare(); }
            else if action == "notifications" { root.close-bar-menus(); root.welcome-open = false; root.toggle-notif(); }
            else if action == "minimize" { root.close-bar-menus(); root.minimize-requested(); }
            else if action == "maximize" { root.close-bar-menus(); root.maximize-requested(); }
            else if action == "close" { root.close-bar-menus(); root.close-requested(); }
            else if action == "filmstrip" { root.close-bar-menus(); root.welcome-open = false; root.film-visible = !root.film-visible; root.film-edge-hot = false; root.stage-bot-hot = false; }
            else if action == "grid" { root.close-bar-menus(); root.welcome-open = false; root.grid-open = !root.grid-open; root.dock-lane-hot = false; root.stage-left-hot = false; }
            else if action == "copy-path" { root.close-bar-menus(); root.welcome-open = false; root.copy-path(); }
            else if action == "sort" {root.sort-menu-y = y - root.content-top + 3px;
                                root.sort-menu-x = x;
                                if (root.sort-open) { root.close-bar-menus(); }
                                else { root.close-bar-menus(); root.sort-open = true; }
                            }
            else if action == "picks" { root.close-bar-menus(); root.open-sel-panel(); }
            else if action == "rejects" { root.close-bar-menus(); root.open-sel-panel(); }
        }

        in property <bool> mac-smoke-toolbar-ok: false;
        in property <bool> mac-full-candidate: false;
        in-out property <bool> mac-diagnostics-open: false;
        in property <string> mac-experiment-label: "";
        in property <string> mac-experiment-status: "";
        in property <string> mac-experiment-log-path: "";
        callback mac-experiment-command(string);
        callback mac-experiment-refocus();
        mac-experiment-refocus => { keys.focus(); root.set-ime(false); }
        // Both surfaces use the SAME key handler, including modifiers, repeats and rebinding.
        callback toolbar-key(KeyEvent, bool);
        toolbar-key(e, pressed) => {
            if pressed { keys.key-pressed(e); } else { keys.key-released(e); }
        }
        in property <bool> mac-experiment-host: false;
        in-out property <bool> mac-experiment-popup-open: false;
        in property <length> mac-experiment-popup-x;
        in property <length> mac-experiment-popup-y;
        callback mac-experiment-popup-action(string);
        changed mac-experiment-popup-open => {
            if !root.mac-experiment-popup-open && root.mac-experiment-label != "" { keys.focus(); }
        }
        title: root.mac-experiment-label == "" ? "Falcon Photo Viewer" : root.mac-experiment-label;
        default-font-family: "Inter"; // bundled (SIL OFL) — matches the Figma design system; registered in main()
        preferred-width: 1280px;
        preferred-height: 820px;
        // Keep the minimum small enough that Windows half/quarter snap (Win+←/→/↑) works on
        // laptops: a 1080p-at-150% display is a 1280×720 LOGICAL desktop, so a half-screen snap
        // targets 640×720 logical — a higher min-width would make Windows refuse the snap. These
        // are logical px; the layout still hugs fine this small (panels overlay, nothing clips out —
        // and the title-bar HUD chips auto-hide below ~250px of centre span, F1).
        min-width: 560px;
        min-height: 400px;
        // Pin a large fixed max so the window's layout constraints stay as static as
        // possible (a changing max would make Slint push set_max_inner_size to winit,
        // which clears the MAXIMIZED flag → spurious un-maximize during scrub).
        max-width: 100000px;
        max-height: 100000px;
        background: transparent; // v0.7.0: the winroot rect below paints base + rounds the window corners
        forward-focus: keys;

        // image + view
        in property <image> photo;
        in property <image> blur-backdrop;
        // Adaptive hi-res: a screen-sized tile of the zoomed-in region of a huge image,
        // overlaid on the (upscaled) base photo and positioned by a normalized source rect
        // (u0,v0)-(u1,v1) so it tracks pan/zoom exactly via the image transform.
        in property <image> region-photo;
        in property <bool> region-active: false;
        in property <float> region-u0;
        in property <float> region-v0;
        in property <float> region-u1;
        in property <float> region-v1;
        // Compare ROI: one hi-res region tile per half (same overlay idea as region-* above),
        // positioned within each half by its own clamped source rect.
        in property <image> region-photo-a;
        in property <image> region-photo-b;
        in property <bool> region-a-active: false;
        in property <bool> region-b-active: false;
        in property <float> region-a-u0;
        in property <float> region-a-v0;
        in property <float> region-a-u1;
        in property <float> region-a-v1;
        in property <float> region-b-u0;
        in property <float> region-b-v0;
        in property <float> region-b-u1;
        in property <float> region-b-v1;
        in property <string> path-text: "Falcon";
        // v0.8.116 (D-A, owner ruling): the pill's other two RENDERINGS of the same path, composed by
        // Rust (`support::hud_path_tiers`) alongside `path-text`. Slint picks between the three by
        // MEASURING them against the pill's live cap (see hudclip's `path-shown`) — the strings are the
        // grammar, the metrics are the compositor's.
        //   `path-mid` — the folder elided to the app's own "…" mark, the FILENAME whole. The owner's
        //     middle tier: the pill exists to name the photo, so the photo's name is the last thing to
        //     go, not the first.
        //   `path-dir` — the folder alone. The narrowest tier, where the filename is dropped because
        //     the EXIF panel names it anyway.
        // Both default "" = ABSENT, which keeps the historic single-string behaviour byte-identical
        // (the HudChip `widest-a` idiom): a caller that sets only `path-text` gets exactly v0.8.115.
        in property <string> path-mid: "";
        in property <string> path-dir: "";
        in property <string> hud-pos: "";      // H6: "current/total" for the title-bar position chip ("" = no folder)
        // v0.8.58 (owner): the position chip's SHOT-INVARIANT frame templates — Rust composes
        // them from the FOLDER (all-0s / all-8s of the total's digit count + the literal total)
        // in step_selection's count block, so the chip frame changes only on a folder swap,
        // never during browsing (see HudChip's widest-a note for the whole mechanism).
        in property <string> hud-pos-widest-a: "";
        in property <string> hud-pos-widest-b: "";
        // ── v0.8.49: position-chip SORT menu ──────────────────────────────────────────────
        // The chip opens a compact anchored menu: the relocated scroll-to-current affordance (G7),
        // the sort methods, and Ascending/Descending. Rust re-sorts through the folder-rescan choke
        // point (apply_scan) — the CURRENT SHOT stays selected (its position number changes and the
        // view follows it). sort-method: 0 Name / 1 Date taken / 2 Date modified / 3 Date created /
        // 4 Size / 5 Type / 6 Rating (SortMethod::as_i32); sort-desc = descending. Both are
        // Rust-owned state (set at boot / folder swap / pick-apply); the menu rows only fire the
        // callbacks, so the marks can never drift from the order actually applied.
        in-out property <bool> sort-open: false;
        in-out property <length> sort-menu-x: 0px; // window-space anchor: the chip TouchArea's absolute x
        in-out property <int> sort-method: 0;
        in-out property <bool> sort-desc: false;
        callback sort-pick(int);      // a method row picked (keeps the direction)
        callback sort-dir-pick(bool); // Ascending(false) / Descending(true) picked (keeps the method)
        // v0.8.49: sort-memory cap (Settings card) — mirrors resume-cap-tier/custom exactly.
        in-out property <int> sort-cap-tier: 2;
        in-out property <int> sort-cap-custom: 0;
        // v0.8.119 (design-sweep O18): the EFFECTIVE cap, mirroring support::eff_resume_cap
        // (a custom > 0 overrides the tier; else the named preset 0 / 3 / 10). Derived from the
        // two live inputs rather than pushed from Rust, so it can never lag a tier click. It is
        // read by the Floating-panels captions: the per-folder floating-panel min-state memory
        // SHARES this cap (support::resolve_panel_min returns None at cap 0), so at 0 those
        // captions must stop promising a memory that is switched off. Pinned against
        // eff_resume_cap by main.rs's eff_resume_cap unit test + the rig row.
        out property <int> sort-cap-eff: root.sort-cap-custom > 0 ? root.sort-cap-custom : [0, 3, 10][root.sort-cap-tier];
        callback set-sort-cap-custom(string); // typed cap (0..500; 0 = off), parse-rejecting
        callback sort-cap-changed();          // preset pick reconciliation (Rust trims the MRU)
        // No folder / no photos → cover the stage with an "open a folder" overlay.
        in property <bool> empty-state: false;
        in property <string> empty-text: @tr("falcon" => "No folder open");
        in-out property <bool> opening-photo: false;
        in-out property <bool> opening-before: false;
        in-out property <bool> opening-after: false;
        in-out property <int> opening-wait-dir: 0; // signed photo offset; grid keys retain a full row
        callback grid-boundary-step(int);
        out property <bool> opening-boundary-wait: root.opening-photo && root.opening-wait-dir != 0;
        in-out property <bool> photo-open-edits: false;
        in-out property <bool> scanning: false; // U1 (v0.3.19): a folder scan is running off-thread → show the indicator
        in-out property <float> zoom: 1.0;
        // v0.8.119 (design-sweep O20/O22): the macOS View menu's `at_fit` (menubar_model: "single-
        // view zoom == 1.0"), as a derived Slint property so the shared ctx row can mirror the Mac
        // row's enablement without new Rust plumbing. zoom is clamped to a 1.0 floor everywhere it
        // is written, so `<= 1.0` and `== 1.0` are the same set — `<=` is the float-safe spelling.
        out property <bool> at-fit: root.zoom <= 1.0;
        in property <int> zoom-pct: 100;     // displayed zoom vs native pixels (100 = 1:1; Rust-computed)
        in-out property <length> pan-x: 0;
        in-out property <length> pan-y: 0;
        // Compare pan is a shared FRACTION (−1..1) applied to each half's own max pan (#7 focused-half
        // pan) — kept separate from the single-view pixel pan-x/y so each stays simple.
        in-out property <float> cmp-pan-fx: 0;
        in-out property <float> cmp-pan-fy: 0;
        in property <float> img-aspect: 1.5;
        // dev HUD
        in-out property <bool> dev-hud: true;
        in property <string> hud-text: "";
        in-out property <int> sim-vram-gb: 0; // dev: simulate a card with this much VRAM (0 = auto)
        callback set-sim-vram(int);
        // popups
        in-out property <bool> settings-open: false;
        in-out property <bool> loading-open: false;
        // W1 file associations (Windows Open-With registration — support.rs assoc module).
        // Family defaults: finished formats ON, RAW opt-in; once registered, refresh-assoc
        // re-reads the live registry state each time Settings opens.
        in-out property <bool> assoc-registered: false;
        in-out property <bool> distinct-raw-icons: false;
        callback distinct-raw-icons-toggled();
        in-out property <bool> assoc-jpeg: true;
        in-out property <bool> assoc-png: true;
        in-out property <bool> assoc-tiff: true;
        in-out property <bool> assoc-heic: true;
        in-out property <bool> assoc-webp: true;
        // v0.8.59: the v0.8.55 formats batch (GIF/BMP/JPEG XL) — finished formats, so default ON
        // like the rest (RAW below stays the one opt-in).
        in-out property <bool> assoc-gif: true;
        in-out property <bool> assoc-bmp: true;
        in-out property <bool> assoc-jxl: true;
        in-out property <bool> assoc-raw: false;
        in-out property <string> assoc-status: "";
        // v0.8.71 (Round B assoc): the HEIC row's conditional availability — Rust probes the WIC
        // codec registry at boot (read-only; macOS is always true). false → the row fades, its
        // toggle disables, and the explanation line (assoc-heic-tip, Rust-routed) mounts under it.
        in property <bool> assoc-heic-avail: true;
        in property <string> assoc-heic-tip: "";
        in-out property <bool> file-assoc-visible: true;   // v0.9.3 (§66): platform table gates the FILE ASSOCIATIONS card (Windows=true; macOS surfaces assoc via Info.plist)
        public function apply-all-associations() {
            if (root.assoc-mac-mode) { root.assoc-prompt-choice(2); }
            else if (root.file-assoc-visible) {
                root.assoc-jpeg = true; root.assoc-png = true; root.assoc-tiff = true;
                root.assoc-heic = root.assoc-heic-avail; root.assoc-webp = true; root.assoc-gif = true;
                root.assoc-bmp = true; root.assoc-jxl = true; root.assoc-raw = true;
                root.assoc-apply();
            }
        }
        callback assoc-apply();          // register / update (idempotent, applies the checkboxes)
        callback assoc-remove();         // delete our registry entries
        callback assoc-open-defaults();  // open ms-settings:defaultapps
        callback refresh-assoc();        // re-read registry → the properties above
        // ── v0.9.16 (Round B assoc): the Mac default-handler card + first-launch popup ──
        // assoc-mac-mode (Rust, boot, macOS only) swaps the FILE ASSOCIATIONS card from the Windows
        // checkbox/register card to the per-family Make-default/Reset rows (mac-assoc-rows, rebuilt
        // by refresh-assoc's Mac arm on every Settings open + after every action). Windows: false →
        // byte-identical card. The popup: exactly-once, sequenced NEVER to stack with the welcome —
        // or with ANY panel/modal (v0.9.17 FIX 1). Rust arms assoc-prompt-armed at boot when the
        // welcome will show first; the `changed modal-open` observer below opens the popup only
        // when the UI goes IDLE (so welcome→Settings via the gear or the footer link makes it wait
        // for Settings to close); a boot with the welcome already shown opens it directly (idle by
        // construction). v0.9.20: assoc-prompt-shown now latches at BOOT (persist-at-show, the
        // onboarding-shown pattern — see main.rs's `assoc_boot`) the instant the popup is
        // armed-or-opened, not at close, so an exit before it actually appears on screen can't
        // resurrect it; the open trigger below now runs on assoc-prompt-armed ALONE, decoupled from
        // assoc-prompt-shown (see the `changed modal-open` comment). Esc = None (declare-only);
        // buttons only, no Enter-accept (visual-thinkers rule).
        in property <bool> assoc-mac-mode: false;
        in property <[MacAssocRow]> mac-assoc-rows: [];
        in property <bool> mac-assoc-change-enabled: true;
        callback mac-assoc-make-default(int);  // family index (ASSOC_FAMILIES order)
        callback mac-assoc-reset(int);         // family index → captured-incumbent/Preview ladder
        in-out property <bool> assoc-prompt-open: false;
        in-out property <bool> assoc-prompt-shown: false;
        in-out property <bool> assoc-prompt-armed: false;
        callback assoc-prompt-choice(int);     // 0 None | 1 RAW+JPG/HEIC | 2 All (Rust applies + logs)
        // scrub speed
        in-out property <float> scrub-fps: 30;
        in property <bool> benchmarked: false;
        in property <bool> bench-running: false;
        // §43 benchmark: the target-MP image's sub/super DCT tiers bracketing this screen (CPU,
        // the scrub pick) + native full res (nvJPEG serial or the CPU fallback — the zoomed rate).
        in property <int> bench-w: 0;                    // the benchmarked long side (px) — persisted for reload labels
        in property <int> bench-sub-fps: 0;
        in property <int> bench-super-fps: 0;
        in property <int> bench-fullres-fps: 0;
        in property <bool> bench-full-gpu: true;         // full-res timed on nvJPEG (false = CPU)
        // fps → 0..1 position over the speed CustomSeg's stop centres (5→0.0 · 12→0.25 · 20→0.5 ·
        // 30→0.75 · 120→1.0, piecewise-linear between). Drives BOTH the custom value's blue indicator
        // line AND the benchmarked device-limit veil so they share ONE mapping (v0.7.5). Clamps to 0..1.
        pure function fps-frac(f: float) -> float {
            return f <= 5 ? 0.0
                : f <= 12 ? (f - 5) / 7 * 0.25
                : f <= 20 ? 0.25 + (f - 12) / 8 * 0.25
                : f <= 30 ? 0.5 + (f - 20) / 10 * 0.25
                : f <= 120 ? 0.75 + (f - 30) / 90 * 0.25
                : 1.0;
        }
        in-out property <bool> bench-use-synthetic: false; // false = current folder · true = generated target-size images
        in-out property <int> bench-target-mp: 45;       // benchmark target image size (megapixels; synthetic mode)
        in property <string> bench-target-mp-text: "45"; // the field's echo (Rust keeps it clamped)
        callback set-bench-target-mp(string);            // parse-rejecting commit
        in property <string> fps-text: "30 fps";
        in property <string> bench-text: @tr("falcon" => "device not yet tested");
        // v0.8.82 (tester issue 9): PROVENANCE of the displayed result — the welcome's Quick
        // benchmark forces a synthetic run without touching the user's "Benchmark with" seg,
        // so the stored numbers can be target-MP tiers while the seg still reads "Current
        // folder". These ride WITH the result (written by the same drain, persisted, boot-
        // restored) so Fast View can annotate honestly instead of mislabeling.
        // v0.8.119 (design-sweep O37, L27): the SHARED predicate for "the next Run measures
        // generated frames, not this folder" — exactly what Rust computes
        // (`force_synthetic || bench_use_synthetic`, main.rs on_run_benchmark). The welcome card
        // keyed its intro and its source hint on `empty-state` ALONE, so with a folder open and
        // Settings → "Benchmark with" on Target size it promised "~30 s on your own photos" and
        // then benchmarked generated 45 MP frames. One property, so the two surfaces cannot drift.
        out property <bool> bench-synth-eff: root.empty-state || root.bench-use-synthetic;
        in property <bool> bench-synthetic: false;   // the displayed result came from a generated (target-MP) run
        in property <int> bench-synth-mp: 0;         // the target MP that run used (persistence rider)
        in property <string> bench-synth-note: "";   // Rust-composed caption (slint! can't concat int+string)
        // v0.8.174 (F2c): the Full tier's UPLOAD probe was clamped to this machine's own
        // detail-upload ceiling (the mixed stage's detail probe has been clamped that way since
        // v0.7.9). A clamped tier must SAY so — the fps beside "Full 8216" was measured on a
        // smaller frame, which is the truth about what this box uploads and a lie if left unsaid.
        // Same shape as the provenance pair above: an int for persistence, a Rust-composed
        // sentence for the eye, and the mount is simply "there is something to say".
        in property <int> bench-clamp-res: 0;        // px the Full upload probe really staged (0 = none recorded)
        in property <string> bench-clamp-note: "";   // Rust-composed caption; "" = nothing was clamped
        // v0.8.195 fix tail (skeptic B, R1c): the browse-speed popup's own note. This popup's TITLE
        // IS the fps number and its segmented pill sits on the user's stop, so with the efficiency
        // posture engaged all of it said 30 while the browse stepped at 20 — the v0.8.123 defect
        // ("built from a JPEG benchmark figure and said nothing about lanes that cannot reach it")
        // re-cut on the title. Rust-composed and EMPTY unless the posture is actually binding, so
        // the mount is the emptiness (`support::scrub_fps_efficiency_note`).
        in property <string> fps-eff-note: "";
        // v0.8.196 fix tail (skeptic B, R4): the Fast View card's own state-derived note. While the
        // posture holds the sampling tier, that card's Seg sits on the user's stop and the app is
        // decoding the other one — the v0.8.195 R1c defect, on the card next door. Rust-composed,
        // mounted on its own emptiness (L4), in the Fast View card's OWN vocabulary.
        in property <string> fastview-eff-note: "";
        in property <string> zoom-sharp-note: ""; // §43: the Always-sharp expected-rate line (built in Rust)
        in property <string> zoom-sharp-slow-note: ""; // v0.8.123 (I3): the slow-format caveat, ONE producer, rendered under BOTH caption arms (built in Rust)
        // v0.9.62 (B2.2): the THIRD always-sharp arm — benchmarked, but by a run that may not speak
        // for this folder. Same mode description as `zoom-sharp-note`, no figure, plus the reason
        // there is none. Built in Rust so the two descriptions cannot drift; a constant string, but
        // it lives beside its sibling rather than as a .slint literal for exactly that reason.
        in property <string> zoom-sharp-unmeasured-note: "";
        // settings
        // ── v0.8.171 (OWNER RULING): HEIC SPEED PRIORITY ──────────────────────────────────────
        // "seems better fit for a toggleable option (something like HEIC speed priority) rather
        // than universal default." DEFAULT OFF, and it is a PRODUCT row in PERFORMANCE, not a
        // Developer lever: it changes what the person browsing sees (a photo you go back to
        // re-decodes), so it belongs where he can find it and read the trade.
        //
        // Rust holds the live value in an atomic that the hardware lane's router re-reads PER
        // DECODE, so this is a real live callback rather than a persist-only property — a flip
        // applies to the next photograph, with no restart and nothing latched (L43).
        in-out property <bool> heic-speed-priority: false;
        callback set-heic-speed-priority(bool);
        // v1.0.0-rc TAIL (OWNER RULING): CMYK JPEG decoding — Falcon's own conversion (false) or
        // Windows' colour-managed codec (true). Mount-gated on `cmyk-route-visible` below.
        in-out property <bool> cmyk-os-route: false;
        callback set-cmyk-os-route(bool);
        // v1.0.0-rc TAIL: platform table gates the CMYK row (Windows=true; the row's words name
        // Windows' codec, so macOS does not offer it — see platform.rs `cmyk_route_visible`).
        in-out property <bool> cmyk-route-visible: true;
        // ── v0.8.195 (OWNER RULING 2026-08-30, option c): EFFICIENCY MODE ───────────────────
        // "go with option c for the efficiency mode." ONE control, three states — 0 Auto (follow
        // the power source), 1 On, 2 Off — DEFAULT Auto, which is why the default here is 0.
        //
        // A PRODUCT row in PERFORMANCE beside HEIC speed priority and Adaptive Hi-Res, not a
        // Developer lever: it changes what the person browsing gets (less speculative decoding,
        // and a browse capped to 20 fps while it is engaged), so it belongs where he can find it.
        // Rust holds the live value in an atomic the tick re-reads every pass, so this is a real
        // live callback — a click applies on the next tick, with nothing latched (L43).
        in-out property <int> efficiency-mode: 0;
        callback set-efficiency-mode(int);
        // v0.8.195 fix tail (skeptic B, R2/O1): the control's LIVE-STATE line, Rust-composed off the
        // same three inputs `efficiency_engaged` takes (`support::efficiency_note`). Without it a
        // desktop's permanent no-op, a laptop engaged right now, a laptop released and a session
        // vetoed by the env lever all rendered as the identical lit "Auto" pill under a caption
        // about a battery — the VISUAL-THINKERS lens, and the spec's own L15 line.
        in property <string> efficiency-note: "";
        // …and whether `FALCON_EFFICIENCY=0` is governing this boot. The Seg is MOUNT-GATED on it
        // (never `visible:` — ledger L4), the note above says why, and the setting still persists:
        // the `heic-lane-cap-env` precedent thirty lines down, whose own comment is "Dev levers win;
        // the UI says so rather than pretending otherwise."
        in property <bool> efficiency-env: false;
        in-out property <bool> use-nvjpeg: true;
        in property <bool> nvjpeg-avail: false;
        // v0.9.10 (Mac fix 2): persistence-only carrier for the one-shot accel migration flag (no UI
        // binding). Seeded at boot from resolve_accel_migration; build_settings reads it back so the
        // stamped `true` round-trips through the normal save path. Default false = "not yet migrated".
        in-out property <bool> accel-migrated: false;
        // v0.9.9 (P6): the accel-toggle label, routed from Rust (platform::accel_toggle_label) so macOS
        // names Image I/O instead of nvJPEG. Default = the Windows literal (byte-identity fallback).
        in property <string> accel-toggle-label: @tr("falcon" => "GPU JPEG decode (nvJPEG)");
        // v0.9.12 (C2/M12): the delete/empty confirmation nouns, routed from Rust so macOS says "Trash"
        // where Windows says "Recycle Bin". Defaults = the Windows literals (byte-identity fallback,
        // pinned by windows_strings_unchanged); the two button labels ride PLATFORM.empty_to_trash /
        // move_to_trash. The .slint no longer hard-codes an OS-specific noun for these four strings.
        // v0.8.119 (design-sweep Y45): the count headline's PHRASE — the dialog leads with the
        // file count Text now, so this is the words after it, singular/plural aware. Rust composes
        // it beside the probe that produces the count (platform::empty_confirm_title), which is why
        // the v0.9.12 boot-time static assignment is gone: one writer, always in step with the
        // number it sits next to.
        in property <string> empty-confirm-title: "files in ./Rejected → Recycle Bin";
        in property <string> empty-confirm-body: "Sends every file currently in ./Rejected to the OS Recycle Bin — recoverable from there until you empty the bin. Photos NOT yet moved to ./Rejected are untouched.";
        in property <string> empty-confirm-label: @tr("falcon" => "Empty to Bin");
        in property <string> delete-confirm-label: @tr("falcon" => "Move to Recycle Bin");
        // v1.0 MERGE TAIL [B-R3, L26]: the kind-8 Overwrite WARN body. Its two siblings in the same
        // ternary (`delete-body`, `empty-confirm-body`) were already Rust-composed; this one typed
        // "Recycle Bin" and reached macOS for the first time at the merge, three lines above the
        // button ladder the merge itself routed. Default = the Windows literal VERBATIM (the
        // byte-identity fallback the whole family uses), fed by `platform::overwrite_confirm_body`.
        in property <string> overwrite-confirm-body: "Overwrite re-renders those files and replaces them in place — the old versions are gone for good, not moved to the Recycle Bin (each replacement is atomic, so a file is never left half-written). Skip existing leaves them untouched and exports the rest. To keep both versions, cancel and turn on “Append the preset name to filenames”.";
        // v1.0 MERGE TAIL [B-R1, L17]: the Efficiency card's LAST SENTENCE only. `Dc || saver` is
        // the Auto predicate on Windows and both halves are named; on macOS `saver` is structurally
        // false (Low Power Mode is not read at v1.0, and `power_probe`'s own doc says so), so the
        // sentence would advertise an input the implementation documents it does not read. Default
        // = the Windows literal VERBATIM, fed by `platform::efficiency_auto_clause`.
        in property <string> efficiency-auto-clause: @tr("falcon" => "Auto follows your power source and Windows' Battery saver.");
        // v0.9.12 (C2/M10): macOS runs ONLY the Metal wgpu backend, so the Vulkan/DX12 override picker
        // in the DEVELOPER GPU card is meaningless there — this flag hides it (the read-only backend
        // status line stays). Windows = false → the picker mounts exactly as before (pixel-identical).
        in property <bool> is-mac: false;
        // v0.8.119 (design-sweep O28): the two DEVELOPER engine rows that macOS forces off. `dev-l2-on`
        // is the EFFECTIVE gate (`settings.ram_l2 && l2_allowed()`), NOT the raw persisted flag — the
        // row was showing ON at every launch on the Mac build while the cache was disabled by platform
        // policy, i.e. answering the one question it exists to answer wrongly, at the DEFAULT setting,
        // to precisely the tester audience. `dev-levers-live` false keeps both rows MOUNTED and
        // `enabled: false` (the GPU-backend treatment: the truth about this build stays visible), with
        // the inline reason line the HEIC assoc row established. Windows/classic: true + "" ⇒ the rows
        // render exactly as before.
        in property <bool> dev-levers-live: true;
        out property <bool> dev-l2-on: root.ram-l2 && root.dev-levers-live;
        in property <string> dev-levers-note: "";
        // v0.8.119 (design-sweep O29): WHY the GPU-decode row is dead on this machine. Routed
        // through platform.rs like every other OS-specific sentence and set once at boot; empty
        // whenever the accelerator IS available, so the line simply never mounts there (the
        // v0.8.71 HEIC-assoc pattern: opacity fade + an INLINE reason, not a hover tip).
        // On macOS `accel_avail` is hardwired true, so this stays "" and the row never fades.
        in property <string> accel-unavail-note: "";
        in-out property <bool> wheel-nav: true;
        in-out property <bool> same-key-clear: true;    // v0.8.37 (FIX B): re-press the current rating key to clear it (keyboard dispatch only)
        // G5 (opt-in): cache-aware scrub backpressure — a held-key scrub HOLDS instead of advancing
        // onto a shot whose fast frame isn't decoded yet, so photos step one-by-one at the decode
        // rate (never a frozen frame with a racing counter). Off (default) = advance freely; the
        // G1 thumbnail stand-in covers the gaps.
        in-out property <bool> scrub-wait-cache: false;
        in-out property <bool> async-blur: true;      // B1 (v0.7.6): frosted blur in the decode pool (default) vs upload thread
        callback set-async-blur(bool);
        in-out property <bool> ram-l2: true;           // v0.7.7 (§57): RAM keep-alive cache for fast frames (default) — no re-decode while it fits
        callback set-ram-l2(bool);
        in-out property <bool> detail-sched: true;     // v0.7.9 (§60): browse-priority detail scheduling (Lever 2 burst + Lever 1 upload priority)
        callback set-detail-sched(bool);
        in-out property <bool> frost-thumb: true;      // A3 (§61): frosted-blur mip from the 256px thumb (default) vs per-frame downscale
        callback set-frost-thumb(bool);
        in-out property <bool> pool18: true;           // A3 (§61): 18-worker decode pool (default) — boot-only, applies on restart
        // v0.8.130 (W2-2, owner ruling Q1): skip the ask-first question when a digit rates a whole
        // selection. DEVELOPER lever, OFF by default; persist-only, read live by the rate path.
        in-out property <bool> direct-bulk-rating: false;
        in-out property <bool> motion-ui: true;        // v0.8.19 (was motion-toasts; serde alias keeps an old OFF): ONE gate for ALL interface motion — M4 toast slide+fade + M5 panel-open + M6 immersive crossfade + M7 HUD chip fades. OFF = every transition instant (v0.8.18 behavior). Live-flip, pure UI gate.
        // ── M5 (v0.8.19): panel OPEN transitions — enter-only (opacity + 8px slide-down, the M4 toast
        // grammar, anim-med ease-out). Root owns one animated reveal per panel: a mount-gated panel
        // can't animate its own birth, but a root property is always alive — when the open flag flips
        // the panel mounts INSTANTLY (controls clickable the same frame, even at opacity 0.2 — hits
        // are NEVER gated on these) while the reveal animates under its visuals. Close + switch stay
        // INSTANT and mount-gated exactly as before, so a closing panel can never swallow clicks.
        // panel-switch: every exclusivity click-site records whether it closed a sibling — a SWITCH
        // renders the incoming panel at once (the M4 toast-replace crisp-swap precedent); only a
        // from-nothing open slides. eff = the gated value every binding reads (motion OFF ⇒ snap).
        property <bool> panel-switch: false;
        // v0.8.20 (feel fix): the reveals animate the ENTER only — duration 0 on the way down.
        // The 1→0 exit ran invisibly (the panel mount-culls the same frame), but a close followed
        // by a quick reopen then started the enter MID-VALUE (e.g. 0.6 → washed-out fade); with the
        // down-snap every open animates the full 0→1. Values (anim-med 200ms / 8px / ease-out) kept.
        property <float> sel-reveal: root.sel-open ? 1.0 : 0.0;
        animate sel-reveal { duration: root.sel-open ? Theme.anim-med : 0ms; easing: ease-out; }
        property <float> set-reveal: root.settings-open ? 1.0 : 0.0;
        animate set-reveal { duration: root.settings-open ? Theme.anim-med : 0ms; easing: ease-out; }
        property <float> speed-reveal: root.loading-open ? 1.0 : 0.0;
        animate speed-reveal { duration: root.loading-open ? Theme.anim-med : 0ms; easing: ease-out; }
        property <float> export-reveal: root.export-open ? 1.0 : 0.0;
        animate export-reveal { duration: root.export-open ? Theme.anim-med : 0ms; easing: ease-out; }
        property <float> sel-eff: (root.motion-ui && !root.panel-switch) ? root.sel-reveal : (root.sel-open ? 1.0 : 0.0);
        property <float> set-eff: (root.motion-ui && !root.panel-switch) ? root.set-reveal : (root.settings-open ? 1.0 : 0.0);
        property <float> speed-eff: (root.motion-ui && !root.panel-switch) ? root.speed-reveal : (root.loading-open ? 1.0 : 0.0);
        property <float> export-eff: root.motion-ui ? root.export-reveal : (root.export-open ? 1.0 : 0.0); // modal sheet — no sibling, no switch concept
        in-out property <bool> auto-orient: true;      // v0.8.0: honor EXIF Orientation (default on); live toggle re-composes
        callback set-auto-orient(bool);
        // info panel
        in-out property <bool> info-open: true;
        in-out property <bool> info-min: false;       // folded view minimised to a small "i" icon
        in-out property <bool> raw-min: false;         // RAW/JPG + zoom panel minimised to a magnifier icon
        // v0.8.97 (the floating-panels launch-preference model): the DEVELOP panel's own open flag —
        // `info-open`'s twin, and that panel's first hidden state (before this it had only raw-min).
        // Persisted (Settings.raw_open). The pair (info-open false, raw-open true) is LEGACY-only:
        // a pre-v0.8.97 settings.json that chose the old "Off" loads straight into it, and the
        // recovery affordances leave the visible develop panel alone there (support::recovery_opens_develop).
        in-out property <bool> raw-open: true;
        // v0.8.97: the LAUNCH PREFERENCE the Settings seg displays and owns — 0 Hidden / 1 Minimised
        // / 2 On (support::PanelsSegCell::index). NOT a mirror of the live panels: no panel control
        // writes it, so the i key / the − buttons / the stub clicks / the menus move the panels and
        // leave this highlight exactly where the user set it. Applied to both panels at every
        // folder/photo open where that folder has no remembered layout (tick::apply_panels_open).
        in-out property <int> panels-default: 2;
        // v0.8.98 (v0.8.97-audit C4): the seg's three RENDERED cell labels, hoisted to a root
        // property purely so a test can read them — the `info-cmd-title` precedent. The comment on
        // the `opts` line has claimed "= support::PanelsSegCell::label(), in index order" since
        // v0.8.97, and nothing checked it: an inline array literal deep in the Settings tree is
        // unreachable from Rust, so the two lists could be reworded apart with every test green
        // (exactly the C14/C20 drift that pinning found on the info command's title). The rig test
        // `panels_seg_labels_are_pinned_to_the_cells` asserts this equals `PanelsSegCell::label()`
        // for all three indices, which is what makes the "ONE source" claim true rather than stated.
        out property <[string]> panels-seg-opts: [@tr("falcon" => "Hidden"), @tr("falcon" => "Minimised"), @tr("falcon" => "On")];
        // The seg's cell → the preference AND an immediate apply to both panels (owner Q2), routed
        // through Rust (tick::apply_panels_seg → support::PanelsSegCell) so the ONE tested map owns
        // the writes and no .slint twin of it can drift.
        callback set-panels-default(int);
        // ── v1.0.0-rc (queue item 33, OWNER RULING 2.4a): THE INFO PANEL VIEW'S LAUNCH ──────
        // ── DEFAULT — the PREFERENCE, never the live `info-view`. ───────────────────────────
        // It is its own property for the reason `panels-default` above is: `sel` must show what
        // the user CHOSE, so the highlight stays put while the panel's own header buttons change
        // the view being read and while a folder open restores that folder's remembered view.
        // Born 1 (STANDARD), byte-for-byte the `info-view` birth state; re-seeded at boot from
        // the same clamped file value the live property gets (main.rs, one local for all three);
        // written only by Rust, through the callback below.
        in-out property <int> info-view-default: 1;
        // The seg's three RENDERED labels — the `panels-seg-opts` precedent (v0.8.98/C4), pinned
        // by `the_settings_view_row_names_its_three_views` against `support::InfoView::label()`.
        out property <[string]> info-view-seg-opts: [@tr("falcon" => "Simple"), @tr("falcon" => "Standard"), @tr("falcon" => "Full")];
        // The cell → the persisted FLOOR *and* an immediate apply to the open panel (owner Q2's
        // "immediate + default", the row above's precedent), through the ONE tested body
        // (tick::apply_info_view_seg → support::InfoView) so no .slint twin of the map exists.
        callback set-info-view-default(int);
        // v0.8.97 (ruling 4): THE shared recovery-from-Hidden. Every affordance that brings the
        // panels back — the revealed corner stub's click, the context-menu row, the macOS View row,
        // and (Rust-side) the i key's second press — calls this ONE body
        // (tick::apply_panels_restore), so "restore" cannot mean two things on two surfaces.
        callback restore-panels();
        in property <string> info-name: "";
        in property <[ExifRow]> exif-rows;  // all entries (expanded view)
        in property <ExifBrief> exif-brief; // folded-view essentials (5×3 grid)
        in property <bool> cs-converting: false;  // source gamut ≠ output gamut → actively colour-converting (#23/CM-1)
        in property <string> cs-chip: "sRGB";     // RAW-panel colour chip text (Rust-built, e.g. "Adobe RGB → Display P3")
        in property <string> cs-note: "";         // full hover explanation (built Rust-side: the slint! macro can't interpolate)
        in property <string> anim-info: "";       // formats batch F2: RAW-panel animation line ("GIF · animated · N frames"); "" hides it (Rust-built)
        in-out property <bool> cs-hover: false;   // hovering the colour chip → show the full note
        property <length> raw-panel-h: 124px;  // live RAW/zoom panel height (synced below) so the cs-note anchors to its top edge across modes
        in property <bool> detail-failed: false;  // current shot's full-res/RAW decode FAILED (#15) — showing the fast proxy; tap to retry
        in property <bool> can-undo-move: false;   // a "Move rejected" just ran and is reversible (#11)
        // v0.8.120 (design-sweep O5): the delete-recovery twin of `can-undo-move` — a delete record
        // exists AND the folder it ran in is still the open one (`on_recover_delete`'s own dir gate,
        // published each tick so the panel row cannot outlive it). The events row's Recover pill
        // mounts on `row.recover && root.can-recover`, exactly the shape the Undo pill uses.
        in property <bool> can-recover: false;
        // v0.8.184 (D1): THE CULL-HISTORY PAIR, published each tick from `support::cull_undo_armed`
        // — one predicate derived from `on_undo`'s own branches (the stack, and the delete record's
        // folder-identity check through `recover_offer_live`). Four surfaces read these: both
        // context menus' Undo/Redo rows and the Events header's pill pair. Per-tick derivation, not
        // write-site hooks: the undo stack has six writer families and L44 says an enumerated-sites
        // discipline is one new writer away from being silently wrong.
        in property <bool> can-cull-undo: false;
        in property <bool> can-cull-redo: false;
        // ── v0.8.186 (U2, OWNER DESIGN): ONE UNDO BUTTON, LABELLED BY CONTEXT ────────────────────
        // "would it be better to make the undo move and undo in the same button but changes text on
        // actual context (for example if last action is move then it shows undo move, as both undos
        // are mapped to the same ctrl+z)." Published each tick from `support::undo_pill_label` — the
        // SAME `live_undo_arm` call that decides `can-cull-undo` and what `undo()` will actually do,
        // so the label cannot claim an arm the chord would not take (L20: a static imperative over a
        // state-dependent dispatch is wrong in some state). Two values only: "Undo" / "Undo move".
        // Language packs (round 2): an English ID, never drawn as is — the Events header pill and
        // both context menus compare it and draw their own translated words.
        in property <string> cull-undo-label: "Undo";
        // ── v0.8.186 (U3, OWNER RULING): THE LINKAGE RIMS ────────────────────────────────────────
        // "an additional visual cue, maybe having something like a blue rim around the same undo
        // button in the events panel and the corresponding notification, indicating it is the same
        // thing/action" — plus the light-grey twin on the redo side. These are ROW INDICES into
        // `notif-model` (−1 = no row describes it), matched Rust-side by ACT STAMP and published by
        // the one derivation that also publishes the pair above. The rows read `i ==
        // root.undo-target-row`; no row carries rim state of its own (L44: one publisher).
        in property <int> undo-target-row: -1;
        in property <int> redo-target-row: -1;
        // ── v0.8.186 (U4, OWNER RULING): THE PINNED LAST-ACTION ROW ──────────────────────────────
        // "I would like to check if it is possible to add a temporary row describing the last action
        // (which is for things that does not trigger a notification - like flagged HWU_1234)" — with
        // "a blue circle indicator before the start of the sentence to indicate it is the one to be
        // undone". Rust composes the sentence (`support::last_act_sentence`) and publishes "" when
        // the act already HAS a row (the rim goes there instead) or when nothing honest can be said.
        // One property, so the text and the mount gate cannot disagree.
        in property <string> last-act-text: "";
        in property <bool> export-running: false;   // a web export is in progress (#18) → show the progress card
        in property <int> export-done: 0;           // shots processed so far
        in property <string> export-filename: "";
        in property <string> export-phase: "";
        in property <bool> export-stopping: false;
        in property <int> export-total: 0;          // shots to process
        // ── v0.8.138 (X3, owner-designed): THE INFO PANEL'S VIEW, NOW THREE-VALUED. ──────────────
        // 0 = SIMPLE · 1 = STANDARD · 2 = FULL. It replaces the `exif-expanded` BOOL, which could
        // only ever say "the long list or the short grid" — and the owner has designed a third,
        // SMALLER view: the immersive cull card's look (a filename and the cull row, nothing else)
        // brought onto the normal stage.
        //
        // WHY AN INT AND NOT A SECOND BOOL. Two bools spanning three states means one combination
        // that must never occur (simple AND expanded), which is a rule living in the head of
        // whoever edits next rather than in the type. An int with three named values cannot hold
        // the illegal state at all, and the ladder is the SIZE ladder — 0 smaller than 1 smaller
        // than 2 — so `< 1` and `== 2` read as what they mean at every site.
        //
        // ORTHOGONAL TO `info-min`, DELIBERATELY, AND THAT IS WHAT KEEPS THE i KEY UNCHANGED. The
        // stub is still the (open, min) pair and nothing here touches it: `i` still folds the panel
        // to the "i" and unfolds it to WHATEVER VIEW IT HELD, which is exactly the old promise
        // ("re-opening returns to the view the user minimised from") now covering three views
        // instead of two. `support::info_key_action` is closed over (open, min) and is not widened;
        // `support::info_expanded` still means "the panel is mounted" and is not widened; the View
        // menu's `info-cmd-title` ladder reads (info-open, info-min, raw-open) and is not touched.
        // SIMPLE IS ENTERED ONLY BY THE PANEL'S OWN DOWN ARROW (owner ruling) — no key, no menu.
        //
        // The default is 1 (STANDARD) — byte-for-byte the old `exif-expanded: false` birth state.
        in-out property <int> info-view: 1;
        in property <int> rating: 0;
        in property <bool> flagged: false;   // current shot picked (for editing)
        in property <bool> rejected: false;  // current shot rejected (for culling)
                                             // (named *ed to avoid Slint's `reject` event keyword)
        // selection / cull-management panel
        in-out property <bool> sel-open: false;          // the flag/reject management panel
        // ── v1.0.0-rc (queue item 31, sheet 2.5): HOVER TO PREVIEW ─────────────────────────────
        // Rest the pointer on a Review tile and the photograph appears larger beside the panel.
        // Slint owns the hover surface, the mount and the clamp; `tick::step_hover_preview` owns
        // the clock, the cache read, the geometry and the publish.
        //
        // THE SETTINGS ROWS. Persist-only, no callback (the `direct-bulk-rating` / `pool18` class):
        // the step reads them live. Both literals MATCH `support::Settings::default()` — true and
        // false — which is what makes a fresh install and an old settings.json agree.
        in-out property <bool> hover-to-preview: true;
        in-out property <bool> hover-preview-instant: false;
        // The A/B row's cells, published from `support::HoverAppears::label()` in index order and
        // pinned against it by `hover_appears_labels_are_pinned_to_the_cells` — the
        // `panels-seg-opts` / `info-view-seg-opts` one-source idiom, because an inline array literal
        // deep in the Settings tree is unreachable from Rust and could be reworded apart with every
        // test still green.
        in property <[string]> hover-appears-seg-opts: [@tr("falcon" => "After a short rest"), @tr("falcon" => "At once")];
        // The A/B row's own callback. The VALUE is written by the Seg's arm; this exists for the
        // field-log line (h8) and for `HoverAppears::label()`'s production use.
        callback set-hover-appears(int);
        // WHICH TILE THE POINTER IS ON, with -1 as the sentinel — the filmstrip's own spelling for
        // the same question. Written in ONE place (the tiles' `hover-changed` handler below) and
        // cleared by four edges: a panel scroll under a resting pointer, the panel closing,
        // immersive, and the modal edge (ledger L22 — a destroyed or unmounted TouchArea never
        // fires `changed has-hover`). The Rust step ALSO forces its whole state to default whenever
        // the gate is false, so these clears are belt to its braces.
        in-out property <int> sel-hover-idx: -1;
        in-out property <length> sel-hover-cy: 0px;
        // A press on a tile, consumed and cleared by the step on the next tick: it hides the card
        // and keeps it hidden until the pointer moves to another tile.
        in-out property <bool> sel-hover-press: false;
        // Rust → UI: the picture, the word, the box (already snapped to whole device px) and the
        // room. `sel-preview-shown` is the ONE flag the mount and the Esc rung both read.
        in property <image> sel-preview-img;
        in property <bool> sel-preview-loading: false;
        in property <bool> sel-preview-shown: false;
        in property <length> sel-preview-w: 0px;
        in property <length> sel-preview-h: 0px;
        in property <bool> sel-preview-room: false;
        in-out property <bool> xmp-sync: false;          // v0.8.69 (E/H2): XMP rating sync (the Rated-row "XMP sync" pill since v0.8.75) — Rust owns the flip (a cancelled backfill leaves it OFF)
        // v0.8.84: the XMP toggle's tooltip (owner ruling: rejects/flags NEVER reach sidecars — the
        // toggle must say so where it lives). ONE property because three sites must compare against
        // the SAME string: the xmpta hover report, its click-time clear, and the changed sel-open
        // unmount clear (the SectionChip v0.8.53 ownership-compare grammar).
        property <string> xmp-tip: @tr("falcon" => "Only star ratings sync to XMP — flags and rejects stay in Falcon.");
        // ── v0.8.129: THE TRANSIENT SELECTION (the selection round, wave 1) ──────────────────
        // A multi-select WORKING SET, disjoint from flag/reject: Ctrl/Cmd+click toggles, Shift
        // ranges, Ctrl+A selects everything displayed. It is Rust-owned (support::SelectSet) and
        // never persisted; the UI reads exactly two things about it — how many are in it, and, per
        // tile, whether that tile is one of them (FilmItem.selected).
        in property <int> count-selected: 0;
        // The hidden "Selected" category chip's WHOLE label ("Selected · 12"), composed in Rust
        // (support::selected_chip_label): Slint 1.17 has no int+string concatenation.
        in property <string> selected-chip-label: "";
        // The two context menus' counted clear row (support::clear_selection_label), published by
        // on_ctx_populate like every other counted menu field — never re-derived here.
        in property <string> ctx-clear-sel-label: @tr("falcon" => "Clear selection");
        // The mode-5 empty state's hint (support::sel_hint_selected_text — it names the platform's
        // own modifier, so it can never teach a key this OS does not have).
        in property <string> sel-hint-selected: "";
        // Shift is physically held → the CURRENT photo's tile previews the range origin in the REST
        // selection visual (owner ruling). Fed by the FocusScope's key handlers below. KNOWN
        // LIMITATION, inherited from Slint (there is no ModifiersChanged event): Shift held ACROSS a
        // focus switch into Falcon reads stale until the next key event. Low-frequency; the preview
        // is decoration, and the gesture itself always reads the live pointer-event modifiers.
        in-out property <bool> shift-held: false;
        // v0.8.133 (the visual wave, D): the CTRL mirror, written beside both `shift-held` writes and
        // reading `e.modifiers.control` — the same field `sel-gesture-kind` classifies with, so the
        // day the Mac trunk swaps Ctrl for Cmd both move together. It inherits the same known
        // limitation stated above (Slint has no ModifiersChanged, so a modifier held across a focus
        // switch INTO Falcon reads stale until the next key event); the preview is decoration and the
        // gesture itself always reads the live pointer-event modifiers.
        in-out property <bool> ctrl-held: false;
        // ...and the one place the previews' DORMANCY is decided, so the three tile surfaces do not
        // each carry the rule (addendum A-2: selection is fully dormant in compare and immersive).
        // v0.8.132 (J16 (a)): `out` so the rig can READ it.
        //
        // v0.8.133 (D — and a BUG FIX): the dormancy is `sel-affordance-live` now, and it has a THIRD
        // term. `sel-gesture-kind` refuses under a modal (nothing behind the scrim may mutate state),
        // but `sel-preview` did not — so with a confirm dialog up, holding Shift lit the current
        // photo's tile with the selection visual for a click the classifier would have thrown away.
        // A preview that promises a refused gesture is worse than no preview; the two now read ONE
        // predicate, which is also what stops the Ctrl twin below from re-importing the same hole.
        out property <bool> sel-affordance-live: !root.opening-photo && !root.compare && !root.immersive && !root.modal-open;
        out property <bool> sel-preview: root.shift-held && root.sel-affordance-live;
        // The Ctrl twin: hovering a tile with Ctrl held shows the REST selection visual — what the
        // click would do — on the tile under the pointer. Each surface ANDs this with its own hover.
        out property <bool> sel-ctrl-preview: root.ctrl-held && root.sel-affordance-live;
        // (idx, kind 0 toggle / 1 range-replace / 2 range-add, from-the-Review-panel). The last
        // argument decides WHICH displayed order a range walks: the panel's filtered feed, or the
        // whole folder (what the strip / dock / stage actually display).
        callback sel-gesture(int, int, bool);
        callback select-all-displayed();     // Ctrl+A — every DISPLAYED photo
        callback clear-selection();          // the nested ×, both ctx menus, empty space, Esc (Rust-gated)
        callback restore-selection();        // the recovery toast's [Restore] pill
        // ── v0.8.130 (W2-1): THE ADAPTING OUTPUT COLUMN ──────────────────────────────────
        // Every one of these is composed in Rust (support::out_col1_*) and published from the
        // tick's own gated pass. The COUNT drives enablement (L15) and the confirm's headline
        // number; the labels stay SHORT because ActionBtn has no clip in a stretch-1 column
        // (L5/H16) — counts live in the confirm, never on a button.
        in property <int> count-out-col1: 0;
        in property <string> out-col1-title: @tr("falcon" => "Picks");
        in property <string> out-copy-label: @tr("falcon" => "Copy picks");
        in property <string> out-web-label: @tr("falcon" => "Export picks");
        in property <string> out-confirm-title: @tr("falcon" => "picks → copy to ./Picks");
        // v0.8.131 (F-P7): the WEB sheet's three retargeted strings, composed Rust-side beside the
        // copy column's own (Slint has no int+string concat, and a UI-side re-derivation of a
        // counted noun is the divergence class this file keeps closing).
        in property <string> out-web-sentence: @tr("falcon" => "picks → export copies → export folder");
        in property <string> out-web-description: "";
        in property <string> out-web-progress-title: @tr("falcon" => "Exporting");
        // v0.8.134 (R2): the RUN's title, captured by the export handler at the instant it starts.
        // The property above is republished every tick by the out-column's gated pass from the
        // DISPLAYED count, and closing the web sheet resets the include-rejects toggle that feeds
        // that count - so a card bound to it went stale to the category default ONE TICK into a run
        // that was still exporting the set the title named. A progress card must say what its own
        // run is doing; the live property stays live for the sheet, which is where live is right.
        in property <string> web-progress-run-title: @tr("falcon" => "Exporting");
        in property <string> out-confirm-body: "";
        // ── v0.8.132 (OQ1, owner-ruled 08-03): THE REJECTED-PHOTOGRAPHS TOGGLE ───────────
        // The adapting column targets what is DISPLAYED, and a Reviewed / Rated / Rotated view can
        // hold photographs already marked reject. `out-reject-count` is how many of the target set
        // those are, measured BEFORE any exclusion: it is the row's mount gate (L4) AND the number
        // the row's sentence names, so it must not collapse to 0 the moment the toggle turns them
        // off — a control that unmounts itself cannot be undone. `include-rejects` is the toggle
        // itself; `include-rejects-default` is what every open of either surface RESETS it to (the
        // two `changed` arms further down — L18, one semantic, no stale carry).
        in property <int> out-reject-count: 0;
        in property <string> out-include-label: "";
        in property <bool> include-rejects-default: false;
        in-out property <bool> include-rejects: false;
        // Owner 2026-09-09: the RAW-only run choice is Skip / Camera preview / Develop RAW.
        // Count over the effective set before the choice, so Skip cannot hide the control.
        // The answer belongs to this run, not a preset or saved setting; every sheet open resets it.
        in property <int> out-raw-only-count: 0;
        in property <string> out-include-raw-label: "";
        in property <string> include-raw-caption: "";
        in property <string> raw-develop-caption: "";
        // Owner 2026-09-09: per-run Skip / Camera preview / Develop RAW; reset to Skip on open.
        in-out property <int> raw-export-mode: 0;
        // ── v0.8.130 (W2-2): BULK ACTIONS ────────────────────────────────────────────────
        // THE ENABLEMENT MIRROR of Rust's `support::bulk_actions_allowed` — the one gate, published
        // for every surface that must GLOW and ENABLE exactly while the shared dispatch body would
        // act (L21/L26). It is a MIRROR, never the authority: every handler re-asks the same
        // question Rust-side.
        //
        // v0.8.130 shipped a four-term `bulk-armed` beside this one (the keyboard's, with
        // `sel-open`); v0.8.133 split this one off it for the explicit surfaces. v0.8.135 (W1)
        // collapsed the pair: the owner superseded the panel term, so there is one gate and one
        // mirror. `sel-open` is not among its terms and that is the ruling, not an omission — the
        // Selected chip, the tile rims and the strip rims are the disclosure, and they are on screen
        // whether the Review panel is or not.
        //
        // It also replaces FIVE inline copies of the same three terms (the two clear-selection rows
        // and the three counted bulk rows) — the sixth copy is what this property exists to prevent.
        out property <bool> bulk-actions-armed: root.count-selected > 0 && !root.compare && !root.immersive;
        in property <string> ctx-bulk-flag-label: @tr("falcon" => "Flag");
        in property <string> ctx-bulk-reject-label: @tr("falcon" => "Reject");
        in property <string> ctx-bulk-delete-label: @tr("falcon" => "Delete…");
        // v1.0.0-rc (queue item 27): the round's three new counted row labels, composed in Rust by
        // `on_ctx_populate` like every counted label above — Slint has no int+string concatenation.
        in property <string> ctx-bulk-rot-cw-label: @tr("falcon" => "Rotate right");
        in property <string> ctx-bulk-rot-ccw-label: @tr("falcon" => "Rotate left");
        // v1.0.0-rc TAIL (item 27, skeptic N3): the DEFAULT is platform-neutral. Every open site
        // calls `ctx-populate` first, which publishes `support::reveal_label(n)` ("Reveal 5 in
        // Explorer" / "… in Finder"), so this literal is unreachable in practice — but it was the
        // only Windows string in markup both platforms compile, and its two siblings above are
        // already neutral.
        in property <string> ctx-reveal-label: @tr("falcon" => "Reveal");
        // v0.8.133 (C.4 ii): the always-on-screen bulk row's four inputs, published by the TICK's
        // gated selection sweep (never by ctx-populate: that runs on a right-click, and this row is
        // on screen the whole time). COUNTED AND DIRECTED — "Unflag 12", never a direction-blind
        // count — and the two on-flags carry the GROUP's state so the button, its label and the
        // write it performs cannot disagree. `bulk-uniform-rating` is -1 for a mixed spread.
        in property <string> bulk-flag-label: @tr("falcon" => "Flag");
        in property <string> bulk-reject-label: @tr("falcon" => "Reject");
        in property <bool> bulk-flag-on: false;
        in property <bool> bulk-reject-on: false;
        in property <int> bulk-uniform-rating: -1;
        // The ask-first arming flag. Cleared by EVERY toast teardown Rust-side, which is what
        // makes "every dismissal that is not Yes is a No" structural rather than enumerated (L18).
        in-out property <bool> toast-bulk-ask: false;
        // Which delete dialog kind 6 currently is. Set true only by the bulk opener and false by
        // the single one, so a stale value can never reach a single delete.
        in-out property <bool> del-bulk: false;
        callback bulk-mark(int);        // 0 = flag, 1 = reject — the uniform-state toggle
        // v1.0.0-rc (queue item 27, sheet 2.1 B2 b): rotate the WHOLE SELECTION, +1 CW / -1 CCW.
        // Index-free, like `bulk-mark` beside it and `copy-selected` below: the subject IS the set.
        callback bulk-rotate(int);
        callback bulk-rate-ask(int);    // ask-first (or direct, behind the DEVELOPER lever)
        callback bulk-rate-yes();
        callback bulk-rate-no();
        callback bulk-delete-ask();
        // ── v0.9.64 (OWNER RULING 08-04): the two doors the mac MENU BAR's plural Photo rows need.
        // Declared here and invoked ONLY from Rust (main.rs's menu-command drain) — no Slint site
        // calls them, because the menu bar is an AppKit surface with no .slint representation. Both
        // re-ask `support::bulk_actions_allowed` Rust-side and both land in the SAME executors every
        // other bulk invoker lands in (`bulk_apply` / `bulk_rate_request`), so there is one
        // implementation of each operation and the menu has no twin of anything.
        //
        // `bulk-unmark` is the `u` key's plural — BulkOp::Clear over the whole selection.
        // `bulk-rate-ask-key` is `bulk-rate-ask` with the KEYBOARD's re-press semantic instead of
        // the star click's: it hands `bulk_rate_request` the user's own "press current rating again
        // to clear" setting rather than a hardcoded true. That parameter has always been the
        // invoker's answer to "does pressing the rating a photo already has mean clear it?" (the
        // tile stars say yes, the digits ask the setting), and the menu-bar Rate row is the DIGIT's
        // twin — it carries the digit as its key hint and its single-photo arm already routes
        // through `same_key_clear_target`. Sharing the star row's door would have made the row
        // answer that question one way with a selection and the other way without one.
        callback bulk-unmark();
        callback bulk-rate-ask-key(int);
        // ── v0.8.130 (W2-4): the export manifest ─────────────────────────────────────────
        in property <bool> ctx-has-manifest: false;
        in property <string> ctx-sel-new-label: @tr("falcon" => "Select new / edited");
        // v0.8.131 (J2 [VD]): is the tile this menu was opened on part of the selection? The three
        // bulk rows MOUNT on it — scope never mixes in one menu. Published by ctx-populate.
        //
        // v0.8.134 (ORANGE-2): it is NOT tile-specific, and both menus rely on that. `ctx-populate`
        // computes it from the RESOLVED TARGET (`t` in main.rs — the clicked tile or thumb, or the
        // CURRENT shot when the stage is right-clicked with idx -1), and every one of the five open
        // sites calls that one populate. So it already answers "is the photo this menu is about in
        // the selection" for the photo menu as well; the name is where it was born, not what it
        // measures. Kept rather than renamed so the J2 rows and the rig pins that name it stay put.
        in property <bool> ctx-tile-selected: false;
        // v0.8.134 (ORANGE-2): THE CTX STAR ROWS' ARM, and the term J2 was missing.
        //
        // v0.8.133 armed both menus' rating rows on `bulk-actions-armed` ALONE, which re-opened the
        // exact state J2 closed one row below: right-click an UNSELECTED photograph with 12
        // selected and a glowing five-star row appeared that rated THE TWELVE — the photo under the
        // cursor in neither scope, one row above three bulk rows that had been gated out of that
        // very menu for the same reason. Two scopes in one menu, again.
        //
        // The row STAYS MOUNTED either way — unarmed it is the single-photo rating control, which
        // is the one cull verb the tile menu has and the thing every other row here targets — so
        // only the ARMED arm gates and neither menu's height moves. (That is why the C-2 rig pins
        // are unchanged: 593/494 on the tile menu, both scopes.)
        out property <bool> ctx-rate-armed: root.bulk-actions-armed && root.ctx-tile-selected;
        callback select-new-edited();
        // v0.8.129 (A-5 / L22): the Selected chip is MOUNT-GATED on count-selected > 0, and its row
        // appearing or vanishing RE-LAYS-OUT the panel rows under it — including the Rated row, which
        // hosts the app's only POSITIONED tooltip. A tip parked at the old y would then point at
        // nothing, so the mount edge is treated as that host's unmount edge, exactly as
        // `changed sel-open` and `changed immersive` already treat theirs. Same ownership compare
        // (only a tip this panel parked is cleared), same unconditional cy reset.
        property <bool> sel-chip-mounted: root.count-selected > 0;
        changed sel-chip-mounted => { if (Tip.text == root.xmp-tip) { Tip.text = ""; } Tip.cy = 0px; }
        // v0.8.119 (design-sweep Y45): the COUNT, not a bool. The Empty-to-Bin confirm was the
        // only dialog in the app with no magnitude — on the op with the widest reach — because the
        // probe deliberately returned a bool. It counts in the same single read_dir pass now, so
        // the dialog leads with the same big number every sibling kind shows and the button's
        // enablement (count > 0) is behaviourally identical to the old has-rejected.
        in property <int> count-bin: 0;                  // W3d: files directly inside ./Rejected (probed on panel-open / op-finish / folder change)
        // v0.8.119 (design-sweep O24): the Selection panel's destructive Empty button spoke a
        // hardcoded Windows noun while every other string of the SAME operation — the confirm
        // title, body and button — is routed through platform.rs. On macOS the panel said
        // "Empty → Bin" and the dialog it opened said "Empty to Trash": two nouns for one OS
        // destination, one of which does not exist there. Set from platform::PLATFORM
        // (empty_action_label), the same channel the dialog uses; the Windows bytes are pinned by
        // main.rs's windows_strings_unchanged, which also lists this invoker (L26).
        in property <string> empty-action-label: @tr("falcon" => "Empty → Bin");
        // v0.8.119 (design-sweep Y60): the Selection panel's empty-state hints. They used to be
        // fixed strings naming P / X / R / 1–5 while all four actions are rebindable, so a user who
        // moved Flag to K and Reject to P was told "Press P on a photo to flag a keeper" by the one
        // surface whose job is to teach the empty state. Composed in Rust from the live keymap
        // (support::selection_empty_hints) at the SAME chokepoint that refreshes the menu chips, so
        // a rebind updates them in the same breath; an unbound action drops the key from the
        // sentence rather than printing the "—" placeholder.
        in property <string> sel-hint-picks: "";
        in property <string> sel-hint-rejects: "";
        in property <string> sel-hint-rated: "";
        in property <string> sel-hint-rotated: "";
        in property <string> sel-hint-any: "";
        in-out property <int> filter-mode: 0;            // 0 Reviewed / 1 Picks / 2 Rejects / 3 Rated / 4 Rotated
        in-out property <int> sel-rating-filter: -1;     // -1 off · 0..5 = only shots with EXACTLY that rating (Phase D)
        // v0.8.123 (I1d): how many shots carry each rating 0..5 WITHIN the current mode filter
        // (Rust-set, from the same gated O(len) sweep that feeds the pill counts). A digit chip
        // whose bucket is 0 cannot build anything but an empty grid, so it renders inert.
        in property <[int]> dchip-counts: [0, 0, 0, 0, 0, 0];
        // v0.8.124 (R3): the bucket the digit-0 chip's CLICK would land in while "★ Rated" is lit.
        // That click drops the mode to Reviewed first (Y59), so the view it builds is
        // (mode 0, rating 0) — reviewed-but-unrated — and `dchip-counts[0]` under mode 3 is
        // structurally zero and cannot speak for it. Same gated sweep, same `support::sel_mode_ok`,
        // so this is still ONE Rust-computed number and the chip cannot disagree with the grid.
        in property <int> dchip-landing-zero: 0;
        in property <[SelTileRow]> sel-rows;             // matching photos, row-chunked into tile pairs
        // v0.8.42 (Item 1): the Selection grid's live viewport (scroll offset + visible height),
        // mirrored from the grid Flickable (two-way / changed-observer below) — the tick maps these
        // to visible rows for demand-loading + eviction-pinning. Rust only READS them.
        in-out property <length> sel-vp-y: 0;
        in-out property <length> sel-vp-h: 0;
        // ── v0.8.154 (A3, owner ruling Q11): THE REVIEW PANEL OPENS RECENTRED ON THE CURRENT SHOT.
        // The pair above is a READ mirror and stays one (v0.8.123 I1b made it one-way on purpose:
        // Slint's Flickable calls `viewport_y.remove_binding()` on every non-Ended wheel phase, and
        // with `interactive: false` nothing would re-establish a two-way alias it dropped). So the
        // recenter gets its OWN one-way channel in the other direction rather than restoring `<=>`.
        //
        // `sel-scroll-seq` is a NONCE, not decoration: the Flickable is mount-gated on `sel-open`,
        // so a re-open starts at viewport-y 0 with a freshly-constructed element — and re-opening
        // the panel on the SAME shot computes the SAME `sel-scroll-y`, which a `changed sel-scroll-y`
        // observer would not see. Rust bumps the seq every time it wants the scroll applied.
        in property <length> sel-scroll-y: 0px;   // target Flickable viewport-y (NEGATIVE = scrolled down)
        in property <int> sel-scroll-seq: 0;      // bump = "apply sel-scroll-y now"
        in property <int> cur-idx: -1;                   // current shot index (reactive tile highlight)
        in property <int> count-all: 0;                  // total shots (for the fresh-folder empty state)
        in property <int> count-reviewed: 0;             // rated OR flagged OR rejected
        in property <int> count-rated: 0;
        in property <int> count-picks: 0;
        in property <int> count-rejects: 0;
        in property <int> count-rotated: 0;              // v0.8.0: distinct shots with a manual rotation
        in property <bool> sel-busy: false;              // a copy/move/export is running (disables actions)
        // Unified events / notifications centre (top-right bell) — the single place all warnings + results surface.
        in property <[NotifRow]> notif-model;            // recent notifications, newest first
        in property <int> notif-unread: 0;               // count since the panel was last opened → bell badge
        in-out property <bool> notif-open: false;        // the events dropdown is open
        in property <bool> tick-degraded: false;         // N9: the per-frame pipeline is failing repeatedly (banner)
        in property <bool> wm-font-missing: false;       // N18: the chosen watermark font isn't installed (fallback in use)
        // v0.8.121 (Round-B fix F16 = audit Y11): …and the SENTENCE that states it, composed once in
        // Rust (support::wm_font_missing_text) so the preset editor's warn line, the export list's
        // warn line and the export-time events entry cannot say the same fact three ways. The warn
        // glyph belongs to each surface; this is the sentence only.
        in property <string> wm-font-warn: "";
        in property <string> toast-text: "";             // transient top-right toast (latest notification)
        in property <int> toast-kind: 0;
        in property <string> toast-reveal-path: "";      // absolute result-folder path for the toast's "Show" ("" = none)
        in property <bool> toast-undoable: false;
        in property <int> toast-jump: -1;                // D2: shot index for a "Resume" toast button (-1 = none)
        in-out property <bool> toast-recover: false;     // v0.8.37 (FIX A1): the delete toast Recover action (restore from the OS Recycle Bin)
        // v0.8.129 (W1-5): the selection clear-recovery action ("Selection cleared (12) [Restore]").
        in-out property <bool> toast-restore: false;
        // v0.8.104 (Round-A C12): the "Open Settings" pill — the recovery route for the boot
        // colour-profile failure, whose fix lives in Settings. The toast is the one surface every
        // affected user sees, and it carried no route at all: the copy said "load it again below"
        // where there is no below. Owner ruling: it opens Settings PLAINLY, no deep link.
        in-out property <bool> toast-settings: false;
        in property <bool> toast-show: false;
        in property <int> toast-more: 0;                 // D1: notifications superseded before timeout -> "+N" chip
        callback toggle-notif();                         // bell click → open/close the events panel (Rust resets unread)
        callback notif-clear();                          // clear the event log
        callback notif-dismiss(int);                     // × on one event row → remove that entry
        callback dismiss-toast();                        // × on the toast
        callback reveal-path(string);                    // open an absolute folder path in the OS file manager
        in-out property <int> confirm-kind: 0;           // pending file op: 0 none / 1 copy picks / 2 move rejects / 3 empty rejected / 4 discard rot / 5 apply rot / 6 delete photo (v0.8.13)
        in property <string> delete-body: "";            // v0.8.13: the "Delete photo?" body, composed Rust-side (filename / pair / sidecar note)
        in property <string> delete-title: @tr("falcon" => "Delete photo?"); // v0.8.130 (W2-2): …and its HEADLINE, which the plural delete makes count-bearing
        in property <string> copy-rot-notice: "";        // v0.8.22 RIDER: Copy-selected (kind 1) confirm line when picks carry unapplied rotation (Rust-composed; empty = hidden)
        in property <string> copy-cloud-notice: "";     // v0.8.24 (D4): Copy-selected (kind 1) line — N cloud-only files a Copy would download (Rust-composed; empty = hidden)
        in property <string> move-cloud-notice: "";     // v0.8.24 (D4): Move-rejected (kind 2) line — N cloud-only files a Move would download (Rust-composed; empty = hidden)
        callback delete-key();                           // v0.8.13: Delete/Backspace on the stage → Rust gates + opens the popup (confirm-kind 6)
        callback delete-shot(int);                       // v0.8.28: context-menu Delete… — (shot idx or -1 = current). SAME capture + gate class as delete-key, at the menu's TARGET shot
        callback delete-recycle();                       // v0.8.13: "Move to Recycle Bin" confirmed → Rust recycles the shot's file(s) + sidecars, then rescans
        callback delete-flag-reject();                   // v0.8.15 (F3): "Mark as rejected" (kind-6 middle button) runs the SAME folder-scoped identity check, then SETS reject on the verified index
        in-out property <bool> rot-reminder-open: false; // v0.8.0 S2: the "N rotations not applied" close reminder
        in-out property <int> copy-content: 0;           // picks copy-content: 0 RAW+JPG / 1 RAW only / 2 JPG only (output triad)
        // web-export sheet (watermark + size). Type 0 None / 1 Image / 2 Text(staged).
        in-out property <bool> export-open: false;
        in-out property <int> export-mode: 0;            // 0 = preset list / 1 = preset editor
        in-out property <int> sel-preset: -1;            // selected preset index in list mode
        in-out property <int> wm-type: 0;
        in-out property <int> wm-opacity-tier: 2;        // 0 Faint / 1 Subtle / 2 Medium / 3 Solid
        // Custom slider values (Phase B): > 0 = a typed value OVERRIDES the tier; 0 = tier-driven.
        // (0 is the safe sentinel — old settings/presets deserialise their missing fields to 0.)
        in-out property <int> wm-opacity-pct: 0;         // custom opacity % (10..100)
        in-out property <int> wm-size-pct: 0;            // custom size % of long edge (5..60)
        in-out property <int> out-quality-custom: 0;     // custom JPEG quality (50..100)
        in-out property <int> wm-size-tier: 1;           // 0 Small / 1 Medium / 2 Large / 3 XL
        in-out property <float> wm-pos-x: 0.92;          // logo centre X (0..1) — precise position
        in-out property <float> wm-pos-y: 0.92;          // logo centre Y (0..1)
        in-out property <int> out-long: 2048;            // export long edge (px)
        in-out property <int> out-quality-tier: 1;       // 0 Web / 1 Social / 2 Print / 3 Max
        // v1.0.0-rc EXPORT FORMAT (F4): the ./export deliverable's container -- 0 = JPG, 1 = PNG. It
        // is an int because the Seg speaks ints; the ONLY translation to the Rust enum is
        // `WebFormat::from_index` / `::index`, so a stop cannot come to mean two things. Persisted
        // and applied exactly like `out-long` (the boot read, the preset apply, the settings
        // snapshot). It sits FIRST in the OUTPUT section because it decides what the two rows under
        // it mean -- a PNG has no quality tier.
        in-out property <int> out-format: 0;
        // v1.0.0-rc EXPORT FORMAT (F4): the Quality row's caption, composed in Rust
        // (`support::out_quality_caption`) because it now depends on THREE inputs -- the format, the
        // tier and the custom override -- and a six-state sentence living in a Slint expression is a
        // sentence no row can falsify. Republished by the same gated tick pass that publishes
        // `wm-name-example`.
        in property <string> out-quality-caption: "";
        // v1.0.0-rc EXPORT FORMAT tail (§R-B): the Format row's caption, composed in Rust too
        // (`support::out_format_caption`). It was a two-element array literal here -- which put the
        // round's headline sentence, the one that answers "can Falcon convert images?", in the one
        // place no row can measure, and both of its stops shipped a false clause. Seeded at boot
        // and on every preset apply as well as from the tick, so it never paints empty.
        in property <string> out-format-caption: "";
        // v0.8.11 (F3 / task #16): resume-position cap — how many folders keep a last-viewed mark.
        in-out property <int> resume-cap-tier: 2;        // 0 = 0(Off) / 1 = 3 / 2 = 10  (RESUME_CAP_TIERS)
        in-out property <int> resume-cap-custom: 0;      // > 0 = a typed cap (1..500) OVERRIDES the tier; 0 = tier-driven
        in-out property <string> wm-text: "";            // Text-watermark content (type 2)
        in-out property <int> wm-text-color: 0;          // 0 White / 1 Black / 2 Grey
        in-out property <string> wm-font: "";            // chosen font family ("" = default system UI font)
        in property <[WmFontRow]> wm-fonts;              // installed font families + typeface-preview strips (Rust-set; enumerated + rendered off-thread, v0.8.90)
        in-out property <bool> wm-font-open: false;      // the font-picker dropdown is expanded
        callback set-wm-font(string);                    // pick a font family → reload + re-raster
        in property <string> wm-image-name: "";          // chosen logo filename (Rust-set; "" = none)
        in property <float> wm-aspect: 1.5;              // preview photo aspect (w/h) — maps drag onto the photo, not the letterbox
        in property <[string]> wm-preset-names;          // saved preset names (Rust-set)
        // v0.8.154 (A7, owner ruling Q25): row-parallel RECIPE lines ("2048 px · q80 · text mark ·
        // bottom-right"), composed in Rust (Slint has no int+string concat — the `hud-pos` rule) and
        // shown as the row's HOVER TOOLTIP, never as a visible summary line. Written only by
        // main.rs's `publish_presets`, together with the names, so index i cannot describe preset j.
        in property <[string]> wm-preset-tips;
        // queue 34 (§1.D, OWNER ASK): the row-parallel preset BRIEFS — the four chips the list row
        // renders beside the name (format · resolution · compression · watermark). Filled by the
        // SAME `publish_presets` walk as the names and the tips, so index i cannot describe preset
        // j; an empty field means "this preset has no such term" and mounts no chip (L4).
        in property <[PresetBrief]> wm-preset-briefs;
        // v0.8.154 (A7, ledger L22): which preset tip THIS surface parked on the shared Tip channel
        // ("" = none). The count-chip clears a few hundred lines up can enumerate their literals;
        // these strings are per-preset and Rust-composed, so the ownership guard needs the value
        // recorded rather than re-derived. Set on hover-in, cleared on hover-out and on every gate
        // below that can destroy a hovered row.
        in-out property <string> wm-tip-owned: "";
        // v0.8.154 (A7, ledger L22 — UNMOUNT EDGES ARE DISMISS PATHS): the preset rows live under
        // TWO mount gates, `export-open` and `export-mode == 0`, and BOTH can fire under the
        // pointer — clicking a row's pencil switches to the editor (mode 1) with the cursor still on
        // the row, and Esc closes the whole sheet. A destroyed TouchArea never fires `changed
        // has-hover`, so without this the recipe would strand on the shared Tip channel and float
        // over whatever replaced the sheet. Mirrored as a local bool because a `changed` observer
        // lives on the element that DECLARES the property; ownership-guarded on `wm-tip-owned`
        // (never a blanket clear — a title-bar host stays live under this sheet and may own the
        // channel); cy reset unconditionally, the `xmpta` rule for the sole positioned host.
        property <bool> wm-list-mounted: root.export-open && root.export-mode == 0;
        changed wm-list-mounted => {
            if (!root.wm-list-mounted && root.wm-tip-owned != "") {
                if (Tip.text == root.wm-tip-owned) { Tip.text = ""; }
                root.wm-tip-owned = "";
                Tip.cy = 0px;
            }
        }
        // v0.3.60 perf: the preview is now GPU-composited — a STATIC base photo (no watermark)
        // plus the watermark raster as a separate overlay Image positioned at the box rect. This
        // replaced the per-frame CPU recomposite that made the large-view drag drop frames.
        // v0.8.100 (A2): `in-out` (was `in`) purely so Rust can READ these back — nothing in .slint
        // writes them. Both now carry COLOUR-MANAGED pixels (baked source→output gamut by
        // step_wm_preview), and the headless rig asserts the actual bytes of the surface rather than
        // trusting the call site; a write-only property cannot be verified that way.
        in-out property <image> wm-photo;                // the CM-baked sample (no watermark) — static base
        in-out property <image> wm-logo;                 // the CM-baked watermark raster, overlaid live
        in property <float> wm-logo-op: 1.0;             // effective opacity applied to the overlay
        // UNCLAMPED logo size fractions (may exceed 1.0) — the overlay Image uses these so an
        // oversized watermark crops at the image edge (clip container) like the export, not squished.
        in property <float> wm-logo-w: 0.0;
        in property <float> wm-logo-h: 0.0;
        // W3a: the watermark's composited rect as FRACTIONS of the photo (Rust-set from the same
        // watermark_rect math the export stamp uses) — drives BOTH the accent box AND the overlay.
        in property <float> wm-box-x: 0.0;
        in property <float> wm-box-y: 0.0;
        in property <float> wm-box-w: 0.0;
        in property <float> wm-box-h: 0.0;
        in property <bool> wm-box-show: false;
        // W3b: the stage-sized watermark preview (drag + scroll-resize; opened by the magnifier
        // button on the small preview; the shared MinimizeIcon returns to the sheet).
        in-out property <bool> wm-large: false;
        callback wm-request-sample(int);   // re-decode the preview sample at this long side (px)
        callback open-export();                          // open the sheet (decides list vs editor)
        callback wm-changed();                           // a watermark/output setting changed → recompute preview
        callback set-wm-type(int);                       // switch None/Image/Text → rebuild the logo for that type
        callback wm-text-changed();                      // Text content/colour changed → re-raster the logo
        callback new-preset();                           // start a new preset (→ editor)
        callback delete-preset(int);                     // delete a saved preset (index) after confirm
        in-out property <int> wm-del-confirm: -1;        // preset index pending delete (-1 = no popup)
        in-out property <string> wm-del-name: "";        // name shown in the delete-confirm popup
        // v0.8.108 (owner ruling 9): the same confirm grammar for FORGETTING a display's remembered
        // colour configuration — its gamut AND its hand-picked/calibrated profile path. Destructive,
        // unrecoverable without the screen plugged back in, so it is never a bare click.
        in-out property <bool> display-del-confirm: false;
        in-out property <string> display-del-key: "";
        in-out property <string> display-del-name: "";
        in-out property <string> wm-preset-name: "";     // editor name field (pre-filled when editing a preset)
        // v0.8.119 (design-sweep O11): "Save preset" is a solid-accent primary button with no
        // `enabled` binding, so on the guaranteed first-run state (no presets → the sheet opens
        // straight into this editor) it looked live and did nothing. Slint has no trim, and a
        // whitespace-only name passes `!= ""` and is then dropped by the Rust guard, so the
        // predicate is computed in Rust off ONE chokepoint: the `changed wm-preset-name` observer
        // below, which fires for the TextInput's two-way write, the pencil pre-fill, Cancel, Save
        // and any Rust-side set — every route that can change the field. The Rust trim guard in
        // on_save_preset STAYS as the backstop.
        in property <bool> wm-name-ok: false;
        // v0.8.187 (X9): WHY the Save button is grey, composed in Rust off the same
        // `changed wm-preset-name` chokepoint that publishes `wm-name-ok` -- so the sentence and the
        // enablement can never disagree. Empty = nothing to say (a fine name, or an untouched
        // field). Same one-property shape as `wm-font-warn`.
        in property <string> wm-name-problem: "";
        callback wm-name-changed(string);
        // ── v0.8.187 (W1 i, OWNER DESIGN D24): APPEND THE PRESET NAME TO THE OUTPUT FILENAME ─────
        // `<stem>_<preset>.jpg` instead of `<stem>.jpg`. The ./export export skips a deliverable whose
        // NAME already exists, and the name carried nothing about how the file was rendered — so a
        // re-export under a different preset kept the old files and reported "N already there".
        // This toggle is the half of the owner's answer that makes two renderings of one photograph
        // NAMEABLE; the collision modal below is the half that makes replacing one a decision.
        // Persisted with the other export settings.
        in-out property <bool> wm-append-preset-name: false;
        // v0.8.187 (X12): the LIVE example filename this export would write, composed Rust-side
        // through the run's own name producer (so the sanitizer is visible, not a surprise found in
        // the folder). Republished whenever the toggle or the selected preset moves.
        in property <string> wm-name-example: "";
        // v0.8.187 (W1 ii): the collision modal's two numbers, from the pre-run scan (Rust). "N of M
        // already exist" — M counts only files the run would actually WRITE, so a RAW-only pick and
        // an undecodable source are not in the denominator.
        in property <int> web-collide-count: 0;
        in property <int> web-collide-total: 0;
        // The headline's words beside that number ("of 12 already exist"). Composed in Rust like
        // every other counted title in this app — the engine has no int+string concatenation, and a
        // UI-side re-derivation of a count is the divergence class this codebase keeps closing.
        in property <string> web-collide-title: "";
        callback export-collide-skip();      // leave the existing files, export the rest
        callback export-collide-overwrite(); // render, then atomically replace (.part + rename)
        callback export-collide-cancel();    // drop the parked run — nothing is exported
        in-out property <string> wm-edit-orig: "";       // name of the preset being EDITED ("" = new) → enables true rename (#10)
        // compare (A|B side-by-side). Both halves share zoom/pan (linked) by default; the focused
        // ("active") half is the rating/flag target. Each half has its own index → its own image +
        // cull badges (A = photo-a etc., B = photo-b etc.), independent of the single-view `photo`.
        in property <bool> compare: false;
        in-out property <int> cmp-focus: 0;    // active half (focus border + rating/flag target): 0 A / 1 B
        in-out property <bool> pin-a: true;    // A pinned (held from wheel-browse) — pinned by default
        in-out property <bool> pin-b: false;   // B pinned
        in-out property <int> cmp-wheel: 0;    // wheel mode: 0 Browse / 1 Zoom (forced to Zoom when both pinned)
        in property <image> photo-a;
        in property <image> photo-b;
        // Each compare half fits/zooms/sharpens in its OWN aspect (Rust sets these from each half's
        // displayed dims) — so a different-aspect half is no longer letterboxed-then-blurred. Both
        // halves share the zoom FACTOR; pan is linked by FRACTION (both show the same relative region).
        in property <float> cmp-aspect-a: 1.5;
        in property <float> cmp-aspect-b: 1.5;
        in property <bool> cmp-unsupported-a: false; // half A is a recognised-but-undecodable source → placeholder
        in property <bool> cmp-unsupported-b: false;
        // v0.8.125 (C1 / design-sweep O1): this half's pixels do NOT describe the shot its labels
        // name (no frame for the new index yet) — the half is cleared and wears the G1 scrim +
        // "Loading…" pill, and the cull gate refuses a rating/flag on it. Rust owns both.
        in property <bool> cmp-loading-a: false;
        in property <bool> cmp-loading-b: false;
        // v0.8.125 (C2 / design-sweep O3+Y73): compare's zoom TRUTH, for the FOCUSED half — the
        // same three signals the single view's badge reads (see step_compare_zoom).
        in property <int> cmp-zoom-pct: 100;
        in property <bool> cmp-zoom-pct-valid: false;
        in property <bool> cmp-detail-live: false;
        // v1.0.0-rc (queue item 30, §1.E — owner ruling 2.3c): is a sharper frame still OWED for
        // the focused half? Published beside `cmp-detail-live` from the terms that site has; see
        // `support::detail_pending` for why this is not `!cmp-detail-live`.
        in property <bool> cmp-detail-pending: false;
        // false = this half's true size is unknowable right now (RAW-only / unreadable header), so
        // 1:1 cannot be computed: the control renders unavailable and its click refuses out loud.
        // v0.8.126 (audit N5): "unknowable" means the handler's OWN guard — a shot with a finished
        // file is knowable even before the header probe lands, because the handler reads it
        // synchronously. Dimming on ordinary JPEG pairs for the probe window said "this cannot act
        // here" about a control that can, which is the state O33 refused to create.
        in property <bool> cmp-one-to-one-known: false;
        // v0.8.126 (audit N6/N37): the focused half's LATCHED full-res failure. The single-view
        // host has always bound `failed`; compare never did, so the shared badge's "Not sharp"
        // state was unreachable here and a half whose decode had given up read amber "Loading…"
        // for ever — on the one surface with no retry card to contradict it.
        in property <bool> cmp-detail-failed: false;
        // v0.8.126 (audit N25): a both-pinned navigation refusal PULSES both pin labels' borders.
        // The toast card is window-rooted at the top right, 400+ px from the two dots it is about,
        // and the repeat press — the thing anyone does when a key seems dead — fell inside the
        // 1.5 s rate limit and produced nothing at all. This fires on every press.
        in property <bool> cmp-pin-pulse: false;
        // v0.8.126 (audit N26): the bothpin caption is a LINGER (armed on entry into the state and
        // on every refusal), not a permanent fixture. Bothpin is the drag-to-compare entry's
        // default, so the sentence otherwise sat over the two photographs indefinitely.
        in property <bool> cmp-bothpin-hint: false;
        // v0.8.126 (audit N24): the compact focus badge's Tip. State-derived (ledger L20) so the
        // imperative is never wrong: the compare bar lost its literal "1:1" when C2 replaced the
        // chip with the state-reading badge, leaving the control that PERFORMS the focus check
        // looking like a readout in the one state a photographer is in when they decide to run it.
        // Language packs (round 2): its two sentences are properties of their own, so the guards that
        // clear the badge's tip on its leave and unmount edges compare the SAME translated text the
        // badge published (never an English literal, which a translated tip would never equal).
        property <string> cmp-tip-one-to-one: @tr("falcon" => "Zoom to 1:1");
        property <string> cmp-tip-fit: @tr("falcon" => "Zoom to fit");
        property <string> cmp-focus-tip: abs(root.zoom - 1.0) <= 0.01 ? root.cmp-tip-one-to-one : root.cmp-tip-fit;
        property <bool> cmp-badge-hot: false; // hover latch (the badge PUSHES hover; L22 clears it)
        in property <string> name-a;
        in property <string> name-b;
        in property <int> rating-a: 0;
        in property <int> rating-b: 0;
        in property <bool> flagged-a: false;
        in property <bool> flagged-b: false;
        in property <bool> rejected-a: false;
        in property <bool> rejected-b: false;
        // ── v0.8.158 (B1c, OWNER RULING Q24): BOTH HALVES ARE THE SAME PHOTOGRAPH. ───────────────
        // Wheel-browse may land there and is deliberately NOT prevented; the two filenames beside
        // the control bar turn WARNING YELLOW so a "comparison" of a photo with itself announces
        // itself. Published by step_compare from `aidx == bidx` — the RESOLVED SHOT INDICES, never
        // the display strings (L42: two different files that happen to share a name are two
        // photographs and must not warn; one photograph in both halves is one shot index twice).
        in property <bool> cmp-same-shot: false;
        // ── v0.8.158 (B1b, Q16): the compare-scoped RAW facts, for the bar's new toggle. Both are
        // published by step_compare from the two resolved half indices — `cur-has-raw` describes
        // the single view's cursor and is the wrong shot in this mode (L21: a remote control's
        // enablement mirrors its own target).
        in property <bool> cmp-has-raw: false;   // either half has a RAW file → the global toggle can do something
        in property <bool> cmp-raw-only: false;  // BOTH halves are RAW with no finished file → the pair's "JPG" cell is really a Preview (Q17)
        in property <string> cmp-finished-format: @tr("falcon" => "Images");
        // Selection → compare integration. The Selection panel can send a tile to half A or B
        // (right-click menu, or drag onto the centred A/B drop zones) → enters compare with that
        // shot in the chosen half. `cmp-a-idx`/`cmp-b-idx` (Rust-set) mark which tiles are in compare.
        in property <int> cmp-a-idx: -1;
        in property <int> cmp-b-idx: -1;
        callback sel-to-compare(int, int);   // (shot idx, half 0=A / 1=B)
        // selection-tile right-click context menu (positioned in WINDOW coords)
        in-out property <bool> sel-ctx-open: false;
        in-out property <length> sel-ctx-x: 0;
        in-out property <length> sel-ctx-y: 0;
        in-out property <int> sel-ctx-idx: -1;
        // selection-tile DRAG → two big centred A/B drop zones (so you don't have to hit the
        // panel-occluded half). `sel-drag-*` track the in-flight drag; the zone rects are computed
        // once here and shared by the drag hit-test (in the tile) and the overlay below.
        in-out property <bool> sel-dragging: false;
        in-out property <length> sel-drag-x: 0;     // live cursor (window coords)
        in-out property <length> sel-drag-y: 0;
        in-out property <int> sel-drag-idx: -1;
        in-out property <int> sel-drag-zone: -1;    // hovered drop zone: -1 none / 0 A / 1 B
        in-out property <image> sel-drag-thumb;
        property <length> drop-w: 184px;
        property <length> drop-h: 224px;
        property <length> drop-y: (root.content-top) + (root.stage-h - root.drop-h) / 2;
        // v0.8.62 (owner ruling 2026-07-18): the zones centre on the VISIBLE STAGE, not the
        // window — with the grid dock open the stage begins at dock-w, so window-centred zones
        // sat ~dock-w/2 left of the photos' centre. The stage is flush-right in the [dock |
        // stage] row, so its window-space centre is width − stage-w/2 (dock closed: stage-w =
        // width → the unchanged width/2). stage-w is LIVE layout (the dock mount + splitter
        // resolve it), so the anchors track a toggle/resize mid-drag — the y twin (drop-y,
        // stage-h) already carried this grammar. The full-window dim + capturing blocker STAY
        // window-sized BY DESIGN (input must die everywhere, the dock included); only the zone
        // anchors move, and drop-zone-at reads these same anchors, so the drag hit-test and
        // the visuals agree by construction. Rig: drop_zones_centre_on_the_visible_stage.
        property <length> drop-cx: root.width - root.stage-w / 2;
        property <length> dropa-x: root.drop-cx - 14px - root.drop-w;
        property <length> dropb-x: root.drop-cx + 14px;
        // which drop zone a window-coord point is over (-1 none / 0 A / 1 B) — shared by the tile
        // drag and the overlay's capturing blocker so both agree.
        pure function drop-zone-at(x: length, y: length) -> int {
            return (y > root.drop-y && y < root.drop-y + root.drop-h && x > root.dropa-x && x < root.dropa-x + root.drop-w) ? 0
                 : (y > root.drop-y && y < root.drop-y + root.drop-h && x > root.dropb-x && x < root.dropb-x + root.drop-w) ? 1
                 : -1;
        }
        // filmstrip
        in property <[FilmItem]> film;
        in property <length> film-offset-px;   // x of the strip row (centres the current shot)
        in property <float> film-frac: 0.0;     // strip centre position 0..1 → the bottom scrollbar thumb
        in property <float> film-vis-frac: 1.0; // fraction of the folder visible in the strip (thumb width; ≥1 hides the bar)
        callback film-seek(float);              // scrollbar press/drag → jump the strip to this fraction of the folder
        // §43 Fast View: the scrub proxy always follows the window; the one lever is which DCT
        // stop brackets it — 0 = Subsample (the stop below, faster/softer), 1 = Supersample
        // (the stop above → downsampled, sharp).
        in-out property <int> quality-super: 1;
        // §43 zoomed browse policy: false = Speed (today's blur→sharp on landing), true = Always
        // sharp (held/wheel browse rate-caps to the benchmarked full-res fps; the stage holds the
        // last sharp frame instead of flashing the fast proxy).
        in-out property <bool> zoom-always-sharp: false;
        // Adaptive hi-res (zoomed-region) loading for huge images.
        in-out property <bool> roi-hi-res: true;     // on (default): tile the zoomed region; off: load whole
        in-out property <int> res-limit: 16384;      // ROI off: whole-image full-res cap (px)
        in property <string> res-limit-text: "16384"; // the res-limit field's displayed value (clamped in Rust)
        callback set-roi-hi-res(bool);
        callback set-res-limit(float);
        // colour-managed display target: 0 sRGB / 1 Display P3 / 2 Adobe RGB / 3 Rec.2020 / 4 Custom /
        // 5 DCI-P3 (v0.8.67 — appended so persisted indices stay stable; Settings → Display + the welcome panel)
        in-out property <int> output-gamut: 0;
        callback set-output-gamut(int);
        // v0.8.68 (D-audit FIX 2): the DCI-P3-vs-Display-P3 disambiguation caption. Defined ONCE
        // here (OS-neutral — no platform routing) and shown under the gamut chips on BOTH surfaces
        // (Settings colour card + welcome col 3). Curly quotes are literal (not the "-delimiters).
        property <string> dci-p3-caption: @tr("falcon" => "DCI-P3 is cinema (DCI white) — most “DCI-P3” monitors are Display P3.");
        // v0.8.119 (design-sweep Y66/Y77): ONE source for the gamut names, the dci-p3-caption
        // precedent applied to the labels themselves. Settings spelled index 3 "Rec.2020" while
        // the welcome chips, the welcome "Now:" line and the info panel's conversion chip (which
        // renders falcon_color's Gamut::label) all spell it "Rec. 2020" — three surfaces, one
        // option, two spellings. Rust fills this array from `Gamut::from_i32(i).label()` so the
        // chips ARE the decoder's own vocabulary and a future rename reaches every surface at
        // once. Indexed by the persisted gamut index (0 sRGB / 1 Display P3 / 2 Adobe RGB /
        // 3 Rec. 2020 / 4 Custom / 5 DCI-P3); slot 4 is never read here — the Custom chip has its
        // own live label channel (custom-gamut-label) — but it is filled so the array stays a
        // faithful mirror of the enum.
        in property <[string]> gamut-labels: ["sRGB", "Display P3", "Adobe RGB", "Rec. 2020", "Custom", "DCI-P3"];
        // custom output gamut (#76): the loaded monitor/display profile's label for the chip ("Custom…"
        // when none is loaded) + its file path (persisted). The two callbacks load a profile.
        in-out property <string> custom-gamut-label: @tr("falcon" => "Custom…");
        // v0.8.76: Rust-computed (support::custom_gamut_label_is_long — label chars > 8, i.e. any
        // real "Custom: <profile>" label) — the Settings grid then gives Custom its OWN full-width
        // row instead of squeezing Rec.2020. Slint can't measure text pre-layout, so the length
        // call is made where the label is composed (arm_custom_icc + the boot restore).
        in-out property <bool> custom-gamut-long: false;
        in-out property <string> custom-icc-path: "";
        // ── v0.8.100 (A4 / design-sweep O31): the remembered profile failed to LOAD this session ──
        // The path above is remembered anyway (a re-calibration, an unmounted volume, or a renamed
        // .icc must not permanently erase the setting), so `custom-icc-path != ""` no longer implies
        // "a profile is installed". Every surface that used to test the path alone now tests
        // `custom-icc-path != "" && !custom-icc-failed` — otherwise the Custom chip would select a
        // gamut with no profile behind it. Cleared the moment a profile installs successfully.
        in-out property <bool> custom-icc-failed: false;
        // The Rust-composed honest line for the colour card while `custom-icc-failed` ("" otherwise) —
        // names the file and says what happens next. Composed where the failure is known, so the two
        // surfaces (this card and the boot toast) cannot drift.
        in-out property <string> custom-icc-warn: "";
        // v0.8.105 (W13): is the failed profile FALCON'S OWN auto-detect artifact (the macOS arm
        // always writes `monitor_detected.icc` into the app's config dir) rather than a file the
        // photographer chose? Written beside `custom-icc-failed` by the same derivation
        // (`custom_icc_failure_state`), because the DIRECTION each card appends depends on it: a
        // file he loaded is reloadable "below"; an artifact he never saw and cannot recognise in a
        // file dialog is recovered by the "Auto-detect this monitor" button ABOVE.
        in-out property <bool> custom-icc-auto: false;
        // The output gamut to PERSIST instead of the live one, or -1 for "persist what's live". Set
        // to 4 when a boot failure drops a Custom session to the sRGB fallback: the session renders
        // sRGB, but the settings file keeps the Custom selection so the next launch's retry restores
        // the whole setup, not just the chip. Any explicit gamut pick clears it back to -1.
        in-out property <int> custom-icc-hold-gamut: -1;
        callback pick-custom-icc();    // open a file dialog to load an .icc / .icm profile
        callback detect-monitor-icc(); // auto-detect this display's OS-assigned colour profile
        // ── v0.8.107: PER-DISPLAY colour management ────────────────────────────────────────
        // The Settings colour card is a stack of per-display sections now. Every row is composed
        // in Rust (see the DisplaySection doc): the ACTIVE display's row mirrors the eight scalar
        // properties above — that display IS the one installed transform — and every other row is
        // composed from its persisted entry in `display_colors`.
        //
        // The DEFAULT below is the honest degrade, not decoration: a display Falcon cannot
        // identify (no enumeration, an unnamed panel, the headless geometry rig) still gets ONE
        // section wired to the live state, so the card is never blank and every control keeps
        // working exactly as it did before this round. Rust replaces it at the first
        // active-display resolution.
        //
        // v0.8.109 (V12/V20): the two fields v0.8.108 REMOVED from DisplaySection (`chip`,
        // `custom-path`) are gone from this literal too. They compiled silently — Slint 1.17's
        // struct-to-struct conversion only rejects extra source fields when the target also has
        // fields the source lacks, and this literal was a strict superset — so both values were
        // dropped on conversion while the literal went on documenting fields the struct's own doc
        // says are GONE.
        in-out property <[DisplaySection]> display-sections: [{
            key: "", name: @tr("falcon" => "This display"), head: @tr("falcon" => "This display"), gamut: 0,
            auto-label: @tr("falcon" => "Auto-detect this monitor"),
            expanded: true, custom-label: @tr("falcon" => "Custom…"), custom-long: false,
            custom-failed: false, custom-warn: "", custom-auto: false,
            connected: true, active: true, session-only: false,
            weak: false, unit-mismatch: false,
        }];
        // v0.8.107 (owner ruling D3): are 2+ displays actually detected? Mount-gates the welcome
        // card's one extra line. FALSE until the post-show enumeration answers (pre-show winit sees
        // zero monitors), so a single-display machine never reads a word about multi-display setups.
        in property <bool> display-multi: false;
        // The per-section actions. The key routes each one to the display the SECTION is about — an
        // empty key means "the display this window is on", which is what the welcome card and every
        // pre-v0.8.107 call site still send.
        callback set-display-gamut(string, int);
        callback pick-display-icc(string);
        callback detect-display-icc(string);
        // v0.8.107 (owner ruling D1): expand/collapse ONE section. Sections are independent — the
        // open set lives in Rust (which also re-composes the model), so the card holds no state and
        // opening a second display does not close the first.
        callback toggle-display-section(string);
        // v0.8.107 (owner ruling D2): forget a disconnected display's remembered configuration.
        callback remove-display(string);
        // v0.8.107 (owner ruling D1): "the active display starts expanded, others start collapsed" —
        // re-asserted every time Settings opens, so the card always opens on the screen you are on.
        callback reset-display-expansion();
        // RAW develop (on-stop): show the developed RAW instead of the embedded JPG
        in-out property <bool> raw-mode: false;
        in property <bool> cur-has-raw: false;       // does the current shot have a RAW file?
        in property <bool> cur-has-finished: false;  // does it have a finished-image file (JPG/PNG/TIFF/…) to copy?
        in property <string> cur-finished-format: @tr("falcon" => "Image");
        in property <bool> cur-unsupported: false;   // current shot is a recognised-but-undecodable image (badge + placeholder)
        in property <string> cur-unsupported-note;    // e.g. "HEIC is currently unsupported" (built in Rust)
        in property <bool> cur-failed: false;         // N3: a SUPPORTED format whose decode FAILED at runtime (corrupt / HEIC no codec) — placeholder, not the previous frame
        in property <string> cur-failed-note;          // e.g. "Couldn't decode — the HEVC/HEIF Image Extension may not be installed"
        in property <bool> cur-cloud: false;          // v0.8.44 (G9): the failure is a cloud (OneDrive) placeholder awaiting download → render the CALM card variant (neutral, no manual-retry line)
        in property <bool> detail-live: true;         // N25: the shown frame IS the full-res detail (not the upscaled fast proxy) — the Focus 1:1 badge only claims sharpness when true
        // v1.0.0-rc (queue item 30, §1.E — owner ruling 2.3c): a sharper frame for THIS shot is
        // still owed and nothing stands in its way. Not `!detail-live`: a playing GIF and an
        // unsupported placeholder never have a detail frame and are not loading one
        // (`support::detail_pending` is the whole predicate, and the reason it is a function).
        in property <bool> detail-pending: false;
        // G1 (P0/P1) honest loading state — set by step_display every tick:
        // `photo-ready`  = the stage image is the CURRENT shot's own real frame (fast proxy or
        //                  detail — NOT a thumbnail stand-in, NOT a stale previous shot). Zoom,
        //                  pan and the 1:1 click gate on it (a 256px thumb can't be focus-checked).
        // `cur-loading`  = a supported, non-failed shot whose decode hasn't landed yet → the
        //                  quiet "Loading…" pill (status, not a warning).
        // `stage-stale`  = worse: not even a stand-in for the current shot is on stage — the
        //                  PREVIOUS shot's pixels are still visible → dim them (never let stale
        //                  pixels read as the current photo). Cull keys are gated in Rust on the
        //                  exact same-index check (not this lagging prop).
        in property <bool> photo-ready: false;
        in property <bool> cur-loading: false;
        in property <bool> stage-stale: false;
        in property <bool> zoom-pct-valid: true;      // G1: the zoom % readout describes the CURRENT shot (else "—")
        // Cache-status meter (next to the A/B button): a single fixed-width bar split into a BEHIND
        // (left) and AHEAD (right) half. The split is PROPORTIONAL to how many shots are available to
        // cache in each direction (`cache-len-before`/`-after`, summing to 1) — so near a folder edge
        // the short side is the direction with few shots left, while the total width stays constant.
        // Each half's FILL (`cache-frac-*`, 0..1 = cached ÷ available in that direction) drives its
        // length + traffic-light colour, filling toward the centre (current shot). So "10 shots left,
        // all cached" = a short right half, 100% green. Lets the user SEE it's caching [status vis].
        in property <bool> cache-meter-show: false;
        // v0.8.196 (WAVE 2, §C): is the efficiency posture engaged RIGHT NOW? Published from the
        // tick's one derived `EfficiencyLimits` (main.rs), and read by exactly one thing: the `if`
        // that mounts the leaf inside the meter below. L4 — the gate is the mount, never `visible:`.
        in property <bool> efficiency-leaf: false;
        in property <float> cache-frac-before: 0.0;    // cached ÷ available BEHIND (fill + colour)
        in property <float> cache-frac-after: 0.0;     // cached ÷ available AHEAD
        in property <float> cache-len-before: 0.5;     // BEHIND half's share of the bar width (0..1)
        in property <float> cache-len-after: 0.5;      // AHEAD half's share (before+after == 1)
        in property <string> cache-meter-tip;         // Rust-built "Cache · behind X/Y · ahead A/B" (hover)
        in-out property <bool> cache-meter-hover: false;
        // immersive / fullscreen (hides all chrome; Esc exits)
        in-out property <bool> immersive: false;
        // v0.8.46 (Item 2): the window's DPI scale (device px per logical px), fed by the
        // BeforeRendering notifier (change-gated). The modal dialogs use it to nudge their
        // centred panels onto integer DEVICE pixels so the footer ActionBtns' 1px borders
        // rasterize symmetrically (at 150% a fractional device y splits the 1.5-device-px
        // stroke asymmetrically across pixel rows — thin-top/thick-bottom, owner report).
        in property <float> win-sf: 1.0;
        // ── M8 (v0.8.33): immersive corner-reveal state (see the reveal eff block below +
        // step_immersive_reveal). The chip confirms cull mutations bottom-right; the RAW/zoom peek
        // reveals bottom-left. Rust owns the linger countdown and sets the *-revealed bools; the
        // stage TouchArea pushes the *-hot hover flags (the PREFERRED zero-new-hit-surface route). ──
        in property <bool> chip-revealed: false;    // Rust → UI: show the cull-state chip (single-view immersive)
        in property <bool> raw-revealed: false;     // Rust → UI: show the RAW/zoom peek (single-view immersive)
        out property <bool> chip-corner-hot: false; // UI → Rust: pointer in the bottom-RIGHT reveal zone
        out property <bool> raw-corner-hot: false;  // UI → Rust: pointer in the bottom-LEFT reveal zone
        out property <bool> raw-panel-hot: false;   // UI → Rust: pointer over the revealed develop surface — the RAW panel, or (v0.8.98) its magnifier stub (keep-alive)
        out property <bool> chip-panel-hot: false;  // UI → Rust: pointer over the revealed cull card (keep-alive; the RAW panel's pattern)
        // v0.8.92 (L25): the FULLY-OFF info panel's corner reveal — NORMAL view (not immersive).
        // Consumes the SAME bottom-right zone flag (chip-corner-hot; one zone, one flag — the
        // tick's `imm` split keeps the two consumers mutually exclusive). Rust lingers it exactly
        // like the two immersive surfaces (step_immersive_reveal's third arm).
        in property <bool> info-revealed: false;    // Rust → UI: show the temporary "i" stub while fully off
        out property <bool> info-stub-hot: false;   // UI → Rust: pointer over the revealed "i" stub (keep-alive)
        // ── v0.9.69 (OWNER RULING §8b): the v0.9.67 IMMERSIVE TOP-EDGE reveal is RETIRED, and its
        // two properties (`bar-revealed`, `top-edge-hot`) are deleted with it. Immersive hands the
        // window controls back to macOS's own auto-revealing strip, so the top edge already has a
        // reveal and it is the system's. The three CORNER reveals above are untouched. On Windows
        // this deletes nothing that ever ran: `bar-revealed` was never written there and every
        // binding that read it collapsed to its v0.9.66 value, which is what is spelled out now. ──
        // ── v0.8.10 chrome-square latch (the corner-notch flash fix; v0.8.20: + the immersive path) ──
        // Slint flips the builtin `maximized` the instant set_maximized() runs (and winit
        // spuriously CLEARS it when Slint pushes min/max-inner-size — see main.rs's
        // re-maximize watchdog), but the OS geometry change lands frames later. Chrome that
        // follows the raw flag renders the 16px ROUNDED corners on a still-monitor-filling
        // window for those frames — and the transparent corner notches let the desktop flash
        // through at the screen corners (the one-off bright top-left sliver, 2026-07-11).
        // Squareness is therefore keyed to GEOMETRY: latch square while maximized (recording
        // the maximized size; refreshed on DPI/monitor changes), and unlatch only when the
        // window's size actually LEAVES that geometry while unmaximized. A flag drop with
        // unchanged geometry (spurious drop; restore-click frames before the OS resize)
        // stays square — the rounded-at-fullscreen frame cannot exist, by construction.
        // v0.8.23: release is additionally DEBOUNCED (square-release-requested → Rust settle
        // window → finish-square-release), and transitions are DWM-masked — see the callback
        // block below.
        // v0.8.21: release additionally requires !screen-filling (see the classifier below) —
        // the F11-exit restore streams multi-step resizes with the maximized sync trailing, so
        // "geometry moved" alone could release onto a still-monitor-filling intermediate.
        property <bool> sticky-square: false;
        property <length> square-latch-w: 0px;
        property <length> square-latch-h: 0px;
        // v0.8.21 (Bug A, evidence-driven): the CURRENT monitor's size in LOGICAL px (Rust
        // pushes it from the tick — winit current_monitor / scale; 0 = unknown). The cycle-hook
        // log proved the OS restore after an F11 exit streams MULTIPLE resize events (35-45ms
        // apart on the dev box) and Slint applies the SIZE before it syncs the maximized flag —
        // so "geometry left the latch" alone can release while an intermediate (or a flag-lagged
        // maximized) geometry still fills the monitor => rounded chrome on a screen-filling
        // surface = the bright corner sliver. The latch therefore releases ONLY when the surface
        // is genuinely non-screen-filling, per the maximize watchdog's own classifier (>=90% w
        // && >=80% h of the CURRENT monitor). screen-w unknown (0) degrades to the v0.8.20
        // release rule — never a stuck latch. KNOWN RESIDUAL (documented trade): a FLOATING
        // window the user sized past 90%/80% of the monitor keeps square corners after an
        // immersive/maximize episode until a resize drops it below the threshold.
        in property <float> screen-w: 0.0;
        in property <float> screen-h: 0.0;
        property <bool> screen-filling: root.screen-w > 100.0
            && (root.width / 1px) >= root.screen-w * 0.90
            && (root.height / 1px) >= root.screen-h * 0.80;
        property <bool> chrome-square: root.maximized || root.immersive || root.sticky-square;
        // ── v0.8.21 debug instrumentation (env-gated; SHIPS) ── Rust sets dbg-chrome from
        // FALCON_DEBUG_CHROME=1; every tap below guards on it, so unset = one false bool and the
        // callbacks never fire (zero steady-state cost). Rust timestamps the lines into falcon.log —
        // the log-level repro harness for window-state/chip bugs (no UI automation needed).
        in property <bool> dbg-chrome: false;
        // (tag, w/px, h/px, immersive, maximized, sticky, latch-w/px, latch-h/px, chrome-square, screen-filling)
        callback dbg-chrome-log(string, float, float, bool, bool, bool, float, float, bool, bool);
        // (hudclip-w/px, bar-w/px, root-w/px, pill-show, chips-show, chips-eff, count-all, hud-pos-set, meter-mounted)
        callback dbg-chips-log(float, float, float, bool, bool, float, int, bool, bool);
        function dbg-snap(tag: string) {
            if (root.dbg-chrome) {
                root.dbg-chrome-log(tag, root.width / 1px, root.height / 1px, root.immersive,
                    root.maximized, root.sticky-square, root.square-latch-w / 1px,
                    root.square-latch-h / 1px, root.chrome-square, root.screen-filling);
            }
        }
        // Transition taps on the two DERIVED chrome states (the raw inputs are tapped from inside
        // their existing changed handlers below — Slint allows one changed handler per property).
        changed sticky-square => { root.dbg-snap("sticky-square"); }
        changed chrome-square => { root.dbg-snap("chrome-square"); }
        // ── v0.8.23 (corner round 3) ── the v0.8.21 latch was PROVEN clean at log level on the
        // dev box, yet the field still showed a (smaller) corner sliver after F11 — the residual
        // classes live where app-side state cannot reach: DWM scaling a stale buffer during the
        // restore ANIMATION (which programmatic toggles don't run), and swapchain-vs-window lag.
        // Two defensive layers, one settle signal (Rust owns the clock — the Slint Timer
        // element's restart() silently no-ops on a never-started timer, so no UI-side timers):
        //  M-1 square-release-requested(): release sites REQUEST; Rust waits until NO resize
        //      landed for ~250ms, then calls finish-square-release() — streamed multi-step
        //      restores and animation stragglers can never catch a rounded frame. Failure
        //      direction is always "square a little longer", never a bright notch.
        //  M-2 chrome-transition-begun(): every immersive/maximize edge; Rust masks the
        //      transition with the DWM 8px ROUND arc, restoring DONOTROUND on the same settle
        //      signal — steady state keeps the user-approved single 16px rounding.
        callback square-release-requested();
        callback chrome-transition-begun();
        public function finish-square-release() {
            // conditions re-checked LIVE at settle time — a re-entered immersive/maximize or a
            // still-screen-filling geometry keeps the latch (the request went stale).
            if (!root.maximized && !root.immersive && !root.screen-filling) {
                root.sticky-square = false;
            }
        }
        // present-time physical-vs-property comparison inputs for the H-b frame tap (Rust reads
        // these in the BeforeRendering notifier when FALCON_DEBUG_CHROME=1; dead cost otherwise).
        out property <float> dbg-logical-w: root.width / 1px;
        out property <float> dbg-logical-h: root.height / 1px;
        // ── M6 (v0.8.19): immersive-mode chrome crossfade ("lights dim", not an instant cull) ──
        // GEOMETRY NEVER FADES: the layout slots, winroot's radius/clip, the square latch above and
        // the maximize handling all key on the RAW immersive/chrome-square bools and switch the same
        // frame, exactly as v0.8.18. ONLY chrome OPACITY follows chrome-eff. Faded chrome lingers
        // mounted while chrome-fading so it can paint its exit, then unmounts — steady immersive
        // keeps today's zero-chrome cost. CLICK-STEAL GATE (v0.7.2 class): every TouchArea inside
        // fading chrome gates on the immersive BOOL itself — never on opacity — so input dies the
        // frame immersive engages and revives the frame it ends (opacity catches up visually).
        // motion-ui OFF ⇒ chrome-eff snaps ⇒ chrome-fading never true ⇒ mount conditions collapse
        // to the v0.8.18 instant cull/restore.
        property <float> chrome-reveal: root.immersive ? 0.0 : 1.0;
        animate chrome-reveal { duration: Theme.anim-med; easing: ease-out; }
        property <float> chrome-eff: root.motion-ui ? root.chrome-reveal : (root.immersive ? 0.0 : 1.0);
        property <bool> chrome-fading: root.chrome-eff > 0.001;
        // ── M8 (v0.8.33): immersive reveal crossfades. Rust owns the linger countdown
        // (step_immersive_reveal) and sets chip-revealed / raw-revealed; these animate opacity from
        // them. DELIBERATE EXCEPTION to the app's enter-only motion default (M4–M7): the owner asked
        // these two surfaces to fade/dissolve on EXIT as well as enter — so the animate blocks are
        // UNCONDITIONAL (both directions). motion-ui OFF ⇒ instant both ways (the eff snaps).
        property <float> chip-reveal: root.chip-revealed ? 1.0 : 0.0;
        animate chip-reveal { duration: Theme.anim-med; easing: ease-out; }
        property <float> chip-reveal-eff: root.motion-ui ? root.chip-reveal : (root.chip-revealed ? 1.0 : 0.0);
        property <float> raw-reveal: root.raw-revealed ? 1.0 : 0.0;
        animate raw-reveal { duration: Theme.anim-med; easing: ease-out; }
        property <float> raw-reveal-eff: root.motion-ui ? root.raw-reveal : (root.raw-revealed ? 1.0 : 0.0);
        // the RAW peek shares the panel with normal mode: max'd with chrome-eff below so the immersive
        // ENTER crossfade still fades the panel out with the rest of the chrome; gated to 0 outside
        // immersive so normal mode is driven purely by chrome-eff (unchanged).
        property <float> raw-reveal-eff-i: root.immersive ? root.raw-reveal-eff : 0.0;
        // v0.8.92 (L25): the fully-off info stub rides the SAME reveal fade grammar (both-direction
        // animate — the owner's M8 dissolve exception applies; motion-ui OFF ⇒ instant).
        property <float> info-reveal: root.info-revealed ? 1.0 : 0.0;
        animate info-reveal { duration: Theme.anim-med; easing: ease-out; }
        property <float> info-reveal-eff: root.motion-ui ? root.info-reveal : (root.info-revealed ? 1.0 : 0.0);
        // root-owned hover flags that a gated TouchArea can strand true mid-fade (a disabled area's
        // changed has-hover may never fire): reset deterministically on the immersive edge.
        changed immersive => {
            // v0.8.20 (B1, the F11→restore corner flash): latch square on ENTER exactly like the
            // maximize path — the width/height observers above keep the latch tracking the
            // fullscreen geometry while immersive, so on EXIT sticky-square holds chrome-square
            // true until the window's size actually LEAVES the latched (monitor-filling) geometry.
            // Rounded corners on a still-fullscreen surface — the bright sliver arc — are
            // impossible by construction, the same proof as v0.8.10's maximize latch.
            if (root.immersive) {
                root.sticky-square = true;
                root.square-latch-w = root.width;
                root.square-latch-h = root.height;
            }
            root.cache-meter-hover = false;
            // v1.0.0-rc (queue item 31, §3.A.5): the Review panel is UNMOUNTED in immersive, so its
            // hovered tile's TouchArea is destroyed on this edge with no `changed has-hover` (L22).
            root.sel-hover-idx = -1;
            // v0.8.98: also covered by `changed raw-panel-mounted` (the immersive edge unmounts the
            // develop panel once its fade ends). Kept: this fires on the edge itself rather than at
            // the end of the crossfade, and belt-and-braces on a stranding class costs nothing.
            root.cs-hover = false;
            Tip.text = ""; // G11 (v0.8.44): a bar unmount mid-hover never fires changed has-hover — clear the tip latch on the immersive edge
            Tip.cy = 0px;  // v0.8.84: the positioned-tip anchor resets with it — the Selection panel unmounts on this edge too, and a stale cy > 0 would re-anchor the NEXT title-bar tip at the dead toggle's y
            // v0.8.51 (hotfix): the four G2 edge-reveal source flags join the reset set — their
            // feeding TouchAreas (the strip's lower band, the dock's pad lane, the stage zones)
            // mount-cull or disable on this edge, so a pointer resting in a zone at F11 strands
            // the flag true and the scrim + pill come back permanently revealed on exit (the
            // exact failure class this handler documents above).
            root.film-edge-hot = false;
            root.dock-lane-hot = false;
            root.stage-bot-hot = false;
            root.stage-left-hot = false;
            // v0.8.92 (L25/L22): the fully-off "i" stub hard-unmounts on the immersive edge (its
            // gate carries !immersive) — a destroyed TouchArea never fires changed has-hover, so a
            // stranded keep-alive here would hold the reveal open forever once the tick's context
            // re-arms. Joins the reset set.
            root.info-stub-hot = false;
            root.chrome-transition-begun(); // v0.8.23 M-2: any immersive edge opens the DWM mask
            root.dbg-snap("immersive-changed");
        }
        // v0.8.92 (L25/L22): clicking the revealed stub flips info-open true, which unmounts the
        // stub MID-HOVER (the pointer is on it by definition) — the destroyed TouchArea never
        // fires changed has-hover, so the gate-owner clears the keep-alive latch here.
        changed info-open => { root.info-stub-hot = false; }
        // v0.8.120 (design-sweep Y74 / L22): the cache meter's THIRD unmount edge. `changed
        // immersive` and hudclip's `changed ctrl-show` already clear the hover flag on the other
        // two; this one (a folder with <2 shots, or a swap to the empty state) mount-culls the
        // meter with the pointer on it, and the destroyed TouchArea never fires `changed has-hover`.
        // Harmless while the tooltip lived INSIDE the culled subtree; now that it is hoisted to the
        // window root, a stranded flag would leave the pill floating over the bar for ever.
        changed cache-meter-show => { if (!root.cache-meter-show) { root.cache-meter-hover = false; } }
        // ── v0.8.98 (v0.8.97-audit C2/C3/C10): the develop panel's mount predicate, ONCE. Its `if`
        //    below binds to this, and so does the L22 latch clear beneath it — so the clear fires on
        //    exactly the edge that destroys the panel's TouchAreas, no more and no less. v0.8.97
        //    hung that clear off `changed raw-open`, which is neither: it MISSED the `raw-min` and
        //    immersive unmounts (the panel dies, the latch lives) and it FIRED on the re-show edge
        //    (raw-open false → true), where nothing has unmounted.
        // ── v0.8.158 (B1b, OWNER RULING Q16): `&& !root.compare`, ON BOTH HALVES. ────────────────
        // "entering A/B compare HIDES the develop panel by default". It is a MODE TERM, not a
        // latch, and that is what makes it mode-SCOPED for free: leaving compare restores whatever
        // (raw-open, raw-min) pair the photographer left behind, because neither field is touched.
        // No stub, deliberately — L25 governs a user DISMISSAL, and this is a mode transition the
        // user made by entering compare; the affordance the panel carried into compare (the RAW
        // toggle) moves to the compare control bar in the same wave, so nothing becomes
        // unreachable. What DOES leave with it: the colour-space chip and its hover note, which
        // have no compare home — stated, not hidden (the note's own gate carries `raw-open` and is
        // cleared by `changed raw-panel-mounted` below, so it cannot strand).
        // The STUB carries the same term: a magnifier button parked in compare's bottom-left would
        // be a way back to a panel this ruling says is not there.
        property <bool> raw-panel-mounted: root.raw-open && !root.raw-min && !root.compare
            && (!root.immersive || root.chrome-fading || root.raw-revealed || root.raw-reveal-eff-i > 0.001);
        // …and the magnifier STUB's, the complementary half (v0.8.98/C13: it now carries the same
        // reveal disjunct, so the immersive peek has something to mount while the panel is parked).
        property <bool> raw-stub-mounted: root.raw-open && root.raw-min && !root.compare
            && (!root.immersive || root.chrome-fading || root.raw-revealed || root.raw-reveal-eff-i > 0.001);
        // v0.8.128 (SEL-LAG P1 RIDER): the three remaining blur-backdrop SAMPLER gates, hoisted
        // for the same reason `raw-panel-mounted` was (v0.8.98 / C2) — ONE predicate, read by the
        // `if` that mounts the surface AND by `blur-sampler-mounted` below, so the two cannot drift.
        property <bool> info-stub-mounted:
            (root.info-open && root.info-min && (!root.immersive || root.chrome-fading))
            || (!root.info-open && !root.immersive && !root.compare && (root.info-revealed || root.info-reveal-eff > 0.001));
        property <bool> info-panel-mounted: root.info-open && !root.info-min && (!root.immersive || root.chrome-fading);
        property <bool> cull-card-mounted: root.immersive && !root.compare && root.chip-reveal-eff > 0.001;
        // v0.8.162: the SIXTH sampler's gate, hoisted here for exactly the reason the five above
        // were — the `if` that mounts the floating EXIF panels and `blur-sampler-mounted` must read
        // ONE property. `FloatingExif` sets `hover-glass: true` inside its own definition
        // (panels.slint), so it samples the backdrop like the stage panels do, but the gate below
        // could not see that: v0.8.159 added a sampler and left the "is anything sampling?"
        // predicate at five terms. Consequence, and it is the owner's report's twin: with the
        // docked panel CLOSED and only floating panels on screen, Rust invalidated the key every
        // tick and never rebuilt, so those panels showed a frost from whatever the last docked
        // surface saw — or, in a session that never opened one, no frost at all.
        property <bool> float-exif-mounted: !root.modal-open && root.float-exif.length > 0;
        // v0.8.163 (§7 item 5): THE SEVENTH SAMPLER, and it is the same lesson one release later.
        // The compare control bar and its two pin labels became `GlassPanel`s with
        // `hover-glass: true`, i.e. they READ `blur-backdrop` — and this predicate is what tells
        // Rust to compose it at all. Left at six terms they would have frosted with whatever the
        // last docked surface saw, or with nothing: compare MINIMISES the EXIF panel by default
        // (Q19) and hides the develop panel entirely (Q16), so a compare session can easily have
        // no other sampler on screen. The gate is `root.compare` because that IS the bar's mount
        // predicate — `if root.compare : cmp` — read here verbatim rather than approximated.
        property <bool> compare-bar-mounted: root.compare;
        // v0.8.169 (item 1): THE EIGHTH SAMPLER — the two context menus. Third instance of the same
        // lesson in three releases (v0.8.162 the floating EXIF panels, v0.8.163 the compare bar), and
        // it is written here rather than learned again: a surface that sets `hover-glass: true` READS
        // `blur-backdrop`, and this predicate is the only thing that tells Rust to compose it. Left
        // out, a right-click would frost with whatever the last docked surface happened to see — or,
        // in a session that never opened one, with nothing at all (an empty `Image` under the 78 %
        // tint = the bare tint over the live photo, which is the v0.8.162 defect exactly).
        // The gate is `ctx-open || sel-ctx-open` because those ARE the two `if` gates that mount the
        // menus, read verbatim rather than approximated.
        // COST, checked: `step_blur_backdrop` composes ~0.7 ms and hands the bytes to the U1 upload
        // thread, and a right-click is a winit window event — which restarts the tick at FULL rate
        // BEFORE the event is handled (`support::TICK_HYSTERESIS_MS`), so the rebuild lands within a
        // few 16 ms ticks of the menu appearing, not a few 125 ms ones.
        property <bool> ctx-menu-mounted: root.ctx-open || root.sel-ctx-open;
        // v0.8.128 (SEL-LAG P1 RIDER): IS ANY SURFACE ACTUALLY SAMPLING `blur-backdrop`?
        //
        // Most of the app's GlassPanels are handed `backdrop: root.blur-backdrop` and never read a
        // pixel of it: the panel's blurred Image is `visible: root.glassy`, and `glassy ==
        // hover-glass` (the glass theme was retired in W2), so every surface that leaves
        // `hover-glass` at its default is passed a canvas it does not sample — the Selection panel,
        // the very surface in the 07-29 lag report, among them. The SAMPLERS are the seven gates
        // OR'd below: the develop panel and its stub, the info panel and its stub, the immersive
        // cull card, the floating EXIF panels, and (v0.8.163) the compare control bar with its two
        // pin labels.
        //
        // Rust reads this to decide whether to rebuild the backdrop at all (tick::step_blur_backdrop),
        // which is the SEL-LAG P1 rider. `out` because it is UI→Rust, like `at-fit` /
        // `raw-panel-hot` / `info-stub-hot`. Composed from the mount PROPERTIES rather than from
        // copies of their expressions, so a change to any gate moves this in the same edit.
        out property <bool> blur-sampler-mounted:
            root.raw-panel-mounted || root.raw-stub-mounted || root.info-stub-mounted
            || root.info-panel-mounted || root.cull-card-mounted || root.float-exif-mounted
            || root.compare-bar-mounted // v0.8.163 (§7 item 5): the compare bar + its pin labels
            || root.ctx-menu-mounted || root.sort-open; // all menus sampling the cropped glass
        // L22: a destroyed TouchArea never fires `changed has-hover`, so the GATE OWNER clears what
        // the panel's own surfaces latched — the colour-chip hover (cs-hover; a stranded one leaves
        // the colour note floating with nothing under it) and the reveal keep-alive (raw-panel-hot;
        // a stranded one holds the immersive peek's linger open for ever, which is C3's pin: the
        // peek's own mount disjunct then keeps the panel on screen in immersive with no pointer
        // anywhere near it). UNMOUNT EDGE ONLY — same discipline as `changed immersive` / `changed
        // compare`, which fire on an edge that really does destroy their surfaces.
        //
        // raw-corner-hot is deliberately NOT in this set (C10). It is fed by the STAGE TouchArea,
        // whose only mount gate is `!compare` — it does not unmount on any develop-panel edge, so it
        // cannot strand here and self-corrects on the next pointer move. Clearing it on the panel's
        // RE-SHOW edge is what used to strand the peek instead: a pointer resting in the bottom-left
        // zone had already reported `bl-hot` true, the clear threw that away, and no further
        // `changed` could re-report it until the pointer moved. (`changed compare` still clears it —
        // there the feeder really does unmount.) The tick's own `raw_ctx` term makes a stray true
        // inert anyway: outside single-view immersive with the develop panel present, the countdown
        // is forced to 0.
        changed raw-panel-mounted => {
            if (!root.raw-panel-mounted) {
                root.cs-hover = false;
                root.raw-panel-hot = false;
            }
        }
        // The stub shares raw-panel-hot (one keep-alive for whichever develop surface is up) and so
        // needs the same clear on ITS unmount edge — chiefly the immersive ENTER while the pointer
        // rests on the parked stub, the very edge that would otherwise pin the new peek open.
        changed raw-stub-mounted => {
            if (!root.raw-stub-mounted) { root.raw-panel-hot = false; }
        }
        // ── v0.8.160 (Y7 + L22): THE FLOATING PANELS' PIN TIP, AND ITS OWN UNMOUNT EDGE. ─────────
        // The two sentences are declared here so there is ONE copy of each: the `for` binds them
        // into every panel, the observer below owns the clear, and Rust's close paths read them back
        // through the same properties (`rebuild_float_exif`).
        out property <string> fx-tip-pinned: @tr("falcon" => "Pinned to this photo — click to follow the current photo");
        out property <string> fx-tip-following: @tr("falcon" => "Following the current photo — click to pin");
        // L22, verbatim: R1's new mount gate can destroy a HOVERED pin button, and a destroyed
        // TouchArea never fires `changed has-hover`, so the tip would strand over the sheet that
        // just opened. Ownership-guarded (only OUR sentences are cleared — another host may own the
        // channel while a panel merely happens to be mounted).
        // v0.9.66 (the round-7 sync): ONE observer, two arms. Slint allows exactly one `changed`
        // callback per property, and this branch declares a second use of the same edge — the
        // deferred macOS association popup, whose whole design is "open when the UI goes idle".
        // Both arms are unconditional reads of the same transition and neither touches the other's
        // state, so folding them costs nothing but the merge; the alternative (a second property
        // mirroring modal-open) would be a second source for one fact.
        changed modal-open => {
            if (root.modal-open && (Tip.text == root.fx-tip-pinned || Tip.text == root.fx-tip-following)) {
                Tip.text = "";
            }
            // v1.0.0-rc (queue item 31, §3.A.5): a sheet opening over the Review panel puts a scrim
            // (and, for the blocking ones, a swallow) between the pointer and the tiles, so the
            // hovered tile can stop being hovered without ever saying so. The gate below already
            // forces the step's state to default while `modal-open` holds; this clears the SOURCE
            // so the card does not come back on the sheet's close under a pointer that never moved.
            if (root.modal-open) { root.sel-hover-idx = -1; }
            // ── v0.9.16/v0.9.20 (Round B assoc), moved here from its own observer ──────────────
            // The Mac first-launch association popup opens only when NO panel or modal surface is
            // up. `modal-open` already ORs settings/loading/confirm/export/rot/welcome (and
            // assoc-prompt-open itself, which is false while armed), so a single observer on it is
            // the robust gate for EVERY route. This replaces the old open-on-welcome-close trigger,
            // which stacked the popup ON TOP of Settings whenever the welcome closed INTO it — the
            // title-bar gear (settings-open toggled true in the same click) and the welcome's
            // "→ Settings · Controls" footer link both did that. Slint flushes changed-observers
            // AFTER the callback body completes, so by the time this fires modal-open already
            // reflects BOTH the welcome-close and the settings-open: the popup waits, then takes
            // its turn the instant the user closes Settings (or any panel) and the UI goes idle.
            // Setting assoc-prompt-open re-raises modal-open, which re-fires this observer once
            // with `!modal-open` false — a harmless no-op, never a loop. Rust still arms this at
            // boot for the welcome-first case and opens the popup directly on a second launch (no
            // welcome → modal-open never transitions, so there is nothing for this to catch).
            // v0.9.20: gate on assoc-prompt-armed ALONE — a `!assoc-prompt-shown` check used to
            // guard this too, but Rust now latches assoc-prompt-shown true (persist-at-show) at the
            // SAME boot that arms the popup, which would block this observer from ever opening the
            // deferred popup. assoc-prompt-armed is sufficient by itself: Rust sets it true only in
            // the armed boot arm, and this observer is the ONLY place that clears it (to false,
            // right before opening), so it can never be stale-true for a popup that has already
            // shown. assoc-prompt-shown now serves purely as the persisted show-once record,
            // decoupled from the open trigger.
            if (!root.modal-open && root.assoc-prompt-armed) {
                root.assoc-prompt-armed = false;
                root.assoc-prompt-open = true;
            }
        }
        // v0.8.33 (M8): the single-view stage TouchArea (which owns the corner hover flags) unmounts
        // in compare — clear them so a stranded hover can't spuriously re-arm a reveal on the way back
        // to single view (the tick also force-expires the countdowns outside single-view immersive).
        changed compare => {
            root.chip-corner-hot = false;
            root.raw-corner-hot = false;
            root.raw-panel-hot = false;
            root.chip-panel-hot = false;
            // v0.8.92-audit (L25/L22): the fully-off "i" stub hard-unmounts on the compare edge (its
            // gate now carries !compare, mirroring the cull chip) — a destroyed TouchArea never fires
            // changed has-hover, so a stub-hover latched when compare opens would hold the reveal
            // alive once the tick's context re-arms. Joins the reset set, exactly as `changed
            // immersive` and `changed info-open` clear it on their edges.
            root.info-stub-hot = false;
            // v0.8.51 (hotfix): the stage TA also owns the G2 edge-zone flags — same unmount, same
            // stranding hazard on the compare edge (the strip/dock flags join for symmetry: a
            // compare entered from a zone hover must not hold a reveal open either way).
            root.film-edge-hot = false;
            root.dock-lane-hot = false;
            root.stage-bot-hot = false;
            root.stage-left-hot = false;
            // v0.8.126 (audit N24, ledger L22): the compact focus badge is a POSITIONED Tip host
            // (its tip hangs under the compare bar, not at the title-bar sentinel y), so it owns
            // the channel and must clear BOTH text and cy on every leave path. Hover-out is one;
            // this unmount edge is the other - a destroyed TouchArea never fires `changed
            // has-hover`, and a stale cy would re-anchor the NEXT host's tip at a dead position.
            root.cmp-badge-hot = false;
            if (Tip.text == root.cmp-tip-one-to-one || Tip.text == root.cmp-tip-fit) { Tip.text = ""; Tip.cy = 0px; }
        }
        // ...and the label follows the STATE while the pointer sits still (the pattern the path
        // pill's `changed pill-tip` established): the badge's imperative flips the moment the zoom
        // crosses Fit, so a tip captured at hover-in would go stale under the cursor.
        changed cmp-focus-tip => {
            if (root.cmp-badge-hot) { Tip.text = root.cmp-focus-tip; }
        }
        changed maximized => {
            if (root.maximized) {
                root.sticky-square = true;
                root.square-latch-w = root.width;
                root.square-latch-h = root.height;
            } else if (root.sticky-square && (root.width != root.square-latch-w || root.height != root.square-latch-h)
                    && !root.screen-filling) { // v0.8.21: a moved-but-still-screen-filling geometry stays latched
                root.square-release-requested(); // v0.8.23 M-1: the release lands after the stability window
            } // else: geometry unchanged → desync/spurious drop → stay square until it moves
            root.chrome-transition-begun(); // v0.8.23 M-2: any maximize edge opens the DWM mask
            root.dbg-snap("maximized-changed");
        }
        changed width => {
            // v0.8.20: track the latch while IMMERSIVE too (the fullscreen resize lands frames
            // after the flag flips — same desync class as maximize), so an F11 exit holds square
            // until the OS restore actually RESIZES the window.
            if (root.maximized || root.immersive) { root.square-latch-w = root.width; }
            else if (root.sticky-square && root.width != root.square-latch-w && !root.screen-filling) { root.square-release-requested(); } // v0.8.21 guard; v0.8.23: debounced
            root.dbg-snap("width-changed");
        }
        changed height => {
            if (root.maximized || root.immersive) { root.square-latch-h = root.height; }
            else if (root.sticky-square && root.height != root.square-latch-h && !root.screen-filling) { root.square-release-requested(); } // v0.8.21 guard; v0.8.23: debounced
            root.dbg-snap("height-changed");
        }
        // right-click context menu
        in-out property <bool> ctx-open: false;
        in-out property <length> ctx-x: 0;
        in-out property <length> ctx-y: 0;
        // v0.8.38 (G2): the ctx menu is TARGET-scoped — -1 = current shot (stage right-click),
        // N = a filmstrip thumb's ABSOLUTE index (film right-click, NO navigation). ctx-populate(idx)
        // resolves the target in Rust and loads the display state below so the ONE menu shows the
        // clicked shot's rating + copy availability; every ACTION routes through the existing guarded
        // index handlers (rotate-shot / delete-shot / reveal-shot / copy-files / sel-to-compare / sel-set-rating).
        in-out property <int> ctx-target: -1;             // -1 = current (stage) / N = thumb abs idx (routes to the -1-aware action callbacks)
        in-out property <int> ctx-idx: -1;                // RESOLVED absolute index (= current for stage) — for sel-to-compare / sel-set-rating
        in-out property <int> ctx-rating: 0;              // the target shot's rating (star display)
        in-out property <bool> ctx-has-finished: false;   // target has a finished-image file (copy enable)
        in-out property <bool> ctx-has-raw: false;        // target has a RAW file (copy enable)
        // v0.8.120 (design-sweep Y56): the target shot's CULL marks, so the menu's new Flag /
        // Reject rows can show their `checked` state — the same accent-label treatment the sort
        // menu's rows use. Filled by ctx-populate beside ctx-rating (one resolve, one target).
        in-out property <bool> ctx-flag: false;
        in-out property <bool> ctx-reject: false;
        in-out property <string> ctx-copy-fmt-label: @tr("falcon" => "Copy image"); // "Copy JPG" etc. for the target
        // v0.8.158 (B1a, OWNER RULING Q31): the menu's SUBJECT LINE, composed in Rust by
        // `on_ctx_populate` (support::ctx_menu_header) — the resolved target's filename, or
        // "[n] images" when the menu's verbs are the bulk ones. Both menus bind it (both open
        // sites call the same populate), so the subject cannot be worded two ways.
        in-out property <string> ctx-header: "";
        // ── v0.8.163 (§7 items 2+3): IS THIS MENU PLURAL? ────────────────────────────────────────
        // Published by `on_ctx_populate` from the SAME expression the header string is composed
        // from (`bulk_scoped && n_sel > 1`), never re-derived here — so the subject line, the
        // header's clickability and the counted action rows below are three readings of ONE fact.
        // It is deliberately NOT `ctx-rate-armed`: that predicate is true for a selection of ONE
        // (where the header names the file and the menu reads single-target), and a "Flag 1" row
        // over a menu headed by a filename would be the two-scopes-in-one-menu defect J2 closed.
        in-out property <bool> ctx-plural: false;
        // ── v0.8.187 (W6, OWNER RULING D25): IS THE RESOLVED TARGET AN ANIMATED GIF? ─────────────
        // The animated-GIF playback lane has no rotation code at all, while the filmstrip tile, the
        // EXIF dimensions and the web export all turn — so a rotate on one used to look applied
        // everywhere except on the picture itself. The owner ruled an HONEST REFUSAL: these rows
        // grey, and the R / Shift+R chords say so out loud. Published by `on_ctx_populate` from the
        // GIF lane's own `>= 2 frames` datum (never from the format — a STILL GIF rotates today and
        // keeps its rows lit, ledger L42), and BOTH menus bind it because both open sites call that
        // same populate.
        in-out property <bool> ctx-rotate-blocked: false;
        // v0.8.163 (§7 item 3): the rating row's label. "Rating" in the single-target menu; "Rate
        // n" while plural, composed Rust-side (Slint has no int+string concatenation) beside every
        // other counted menu string.
        in-out property <string> ctx-rate-label: @tr("falcon" => "Rating");
        // v0.8.163 (§7 item 3): the plural UNMARK row's counted label ("Unmark 3"). Its two
        // siblings reuse `ctx-bulk-flag-label` / `ctx-bulk-reject-label` — the Selection-tile
        // menu's own rows — so the twins say one thing; unmark has no direction, hence its own.
        in-out property <string> ctx-bulk-unmark-label: @tr("falcon" => "Unmark");
        // ── v0.8.194 (FIX 2026-08-18 §1C3): THE COUNTED COPY ROWS' THREE TITLES + THREE GATES. ───
        // The owner's report: with several photographs selected the menus offered no "copy (n)" and
        // both menus (and Ctrl+C) copied the current image only. These are the plural arm's
        // published labels — "Copy JPG (3)" / "Copy RAW (2)" / "Copy both (3)" — composed by
        // `on_ctx_populate` through `support::bulk_copy_rows` beside every other counted string,
        // never here (Slint has no int+string concatenation, and the count must be the one the
        // click really copies). The three may differ from each other: each names the photographs
        // ITS kind yields a file from.
        //
        // The `-on` bools are those same counts (> 0), so a lit row always has a file behind it —
        // the v0.8.125 Y18 rule, aggregated. `both-on` is the SET's own both (some finished file
        // AND some RAW anywhere in the selection), which is exactly the aggregate predicate the
        // Ctrl+C walk answers with mode 2, so the cap can never land on a greyed row.
        in-out property <string> ctx-bulk-copy-fin-label: @tr("falcon" => "Copy image");
        in-out property <string> ctx-bulk-copy-raw-label: @tr("falcon" => "Copy RAW");
        in-out property <string> ctx-bulk-copy-both-label: @tr("falcon" => "Copy both");
        in-out property <bool> ctx-bulk-copy-fin-on: false;
        in-out property <bool> ctx-bulk-copy-raw-on: false;
        in-out property <bool> ctx-bulk-copy-both-on: false;
        // ── v0.8.159 (B2, OWNER RULING Q19): THE FLOATING EXIF PANELS. ───────────────────────────
        // ONE model, ordered by open sequence (newest LAST), capped at 4 in Rust; ONE component
        // mounted per entry. Every mutation — open, close, pin, drag landing — goes back to Rust,
        // which owns the list, the cap, the identity carry and the close-trigger matrix; the window
        // holds no per-panel state of its own. `float-exif-any` is the Esc dispatch's readable
        // predicate (UI→Rust would be the wrong direction; Rust reads its own list).
        in property <[FloatExifPanel]> float-exif;
        callback float-exif-open(int, length, length); // (shot idx or -1 = current, window x, window y)
        callback float-exif-close(int);                // by model row
        callback float-exif-toggle-pin(int);
        callback float-exif-moved(int, float, float);  // the clamped landing, published on release
        // key rebinding (Settings → Controls)
        in property <[KeybindRow]> keybinds;
        // v0.8.65 (C3/H4+M7): BASIC SHORTCUTS — the fixed system keys, now discoverable in Settings
        // and rebindable behind the section's Edit unlock (basics-edit; Rust re-locks it whenever the
        // Settings sheet closes). Rows share KeybindRow + the CONTROLS capture machinery.
        in property <[KeybindRow]> basic-binds;
        in-out property <bool> basics-edit: false;
        // ── v0.8.169 (item 6, OWNER RULING): THE LEGACY DEVELOPER FOLD ──────────────────────────
        // "as most of the developer options are no longer touched for quite a while, fold the
        // developer section items except the dev panel (HUD) and the new locate logs button in a
        // show legacy dev settings section so that they do not distract users."
        //
        // COLLAPSED ON EVERY OPEN, and that is a RESET rather than a default: the property is reset
        // in the OPEN arm of `changed settings-open` below, exactly as `reset-display-expansion`
        // is, so a session that expanded the fold once does not carry it into every later visit.
        // (A default alone would not do it — the Slint sheet's mount gate does not re-run a
        // property's initialiser.)
        // v1.0.0-rc (queue item 33, OWNER RULING 2.4b, "(c) split into 'Advanced' and 'Legacy',
        // both with the '· N changed' badge"): the FIRST of the two folds. Same reset discipline
        // as its twin below — both are forced false in the OPEN arm of `changed settings-open`,
        // because a default alone does not re-run when the sheet remounts.
        in-out property <bool> dev-advanced-open: false;
        in-out property <bool> dev-legacy-open: false;
        // v1.0.0-rc (queue item 33, sheet 2.4b): how many PERSISTED levers inside each fold stand
        // off their default — published every tick by `tick::step_dev_fold_counts` from
        // `support::dev_fold_counts(&DevLevers, &Settings::default())`, so the defaults are read
        // from `impl Default for Settings` and exist nowhere in this file (ledger L28/L29). The
        // headers render them as a state-derived suffix (L20), which is what gives a closed fold
        // an on-screen trace of a lever flipped weeks ago — the 08-12 F5-4 finding.
        in property <int> dev-advanced-changed: 0;
        in property <int> dev-legacy-changed: 0;
        // The LIVE dispatch tokens (Rust: refresh_basic_keys) — the FocusScope arms below compare
        // key-token(e.text) against these instead of hardcoded Key.* literals, so a rebound basic
        // works everywhere its old key did (hold-to-scrub, release, compare gating included).
        in property <string> kb-prev: "Left";
        in property <string> kb-next: "Right";
        in property <string> kb-first: "Home";
        in property <string> kb-last: "End";
        in property <string> kb-cmpswap: "Tab";
        in property <string> kb-cmppin: "Space";
        in property <string> kb-del: "Del";
        // While a rebind is listening, the FocusScope routes every PLAIN key into key-typed (special
        // keys as tokens) instead of running its arms — armed/disarmed by Rust with the capture.
        in property <bool> capture-armed: false;
        // v0.8.65 (C3/M6): the Open… (Image | Folder) menu — anchored under its trigger (the
        // title-bar Open button, or the empty-state button). Same overlay grammar as the sort menu;
        // x/y are overlay-relative (the title-bar trigger uses the standard 3px inset).
        in-out property <bool> open-menu-open: false;
        in-out property <length> open-menu-x: 0px;
        in-out property <length> open-menu-y: 3px;
        // v0.8.65 (C3): the Settings footer version row (Rust: env!("CARGO_PKG_VERSION") — the
        // branch automatically shows its own version through the same property).
        in property <string> app-version: "";
        in-out property <bool> about-open: false;
        in property <string> about-repository;
        in-out property <string> about-error;
        callback about-link-requested(int);
        public function show-about() { root.about-error = ""; root.about-open = true; keys.focus(); }
        changed about-open => { if (!root.about-open) { root.about-error = ""; keys.focus(); } }
        // v0.8.65 (C3/H5): geometry-memory toggle — persisted straight off this property by
        // build_settings (the motion-ui pattern); default OFF = today's placement behaviour.
        in-out property <bool> remember-geometry: false;
        // v0.8.65 (C3/M9): the colour card's OS-concept description (platform-routed, M12 pattern).
        in property <string> gamut-copy: "";
        // ── v0.8.67 (D): the welcome/onboarding panel ──
        // welcome-open mounts the modal overlay (Rust opens it at boot when the persisted
        // onboarding_shown latch is absent/false; the Settings footer's "Show welcome" re-opens it).
        // NO wizard state: every control inside applies immediately; Skip / Done / Esc are all the
        // same plain close. onboarding-shown is the persisted latch — since v0.8.76 Rust sets it
        // TRUE at boot-show (persist-at-show; the close-observer latch below is now redundant
        // belt-and-braces) and build_settings persists it straight off this property.
        in-out property <bool> welcome-open: false;
        in-out property <bool> onboarding-shown: false;
        // The RECOMMENDED card: Rust-composed one-liner ("Scrub 20 fps · Supersample 2054"; "" =
        // not yet benchmarked → quiet placeholder), the one-tap apply, and its applied latch
        // (re-armed by every fresh bench result in drain_bench).
        in property <string> bench-rec-text: "";
        // ── v0.8.160 (B4/U11): "Applied" IS DERIVED, NOT LATCHED. ────────────────────────────────
        // The latch was set by the Apply callback and cleared only by a NEW benchmark result, so the
        // card kept saying "Applied" — with its button disabled — after the reader moved the scrub
        // slider or the Fast View seg one click away from the recommendation. A lying label plus a
        // dead control, in a shipped Settings card.
        // A write-site demotion would have needed two traps solved (the quality-super SUPER path
        // never enters Rust, and a changed-observer would race Apply's own writes). Deriving needs
        // neither, re-arms in BOTH directions — including drifting back ONTO the recommendation —
        // and cannot go stale by construction (L27/L43: no latch, so no demotion edge to miss).
        // The two terms are the recommendation itself, published beside its text by the same Rust
        // producer (`support::bench_recommendation`) so the label and the effect cannot skew.
        in property <float> bench-rec-fps: 0;
        in property <bool> bench-rec-super: false;
        out property <bool> bench-rec-applied:
            root.benchmarked && root.scrub-fps == root.bench-rec-fps
            && root.quality-super == (root.bench-rec-super ? 1 : 0);
        // v0.9.60 (W2-5d): the card's placeholder line, composed by the SAME Rust producer as the
        // text above (`support::bench_rec_card`) so the two can never disagree about why there is
        // no recommendation. Default = the literal this row carried before, so Windows renders
        // byte-identically in every state; on macOS a synthetic run replaces it with "not yet
        // measured for this folder" — a run HAS happened, and "shown after the run" would be a lie
        // about it.
        in property <string> bench-rec-hint: @tr("falcon" => "shown after the run");
        // v0.9.60 (W2-5d): may the displayed benchmark PARAMETERIZE this folder's promises?
        // Derived, never set from Rust, so it cannot drift from the two facts it reads. On Windows
        // `is-mac` is false, so this is exactly `benchmarked` and every consumer behaves as before
        // (owner decision B3 covers whether Windows should change too).
        // v0.9.62 (B2.2 / audit J12): an `out` property. It is READ by Rust — the rig pins it
        // against `support::bench_result_governs_for`, so the Slint expression and the Rust
        // predicate cannot drift apart while three surfaces (the veil, the honest line, the
        // always-sharp captions) depend on them agreeing. The pair disagreed about single-sourcing
        // this into Rust and pushing a value back; the derived binding won, because a binding cannot
        // go stale against its own inputs and a pushed value can — the equivalence pin is what
        // makes that safe.
        out property <bool> bench-governs: root.benchmarked && !(root.is-mac && root.bench-synthetic);
        callback apply-bench-rec();

        // reactive image geometry (Rust drives zoom/pan via callbacks)
        out property <length> stage-w: stage.width;
        // v0.8.162 (OWNER-CAUGHT, L7): the stage's LEFT edge in WINDOW space — the x half of the
        // frosted backdrop's origin, and the value every window-rooted GlassPanel passes as `ox`.
        // `stage.x` IS window-space x: the [grid dock | stage] row is a direct child of the root
        // VerticalLayout, so the row itself sits at x = 0 and the stage's own x inside it is
        // exactly the dock's live width (mount + splitter). Same reasoning as `stage-w` above —
        // LIVE layout, never re-derived from `grid-open ? grid-dock-w : 0`, which would have to be
        // kept in step with the dock's mount gate by hand.
        out property <length> stage-x: stage.x;
        // v0.8.120 (design-sweep O16): the FILMSTRIP's width. `step_filmstrip` computed its
        // centring offset, its clamp basis and both seek-bar fractions from `stage-w` — but the
        // strip is NOT inside the [grid dock | stage] row: it is a sibling below it, x=0, `width:
        // 100%`. With the default 3-column dock open on a 1920px window that put the accent-framed
        // current thumb at x=764 instead of 960 (196px left of the strip's own middle, 392px left
        // of the photo it belongs to) and left a ~72px dead band of empty strip at the right edge.
        // The [VD] basis is WINDOW-centred, which is what the strip's documented contract ("the
        // current thumb sits at the strip's centre") and the window-centred bottom edge pill both
        // already say. A named property rather than `root.width` at the read site, so a future
        // strip that is not full-width changes ONE line.
        out property <length> strip-w: root.width;
        out property <length> stage-h: stage.height;
        // stage + the filmstrip strip below it — the backdrop covers this, so glass panels dipping
        // over the filmstrip blur it too (no hard seam). Filmstrip is 102 px (hidden in empty state;
        // v0.8.50 G2: and when the user collapses it via the bottom edge pill — film-visible).
        //
        // v0.8.162 (found while mapping the `ox` defect — the SAME class on the other axis, L27):
        // the strip band had THREE readers with TWO different predicates. `content-h` (the height a
        // GlassPanel maps the canvas into) omitted `immersive`; the Rust compositor's own `fh`
        // (`tick::step_blur_backdrop`) omitted `film-visible`; only the left edge band spelled all
        // three terms. So with the strip collapsed the canvas was 102 px TALLER than the box it was
        // mapped into (frost squashed, the filmstrip's own background bleeding up into every panel)
        // and in immersive it was 102 px shorter (frost stretched). ONE property now, and Rust
        // READS it (`app.get_film_band()`) instead of carrying a second copy of the predicate.
        out property <length> film-band:
            (root.empty-state || root.immersive || !root.film-visible) ? 0px : 102px;
        out property <length> content-w: root.stage-x + root.stage-w;
        out property <length> content-h: root.stage-h + root.film-band;
        property <bool> wbound: (root.stage-w / root.stage-h) < root.img-aspect;
        out property <length> base-w: root.wbound ? root.stage-w : root.stage-h * root.img-aspect;
        out property <length> base-h: root.wbound ? root.stage-w / root.img-aspect : root.stage-h;
        out property <length> img-w: root.base-w * root.zoom;
        out property <length> img-h: root.base-h * root.zoom;
        out property <length> img-x: (root.stage-w - root.img-w) / 2 + root.pan-x;
        out property <length> img-y: (root.stage-h - root.img-h) / 2 + root.pan-y;

        // ── v0.8.50 (G1, the grid batch): the folder-grid DOCK ──
        // The stage row is [grid dock | photo stage]: a left dock whose Flickable viewport
        // is the VIRTUAL total height (thousands of rows) while only a small window of live
        // GridThumbs exists, positioned by grid-win-y and reused via set_row_data — the
        // step_filmstrip idiom rotated 90° (mechanism proven by the G0 spike, branch
        // spike-gridvirt: 176k-px viewport, 0 coverage failures, ~80µs steps, idle free).
        // Rust (tick::step_folder_grid) owns every window/pitch/column computation off the
        // LIVE dock width; the Flickable owns wheel + clamping (interactive:false — the
        // Selection panel's field-proven posture; press-drag stays free for the tiles'
        // drag-to-compare). Immersive/empty-state mount-cull the dock (the title-bar-slot
        // rule) — grid-open is untouched, so the state restores on exit.
        in-out property <bool> grid-open: false;
        in-out property <length> grid-dock-w: 392px; // 8 pad + 3×120 tiles + 2×8 gaps + 8 pad (fixed this stage; the G2 splitter varies it)
        in property <length> grid-virtual-h: 0px;    // Rust: pad + virtual-rows × row-pitch
        in-out property <length> grid-vp-y: 0px;     // Flickable viewport-y mirror (negative when scrolled; the sel-vp-y idiom)
        in-out property <length> grid-vp-h: 0px;     // live dock viewport height (Rust reads for the window math)
        in property <length> grid-win-y: 0px;        // live-window container y within the viewport (= pad + base-row × pitch)
        in property <int> grid-cols: 3;              // Rust: columns from the LIVE dock width
        in property <[FilmItem]> grid-items: [];     // the live window (rows × cols, flat; VOID tail cells = default items)
        // v0.8.192 (owner order): the title-bar path context menu ("Copy path", v0.8.50 option (b))
        // is RETIRED with its two properties — the pill's LEFT click copies the path again, because
        // the SectionChip and the edge pill already carry the grid toggle. See the tombstone at the
        // old menu's mount site below.
        // ── v0.8.50 (G2): hide-filmstrip + the edge-pill reveal system ──
        // film-visible: NEW capability — the strip mount-culls on it (the stage takes the full
        // height the same frame, the title-bar-slot rule); persisted; edge-pill-only access
        // (owner design — no menu/keyboard route). Default true.
        in-out property <bool> film-visible: true;
        // Edge-proximity SOURCE flags, pushed from the surfaces that own those pixels via
        // `changed` observers (the M8 corner-reveal pattern — NO new window-wide hit surface,
        // so nothing can click-steal): the stage TA (bottom zone when the strip is hidden;
        // left zone when the grid is closed), the strip's own TA (its lower band), and the
        // dock's 8px left-pad lane. The pills' own hover keeps the reveal alive while aimed.
        property <bool> stage-bot-hot: false;
        property <bool> stage-left-hot: false;
        property <bool> film-edge-hot: false;
        property <bool> dock-lane-hot: false;

        callback titlebar-pressed();
        callback close-requested();
        callback minimize-requested();
        callback maximize-requested();
        callback navigate(int);
        callback navigate-step(int);
        callback nav-released();
        callback toggle-hud();
        callback zoom-at(length, length, float);
        callback stage-hover(length, length); // v0.9.12 (C2/M11): stage-local cursor → Rust (macOS pinch-zoom anchor)
        callback photo-clicked(length, length); // toggle 1:1 zoom at the click point
        callback pan-start();
        callback pan-move(length, length);
        callback pan-reset();
        // v0.8.182 (2026-08-13 owner report): the COMPARE drag's only way into Rust. The compare pan
        // writes `cmp-pan-fx/fy` here in the markup and never crosses over (unlike `pan-move`, which
        // Rust clamps), so without this the highest-rate input surface in compare stamped no
        // interaction clock at all and the gesture park could not see the drag it exists for. It
        // carries no arguments on purpose: the geometry stays in the markup, only the FACT of the
        // gesture is exported.
        callback cmp-pan-input();
        callback set-fps(float);
        // Custom slider inputs (Phase B) — strings so Rust can PARSE + clamp and REJECT invalid input
        // (a to-float() in Slint silently maps garbage to 0, which is exactly what we don't want).
        callback set-wm-custom(int, string);             // 0 opacity % / 1 size % / 2 JPEG quality
        callback set-fps-custom(string);                 // Speed popup custom scrub fps (parse-rejecting)
        callback set-outlong-custom(string);             // export output long edge, custom px (parse-rejecting)
        callback set-resume-cap-custom(string);          // v0.8.11 (F3): typed resume-position cap (0..500; 0 = off), parse-rejecting
        callback resume-cap-changed();                   // v0.8.11 (F3): a preset pick — re-trim the in-memory LRU to the new cap
        callback run-benchmark(bool);    // arg = force-synthetic: the welcome's no-folder run passes true (target-MP frames for THAT run; the persisted "Benchmark with" seg is untouched). Settings passes false and honors the seg.
        callback run-posture-bench();                    // v0.9.9 (P6): TEMPORARY dev posture bench (log-only)
        callback set-nvjpeg(bool);
        callback set-rating(int);
        callback set-flag(bool);         // pick/unpick the current shot
        callback set-reject(bool);       // reject/unreject the current shot
        callback clear-mark();           // clear flag+reject on the current shot
        callback set-filter(int);        // Selection-panel filter chip
        callback sel-jump(int);          // jump to a shot index from the Selection list
        // ── v0.8.160 (B2/U9): THE LAST ARGUMENT OF THE NEXT FOUR IS "A MENU SENT THIS". ─────────
        // D1b's ruling is about POPUP-TARGETED actions — a menu that captured an index while the
        // current shot moved on. The hook landed on these four SHARED callbacks, which the grid
        // thumbs' and Review tiles' own flag/reject buttons and star rows also call: those are
        // VISIBLE surfaces whose badge updates on the same tick, so the toast is redundant there —
        // and it is worse than redundant, because `show_transient_toast` CLEARS `toast-restore` /
        // the bulk ask, so a tile-badge click destroyed a live [Restore] or [Yes] offer.
        // An explicit bool beats reading `ctx-open` in Rust (which is true here only because the
        // menu arms happen to close AFTER invoking): the compiler enforces every call site, so a
        // new invoker cannot silently inherit the wrong answer. `false` = the surface is on screen.
        // ACCEPTED RESIDUAL, stated rather than machined away: a menu opened FROM a still-visible
        // thumb toasts redundantly. The ruling's letter covers it and visibility-testing every
        // surface is not worth the machinery.
        callback sel-set-rating(int, int, bool); // (shot index, rating, MENU-INITIATED) — rate a tile in the panel
        callback sel-toggle-flag(int, bool);   // toggle flag on a tile (by shot index, MENU-INITIATED)
        callback sel-toggle-reject(int, bool); // toggle reject on a tile (by shot index, MENU-INITIATED)
        // v0.8.120 (design-sweep Y56): clear BOTH marks on a shot by index — the "Unmark" the macOS
        // Photo menu has always had, arriving on the surface that is the filmstrip's ONLY per-thumb
        // affordance. (The two toggles above cannot express it: each is a toggle of its own bit.)
        callback sel-unmark(int, bool);
        // v0.8.120 (design-sweep O10): the preset editor's staged-edit bracket. `export-editor-open`
        // SNAPSHOTS the live wm-*/out-* recipe + the ticked preset; `export-editor-cancel` restores
        // it and returns to the list (or closes the sheet when there are no presets) — the SAME body
        // the Cancel button, Esc and the sheet's X all run, so the editor has exactly two exit
        // semantics: commit (Save) or revert (everything else). L18.
        callback export-editor-open();
        callback export-editor-cancel();
        callback rotate-shot(int, int);  // v0.8.0: (shot idx or -1 = current, dir +1 CW / -1 CCW)
        callback discard-rotations();    // v0.8.0: clear all manual rotations for this folder (confirm-kind 4)
        callback apply-rotations();      // v0.8.0 S2: write the manual rotations into the photos (confirm-kind 5)
        callback reminder-close-anyway();// v0.8.0 S2: acknowledge the unapplied-rotations reminder + quit
        callback copy-picks(int);        // copy flagged photos → ./Picks (arg = copy-content: 0 both/1 raw/2 jpg)
        callback toggle-xmp-sync();      // v0.8.69 (E/H2): the Selection-panel toggle — Rust gates the flip (OFF→ON may open the kind-7 backfill confirm)
        callback xmp-backfill-confirm(); // v0.8.69 (E/H2): confirm-kind 7 "Write sidecars" — queue the backfill + enable sync
        callback move-rejects();         // move rejected photos → ./Rejected
        callback undo-move();            // reverse the last "Move rejected" (#11)
        callback empty-rejected();       // send ./Rejected contents → OS Recycle Bin (#24)
        callback export-web();           // resize+watermark flagged photos → ./export (social prep)
        callback cancel-export();        // stop a running web export (#18)
        callback choose-watermark();     // pick a PNG logo (native file dialog)
        callback apply-preset(int);      // load a saved watermark/export preset
        callback save-preset(string, string); // save current settings as a named preset (new-name, orig-name for rename)
        callback copy-path();            // click the title-bar path → copy the current photo's full path
        callback copy-name();            // click the EXIF filename → copy the filename
        // v0.8.163 (§7 item 2): click the CONTEXT MENU's filename header → copy that menu's
        // target's filename. A separate door from `copy-name` because the two name different
        // photographs (the panel's is the shot on the stage; this one is `ctx-idx`, which on a
        // filmstrip / grid / compare-half right-click is deliberately not it) — but ONE body
        // behind them, so the clipboard write and the confirmation are the same by construction.
        callback copy-ctx-name();
        callback next-unrated();         // jump to the next photo with no rating
        callback toggle-compare();       // A|B side-by-side compare mode
        callback compare-one-to-one();   // zoom both compare halves to true 1:1 (sized to the active half)
        callback compare-browse(int);    // wheel browse: advance the UNPINNED half(s) by ±1
        callback compare-toggle-pin(int); // toggle pin on a half (0 A / 1 B)
        callback compare-set-active(int); // make a half active (rating/flag target) → current follows it
        // v0.8.135 (W2c): click at this (x, y) in the strip. Y is load-bearing now — the receiver
        // resolves the point through ONE geometry (`support::film_cell_at`), which answers "a
        // thumb" or "the strip's empty space" (an 8px inter-thumb gap, or the floor below the
        // 11..91px thumb band). Empty space CLEARS the selection; it used to floor-map onto the
        // thumb to its left and navigate.
        callback film-clicked(length, length);
        // v0.8.135 (W2c): 120/128 — the fraction of a 128px strip cell the THUMB occupies.
        // Published once at boot from `support::FILM_THUMB_FRAC`, so the hover site below and the
        // Rust receiver cannot drift: the hover lift and the click target are one number.
        in property <float> film-thumb-frac: 0.9375;
        callback film-scroll(int);       // wheel: step the current shot ±1 (smooth)
        callback film-drag-start();
        callback film-drag-move(length); // cumulative dx from press → scrub the strip
        callback film-drag-end();
        // v0.8.27: drag-UP from the filmstrip into A/B compare. The strip's ONE TouchArea classifies
        // each press ONCE past a ~10px slop via this Rust bridge (film_drag_classify — pure, unit-
        // tested), then STICKS with the answer for the whole press: mostly-horizontal → the native
        // scrub (unchanged); within ±film-cone-deg of straight UP → the SHARED Selection compare-drag
        // (sel-drag-* state, drop zones, sel-to-compare). Downward/ambiguous → horizontal, always.
        callback film-classify(length, length) -> int; // (dx, dy from press) → 0 pending / 1 horizontal / 2 compare-up
        in-out property <int> film-cone-deg: 20;       // ± degrees from straight up (5..45, persisted; INPUT slider — moved from DEVELOPER, G4 v0.8.44)
        callback set-film-cone-custom(string);         // typed cone (parse-rejecting in Rust, clamps 5..45)
        in-out property <int> reveal-linger-sec: 3;    // M8 immersive reveal linger (seconds, 1..10; persisted; DEVELOPER slider)
        callback set-reveal-linger-custom(string);     // typed linger (parse-rejecting in Rust, clamps 1..10)
        // v0.8.43: GPU backend AUTO-TUNE + a DEVELOPER override. gpu-backend-sel is a persistent user
        // pin (0 Auto / 1 Vulkan / 2 DX12); the three status strings are read-only, filled at boot by
        // the RenderingSetup notifier. The backend is bound once at startup — a change applies NEXT launch.
        in-out property <int> gpu-backend-sel: 0;
        in-out property <string> gpu-cur-backend: "";
        in-out property <string> gpu-cur-adapter: "";
        in-out property <string> gpu-timings: "";
        callback set-gpu-backend-override(int);        // 0 Auto clears memo + pin; 1 Vulkan / 2 DX12 pin
        // ── v0.8.169 (item 7, OWNER RULING): THE HEIC HARDWARE-LANE CONCURRENCY CAP, FROM THE UI ──
        // "add a dev settings slider for this - with the following 3 options custom|4|uncapped so
        // that I can test them." `FALCON_HEIC_LANE_CAP` has existed since v0.8.157 as an env lever;
        // the Intel-iGPU log then measured what the UNCAPPED flood costs when 18 workers race for 3
        // D3D11VA sessions (5 s checkout give-ups → 14-17 s WIC frames). This makes the arm
        // switchable without a shell.
        //
        // ONE INT IS THE WHOLE MODEL: 0 = UNCAPPED, 4 = the measured-win stop, any other n > 0 = a
        // typed custom cap. `CustomSeg`'s contract maps onto that exactly (`custom > 0` IS a custom
        // value), which is why the stops are ["4", "Uncapped"] and Custom is the component's own
        // built-in leading segment — the owner's stated order, in the app's existing tuner-card
        // grammar.
        //
        // v0.8.171 (OWNER RULING: "default to cap 4 instead of unlimited in future releases"): the
        // resting position is 4. Rust pushes the live value over this at the settings apply either
        // way; what this literal decides is the ONE frame before that, and it should not be the
        // arm the build no longer ships. The absent-vs-explicit distinction that carries the ruling
        // lives in `Settings::heic_lane_cap` (an `Option` now) — a Slint int cannot express it and
        // does not need to.
        //
        // LIVE, and grounded before it was claimed: `tick`'s prefetch step re-reads
        // `support::heic_lane_cap()` EVERY TICK (main.rs, beside the settings throttle), so a change
        // takes effect on the next tick with no restart and no folder reopen. That is what makes
        // `set-heic-lane-cap` a real callback rather than a persist-only property like `pool18`.
        // L43: nothing latches — the value IS the atomic, every read re-asks it, and the env lever
        // (when set) wins for the whole boot by construction rather than by a flag someone must clear.
        in-out property <int> heic-lane-cap: 4;
        // Is `FALCON_HEIC_LANE_CAP` set in THIS process's environment? True ⇒ the env value governs
        // and this control cannot move it, so the control is not mounted at all (L15/L21: an enabled
        // control whose handler would silently refuse is worse than an honest absence) and the note
        // below says which value is live and where it came from.
        in property <bool> heic-lane-cap-env: false;
        // The state-derived status line, composed Rust-side (`support::lane_cap_note`) — it carries
        // a NUMBER and Slint has no int+string concatenation, and it has to name the SOURCE, which
        // is a Rust fact.
        in property <string> heic-lane-cap-note: "";
        // v0.8.172 (G10): THE WITNESS. `heic-lane-cap` is an int, so a stored 0 cannot say whether it
        // came from the owner picking Uncapped or from this property's own declared default being
        // saved by v0.8.169's unconditional periodic write. This flag is set — in Rust, at the ONE
        // door both control paths pass through — the moment the control is actually used, and
        // `build_settings` persists it beside the number. Boot mirrors the persisted value back, so
        // once an install has said Uncapped it keeps saying it. Never set by Slint: a `picked`
        // handler that set it here would also have to be duplicated in `custom-committed`, and a
        // witness with two writers is a witness that can disagree with itself.
        in-out property <bool> heic-lane-cap-set: false;
        callback set-heic-lane-cap(int);           // apply live + log the change
        callback set-heic-lane-cap-custom(string); // typed cap (parse-rejecting in Rust, clamps 1..18)
        callback set-raw(bool);
        callback toggle-fullscreen();
        // v0.9.21 (item 1): allow/disallow the OS input-method editor (composed CJK input). Driven
        // by the focus observers below — TRUE only while a REAL text field (`wtin`/`pin`) holds
        // focus; the `keys` nav scope asserts FALSE so a composing IME (macOS Pinyin) can never eat
        // the printable culling keys. Rust body is macOS-only (winit set_ime_allowed); Windows no-op.
        callback set-ime(bool);
        callback escape-pressed();
        callback settings-closed();                      // fires whenever the Settings sheet hides (any path) —
                                                         // Rust abandons a still-armed key-rebind capture (N22 UI reset)
        callback reveal-shot(int);            // v0.8.28: reveal a shot's file in Explorer (idx or -1 = current) — shared by both context menus (mirrors rotate-shot)
        in-out property <bool> diagnostic-logging: false;
        callback diagnostic-logging-toggled(bool);
        // Settings → LANGUAGE (i18n.rs). Rust builds the rows from the language list ("System (…)",
        // "English", then each pack's own name), maps a row to the saved preference, and says whether
        // the pick differs from the running language. The language changes at the next start.
        in property <[string]> language-options: [];
        in-out property <int> language-sel: 0;
        in property <bool> language-restart: false;
        callback language-picked(int);
        // Settings → Developer → Widen controls to fit text was flipped: Rust re-decides the two
        // label cut-offs it owns (the Auto-detect pills and the Custom chip's own row).
        callback fit-text-toggled();
        // The LANGUAGE dropdown (owner ruling during the round-1 review: "Use a dropdown", in the
        // app's menu style, scrolling when needed). Its trigger publishes its own window-space left
        // edge, bottom edge and width when it opens the menu, so the menu hangs under it at its width.
        in-out property <bool> language-menu-open: false;
        in-out property <length> language-menu-x: 0px;
        in-out property <length> language-menu-y: 0px;
        in-out property <length> language-menu-w: 0px;
        callback show-log();       // reveal falcon.log (debugging the cull/export file ops)
        callback copy-files(int, int);  // v0.8.38 (G2): (shot idx or -1 = current, kind 0 finished / 1 RAW / 2 both)
        // v0.8.194 (FIX 2026-08-18 §1C1): the SET's copy — (kind 0 finished / 1 RAW / 2 both), no
        // index at all. Like `bulk-mark` and `clear-selection` its subject is the selection, so a
        // menu opened on a thumb or a Review tile has no target for it to lie about (J2: one menu,
        // one scope). Rust re-checks the same `bulk_armed` gate the cull keys use before it acts.
        callback copy-selected(int);
        // v1.0.0-rc (queue item 27, sheet 2.1 B3 b): reveal every selected file in ONE file-manager
        // window. Index-free for the same reason `copy-selected` is.
        callback reveal-selected();
        callback ctx-populate(int);     // v0.8.38 (G2): resolve target (idx or -1) + load the ctx-menu display state (Rust)
        // v0.8.119 (design-sweep O17/O19/O23): which of the three Copy rows the Ctrl+C priority
        // walk would actually perform for the ctx menu's target (2 both / 1 RAW / 0 finished;
        // -1 = nothing applicable). Filled by ctx-populate through support::ranked_copy_mode —
        // the SAME helper on_copy_shortcut dispatches through — so the keycap can sit on the row
        // the key really runs instead of always on the first one.
        in property <int> ctx-rank-mode: -1;
        // v0.8.125 (C5 / the M9 immersive question): leave immersive the way Esc does (Rust owns
        // the DWM mask + the geometry restore). Called by `open-sel-panel()` so a panel-opening
        // button reachable in immersive does what its label says instead of nothing.
        //
        // v0.8.126 (judge-first k / audit N8): it RETURNS whether immersive was actually left. On
        // the macOS arm the handler refuses while a native-fullscreen transition is in flight, and
        // it did so silently - so the Slint caller dismissed the rotation reminder, left `immersive`
        // true, and the Selection panel's own `!immersive` mount gate swallowed the open. That is
        // the exact C5 bug surviving in the one window C5 could not cover, now with the reminder
        // already gone so there was nothing left on screen to retry from.
        callback exit-immersive() -> bool;
        callback film-recenter();       // v0.8.38 (G7): re-engage the filmstrip's follow-current (position-chip click; Rust sets film_follow)
        callback toggle-sel-panel();    // v0.8.38 (G6): Selection panel toggle w/ top-left exclusivity (keyboard 's' + the title-bar button)
        // v0.8.121 (Round-B fix F10 = audit A19, L26): the modal gate lives on the BODY, not only on
        // the buttons that happen to call it. O8 gated four title-bar invokers; the Picks and Rejects
        // count chips open the SAME panel and were left ungated — and wave 1 had just retitled their
        // tips ("Picks — open Selection") precisely to make that click discoverable. Under a delete
        // confirm, the export sheet or the rotation reminder the panel mounted UNDER the scrim at
        // ~33% brightness, completely inert, its own close × included, with no cue.
        // v0.8.126 (judge-first k / audit N7, ledger L26): the OPEN direction routes through the
        // shared body below. C5 taught `open-sel-panel()` to leave immersive first, but this
        // sibling - the 's' key and the title-bar Selection button - kept its own `!immersive`
        // refusal, so ONE panel had TWO rules and the comment on the shared body still claimed
        // they carried the identical gate. The CLOSE direction stays as it was (there is nothing
        // to leave immersive for when the panel is already shut).
        toggle-sel-panel => {
            if (root.sel-open) {
                if (!root.immersive && !root.modal-blocking) { root.sel-open = false; }
            } else {
                root.open-sel-panel();
                // v0.8.135 (W8, owner rule) - THE GENERIC OPEN LANDS ON THE WORK.
                // The two GENERIC doors into this panel - the `s` key and the title-bar Review
                // button - promise nothing about a category, so they should land on the one the
                // user is in the middle of: "Selected" while a selection exists, the "Reviewed"
                // default otherwise. Anything that PRE-SETS a category keeps landing where it says
                // it will (the rotation reminder sets 4; the Picks/Rejects count chips say "open
                // Review" and mean it), which is exactly why this lives at the toggle and NOT
                // inside `open-sel-panel()`, the body all of them share.
                //
                // AFTER the open and gated on it: that body can refuse (a modal is up, or a macOS
                // fullscreen transition declines the immersive exit), and a refused open must not
                // silently re-file the panel's view for the next time it does open.
                // Through `set-filter`, never `filter-mode` directly - the callback carries the
                // pre-5 memory the A-4 fallback returns to and the rating-filter reconciliation.
                if (root.sel-open) { root.set-filter(root.count-selected > 0 ? 5 : 0); }
            }
        }
        // The panel-OPEN body (as opposed to the toggle above): what the two count chips, the
        // rotation reminder AND the toggle's open direction run. Kept separate on purpose — a chip
        // that reads "open Selection" must not CLOSE it on a second click — but there is one rule
        // for one surface, and since v0.8.126 the toggle really does share this body (L26).
        function open-sel-panel() {
            // v0.8.125 (C5 / the M9 immersive question): this body used to REFUSE while immersive.
            // The rotation reminder mounts IN immersive and offers "Open Selection" as its primary
            // action — so the click closed the reminder and opened nothing, because the panel's own
            // mount gate carries `!immersive`. A button does what it says: leave immersive first,
            // then open. Every invoker of this body inherits it (L26), and the modal gate below is
            // unchanged — the reminder clears its own flag before calling, as its comment states.
            // v0.8.126 (judge-first k / audit N8): the exit can REFUSE (macOS, mid native-
            // fullscreen transition). Opening anyway would set `sel-open` true behind the panel's
            // own `!immersive` mount gate — "the same dead end wearing a true flag", with the
            // reminder already dismissed. On a refusal this is a clean no-op and the reminder
            // stays up to be retried.
            if (!root.modal-blocking && (!root.immersive || root.exit-immersive())) {
                root.welcome-open = false; // v0.8.68 (D-audit FIX 4): the welcome closes first
                root.panel-switch = root.settings-open || root.loading-open;
                root.sel-open = true;
                root.settings-open = false;
                root.loading-open = false;
            }
        }
        // v0.8.93: THE info-panel command — the body the photo right-click menu's info row runs,
        // hoisted to a named callback so any REMOTE surface (the macOS View menu) can drive the
        // IDENTICAL path (single dispatch; ledger L21 — a remote surface's enablement mirrors THIS
        // handler's own gate). It keeps working in COMPARE, which the compare-recovery ruling
        // depends on: the expanded panel really does mount over the A/B split.
        // v0.8.94 (v0.8.93-audit C21): it is INERT while IMMERSIVE, where NEITHER surface mounts
        // (the stub arm and the expanded arm both carry `(!root.immersive || root.chrome-fading)`).
        // Without this the row's state-derived imperative lied twice over: "Show info panel" showed
        // nothing, and the title then flipped to "Minimise info panel", so a second click left the
        // user with the stub on immersive exit — a state they never asked for. This matches the i
        // key's own tested ruling for the same state (support::info_key_action → Nothing while
        // immersive). Remote enablement mirrors THIS gate — see menubar_model::enabled_for.
        callback toggle-info-panel();
        // v0.8.97 (ruling 4): the OFF arm delegates to the shared `restore-panels` body — with the
        // Hidden cell hiding BOTH floating panels, "show it again" has to bring both back, and that
        // decision (including the legacy exception) lives in exactly one tested place. The ON arm is
        // untouched: this row is still the INFO panel's own minimise/expand toggle (per-panel
        // independence — the owner's "each panel's controls stay independent").
        toggle-info-panel => {
            if (!root.immersive) {
                if (!root.info-open) { root.restore-panels(); }
                else { root.info-min = !root.info-min; }
            }
        }
        // v0.8.94 (v0.8.93-audit C14/C20): the info command's TITLE, same treatment. The three
        // strings used to be hardcoded twice — here in the ctx MenuItem and again in Rust
        // (support::info_menu_title, which feeds the macOS View row) — under a doc comment claiming
        // they were "single-sourced". They were not: nothing bound the two copies, so a reworded ctx
        // row would have silently diverged from the View row with every test still green. Now the
        // MenuItem binds to THIS property and the rig pins the property against
        // support::info_menu_title(open, min, raw-open) for every state pair, so a reword on either
        // side fails a test instead of shipping two words for one command. (v0.8.97: the pin gained
        // the raw-open dimension with the plural title below; the seg's own two-way cross-check,
        // which this used to be modelled on, is retired — `sel` now reads a preference nothing else
        // writes, so there is no second language to disagree with.)
        // v0.8.97 (ruling 5): the OFF arm goes PLURAL when both floating panels are hidden, because
        // that is what the command then does (`restore-panels` brings both back). The LEGACY pair —
        // info hidden, develop still visible, reachable only by loading a pre-v0.8.97 settings.json —
        // keeps the singular, because there the command really does restore one panel. The two ON
        // titles are UNCHANGED: they are the info panel's own controls and move only it.
        out property <string> info-cmd-title: !root.info-open
                                            ? (root.raw-open ? @tr("falcon" => "Show info panel") : @tr("falcon" => "Show panels"))
                                            : (root.info-min ? @tr("falcon" => "Expand info panel") : @tr("falcon" => "Minimise info panel"));
        // v0.8.96-audit (owner amendment, 2026-07-26): the Settings → CONTROLS keybind row for the
        // "i" action is STATE-DERIVED as well. Its ACTIONS-table label describes the COMMON case —
        // minimised ⇄ expanded — because fully-off is a rare state the user opts into deliberately;
        // but in that rare state the row would then be describing something the key cannot do from
        // there, so while the panel is OFF the row borrows the ctx-menu's own off-state imperative.
        // NOT a second copy of that string: the off branch READS `info-cmd-title`, which in this
        // exact state IS "Show info panel" (its own first branch) and is already pinned against
        // support::info_menu_title by the rig — so the two surfaces cannot drift by construction.
        // WHY a property and a row conditional rather than a Rust-side label: the CONTROLS rows are
        // a Rust-built static model (support::keybind_rows off the ACTIONS table), rebuilt on keymap
        // events only — it would sit stale while the sheet is open and the user presses i. This
        // binding re-evaluates the moment `info-open` moves, which is the same live-both-ways
        // discipline the DISPLAY seg's `sel` follows.
        out property <string> info-bind-label: !root.info-open
                                             ? root.info-cmd-title
                                             : @tr("falcon" => "Minimise / expand info panel");
        // v0.8.28: LIVE shortcut-peek labels for the context-menu chips. The rebindable ones are composed
        // Rust-side (menu_shortcut → pretty_key) at keymap load AND after every rebind.
        // v0.9.3 (§66): the FIXED chips (copy, delete) + the reveal verb are ALSO Rust-filled, from the
        // platform table (refresh_menu_shortcuts / boot) — were bare Slint defaults/literals. "" → no chip.
        in-out property <string> sc-rotcw;
        in-out property <string> sc-rotccw;
        in-out property <string> sc-zoom;
        in-out property <string> sc-info;
        in-out property <string> sc-full;
        in-out property <string> sc-copy;
        in-out property <string> sc-delete;
        // v0.8.137 (W3): the Ctrl+D / ⌘D cap for both menus' "Clear selection" row. Platform-table
        // sourced like sc-copy (the chord is spelled in the FocusScope, not in ACTIONS).
        in-out property <string> sc-deselect;
        // v0.8.169 (item 4, OWNER): the three MARK rows' caps. REBINDABLE actions — "flag" (p),
        // "reject" (x) and "unflag" (u) in main.rs ACTIONS — so these come from the LIVE keymap
        // through `menu_shortcut`, exactly like `sc-rotcw` above and NOT from a literal (the
        // v0.8.120 O21 lesson: `sc-delete` was pinned to a platform constant while its action was
        // rebindable, and a remapped Delete then taught a dead key).
        in-out property <string> sc-flag;
        in-out property <string> sc-reject;
        in-out property <string> sc-unmark;
        // v0.8.169 (item 5, OWNER): the Select row's cap — "Ctrl / Shift" (⌘ / ⇧ on the Mac arm).
        // Platform-table sourced like sc-copy / sc-deselect: these are MODIFIERS spelled in the
        // FocusScope's own modifier mirror, never in ACTIONS, so `menu_shortcut` cannot supply them.
        in-out property <string> sc-select;
        // v1.0.0-rc (queue item 27, sheet 2.1 B7): the "Select all" row's cap. A FIXED chord like
        // Ctrl+C / Ctrl+D — Ctrl+A is spelled in the FocusScope ladder, not in ACTIONS — so it comes
        // from the platform table through `refresh_menu_shortcuts`, the one publisher of every cap here.
        in-out property <string> sc-select-all;
        // v0.8.184 (D1): the Undo/Redo rows' caps. FIXED chords like Ctrl+C and Ctrl+D — they are
        // spelled in the FocusScope ladder, not in ACTIONS, so `menu_shortcut` cannot supply them
        // and they come from the platform table (the Mac merge is then a table swap, exactly as
        // `sc-copy` / `sc-deselect` are). Unconditional on BOTH menus, which is the v0.8.119
        // doctrine satisfied rather than excepted: `undo()` / `redo()` take no index, so the
        // thumb-vs-current scope question that keeps caps off rotate/delete/copy does not arise,
        // and the row's enablement IS the chord's own arm.
        in-out property <string> sc-undo;
        in-out property <string> sc-redo;
        in property <string> reveal-verb;
        callback copy-shortcut();  // Ctrl+C — copy per the configurable priority (§33)
        // Configurable Ctrl+C copy priority (§33 Settings). The model order IS the priority.
        in property <[CopyPrefRow]> copy-pref-model;
        callback toggle-copy-pref(int);   // flip `enabled` for the pref with this mode
        callback move-copy-pref(int, int); // reorder: from index → to index
        callback open-folder();    // open the native folder picker
        callback undo();           // Ctrl+Z — revert the last rating change
        callback redo();           // Ctrl+Shift+Z / Ctrl+Y — re-apply the last undone change
        callback recover-delete(); // v0.8.37 (FIX A1/A2): restore the just-deleted shot from the OS Recycle Bin (toast Recover button + Ctrl+Z)
        callback retry-detail();   // re-attempt the current shot's failed full-res/EXIF/WB decode (#15)
        callback rebind(string);   // start capturing a new key for this action id
        // Photo menus and keys share one command route, so displayed hints describe
        // the action actually taken on the menu's captured photo/selection.
        in-out property <length> review-backdrop-x;
        in-out property <length> review-backdrop-y;
        in-out property <length> review-backdrop-w;
        in-out property <length> review-backdrop-h;
        in-out property <length> review-grid-x;
        in-out property <length> review-grid-y;
        in-out property <length> review-grid-w;
        in-out property <length> review-grid-h;
        in-out property <length> context-menu-x;
        in-out property <length> context-menu-y;
        in-out property <length> context-menu-w;
        in-out property <length> context-menu-h;
        in property <image> menu-backdrop;
        in-out property <bool> menu-blur-ready: false;
        in property <length> menu-blur-x;
        in property <length> menu-blur-y;
        in property <length> menu-blur-w;
        in property <length> menu-blur-h;
        property <bool> menu-blur-covers: root.menu-blur-ready && root.context-menu-x >= root.menu-blur-x
            && root.context-menu-y >= root.menu-blur-y
            && root.context-menu-x + root.context-menu-w <= root.menu-blur-x + root.menu-blur-w + 0.1px
            && root.context-menu-y + root.context-menu-h <= root.menu-blur-y + root.menu-blur-h + 0.1px;
        changed ctx-open => { root.menu-blur-ready = false; }
        changed sel-ctx-open => { root.menu-blur-ready = false; }
        changed sort-open => { root.menu-blur-ready = false; }
        // A held shortcut must not repeat onto the displayed photo after its menu closes.
        in-out property <bool> menu-key-used: false;
        callback context-stale() -> bool;
        callback menu-action(string, bool) -> bool;
        menu-action(action, via-key) => {
            if (!root.ctx-open && !root.sel-ctx-open) { return false; }
            if (action != "flag" && action != "reject" && action != "unflag"
                && action != "delete" && action != "delete-one" && action != "rotcw" && action != "rotccw"
                && action != "copy" && action != "copy-fin" && action != "copy-raw" && action != "copy-both"
                && action != "rate0" && action != "rate1" && action != "rate2" && action != "rate3"
                && action != "rate4" && action != "rate5" && action != "undo" && action != "redo") { return false; }
            if (via-key) { root.menu-key-used = true; }
            if (root.context-stale()) { root.ctx-open = false; root.sel-ctx-open = false; return true; }
            if (root.modal-open || root.capture-armed) { return true; }
            let target = root.sel-ctx-open ? root.sel-ctx-idx : root.ctx-idx;
            let plural = root.ctx-plural;
            if (action == "flag" || action == "reject" || action == "unflag") {
                if (plural) {
                    if (!root.bulk-actions-armed) { return true; }
                    root.bulk-mark(action == "flag" ? 0 : (action == "reject" ? 1 : 2));
                } else if (action == "flag") { root.sel-toggle-flag(target, true); }
                else if (action == "reject") { root.sel-toggle-reject(target, true); }
                else { if (!root.ctx-flag && !root.ctx-reject) { return true; } root.sel-unmark(target, true); }
            } else if (action == "delete" || action == "delete-one") {
                if (root.opening-photo) { return true; }
                if (plural && action != "delete-one") {
                    if (!root.bulk-actions-armed) { return true; }
                    root.bulk-delete-ask();
                } else { root.delete-shot(target); }
            } else if (action == "rotcw" || action == "rotccw") {
                let turns = action == "rotcw" ? 1 : -1;
                if (plural) {
                    if (!root.bulk-actions-armed) { return true; }
                    root.bulk-rotate(turns);
                } else {
                    if (root.ctx-rotate-blocked) { return true; }
                    root.rotate-shot(target, turns);
                }
            } else if (action == "copy" || action == "copy-fin" || action == "copy-raw" || action == "copy-both") {
                if (root.opening-photo) { return true; }
                let bulk = plural;
                let ranked = root.ctx-rank-mode;
                let mode = action == "copy" ? ranked : (action == "copy-fin" ? 0 : (action == "copy-raw" ? 1 : 2));
                if (mode < 0) { return true; }
                if (bulk) {
                    if (!root.bulk-actions-armed || !(mode == 0 ? root.ctx-bulk-copy-fin-on : (mode == 1 ? root.ctx-bulk-copy-raw-on : root.ctx-bulk-copy-both-on))) { return true; }
                    root.copy-selected(mode);
                } else {
                    if (!(mode == 0 ? root.ctx-has-finished : (mode == 1 ? root.ctx-has-raw : (root.ctx-has-finished && root.ctx-has-raw)))) { return true; }
                    root.copy-files(target, mode);
                }
            } else if (action == "undo" || action == "redo") {
                if (action == "undo") { if (!root.can-cull-undo) { return true; } root.undo(); }
                else { if (!root.can-cull-redo) { return true; } root.redo(); }
            } else {
                let stars = action == "rate0" ? 0 : (action == "rate1" ? 1 : (action == "rate2" ? 2 : (action == "rate3" ? 3 : (action == "rate4" ? 4 : 5))));
                if (root.ctx-rate-armed) {
                    if (via-key) { root.bulk-rate-ask-key(stars); } else { root.bulk-rate-ask(stars); }
                } else {
                    root.sel-set-rating(target, (stars > 0 && root.ctx-rating == stars && (!via-key || root.same-key-clear)) ? 0 : stars, true);
                }
            }
            root.ctx-open = false; root.sel-ctx-open = false;
            return true;
        }
        callback key-typed(string); // a printable key was pressed (rebind capture / hotkey)
        callback basics-locked();      // v0.8.65 (C3/H4): BASIC section Save — Rust abandons a live capture + clears warnings
        callback basics-unlocked();    // v0.8.77 (owner): Edit pressed — Rust snapshots the basics' bindings so Cancel can honestly revert
        callback basics-cancelled();   // v0.8.77 (owner): Cancel pressed — Rust restores the Edit-press snapshot + clears capture/warnings
        callback reset-basic-binds();  // v0.8.65 (C3/H4): restore the BASIC defaults (unlocked mode only)
        callback reset-cull-binds();   // v0.8.156 (C3, ruling Q8+Q32): restore the 17 CONTROLS defaults — the twin of the pill above
        callback open-folder-direct(); // v0.8.65 (C3/M6): the Open… menu's "Folder…" — a true folder picker

        // v0.7.3 GF1/GF2 + v0.8.13: the SINGLE modal-gate predicate. Was hand-mirrored in main.rs's
        // `modal_active`; that twin is DELETED — Rust now reads THIS via `app.get_modal_open()` (one
        // source, no lock-step drift). Covers the settings/loading/export sheets + the confirm dialog
        // (EVERY kind, incl. the v0.8.13 delete popup, via `confirm-kind != 0`) + the rotation close
        // reminder. While one is up, the nav/fullscreen/undo/redo/copy keys below stay swallowed
        // (accept) but INERT, so they can't mutate cull state invisibly behind the scrim. The Selection
        // panel is deliberately NOT in this set — arrows keep working while it is open.
        // v0.8.67 (D): + the welcome panel — while it's up the nav/cull/delete keys below stay
        // swallowed-but-inert (same scrim rule), so first-launch key presses can't mutate state invisibly.
        // v0.8.109 (V6): + the FORGET-a-display confirm. It was covered only transitively, by
        // `settings-open` — but its own scrim starts below the title bar ("title bar stays live"),
        // and the title-bar Settings button TOGGLES `settings-open`, so the parent supplying the
        // guard could be dismissed from OUTSIDE the scrim while a destructive confirm was up, and
        // every gated shortcut below went live behind it. (`wm-del-confirm`/`wm-font-open` get away
        // with not registering because their parent, `export-open`, cannot be closed from the live
        // title bar.) The `changed settings-open` teardown closes it too, so it can never outlive
        // the panel it belongs to.
        // Fullscreen shares the actual-dialog list with editing, but has two narrower
        // exceptions. A ready photo permits fullscreen during discovery on both platforms.
        // On Mac, the welcome guide also permits native fullscreen without entering
        // immersive photo mode (on_toggle_fullscreen keeps the toolbar and traffic lights).
        // Windows fullscreen is immersive, so its welcome guide continues to block it.
        out property <bool> dialog-open: root.about-open || root.settings-open || root.loading-open || root.confirm-kind != 0 || root.export-open || root.rot-reminder-open || root.display-del-confirm || root.assoc-prompt-open;
        out property <bool> modal-open-base: root.opening-boundary-wait || (root.opening-photo && !root.photo-open-edits) || root.dialog-open;
        out property <bool> modal-open: root.modal-open-base || root.welcome-open; // v0.8.67 (D): + welcome. v0.9.16: the assoc popup rides the base.
        // Fullscreen only needs the ready photo, including while waiting at a batch edge.
        // Keep real dialogs and the Windows welcome guide in charge of their input.
        out property <bool> modal-open-fs: root.dialog-open
            || (!root.native-window-controls && root.welcome-open)
            || (!root.photo-ready && (root.opening-boundary-wait || (root.opening-photo && !root.photo-open-edits)));
        // v0.8.120 (design-sweep O8/O9): the SCRIM-BEARING subset of `modal-open` — the modals that
        // draw a full-window scrim ABOVE every panel the title bar's four panel buttons open. Those
        // panels all mount BEFORE the confirm overlay, so clicking the gear / Browse speed /
        // Selection / bell under an open dialog used to raise a full-height glass panel at ~33%
        // brightness that is completely inert, with no cue explaining why.
        //   NOT here, deliberately:
        //   • settings-open / loading-open — they ARE two of those panels; gating on them would
        //     disable the very button that closes them;
        //   • welcome-open — each of these buttons closes the welcome FIRST (v0.8.68 FIX 4), so its
        //     panel lands in front of nothing;
        //   • wm-font-open / wm-del-confirm — reachable only from inside the export sheet, so
        //     `export-open` already covers both.
        //   • the Mac first-launch association popup (v0.9.16) IS here — it draws its own scrim
        //     above every panel, exactly like the confirm overlay.
        out property <bool> modal-blocking: root.about-open || root.confirm-kind != 0 || root.rot-reminder-open || root.export-open || root.display-del-confirm || root.assoc-prompt-open;
        // ── v0.8.155 (D1a, OWNER RULING 1): ONE "A POPUP OWNS THE POINTER" PREDICATE ────────────
        // v0.8.150 (J3) gave the three photo wheels the MODAL gate, which was the right fix for
        // the surface it named (a scrim over the stage) and covers none of the surfaces this ruling
        // is about. A context menu, the sort menu, the Open menu and the events dropdown all mount
        // OVER the photo with a dismiss overlay, and a wheel notch over any of
        // them changed the photograph underneath — which is also how a menu comes to be TARGETING a
        // shot that is no longer current (the frozen-menu case D1b answers).
        //
        // THE ENUMERATION IS THE OWNER'S, re-derived at tip rather than transcribed: ctx, sel-ctx,
        // sort, open-menu, notif (the path menu was a sixth until v0.8.192 retired it — the pill
        // copies on click now and has no menu). Nothing else on this root qualifies — `wm-font-open`
        // and `wm-del-confirm` live inside `export-open` (already in `modal-open`); `settings-open`
        // / `loading-open` / `welcome-open` are in `modal-open` too; `sel-open` and `grid-open` are
        // PANELS the photographer browses from and are deliberately excluded (`modal-open`'s own
        // note: "arrows keep working while it is open"); `toast-show` is a transient card that
        // never owns the pointer.
        //
        // ONE PREDICATE, EVERY GATE — the three wheel handlers read this and nothing else, so a
        // future popup joins all three by being added HERE (L26/L27: derive from the real mount
        // predicates, route through one helper).
        // ── v0.8.155 (D2 / owner ruling Q27): IS THE TOAST CARD COVERED RIGHT NOW? ──────────────
        // The ruled behaviour is that a toast's expiry countdown does not run while a blocking
        // dialog owns the screen — "an offer like Recover can never expire while the user was
        // blocked from clicking it". So the FIRST TWO TERMS answer one physical question: does
        // something paint OVER the toast and swallow its pills? (The third, added by item 30 below,
        // answers a different one and is not about mount order at all.) That is decided by MOUNT
        // ORDER in this file, not by an existing convenience predicate, and the two disagree:
        //   toastcard is at the window root; everything declared AFTER it paints above it —
        //   confirm-kind != 0, rot-reminder-open, export-open, welcome-open, display-del-confirm.
        // `modal-blocking` is the first, second, third and fifth of those and MISSES `welcome-open`
        // (it is excluded there for a reason that is about the title-bar buttons, not about the
        // toast). `settings-open` / `loading-open` are NOT here: those panels mount BEFORE the
        // toast, so the card sits on top of them and stays clickable — which is exactly why the
        // sweep's Q27 note called the toast "fully visible and clickable there". `notif-open` is
        // not here either: opening the events panel DESTROYS the toast (`on_toggle_notif`), so
        // there is never a countdown to freeze. (L27: derive the edges from the real mount
        // predicate, every term.)
        // ── v1.0.0-rc (queue item 30, §1.B / OWNER RULING 2.3a): …AND WHILE THE POINTER IS ON IT.
        // Q27 above froze the seconds the user COULD NOT spend. The ask-first question needs the
        // other half: the seconds they are DEMONSTRABLY spending. A question about twelve
        // photographs that expires under the finger hovering its [Yes] is the same broken promise
        // one layer in, and the freeze is the answer the owner ruled ("agree with the own linger
        // and the freeze while hovered").
        //
        // It applies to EVERY toast, not the ask alone — one card, one countdown, one predicate —
        // so a [Recover] or an [Undo] the pointer is resting on does not expire either.
        //
        // `toast-hovered` is measured, not assumed: see its declaration below the card.
        out property <bool> toast-blocked: root.modal-blocking || root.welcome-open || root.toast-hovered;
        // Is the pointer on ANY part of the visible card — the sentence, the "+N" chip, an action
        // pill, the Yes/No row, the Open Settings row, the ×? One reading, because `tbody` is their
        // common ANCESTOR (see the card's own note). While the card is not `hot` — the enter fade,
        // and after it has gone — `tbody` is disabled and reports no hover, so the ~anim-med of the
        // slide-in is still spent and a card that has left cannot latch the next one's countdown.
        // The first of those is stated rather than fixed: `hot` is the click-steal gate (v0.7.2)
        // and must not move for this.
        out property <bool> toast-hovered: tbody.has-hover;
        out property <bool> menu-open: root.ctx-open || root.sel-ctx-open
                                     || root.sort-open || root.open-menu-open
                                     || root.notif-open;
        out property <bool> popup-open: root.modal-open || root.menu-open;
        // v1.0.6: inspection (zoom, pan, 1:1, Fit) needs only the current photo, never the complete
        // collection. `inspection-blocked` is `modal-open` minus View only's opening term: dialogs and
        // the welcome guide still own input. View only keeps edits on `modal-open`; browsing verified
        // neighbours uses the same narrower input gate as inspection.
        // The Rust callbacks, the Fit key and the Mac menu rows read it. The photo's own pointer surfaces
        // read `photo-popup-open`, which adds the menus, exactly as they read `popup-open` before.
        out property <bool> inspection-blocked: root.dialog-open || root.welcome-open;
        out property <bool> photo-popup-open: root.inspection-blocked || root.menu-open;
        // Modified clicks must not become plain navigation when early multi-selection
        // is unavailable. This is also the real-dialog/menu gate for thumbnail clicks.
        public pure function neighbour-browse-allowed(ctrl: bool, shift: bool) -> bool {
            return !root.photo-popup-open && !(root.opening-photo && (ctrl || shift));
        }
        // v1.0.0-rc (queue item 31, §3.B.2) — THE HOVER PREVIEW'S GATE, COMPOSED ONCE.
        //
        // Five terms, and only one of them is new. `popup-open` above is REUSED VERBATIM — its own
        // ruling says a future consumer joins by reusing it rather than by re-typing its six terms
        // — `sel-open && !immersive` is the Review panel's own mount gate (in immersive the panel is
        // not hidden, it is UNMOUNTED, so the hover source cannot exist), and `!compare` is the one
        // genuinely new term: the panel IS mounted in compare, because compare's drag-to-A/B
        // pipeline starts from these very tiles. Rust reads `app.get_hover_preview_live()` and
        // nothing re-states the five (ledger L26/L27 — the class this codebase has paid for three
        // times). The card's own mount carries it too, so a card can never outlive a popup by a tick.
        out property <bool> hover-preview-live: root.hover-to-preview && root.sel-open
                                             && !root.immersive && !root.popup-open && !root.compare;
        // v0.8.120 (design-sweep Y75): "one title-bar menu at a time", as ONE function instead of a
        // rule two of the bar's ten controls happened to implement. Every title-bar control's
        // `clicked` calls it, the way `welcome-open = false` was rolled out across the same buttons
        // in v0.8.68 FIX 4 — so opening a menu, changing your mind and pressing another bar button
        // can no longer leave the first menu floating over what the second one just opened (with its
        // dismiss overlay eating the next click).
        function close-bar-menus() {
            root.sort-open = false;
            root.open-menu-open = false;
        }
        // v0.8.120 (design-sweep O39): the welcome colour card's own line for an auto-detect /
        // load-profile result. Both failure paths were toast-only, and the toast draws UNDER the
        // welcome scrim — so the panel's one accented "(recommended)" button had no in-panel
        // feedback at all. Rust writes it; cleared on the panel's close edge below so a stale note
        // can never greet the next open.
        in-out property <string> gamut-detect-note: "";
        // v0.8.120 (design-sweep Y74): the cache meter's window-space centre, reported from its own
        // x=0 TouchArea (the absolute-position rule) so the hoisted tooltip twin can centre on it.
        in-out property <length> cache-meter-cx: 0px;

        // v0.8.84 (rig plumbing): the tiplayer's SOLVED frame, exported for tipgeom_tests — the
        // renderer is an anonymous always-mounted window-root Rectangle, so the testing backend's
        // type-name lookup can't reach it; these read the same bindings the compositor renders
        // (display-only mirrors — nothing writes through them).
        out property <length> tip-x: tiplayer.x;
        out property <length> tip-y: tiplayer.y;
        out property <length> tip-w: tiplayer.width;
        out property <length> tip-h: tiplayer.height;

        // v0.8.65 (C3/H4): canonical token for a key event's text. Special keys map to the STABLE
        // token the keymap stores ("Left"/"Right"/"Home"/"End"/"Tab"/"Space"/"Del"); "Del" absorbs
        // Backspace (today's synonym — a rebound delete moves both). Anything else returns the raw
        // text, so printable rebinds ride the same compares. key-token never returns "" for a real
        // key, so an unbound (empty) kb-* property can never false-match an arm.
        // PUA CONTRACT (v0.8.66, C3 audit): the special keys NOT canonicalized here — Up/Down,
        // PageUp/Down, Insert, F-keys — reach `key-typed` (via the capture funnel above) as RAW
        // Slint Private-Use chars (U+E000..=U+F8FF). Rust's capture path (`is_pua_char`) REFUSES
        // them so they can never be bound; if a future basic action needs one, add its token here.
        pure function key-token(t: string) -> string {
            if (t == Key.LeftArrow) { return "Left"; }
            if (t == Key.RightArrow) { return "Right"; }
            if (t == Key.Home) { return "Home"; }
            if (t == Key.End) { return "End"; }
            if (t == Key.Tab) { return "Tab"; }
            if (t == " ") { return "Space"; }
            if (t == Key.Delete || t == Key.Backspace) { return "Del"; }
            return t;
        }
        // How a token reads on a keycap. The token stays English in settings and in every comparison
        // above; only what is drawn is translated (support::pretty_key is the Rust twin).
        pure function key-name(t: string) -> string {
            if (t == "Left") { return @tr("falcon" => "Left"); }
            if (t == "Right") { return @tr("falcon" => "Right"); }
            if (t == "Home") { return @tr("falcon" => "Home"); }
            if (t == "End") { return @tr("falcon" => "End"); }
            if (t == "Tab") { return @tr("falcon" => "Tab"); }
            if (t == "Space") { return @tr("falcon" => "Space"); }
            if (t == "Del") { return @tr("falcon" => "Del"); }
            return t;
        }

        // v0.8.127 (owner report: the MX Master 3S's horizontal tilt) — THE TWO WHEEL MAPPINGS, ONCE.
        //
        // A tilt arrives as a scroll event with delta-x set and delta-y ZERO. All four of this
        // window's scroll handlers read only delta-y through `e.delta-y > 0 ? a : b`, an expression
        // with no "neither" arm — so a tilt in EITHER direction took the false branch: the stage
        // zoomed OUT on a left tilt and a right tilt alike, the compare stage browsed backwards, the
        // filmstrip scrolled backwards, and the watermark shrank. One missing case, four surfaces.
        //
        // These two pure functions ARE that case, stated once (the key-token / fps-frac house
        // pattern). `wheel-nav-dir` answers "which way is this event NAVIGATING", `wheel-zoom-delta`
        // answers "how much is it ZOOMING", and 0 means "not that gesture" in both — a value every
        // consumer treats as inert (the Rust belts on navigate-step / compare-browse / film-scroll /
        // zoom-at, and the two Slint-side guards where there is no Rust receiver).
        //
        // Horizontal wins only when it DOMINATES (|dx| > |dy|), so a diagonal trackpad flick keeps
        // today's vertical behaviour and a pure vertical wheel is byte-identical to the expression
        // each site used to carry. RIGHT = NEXT: the filmstrip runs left-to-right, so tilting right
        // walks forward along it — the spatial order the photographer is already looking at.
        public pure function wheel-nav-dir(dx: length, dy: length) -> int {
            if (abs(dx / 1px) > abs(dy / 1px)) { return dx > 0 ? 1 : -1; }
            if (dy == 0) { return 0; }
            return dy > 0 ? -1 : 1;
        }
        // The zoom half of the same decision. A tilt can never zoom, and "no scroll at all" is not a
        // zoom-out — which is what the bare `e.delta-y > 0 ? in : out` made it.
        public pure function wheel-zoom-delta(dx: length, dy: length) -> float {
            if (abs(dx / 1px) > abs(dy / 1px)) { return 0; }
            return dy / 1px;
        }
        // v0.8.129 (W1-2) — ONE classifier for all four selection surfaces (filmstrip, grid dock,
        // Review-panel tile, stage). Returns -1 when the click is NOT a selection gesture, so every
        // receiver's `else` is today's behaviour, byte-for-byte. The DORMANCY GATE lives here too:
        // in compare and in immersive the selection is fully inert (addendum A-2 — and compare is
        // NOT dormant for free: all three tile surfaces mount AND take input there), and under a
        // modal nothing behind the scrim may mutate state. So no receiver has to remember the rule,
        // and no receiver can implement it differently.
        public pure function sel-gesture-kind(ctrl: bool, shift: bool) -> int {
            if (root.opening-photo || root.compare || root.immersive || root.modal-open) { return -1; }
            if (ctrl && shift) { return 2; }
            if (ctrl) { return 0; }
            if (shift) { return 1; }
            return -1;
        }

        keys := FocusScope {
            // v0.8.65 (C3/H4): the arm ORDER changed — F12/F11/Esc/Enter/Ctrl first (their keys are
            // disjoint from every rebindable token/printable, so relative behaviour is untouched),
            // then ONE capture funnel, then the basic-shortcut arms reading the LIVE kb-* bindings
            // in the positions their hardcoded ancestors held. Conflict refusal (Rust) guarantees a
            // key never matches two arms' bindings.
            key-pressed(e) => {
                // v0.8.129 (W1-2): the Shift-held mirror for the range-origin preview. Written from
                // the LIVE modifier state on every key event (Slint has no ModifiersChanged), which
                // is also why the Shift key's own press is enough to arm it — the modifier state is
                // updated before the event is delivered.
                root.shift-held = e.modifiers.shift;
                root.ctrl-held = e.modifiers.control; // v0.8.133 (D): the Ctrl half of the same mirror
                if (!e.repeat && e.text != Key.Control && e.text != Key.Shift && e.text != Key.Alt && e.text != Key.Meta) { root.menu-key-used = false; }
                // About owns all keyboard input, including an armed Settings key-rebind.
                // It is the topmost overlay; one Escape closes only this card.
                if (root.about-open) { if (e.text == Key.Escape) { root.about-open = false; } accept }
                else if (e.repeat && root.menu-key-used) { accept }
                else if (e.text == Key.F12) { root.toggle-hud(); accept }
                // v0.9.67 (OWNER RULING 08-08 (ii)): `modal-open-fs`, not `modal-open` — the
                // fullscreen action's own gate, which is `modal-open` minus `welcome-open`. Every
                // other arm in this ladder keeps `modal-open`/`popup-open` exactly as it was.
                else if (e.text == Key.F11) { if (!root.modal-open-fs) { root.toggle-fullscreen(); } accept }
                // v0.9.8 (Mac fix, issue 2): the macOS-conventional fullscreen shortcut ⌃⌘F (Control+Meta+F).
                // On the Mac laptop F11 is the SYSTEM "Show Desktop" shortcut, which the OS intercepts before
                // the app sees it (the tester's "blank with a desktop behind it") — we do NOT fight that OS
                // key; instead this alias gives Mac users a working key (the 'f' cull action also toggles
                // fullscreen and works). ⌃⌘F is checked BEFORE the generic Ctrl/Alt reject below (and its
                // modifiers keep it clear of the v0.8.65 capture funnel, which takes PLAIN keys only).
                // v1.0 MERGE TAIL [A-O2]: THE ARM IS macOS-ONLY NOW, and it always should have been.
                // The branch's own comment argued Win+Ctrl+F was "an inert combo (no Falcon binding) —
                // harmless", which reasons about FALCON's other bindings and not about the OS's: on
                // Windows Meta is the Win key and Ctrl+Win+F is a chord the system itself owns. Trunk
                // `c1ff8f8` had no such arm, so the merge would have been the first delivery of a new
                // Windows key binding that no list names. `native-window-controls` is the macOS-only
                // property main() sets once at boot — no cfg needed, and the rig can drive it.
                else if (root.native-window-controls && e.modifiers.control && e.modifiers.meta && (e.text == "f" || e.text == "F")) { if (!root.modal-open-fs) { root.toggle-fullscreen(); } accept }
                // (v0.8.65 C3/H4: the branch's hardcoded Home/End arms moved DOWN into the
                // rebindable kb-first/kb-last arms with the other basics — one dispatch, not two.)
                // Esc cancels an open confirm dialog FIRST (before the global escape action,
                // so it doesn't also exit fullscreen / clear other state). Stays ABOVE the capture
                // funnel so Esc still cancels an armed rebind (escape-pressed owns that).
                else if (e.text == Key.Escape) {
                    // v0.8.120 (design-sweep O9): this ladder is now LITERALLY the reverse of the
                    // markup's mount order, so "innermost first" is a fact rather than an intention:
                    //   language menu > display-del-confirm > wm-del-confirm > wm-font-open > welcome > wm-large >
                    //   export sheet > rotation reminder > file-op confirm.
                    // Two arms moved. (a) The reminder mounts ABOVE the confirm overlay and
                    // double-dims it, yet the confirm was tested first — so with both up Esc closed
                    // the HIDDEN dialog while the visible reminder did not move, i.e. the keypress
                    // read as dead. (b) `welcome-open` sat last; its own note says nothing above it
                    // can open while it is modal, so its position is inert either way — it is
                    // written in its true place so the list reads as one rule, not a rule plus an
                    // exception.
                    // The LANGUAGE dropdown first: it mounts above Settings and closes on any press,
                    // so whenever it is open it is the innermost surface. Esc closes the menu, not
                    // the Settings panel under it.
                    if (root.language-menu-open) { root.language-menu-open = false; }
                    else if (root.display-del-confirm) { root.display-del-confirm = false; }
                    else if (root.wm-del-confirm >= 0) { root.wm-del-confirm = -1; }
                    else if (root.wm-font-open) { root.wm-font-open = false; }
                    // v0.9.16 (Round B): the Mac first-launch assoc popup — Esc = None (declare-only,
                    // the same plain close as its None button; the changed-observer latches shown).
                    // It mounts LAST of all, so under v0.8.120's reverse-mount-order rule it is
                    // tested first among these.
                    else if (root.assoc-prompt-open) { root.assoc-prompt-open = false; }
                    // v0.8.67 (D): Esc == Skip == Done (all the same plain close, no wizard).
                    else if (root.welcome-open) { root.welcome-open = false; }
                    else if (root.wm-large) { root.wm-large = false; root.wm-request-sample(720); }
                    // v0.8.120 (design-sweep O10 / L18): inside the EDITOR, Esc is Cancel — the same
                    // revert-and-return the Cancel button performs, not a silent third behaviour that
                    // keeps every edit and closes the sheet.
                    else if (root.export-open && root.export-mode == 1) { root.export-editor-cancel(); }
                    else if (root.export-open) { root.export-open = false; }
                    else if (root.rot-reminder-open) { root.rot-reminder-open = false; }
                    // v0.8.187 (W1 ii): Esc is a THIRD door out of the collision modal, so it owes
                    // the same drop the modal's own Cancel makes (L26 — an obligation only one
                    // invoker honours is not an obligation). v0.8.187 (X13): …and the same RETURN,
                    // for the same reason — Esc on this modal is a Cancel, and a Cancel here means
                    // "back to the sheet".
                    else if (root.confirm-kind != 0) { if (root.confirm-kind == 8) { root.export-collide-cancel(); root.export-open = true; } root.confirm-kind = 0; }
                    else { root.escape-pressed(); }
                    accept
                }
                // Enter confirms the confirm dialog — but for the destructive Move (kind 2) AND the
                // Empty-to-Recycle-Bin (kind 3) it maps to Cancel, so a stray Enter can never trigger a
                // destructive op (error prevention). Only the non-destructive copy (kind 1) confirms.
                // v0.8.38 (G5): Enter on the delete-preset confirm CANCELS (dismisses) it — matching the
                // destructive confirm dialogs ("Enter never destroys"). Innermost, so it wins like Esc.
                // v0.8.108: the display-forget confirm joins the same rule — Enter DISMISSES it.
                else if (e.text == Key.Return && root.display-del-confirm) { root.display-del-confirm = false; accept }
                else if (e.text == Key.Return && root.wm-del-confirm >= 0) { root.wm-del-confirm = -1; accept }
                else if (e.text == Key.Return && root.rot-reminder-open) {
                    // v0.8.120 (design-sweep O25): the SAME body as the reminder's own "Open
                    // Selection" button — two invokers of one promise (L26), so both land on the
                    // Rotated filter. The default Reviewed filter excludes rotation-only shots, so
                    // the reminder's "Review them in the Selection panel" used to open on the big
                    // "Nothing reviewed yet." empty state.
                    // v0.8.122 (M9 = the v0.8.121 verify's seam finding): through the SHARED
                    // `open-sel-panel()` body, like every other invoker (L26). ORDER MATTERS:
                    // `rot-reminder-open` is one of the four terms in `modal-blocking`, and
                    // `open-sel-panel()` refuses while that is set — so the reminder must be
                    // cleared BEFORE the call or the dialog's own primary button self-refuses.
                    root.set-filter(4); root.sel-rating-filter = -1;
                    root.rot-reminder-open = false; root.open-sel-panel();
                    accept
                }
                else if (e.text == Key.Return && root.confirm-kind != 0) {
                    // v0.8.132 (OQ1 rule 2): Enter is the SECOND door into the copy, so it mirrors
                    // the button's own gate (L21/L26 — an enablement that only one invoker honours
                    // is not an enablement). Rust re-checks besides.
                    if (root.confirm-kind == 1 && root.count-out-col1 > 0) { root.copy-picks(root.copy-content); }
                    // v0.8.187 (W1 ii): …and Enter is the FOURTH. Kind 8 is in the `>= 2` family,
                    // i.e. Enter CANCELS it — a stray Return must never overwrite a photograph's
                    // deliverable, which is exactly the rule this arm exists to keep. X13: a cancel
                    // is a cancel on every door, so this one returns to the sheet as well.
                    if (root.confirm-kind == 8) { root.export-collide-cancel(); root.export-open = true; }
                    if (root.confirm-kind >= 2) { root.confirm-kind = 0; }
                    accept
                }
                // Ctrl+Shift+Z or Ctrl+Y → redo (checked BEFORE plain Ctrl+Z, since Ctrl+Shift+Z also
                // carries text "Z" + control). Intercepted before key-typed like undo.
                // popup-open, not modal-open: undo/redo JUMP `current` to the edited shot
                // (show_or_say), so under an open menu they are nav keys in disguise — the
                // same class the eight nav arms close (post-verify catch, v0.8.161).
                else if (e.modifiers.control && e.modifiers.shift && (e.text == "z" || e.text == "Z")) { if (!root.menu-action("redo", true) && !root.popup-open) { root.redo(); } accept }
                else if (e.modifiers.control && (e.text == "y" || e.text == "Y")) { if (!root.menu-action("redo", true) && !root.popup-open) { root.redo(); } accept }
                // Ctrl+Z → undo the last rating (intercepted before key-typed so it can't
                // also fire the plain "z" = reset-zoom binding).
                else if (e.modifiers.control && (e.text == "z" || e.text == "Z")) { if (!root.menu-action("undo", true) && !root.popup-open) { root.undo(); } accept }
                // Ctrl+C → copy per the configurable priority (§33). Intercepted before key-typed so it
                // can't also fire the plain "c" = compare binding (same shape as the Ctrl+Z-before-"z" case).
                // AUDIT 08-18 L2 (recorded, deliberately UNRULED): this arm carries no `!e.modifiers.shift`
                // term — unlike Ctrl+A and Ctrl+D below — so Ctrl+SHIFT+C is an unadvertised ALIAS of
                // Ctrl+C and, from v0.8.194, copies the selection through the same armed branch. Left
                // exactly as it is: whether the alias is kept or gated is the owner's call, and changing
                // it here would retire a chord some hands may already use, unannounced.
                else if (e.modifiers.control && (e.text == "c" || e.text == "C")) { if (!root.menu-action("copy", true) && !root.modal-open) { root.copy-shortcut(); } accept }
                // v0.8.129 (W1-2): Ctrl/Cmd+A = select every DISPLAYED photo. It sits WITH the other
                // Ctrl chords (the house pattern) and therefore ABOVE the capture funnel, so it must
                // state the capture gate itself: while a rebind is listening, no chord may act. The
                // rest is spec R-D's exact predicate — not in compare, not immersive, no modal — and
                // it deliberately DOES fire with the Review panel open: that panel is a selection
                // surface, and Ctrl+A there means "everything this panel is showing". `!shift` keeps
                // Ctrl+Shift+A free for a future arm rather than folding it in silently.
                else if (e.modifiers.control && !e.modifiers.shift && (e.text == "a" || e.text == "A")) {
                    if (!root.modal-open && !root.capture-armed && !root.compare && !root.immersive) { root.select-all-displayed(); }
                    accept }
                // v0.8.135 (W9): Ctrl/Cmd+D = DESELECT ALL - Ctrl+A's inverse, in the chord family
                // beside it and under the identical gate (verified free: no other arm in this
                // FocusScope, no menu row and no rebindable action claims D with Control). It goes
                // through `clear-selection`, the ONE clearing body - so it inherits the A-4 category
                // fallback and the >=3 Restore offer that every other clearing route already has,
                // and a Ctrl+D with nothing selected is the same silent no-op the handler gives the
                // menus. `sel-affordance-live`'s three terms are spelled out here for the same
                // reason Ctrl+A spells them: a chord sits ABOVE the capture funnel, so it must state
                // the capture gate itself.
                else if (e.modifiers.control && !e.modifiers.shift && (e.text == "d" || e.text == "D")) {
                    if (!root.modal-open && !root.capture-armed && !root.compare && !root.immersive) { root.clear-selection(); }
                    accept }
                // v0.8.65 (C3/H4): the ONE capture funnel — while a rebind is listening, every PLAIN
                // (unmodified) key routes to Rust as its canonical token, which validates (single
                // printable OR a basic token; garbage keeps the row listening), runs the J5-3
                // conflict check, and commits or refuses. Modified combos fall through exactly as
                // before (a modified key was never capturable); F12/F11/Esc/Enter keep their arms
                // above, so dev-HUD / cancel behave identically while a capture is armed.
                else if (root.capture-armed && !e.modifiers.control && !e.modifiers.alt) { root.key-typed(root.key-token(e.text)); accept }
                // ── v0.8.160 (B1/U8): EVERY NAV ARM BELOW READS `popup-open`, NOT `modal-open`. ──
                // D1a gated the three photo WHEELS on `popup-open` and left these keys on
                // `modal-open`, which contains NONE of the menu/dropdown surfaces (six then, five
                // since v0.8.192 retired the path menu). So Home, End,
                // the arrows and compare's Tab/Space could walk `current` out from under an open
                // context menu — and a context menu captures its target index when it opens, so this
                // is the frozen-menu case D1b exists to apologise for, still being manufactured.
                // (Two more wrongs rode on it: the stage menu's ★3 arm computes toggle-off from the
                // FROZEN rating, and the Flag row's checkmark is frozen while its action polarity is
                // live. Both become unreachable when `current` cannot move under the menu.)
                // The predicate already existed; the wheel gates' own comment already promised nav
                // parity; this is that promise, kept. DISPATCH SEMANTICS ARE UNTOUCHED — the arms
                // still `accept`, so a gated key is swallowed-but-inert exactly as under a modal.
                // Menus are deliberately NOT closed on a `cur-idx` change: an indexed menu outliving
                // the current shot is the RULED D1b flow (the notifier names the target instead).
                //
                // Browse prev/next — the LIVE bindings (default ← / →; a printable rebind lands here
                // too, ahead of key-typed, so hold-to-scrub + release semantics ride along).
                else if (root.key-token(e.text) == root.kb-next) { if (!root.photo-popup-open) { root.navigate(1); } accept }
                else if (root.key-token(e.text) == root.kb-prev) { if (!root.photo-popup-open) { root.navigate(-1); } accept }
                // v0.8.52 (owner fix 3): Up/Down = current shot ± one grid ROW, active ONLY while the
                // grid dock is mounted (open, not immersive, not empty) — the gate lives in the CONDITION,
                // so with the dock closed both keys fall through to key-typed exactly as before. NOT
                // rebindable (a grid-gated compound arm, not a single action — the BASIC section lists
                // them as an informational row). Row step = the LIVE column count; clamped at the folder
                // ends; routed through sel-jump (the discontinuous-jump path: primes G3 + recentres).
                else if (e.text == Key.UpArrow && root.grid-open && !root.immersive && !root.empty-state) {
                    if (!root.photo-popup-open) {
                        if ((root.opening-boundary-wait && root.opening-wait-dir < 0) || (root.opening-before && root.cur-idx < root.grid-cols)) { root.grid-boundary-step(-1); }
                        else { root.sel-jump(max(0, root.cur-idx - root.grid-cols)); }
                    } accept }
                else if (e.text == Key.DownArrow && root.grid-open && !root.immersive && !root.empty-state) {
                    if (!root.photo-popup-open) {
                        if ((root.opening-boundary-wait && root.opening-wait-dir > 0) || (root.opening-after && root.cur-idx + root.grid-cols >= root.count-all)) { root.grid-boundary-step(1); }
                        else { root.sel-jump(min(root.count-all - 1, root.cur-idx + root.grid-cols)); }
                    } accept }
                // v0.8.38 (G6): first / last shot through the SAME discontinuous-jump path the
                // filmstrip / Selection list use (default Home / End — live bindings).
                else if (root.key-token(e.text) == root.kb-first) { if (!root.popup-open) { root.sel-jump(0); } accept }
                else if (root.key-token(e.text) == root.kb-last) { if (!root.popup-open) { root.sel-jump(root.count-all - 1); } accept }
                // Compare-mode keyboard parity (#7): swap the active half / toggle its pin (default
                // Tab / Space — live bindings). Accepted so Tab doesn't drive Slint focus traversal.
                // v0.8.120 (design-sweep Y42): a gate at all — these two were the only FocusScope
                // action arms without one, while their macOS menu twins carry it. Tab under a modal
                // swaps the active half, which also moves `current`, so the app's current shot, the
                // EXIF/rating target and the filmstrip centring all changed behind a scrim every
                // other key is blocked from touching. (v0.8.160: `popup-open`, with the rest.)
                else if (root.compare && root.key-token(e.text) == root.kb-cmpswap) { if (!root.popup-open) { root.compare-set-active(root.cmp-focus == 0 ? 1 : 0); } accept }
                else if (root.compare && root.key-token(e.text) == root.kb-cmppin) { if (!root.popup-open) { root.compare-toggle-pin(root.cmp-focus); } accept }
                // v0.7.3 GF3: a Ctrl/Alt-modified key must never reach cull dispatch —
                // Ctrl+1 rated the photo, Ctrl+X toggled reject. (Ctrl+C/Z/Y are handled
                // above; plain unmodified keys flow to key-typed exactly as before.)
                else if (e.modifiers.control || e.modifiers.alt) { reject }
                // v0.8.13: an UNMODIFIED delete key opens the "Delete photo?" popup (default Del —
                // key-token folds Backspace into "Del", today's synonym, so both follow the binding).
                // Fires ONLY while this scope holds focus, so a TextInput being typed into never
                // reaches it (same gate as 'r'/'x'); Rust re-checks shot/modal/compare before it opens.
                else if (root.key-token(e.text) == root.kb-del) { root.delete-key(); accept }
                else { root.key-typed(e.text); accept }
            }
            key-released(e) => {
                root.shift-held = e.modifiers.shift; // v0.8.129: the other half of the mirror
                root.ctrl-held = e.modifiers.control; // v0.8.133 (D): ...and its Ctrl twin, both halves
                if (root.key-token(e.text) == root.kb-next || root.key-token(e.text) == root.kb-prev) { root.nav-released(); accept }
                else { reject }
            }
            // v0.9.21 (item 1): while the NAV scope holds focus, composed IME input is OFF — with
            // macOS Pinyin active the OS otherwise composes every unmodified printable key and the
            // text-matched arms above starve ("keyboard dead under CJK input"). Every panel-close
            // path re-focuses this scope (the keys.focus() observers below), so this also UNDOES a
            // text field's IME re-enable the moment editing ends. Observer lives on the component
            // that OWNS has-focus (the observer-on-the-owner rule). Rust body: no-op on Windows.
            changed has-focus => { if (self.has-focus) { root.set-ime(false); } }
        }

        // Restore keyboard focus to the nav scope when a sheet that holds a TextInput closes (the
        // watermark/preset-name fields in the export sheet; the res-limit/bench-MP/custom-fps fields in
        // settings). A focused TextInput is destroyed when its sheet hides, so focus is otherwise lost —
        // the wheel (a TouchArea) keeps working but arrow-key nav goes dead until `keys` is re-focused.
        // v0.8.132 (OQ1, L18): …and the second half of this edge — every open of the web sheet
        // starts the rejected-photographs toggle at its category's default, never at whatever the
        // last open left behind in a dialog the user may well have cancelled. ONE observer per
        // property (the engine rejects a second `changed export-open` outright), so the reset rides
        // the focus restore that was already here.
        changed export-open => {
            if (!root.export-open) { keys.focus(); }
            // Both run-scoped answers reset on the open edge. The rejects answer retains its
            // category default; the RAW-only source always starts at Skip (owner 2026-09-09),
            // including a later set in which the RAW-only row is not mounted.
            if (root.export-open) { root.include-rejects = root.include-rejects-default; root.raw-export-mode = 0; }
        }
        // v0.8.132 (OQ1, L18): the copy confirm's half of the same edge. Observers rather than the
        // handful of opener sites, because the openers are not a closed set — `confirm-kind = 1` is
        // written from the panel button here, `export-open` from Rust (`open-export`), and both will
        // grow callers. The property's OWNER carries the observer (the house rule), which is what
        // makes the pair total. The counts do not lurch at the open: while both surfaces are closed
        // the tick already publishes under this SAME default (support::include_rejects_effective).
        changed confirm-kind => { if (root.confirm-kind == 1) { root.include-rejects = root.include-rejects-default; } }
        // v0.8.120 (design-sweep Y47): the editor subtree unmounts on Cancel AND on the Rust save
        // path WITHOUT closing the sheet, so `changed export-open` fired for neither — a focused
        // preset-name TextInput was destroyed and focus went nowhere: Esc dead, arrow-scrub dead,
        // every hotkey dead until the sheet was closed by mouse; on macOS `set_ime_allowed(true)`
        // was likewise never undone for the rest of the sheet's life. One observer on the property's
        // OWNER covers every route in and out of the editor (the L22 pattern).
        // v0.8.120 (design-sweep O10): the same edge ARMS the staged-edit snapshot — entering the
        // editor is the last moment the pre-edit wm-*/out-* state still exists.
        changed export-mode => {
            if (root.export-mode == 1) { root.export-editor-open(); }
            keys.focus();
        }
        // v0.8.119 (design-sweep O11): the preset-name trim check. The observer lives on the
        // component that OWNS the property (the house rule), which is also what makes it total:
        // the editor's TextInput is `text <=> root.wm-preset-name`, so typing, the pencil
        // pre-fill, Cancel, Save and any Rust write all pass through here.
        changed wm-preset-name => { root.wm-name-changed(self.wm-preset-name); }
        changed settings-open => {
            // v0.8.109 (V6): the display-forget confirm is transient panel state, torn down with the
            // panel like every other — it is launched from a Settings section and has no meaning
            // without it.
            if (!root.settings-open) { root.display-del-confirm = false; root.language-menu-open = false; keys.focus(); root.settings-closed(); }
            else {
                root.refresh-assoc(); // re-read the live registry state (W1)
                // v0.8.107 (owner ruling D1): the colour card opens on the display THIS WINDOW
                // IS ON, every time Settings is opened — "adjust the screen I'm on" is the common
                // case, and a stale expansion from three sessions ago is not a preference. The
                // observer lives on the component that OWNS `settings-open` (the house rule).
                root.reset-display-expansion();
                // v0.8.169 (item 6, OWNER RULING): the legacy dev fold is COLLAPSED on every open.
                // Same reasoning as the display expansion one line up — a fold the owner opened to
                // check one lever is not a preference, and the whole point of the ruling is that
                // these rows stop being the first thing the DEVELOPER section shows.
                // v1.0.0-rc (queue item 33, OWNER RULING 2.4b): the one fold is now TWO, and the
                // ruling extends to BOTH unchanged in reason — a fold left open is still not a
                // preference, and two folds that reset differently would be a second rule to
                // remember for no gain. What makes a collapsed fold honest about its contents is
                // the "· N changed" suffix each header now carries (the F5-4 half of the split).
                root.dev-advanced-open = false;
                root.dev-legacy-open = false;
            }
        }
        // N23) the speed popup holds the custom-fps TextInput; without this, closing it by click-away/X
        // orphans focus and every key (arrow scrub, Esc, hotkeys) goes dead until Settings/Export cycle.
        changed loading-open => { if (!root.loading-open) { keys.focus(); } }
        // v0.8.67 (D): ANY close of the welcome panel (Skip / Done / Esc / the footer link) latches
        // the persisted shown-once flag — one observer instead of four close sites (the property is
        // owned HERE, per the observer-on-the-owner rule). Re-latching true on a "Show welcome"
        // reopen+close is a harmless no-op. keys.focus() mirrors the other overlay closes.
        // v0.8.76: Rust now latches onboarding-shown TRUE at boot-show (persist-at-show — an exit
        // with the panel still open used to flush false and the welcome returned every launch), so
        // the latch here is a redundant no-op KEPT deliberately: keys.focus() is load-bearing on
        // close, and the belt-and-braces latch costs nothing.
        // v0.8.120 (design-sweep O39 / L22): + the welcome's detect note dies with the panel it
        // lives in. Without it, a failure from one session's welcome would be the first thing the
        // NEXT open showed, above a "Now:" line that may since have become true. Folded into the
        // EXISTING observer because Slint allows one `changed` handler per property per component.
        changed welcome-open => { if (!root.welcome-open) { root.onboarding-shown = true; root.gamut-detect-note = ""; keys.focus(); } }
        // v0.8.84 (the G11 unmount class, exactly the immersive-edge lesson): closing the Selection
        // panel while the XMP toggle is hovered unmounts xmpta — `changed has-hover` never fires on
        // an unmount, so the positioned tip would stick on screen with nothing hosting it. EVERY
        // close route (the header ×, the title-bar Selection button's exclusivity flip, the S key,
        // panel switches) flips this ONE property, so one owner-side observer covers them all.
        // Ownership compare on the text (a sentinel host may already own the channel); cy resets
        // unconditionally (it belongs to the sole positioned host — see the Tip global's contract).
        changed sel-open => {
            if (!root.sel-open) {
                if (Tip.text == root.xmp-tip) { Tip.text = ""; }
                Tip.cy = 0px;
                // v1.0.0-rc (queue item 31, §3.A.5): the panel's own unmount destroys every tile
                // TouchArea at once, and a destroyed TouchArea never fires `changed has-hover` (L22).
                root.sel-hover-idx = -1;
            }
        }
        // v0.9.16 (Round B): ANY close of the assoc popup (a choice button / Esc / any future route)
        // latches the persisted shown-once flag. v0.9.20: Rust now latches assoc-prompt-shown TRUE at
        // BOOT the instant the popup is armed-or-opened (persist-at-show — the onboarding_boot
        // pattern; see main.rs's `assoc_boot`), so this is a redundant belt-and-braces latch, kept
        // because keys.focus() is load-bearing on close (the welcome-open observer precedent exactly).
        changed assoc-prompt-open => { if (!root.assoc-prompt-open) { root.assoc-prompt-shown = true; keys.focus(); } }
        // ── v0.7.0 window chrome: ONE clipping root that rounds the app window's 4 corners. ──
        // The Window itself is transparent; this rect paints the base surface and clips ALL
        // content to a 16px rounded rect — square when maximized/immersive (the OS owns those
        // shapes). Children keep their original indentation (Slint ignores indentation).
        winroot := Rectangle {
        width: 100%; height: 100%;
        // v0.9.11: a decorated macOS window OWNS its shape — the frame's corner mask rounds the
        // content and the OS draws the shadow — so Falcon's 16px arc would DOUBLE-round there
        // (ours inside the system's). native-window-controls joins chrome-square in the square
        // set; Windows (false) keeps the v0.7.0 arc byte-identically.
        border-radius: (root.chrome-square || root.native-window-controls) ? 0px : Theme.radius-window;
        clip: !(root.chrome-square || root.native-window-controls); // no clip layer when the OS owns the window shape
        background: Theme.base;

        VerticalLayout {
            // ── title bar SLOT (M6, v0.8.19) ── geometry only: mount-culls on the immersive
            // bool (exactly the v0.8.18 condition) so the stage reflows the SAME frame immersive
            // flips; the bar's pixels + input live in the hoisted overlay after the filmstrip.
            if !root.immersive : Rectangle { height: root.content-top; }

            // ── v0.8.50 (G1): the stage row — [grid dock | photo stage] ──
            // The dock is honest LAYOUT (the stage shrinks; nothing overlays photos — the
            // owner mount rule). It never touches a window corner (44px title bar above,
            // 102px filmstrip below), so the winroot 16px arc is untouched by construction.
            HorizontalLayout {
                vertical-stretch: 1;
                if root.grid-open && !root.immersive && !root.empty-state : griddock := Rectangle {
                    width: root.grid-dock-w;
                    background: Theme.base; // the dock is chrome (the filmstrip's surface), not stage
                    clip: true; // layouts don't clip — the dock must (live rows ride grid-win-y past both edges)
                    // v0.8.129 (W1-5): the dock's BACKGROUND is the grid's genuine empty space — a
                    // click here reached no handler at all before this. Declared BEFORE the Flickable
                    // so every tile (declared after) still wins its own hits; what is left to this
                    // area is the padding, the inter-tile gutters and everything past the last row.
                    // Compare keeps its own click grammar (A-2), and the dock is unmounted in
                    // immersive by its own gate, so `!compare` is the whole condition here; the Rust
                    // handler is the real gate (it also owns the fallback + the recovery toast).
                    TouchArea { clicked => { if (!root.compare) { root.clear-selection(); } } }
                    Flickable {
                        interactive: false; // wheel-only (the Selection panel's posture) — press-drag stays free for drag-to-compare
                        viewport-width: self.width;
                        viewport-height: root.grid-virtual-h;
                        viewport-y <=> root.grid-vp-y;
                        init => { root.grid-vp-h = self.height; }
                        changed height => { root.grid-vp-h = self.height; }
                        Rectangle {
                            y: root.grid-win-y;
                            x: 0; width: 100%; height: 1px; // a positioning anchor only (children overflow by design; the dock clips)
                            for item[i] in root.grid-items : GridThumb {
                                x: 8px + Math.mod(i, root.grid-cols) * 128px; // 120px tile + 8px gap — the filmstrip pitch
                                y: Math.floor(i / root.grid-cols) * 88px;     // 80px tile + 8px row gap
                                width: 120px; height: 80px;
                                item: item; cur-idx: root.cur-idx; edits-enabled: !root.modal-open;
                                preview: root.sel-preview; // v0.8.129 (W1-3): the Shift range-origin preview
                                ctrl-preview: root.sel-ctrl-preview; // v0.8.133 (D): ANDed with this tile's own hover inside the component
                                // v0.8.129 (W1-2): the HOST classifies the click through the one
                                // shared function and routes — gesture, or the jump it always was.
                                clicked-with(ctrl, shift) => {
                                    if (item.pending) { if (root.neighbour-browse-allowed(ctrl, shift)) { root.sel-jump(item.idx); } }
                                    else if (root.sel-gesture-kind(ctrl, shift) >= 0) { root.sel-gesture(item.idx, root.sel-gesture-kind(ctrl, shift), false); }
                                    else if (root.neighbour-browse-allowed(ctrl, shift)) { root.sel-jump(item.idx); }
                                }
                                toggle-flag => { root.sel-toggle-flag(item.idx, false); }
                                toggle-reject => { root.sel-toggle-reject(item.idx, false); }
                                // right-click → the FULL stage/film context menu, target-scoped to this
                                // tile (the filmstrip right-click pattern: ctx-y is stage-relative).
                                ctx(x, y) => {
                                    root.ctx-target = item.idx;
                                    root.ctx-populate(item.idx);
                                    root.ctx-x = x;
                                    root.ctx-y = y - (root.content-top);
                                    root.ctx-open = true;
                                    root.settings-open = false;
                                    root.loading-open = false;
                                }
                                // drag-to-compare — the SHARED sel-drag pipeline (SelTile wiring verbatim)
                                drag-start => { if (!root.opening-photo && !root.photo-popup-open) { root.sel-drag-idx = item.idx; root.sel-drag-thumb = item.thumb; root.sel-drag-zone = -1; root.sel-dragging = true; } }
                                drag-move(x, y) => { if (root.sel-dragging) { root.sel-drag-x = x; root.sel-drag-y = y; root.sel-drag-zone = root.drop-zone-at(x, y); } }
                                drag-end => { if (root.sel-dragging && !root.opening-photo && root.sel-drag-zone >= 0) { root.sel-to-compare(root.sel-drag-idx, root.sel-drag-zone); } root.sel-dragging = false; root.sel-drag-zone = -1; }
                            }
                        }
                    }
                    // v0.8.52 (owner fix 1): the HIDE-grid proximity LANE — the dock's 8px RIGHT pad
                    // (was the LEFT pad in v0.8.50; the hide pill anchors at the dock/stage boundary
                    // now, so proximity belongs to that flank). Declared BEFORE the seek bar so the
                    // bar keeps winning its hits when mounted (the lane then covers the bar-less
                    // state — a fitting grid — while the stage TA's left band covers the boundary's
                    // stage flank in every state). Tiles end at width−8, so this steals nothing.
                    // v0.8.135 (W2b): ...AND IT CLEARS, like the dock background it covers. This
                    // lane is declared AFTER the Flickable, so it occluded the dock's own
                    // clear-selection area (declared BEFORE it) for the full height of the right
                    // 8px — an 8px column that looks exactly like dock background and answered
                    // nothing. The scrollbar that replaces it when the grid is scrollable is
                    // deliberately NOT given this: a click there SEEKS, which is a control acting,
                    // not empty space [VD — stated rather than silently generalised].
                    TouchArea {
                        x: parent.width - 8px; width: 8px; height: 100%;
                        changed has-hover => { root.dock-lane-hot = self.has-hover; }
                        clicked => { if (!root.compare) { root.clear-selection(); } }
                    }
                    // RIGHT-edge mini scrollbar — `MiniVBar` (widgets.slint), the filmstrip's top
                    // seek bar rotated vertical (4px track / proportional accent thumb / press+drag
                    // seek). Pure UI: seeking writes grid-vp-y directly (the Flickable mirror);
                    // hidden when the whole grid fits. Declared AFTER the Flickable so the band wins
                    // hits — which is exactly why it must fit INSIDE the dock's 8px right pad (audit
                    // YELLOW fix: a 12px band overhung the rightmost tile column by 4px, x 380..384,
                    // and stole that strip's clicks/drag-starts/hover whenever the grid was
                    // scrollable; tiles end at 384, so an 8px band at x 384.. clears them
                    // completely).
                    // v1.0.0-rc (item 37): the forty lines that used to stand here ARE that component
                    // now — the Review panel asked for the same bar, and the arithmetic lives in one
                    // place so the two cannot drift. Behaviour is unchanged by construction (the same
                    // expression over the same three inputs) and pinned by
                    // `the_dock_grids_migrated_bar_seeks_exactly_as_its_inline_copy_did`.
                    // NOT SNAPPED, deliberately, unlike the Review panel's mount: this x is
                    // `parent.width − 8px` over a Rust-driven `grid-dock-w` of 128n + 8, always even,
                    // so the band's origin is already whole at every field scale — L46's parity story,
                    // already ruled for this dock.
                    if root.grid-virtual-h > root.grid-vp-h : MiniVBar {
                        x: parent.width - 8px; width: 8px; height: 100%;
                        vp-h: root.grid-vp-h; content-h: root.grid-virtual-h; vp-y: root.grid-vp-y;
                        seek(y) => { root.grid-vp-y = y; }
                    }
                    // dock ↔ stage divider (the filmstrip's hairline grammar)
                    // v0.8.191 (H4): a COLUMN tie, and it read HEAVY, not thin. `grid-dock-w` is
                    // Rust-driven 128n + 8 — always even — so this x is always ODD and its device
                    // column always half-integer: a 1.5-device-wide AA-off fill from a .5 origin
                    // covers TWO whole columns (33% heavy) beside a stage of AA'd chrome. Columns
                    // are never mirrored, so unlike the rules above it was stable — stably wrong.
                    // Vertical = the same hairline rotated a quarter turn (glyphs.slint).
                    dockdiv := AaHairline { x: parent.width - 1px; width: 1px; height: 100%; vertical: true; tint: Theme.divider; }
                }

            // ── image stage ──
            stage := Rectangle {
                vertical-stretch: 1;
                background: Theme.stage;
                clip: true;
                if !root.compare : Image {
                    source: root.photo;
                    image-fit: contain;
                    width: root.img-w;
                    height: root.img-h;
                    x: root.img-x;
                    y: root.img-y;
                }
                // Adaptive hi-res tile of the zoomed-in region, drawn over the (upscaled)
                // base photo. Its rect is the region's place within the image, so it tracks
                // pan/zoom exactly; image-fit:fill is distortion-free (tile aspect == rect aspect).
                if !root.compare && root.region-active : Image {
                    source: root.region-photo;
                    image-fit: fill;
                    x: root.img-x + root.region-u0 * root.img-w;
                    y: root.img-y + root.region-v0 * root.img-h;
                    width: (root.region-u1 - root.region-u0) * root.img-w;
                    height: (root.region-v1 - root.region-v0) * root.img-h;
                }
                if !root.compare : TouchArea {
                    // set once the press moves past a small threshold → it's a pan, not a
                    // click, so the release must NOT toggle the 1:1 zoom.
                    property <bool> dragged: false;
                    // v0.8.33 (M8): corner reveal hot-zones — pure hover geometry off the stage
                    // pointer (the PREFERRED route: NO new hit surface). `self.mouse-x/y` are
                    // stage-relative (this TA fills the stage); guarded on has-hover so a stale
                    // position never counts. Pushed to root; the tick's linger countdown consumes them.
                    property <bool> br-hot: self.has-hover
                        && self.mouse-x >= parent.width - Theme.reveal-zone-w
                        && self.mouse-y >= parent.height - Theme.reveal-zone-h;
                    property <bool> bl-hot: self.has-hover
                        && self.mouse-x <= Theme.reveal-zone-w
                        && self.mouse-y >= parent.height - Theme.reveal-zone-h;
                    // v0.9.69 (OWNER RULING §8b): the v0.9.67 TOP-edge band is gone — see the
                    // property block's retirement note. The two CORNER zones above stay exactly as
                    // v0.8.33 wrote them; this deletes a mac-only band that was inert on Windows.
                    changed br-hot => { root.chip-corner-hot = self.br-hot; }
                    changed bl-hot => { root.raw-corner-hot = self.bl-hot; }
                    // v0.9.12 (C2/M11): report the stage-local cursor to Rust so the macOS pinch-gesture
                    // arm can anchor zoom at the cursor (winit's PinchGesture carries no position). mouse-x/y
                    // update continuously while hovering (same source br-hot reads), so `changed` fires on
                    // every move. The Rust side just stores two floats in a Cell — nothing on Windows reads
                    // it, so behaviour and layout stay identical.
                    changed mouse-x => { root.stage-hover(self.mouse-x, self.mouse-y); }
                    changed mouse-y => { root.stage-hover(self.mouse-x, self.mouse-y); }
                    // v0.8.52 (owner fix 1, supersedes v0.8.50): NON-immersive edge-pill proximity off
                    // the same stage pointer (the M8 route: no new hit surface). The zones now serve
                    // BOTH pill modes — SECTION VISIBLE: the stage edge IS the section boundary the
                    // HIDE pill anchors to, so a half-depth band arms it; SECTION HIDDEN: the stage
                    // edge is the window edge, full depth arms the SHOW pill (the v0.8.50 behavior).
                    // Immersive is gated at the overlay (the corner-reveal system owns immersive).
                    property <bool> eb-hot: self.has-hover
                        && self.mouse-y >= parent.height - (root.film-visible ? Theme.edge-zone / 2 : Theme.edge-zone);
                    property <bool> el-hot: self.has-hover
                        && self.mouse-x <= (root.grid-open ? Theme.edge-zone / 2 : Theme.edge-zone);
                    changed eb-hot => { root.stage-bot-hot = self.eb-hot; }
                    changed el-hot => { root.stage-left-hot = self.el-hot; }
                    scroll-event(e) => {
                        // Ctrl + wheel always zooms (at the cursor); otherwise the wheel
                        // navigates when wheel-nav is on, else zooms. Nav direction is
                        // inverted from before so wheel-up = previous photo (natural).
                        // v0.8.127: both decisions come from the shared mappings above — a tilt
                        // navigates and can never zoom (it used to zoom OUT, both directions).
                        //
                        // v0.8.150 (J3) — THE MODAL GATE, which the KEYS have had since v0.7.3 and
                        // the WHEEL never did. A Slint `TouchArea` whose `scroll-event` is unset
                        // returns `EventResult.reject` (the enum's first value is its default), and
                        // a rejected wheel keeps travelling FRONT-TO-BACK through the item tree —
                        // so the dismiss `TouchArea` on a modal's scrim, and the bare `TouchArea`
                        // inside its `GlassPanel`, were both transparent to the wheel and every
                        // notch over an open Settings sheet outside its `Flickable` body reached
                        // THIS handler and changed the photograph behind the scrim. Under a heavy
                        // browse that is self-amplifying: each notch demands a fresh 48 MP decode
                        // AND a frosted-backdrop rebuild.
                        //
                        // The rule is not new and the predicate is not new — `modal-open` is "the
                        // SINGLE modal-gate predicate" (see its declaration), and `sel-gesture-kind`
                        // already states the reason in one line: "under a modal nothing behind the
                        // scrim may mutate state". The wheel is swallowed-but-INERT, exactly like
                        // the nav keys at `kb-next`/`kb-prev`: `accept` still fires below, so the
                        // event stops here rather than falling through to some other surface.
                        // v0.8.155 (D1a, owner ruling 1): `popup-open` — modal-open PLUS the six
                        // menu/dropdown surfaces. See the predicate's declaration for the set.
                        if (!root.photo-popup-open) {
                            if (e.modifiers.control) {
                                root.zoom-at(self.mouse-x, self.mouse-y, root.wheel-zoom-delta(e.delta-x, e.delta-y));
                            } else if (root.wheel-nav) {
                                if (!root.photo-popup-open) { root.navigate-step(root.wheel-nav-dir(e.delta-x, e.delta-y)); }
                            } else {
                                root.zoom-at(self.mouse-x, self.mouse-y, root.wheel-zoom-delta(e.delta-x, e.delta-y));
                            }
                        }
                        accept
                    }
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                            self.dragged = false;
                            root.pan-start();
                        }
                        // a clean left release (no drag) toggles 1:1 zoom at the cursor.
                        // v0.8.129 (W1-2, the ruled "1:1-toggle gate"): a MODIFIED clean click
                        // toggles the CURRENT photo's selection and CONSUMES the click. Without this
                        // interception Ctrl+click fell straight through to photo-clicked and toggled
                        // 1:1 zoom as well — two actions from one gesture. The two accepted
                        // cohabitations are untouched: Ctrl+DRAG still pans (this arm requires
                        // !dragged) and Ctrl+WHEEL still zooms (a different handler entirely).
                        if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left && !self.dragged) {
                            if (root.sel-gesture-kind(e.modifiers.control, e.modifiers.shift) >= 0) {
                                root.sel-gesture(root.cur-idx, root.sel-gesture-kind(e.modifiers.control, e.modifiers.shift), false);
                            } else {
                                root.photo-clicked(self.mouse-x, self.mouse-y);
                            }
                        }
                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                            root.ctx-target = -1;           // v0.8.38 (G2): stage right-click targets the CURRENT shot
                            root.ctx-populate(-1);
                            // v0.8.54 (owner bug): ctx-x is consumed in WINDOW space (the menu's x
                            // clamps against root.width), but this passed the STAGE-LOCAL mouse-x —
                            // correct only while the stage began at window x=0. With the grid dock
                            // open the stage starts at x = grid-dock-w, so the menu opened exactly
                            // that far LEFT of the cursor. Anchor via absolute-position + mouse —
                            // the film-thumb/grid-tile openers' proven formula (owner-verified
                            // correct) — for x AND y (y was value-identical before — stage top ==
                            // overlay top — but now shares the one grammar instead of relying on it).
                            root.ctx-x = self.absolute-position.x + self.mouse-x;
                            root.ctx-y = self.absolute-position.y + self.mouse-y - (root.content-top);
                            root.ctx-open = true;
                            root.settings-open = false;
                            root.loading-open = false;
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            if ((self.mouse-x - self.pressed-x) > 4px || (self.pressed-x - self.mouse-x) > 4px
                             || (self.mouse-y - self.pressed-y) > 4px || (self.pressed-y - self.mouse-y) > 4px) {
                                self.dragged = true;
                            }
                            root.pan-move(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                        }
                    }
                }

                // ── compare A|B. Halves share the zoom FACTOR; pan is linked by FRACTION so both show
                //    the same relative region while each fits in its OWN aspect (a different-aspect half
                //    stays sharp). PIN a half (click its label) to hold it: the wheel BROWSES the unpinned
                //    half(s) — none pinned → both move in lockstep; one pinned → the other; both pinned
                //    (or the toggle = Zoom) → wheel ZOOMS. The focused half (accent half-border) is the
                //    rating/flag target. Each half has its own index → image + badges + aspect. ──
                if root.compare : cmp := Rectangle {
                    property <length> hw: (self.width - 2px) / 2;
                    property <length> hh: self.height;
                    // PER-HALF geometry: each half fits in its OWN aspect, so a different-aspect half is
                    // sharp (not letterboxed-then-overlay-misaligned). Shared zoom FACTOR (root.zoom).
                    // Non-hyphen names (iwa, not iw-a) — `cmp.iw-a` would parse as subtraction.
                    property <bool> wba: (cmp.hw / cmp.hh) < root.cmp-aspect-a;
                    property <length> bwa: cmp.wba ? cmp.hw : cmp.hh * root.cmp-aspect-a;
                    property <length> bha: cmp.wba ? cmp.hw / root.cmp-aspect-a : cmp.hh;
                    property <length> iwa: cmp.bwa * root.zoom;
                    property <length> iha: cmp.bha * root.zoom;
                    property <length> mpxa: max(0px, (cmp.iwa - cmp.hw) / 2);
                    property <length> mpya: max(0px, (cmp.iha - cmp.hh) / 2);
                    property <bool> wbb: (cmp.hw / cmp.hh) < root.cmp-aspect-b;
                    property <length> bwb: cmp.wbb ? cmp.hw : cmp.hh * root.cmp-aspect-b;
                    property <length> bhb: cmp.wbb ? cmp.hw / root.cmp-aspect-b : cmp.hh;
                    property <length> iwb: cmp.bwb * root.zoom;
                    property <length> ihb: cmp.bhb * root.zoom;
                    property <length> mpxb: max(0px, (cmp.iwb - cmp.hw) / 2);
                    property <length> mpyb: max(0px, (cmp.ihb - cmp.hh) / 2);
                    // Pan (#7): a shared FRACTION (root.cmp-pan-fx/fy, −1..1) applied to EACH half's own
                    // max pan, so both show the same relative region AND each can reach its own edges. The
                    // FOCUSED half is the drag DRIVER: mpx/y-drv is its max, so dragging pans it 1:1 (the
                    // other half follows proportionally). Fixes the old "B can't pan to its edges" when A
                    // had no pan room but B did.
                    property <length> pax: root.cmp-pan-fx * cmp.mpxa;
                    property <length> pay: root.cmp-pan-fy * cmp.mpya;
                    property <length> pbx: root.cmp-pan-fx * cmp.mpxb;
                    property <length> pby: root.cmp-pan-fy * cmp.mpyb;
                    property <length> mpxdrv: root.cmp-focus == 0 ? cmp.mpxa : cmp.mpxb;
                    property <length> mpydrv: root.cmp-focus == 0 ? cmp.mpya : cmp.mpyb;
                    property <bool> bothpin: root.pin-a && root.pin-b;
                    property <int> wheel-eff: cmp.bothpin ? 1 : root.cmp-wheel; // forced to Zoom when both pinned
                    // v0.8.126 (R7 / audit N10+N20): ONE shared width budget for the top-centre
                    // band. The gutter between a stage edge and the centred control bar, computed
                    // once and handed to BOTH pin labels, instead of two labels each solving their
                    // x AND a floored name budget from ctlbar.width independently. A label never
                    // exceeds its slot, so A's x is >= 0 and B's right edge <= the stage width at
                    // every window size, by construction rather than by a re-tuned literal.
                    property <length> pinslot: max(0px, cmp.width / 2 - ctlbar.width / 2 - 10px);
                    HorizontalLayout {
                        spacing: 2px;
                        Rectangle {
                            horizontal-stretch: 1; clip: true;
                            border-width: root.cmp-focus == 0 ? 2px : 1px;
                            border-color: root.cmp-focus == 0 ? Theme.accent : Theme.border;
                            Image { source: root.photo-a; image-fit: contain;
                                    width: cmp.iwa; height: cmp.iha;
                                    x: (parent.width - cmp.iwa) / 2 + cmp.pax;
                                    y: (parent.height - cmp.iha) / 2 + cmp.pay; }
                            // undecodable source in this half → centred broken-image glyph (never a stale photo)
                            if root.cmp-unsupported-a : UnsupportedGlyph {
                                tint: Theme.text-dim; width: 30px; height: 30px;
                                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                            }
                            // hi-res tile of the zoomed-in region (source-res when past the base cap)
                            if root.region-a-active : Image {
                                source: root.region-photo-a; image-fit: fill;
                                x: (parent.width - cmp.iwa) / 2 + cmp.pax + root.region-a-u0 * cmp.iwa;
                                y: (parent.height - cmp.iha) / 2 + cmp.pay + root.region-a-v0 * cmp.iha;
                                width: (root.region-a-u1 - root.region-a-u0) * cmp.iwa;
                                height: (root.region-a-v1 - root.region-a-v0) * cmp.iha;
                            }
                            // ── v0.8.125 (C1 / design-sweep O1): the G1 honest-loading state, PER HALF.
                            //    The same grammar the single view uses (scrim + a quiet "Loading…"
                            //    pill), anchored INSIDE this half rather than at stage centre, so it
                            //    names WHICH side is waiting. Rust clears the pixels the moment they
                            //    stop describing this half's shot, so the pin label's name, rating
                            //    digit and flag glyph beside it can no longer be read as belonging
                            //    to another photo's pixels. Mounted LAST so it covers the region
                            //    tile too. No TouchArea: input passes through (the cull, zoom and
                            //    1:1 gates live in Rust, not in a swallow layer). ──
                            // v0.8.126 (judge-first a / audit N22): NO SCRIM. The house rule the
                            // comment above cites is scrim-over-STALE-pixels (the single view's own
                            // arm is `root.stage-stale ? Theme.scrim-heavy : transparent`) - and C1
                            // CLEARS this half's pixels by construction, so `scrim-heavy` (#0a0a0ac0)
                            // was compositing over the identical `Theme.stage` (#0a0a0a): a
                            // provable zero-pixel delta, plus a full-half composite and an `animate`
                            // on a constant literal, on the perf-critical browse path. The pill IS
                            // the state here, exactly as it is in the single view's non-stale arm.
                            if root.cmp-loading-a : Rectangle {
                                width: 100%; height: 100%;
                                background: transparent;
                                Rectangle {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    width: lpilla.preferred-width + 26px; height: 26px;
                                    border-radius: Theme.radius;
                                    background: Theme.block;
                                    border-width: 1px; border-color: Theme.border-strong;
                                    lpilla := Text {
                                        x: 13px; text: @tr("falcon" => "Loading…");
                                        color: Theme.text-dim; font-size: Theme.font-sm; font-weight: 600;
                                        vertical-alignment: center; height: parent.height;
                                    }
                                }
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1; clip: true;
                            border-width: root.cmp-focus == 1 ? 2px : 1px;
                            border-color: root.cmp-focus == 1 ? Theme.accent : Theme.border;
                            Image { source: root.photo-b; image-fit: contain;
                                    width: cmp.iwb; height: cmp.ihb;
                                    x: (parent.width - cmp.iwb) / 2 + cmp.pbx;
                                    y: (parent.height - cmp.ihb) / 2 + cmp.pby; }
                            if root.cmp-unsupported-b : UnsupportedGlyph {
                                tint: Theme.text-dim; width: 30px; height: 30px;
                                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                            }
                            // hi-res tile of the zoomed-in region (source-res when past the base cap)
                            if root.region-b-active : Image {
                                source: root.region-photo-b; image-fit: fill;
                                x: (parent.width - cmp.iwb) / 2 + cmp.pbx + root.region-b-u0 * cmp.iwb;
                                y: (parent.height - cmp.ihb) / 2 + cmp.pby + root.region-b-v0 * cmp.ihb;
                                width: (root.region-b-u1 - root.region-b-u0) * cmp.iwb;
                                height: (root.region-b-v1 - root.region-b-v0) * cmp.ihb;
                            }
                            // v0.8.125 (C1 / O1): B's half of the honest-loading state (see A above).
                            if root.cmp-loading-b : Rectangle {
                                width: 100%; height: 100%;
                                background: transparent; // v0.8.126 (N22): see A above
                                Rectangle {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    width: lpillb.preferred-width + 26px; height: 26px;
                                    border-radius: Theme.radius;
                                    background: Theme.block;
                                    border-width: 1px; border-color: Theme.border-strong;
                                    lpillb := Text {
                                        x: 13px; text: @tr("falcon" => "Loading…");
                                        color: Theme.text-dim; font-size: Theme.font-sm; font-weight: 600;
                                        vertical-alignment: center; height: parent.height;
                                    }
                                }
                            }
                        }
                    }
                    // interaction layer BELOW the labels/bar so their buttons stay clickable; the images
                    // carry no TouchArea, so clicks on the photo fall through here (focus / zoom).
                    cta := TouchArea {
                        // Incremental drag baseline (mouse pos at the LAST moved event). Accumulating the
                        // fraction per-event means a mid-drag change to mpxdrv (Tab/click swaps the focused
                        // half, or a zoom) applies only to the NEXT delta — no jump — and there's no clamp
                        // dead-zone (each small delta lands immediately).
                        property <length> lastmx;
                        property <length> lastmy;
                        property <bool> dragged;
                        scroll-event(e) => {
                            // Ctrl + wheel always zooms (both halves); otherwise the Browse|Zoom pill decides.
                            // v0.8.127: the zoom is written HERE rather than through a callback, so
                            // the "0 is not a gesture" rule needs its own guard — without it a tilt
                            // while both halves are pinned would shrink both photographs.
                            // v0.8.150 (J3): the same modal gate as the single-view stage above —
                            // compare is a stage too, and a modal's scrim covers both.
                            // v0.8.155 (D1a): …and the same POPUP gate, for the same reason — the
                            // context menus reach compare's halves as of ruling Q23's surface work.
                            if (!root.popup-open) {
                                if (e.modifiers.control || cmp.wheel-eff == 1) {
                                    if (root.wheel-zoom-delta(e.delta-x, e.delta-y) != 0) {
                                        root.zoom = clamp(root.zoom * (root.wheel-zoom-delta(e.delta-x, e.delta-y) > 0 ? 1.15 : 0.87), 1.0, 12.0); // zoom both
                                        if (root.zoom <= 1.0) { root.cmp-pan-fx = 0; root.cmp-pan-fy = 0; }
                                    }
                                } else {
                                    root.compare-browse(root.wheel-nav-dir(e.delta-x, e.delta-y)); // browse the unpinned half(s)
                                }
                            }
                            accept
                        }
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                self.dragged = false; self.lastmx = self.mouse-x; self.lastmy = self.mouse-y;
                            }
                            // ── v0.8.159 (B2, OWNER RULING Q23): THE COMPARE HALVES GET THE MENU.
                            // "right-click on a half targets that half" — so the target is the
                            // RESOLVED index of the half under the cursor (`cmp-a-idx`/`cmp-b-idx`,
                            // published by step_compare), never -1: a stage-scoped -1 here would
                            // aim every row at `current`, which in compare is not either half.
                            // With a real index every row routes through the same guarded
                            // index-taking callbacks the filmstrip and grid-tile openers use, and
                            // `ctx-populate` fills the menu's rating / marks / copy availability
                            // for THAT photograph. The two anchor lines are the stage opener's
                            // formula verbatim (absolute-position + mouse; y made stage-relative),
                            // which is the one grammar all four open sites now share.
                            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                                root.ctx-target = self.mouse-x < self.width / 2 ? root.cmp-a-idx : root.cmp-b-idx;
                                root.ctx-populate(root.ctx-target);
                                root.ctx-x = self.absolute-position.x + self.mouse-x;
                                root.ctx-y = self.absolute-position.y + self.mouse-y - (root.content-top);
                                root.ctx-open = true;
                                root.settings-open = false;
                                root.loading-open = false;
                            }
                            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left && !self.dragged) {
                                if ((self.mouse-x < self.width / 2 ? 0 : 1) != root.cmp-focus) {
                                    root.compare-set-active(self.mouse-x < self.width / 2 ? 0 : 1); // switch active (rating target)
                                // v0.8.125 (C2 / design-sweep O3): the magic 1.5 is gone here too —
                                // this is `on_photo_clicked`'s own rule, so the photo click and the
                                // bar's badge cannot disagree about what "click again" does.
                                } else if (abs(root.zoom - 1.0) > 0.01) {
                                    root.zoom = 1.0; root.cmp-pan-fx = 0; root.cmp-pan-fy = 0;  // active clicked again → fit both
                                } else {
                                    root.compare-one-to-one();                        // active clicked → 100% (both)
                                }
                            }
                        }
                        moved => {
                            if (self.pressed) {
                                // v0.8.182 (2026-08-13 owner report): STAMP THE INTERACTION CLOCK,
                                // unconditionally and before the clamps — the W2 precedent from the
                                // single-view drag (`pan-move` stamps above its own clamp). The pan
                                // clamp is PER-AXIS, so a gesture that has run out of room in one
                                // axis is still a gesture; gating the stamp on movement would park
                                // and un-park inside one drag, which is the W3 failure mode.
                                root.cmp-pan-input();
                                if (abs(self.mouse-x - self.pressed-x) > 4px || abs(self.mouse-y - self.pressed-y) > 4px) { self.dragged = true; }
                                // Accumulate the pan FRACTION from the incremental mouse move ÷ the FOCUSED
                                // half's max pan (1:1 on that half). If the focused half has no room in an
                                // axis, that axis stays put (guard avoids /0 → NaN). lastmx/y advance every
                                // event so a mid-drag focus/zoom change only affects the next delta (no jump).
                                root.cmp-pan-fx = cmp.mpxdrv > 0px
                                    ? clamp(root.cmp-pan-fx + (self.mouse-x - self.lastmx) / cmp.mpxdrv, -1.0, 1.0)
                                    : root.cmp-pan-fx;
                                root.cmp-pan-fy = cmp.mpydrv > 0px
                                    ? clamp(root.cmp-pan-fy + (self.mouse-y - self.lastmy) / cmp.mpydrv, -1.0, 1.0)
                                    : root.cmp-pan-fy;
                                self.lastmx = self.mouse-x;
                                self.lastmy = self.mouse-y;
                            }
                        }
                        double-clicked => { root.zoom = 1.0; root.cmp-pan-fx = 0; root.cmp-pan-fy = 0; }
                    }
                    // A label = PIN TOGGLE, pulled in to flank the control bar on the LEFT. A filled dot +
                    // accent border = pinned. Click to pin/unpin. (Focus comes from clicking the photo.)
                    pinlabel-a := ComparePinLabel {
                        x: cmp.width / 2 - ctlbar.width / 2 - 10px - self.width; y: 8px;
                        // v0.8.163 (§7 item 5 [VD]): the same glass, the same offsets — this pill's
                        // host is `cmp` too, so the stage origin is (0, 0) here as well.
                        backdrop: root.blur-backdrop;
                        sw: root.content-w; sh: root.content-h; ox: -root.stage-x; oy: 0px;
                        pinned: root.pin-a; letter: "A"; focused: root.cmp-focus == 0;
                        name: root.name-a; rating: root.rating-a; flagged: root.flagged-a; rejected: root.rejected-a;
                        slot: cmp.pinslot;
                        muted: root.cmp-loading-a; // v0.8.126: the identity dims with the pixels
                        pulse: root.cmp-pin-pulse;
                        warn: root.cmp-same-shot;  // v0.8.158 (B1c, Q24): BOTH labels, one flag
                        toggle => { root.compare-toggle-pin(0); }
                    }
                    // B label = PIN TOGGLE, flanking on the RIGHT.
                    pinlabel-b := ComparePinLabel {
                        x: cmp.width / 2 + ctlbar.width / 2 + 10px; y: 8px;
                        backdrop: root.blur-backdrop;
                        sw: root.content-w; sh: root.content-h; ox: -root.stage-x; oy: 0px;
                        pinned: root.pin-b; letter: "B"; focused: root.cmp-focus == 1;
                        name: root.name-b; rating: root.rating-b; flagged: root.flagged-b; rejected: root.rejected-b;
                        slot: cmp.pinslot;
                        muted: root.cmp-loading-b;
                        pulse: root.cmp-pin-pulse;
                        warn: root.cmp-same-shot;  // v0.8.158 (B1c, Q24): BOTH labels, one flag
                        toggle => { root.compare-toggle-pin(1); }
                    }
                    // top-centre control bar (ON TOP): 1:1 · Fit · [Browse | Zoom] wheel-mode toggle.
                    // ── v0.8.163 (§7 item 5, OWNER RULING): THE BASE IS THE HOUSE GLASS. ─────────
                    // "if the glass blur for floating exif panel can be fixed, also make the base
                    // of the A/B compare's floating top control panel a glass blur texture
                    // (buttons, toggles and sliders stay as is)." So the ONLY change here is the
                    // material of the bar itself: `GlassPanel` (the app's floating-surface skin —
                    // blurred backdrop + neutral tint), never a hand-rolled blur, and every control
                    // inside `cbar` below is byte-identical to v0.8.162.
                    //
                    // THE OFFSETS, in v0.8.162's contract: `ox`/`oy` state where the STAGE's
                    // top-left sits in THIS host's coordinate space. The host is `cmp`, which is a
                    // full-bleed child of `stage` (no x/y/size of its own), so the stage origin IS
                    // this space's origin — 0, 0, exactly like the docked EXIF panel one level up.
                    // That is also why the bar frosts correctly over BOTH halves and the divider:
                    // the canvas `support::stage_blur` composes covers the whole stage rect, and
                    // this mapping lands it on itself.
                    //
                    // `hot` is left at its default FALSE [VD] — the bar stays frosted rather than
                    // solidifying under the pointer like the EXIF panels do. Slint hover is
                    // EXCLUSIVE, so a `hot` OR would have to name every control on the bar or the
                    // base would flicker out from under whichever one the pointer is on (the
                    // v0.8.138 X3 defect), and naming them means giving SegPill and FocusBadge new
                    // hover outputs — i.e. touching the controls the ruling says stay as they are.
                    // Permanently frosted is also the right reading of the request: this is a
                    // material for the bar, not a hover behaviour.
                    ctlbar := GlassPanel {
                        x: (parent.width - self.width) / 2; y: 8px;
                        // FIX-F concentric: inner SegPill radius-ctrl 8 + (34-26)/2 = 4px gap -> outer Theme.radius 12 (post-L41 values; the concentric sum is the invariant and survived the even pass exactly: 9+4=13 became 8+4=12)
                        // (GlassPanel already sets all four corners to Theme.radius — the same value
                        // the hand-rolled base set, so the concentric arithmetic above is unchanged.)
                        width: cbar.preferred-width + 20px; height: 34px;
                        backdrop: root.blur-backdrop;
                        sw: root.content-w; sh: root.content-h; ox: -root.stage-x; oy: 0px;
                        hover-glass: true;
                        // The hairline SURVIVES the material change: GlassPanel's own border is a
                        // no-op (`Theme.border` is transparent at 0px) because its call sites are
                        // large panels; this is a 34px control bar sitting over a photograph, and
                        // its 8%-white edge is what has always told it apart from the image behind
                        // it. Keeping it is the smaller deviation from "the base becomes glass".
                        border-width: 1px; border-color: Theme.border-strong;
                        TouchArea {} // swallow clicks on the bar background
                        cbar := HorizontalLayout {
                            x: 10px; spacing: 8px;
                            // v0.8.125 (C2 / design-sweep O3+Y73): the "1:1" chip that lit on a bare
                            // `zoom > 1.5` is GONE, and what stands in its place is the SINGLE VIEW'S
                            // OWN focus badge — same words, same colour rule, same tap-toggles-1:1
                            // action, in this bar's chip geometry (`compact`). That is the whole fix:
                            // the lit state now keys on the real computed percentage against SOURCE
                            // pixels for the FOCUSED half, so "1:1" cannot be claimed at 1.5x on a
                            // 45 MP file, and compare stops being the one mode with no zoom truth on
                            // screen — on the surface whose entire purpose is the focus check.
                            // Fixed width for the same reason the SegPill beside it is fixed: the bar
                            // is centred and the pin labels flank it, so a width that breathed with
                            // the percentage would slide both labels on every wheel notch.
                            // v0.8.126 (R7 / audit N10): the fixed width is the badge's MEASURED
                            // WIDEST BOUNDED state - "Focus 1:1" + the clamped four-digit
                            // percentage + "%" + the compact dialect's padding and spacing - which
                            // is what makes it a size rather than a hand-picked number. The bound
                            // itself is `tick::ZOOM_PCT_DISPLAY_MAX`; without it the percentage is
                            // unbounded below source width (a small source at MAX_ZOOM on a 2x
                            // display runs to five and six digits) and no fixed width could hold
                            // it. The widest-state geometry is asserted in the rig.
                            //
                            // v0.8.126 (audit N6/N37): `failed` is bound now. The single-view host
                            // always passed it; compare never did, so the shared badge's "Not
                            // sharp" state was unreachable here and a latched full-res failure
                            // read amber "Loading…" for ever.
                            //
                            // v0.8.126 (audit N24): ...and it carries the Tip its action deserves.
                            // C2 removed the bar's only literal "1:1", so at Fit - the state a
                            // photographer is in when they decide to check focus - the control
                            // that PERFORMS the check named its own state and never its action.
                            // The string is state-derived (L20), so the imperative is never wrong.
                            cmpbadge := FocusBadge {
                                compact: true; width: max(116px, Theme.fit-text ? self.fit-width : 0px); y: (parent.height - self.height) / 2;
                                pct: root.cmp-zoom-pct; pct-valid: root.cmp-zoom-pct-valid;
                                detail-live: root.cmp-detail-live; zoom: root.zoom;
                                failed: root.cmp-detail-failed;
                                pending: root.cmp-detail-pending; // item 30 (§1.E): the quiet word at Fit
                                available: root.cmp-one-to-one-known;
                                hover-changed(h) => {
                                    root.cmp-badge-hot = h;
                                    if (h) {
                                        Tip.text = root.cmp-focus-tip;
                                        Tip.cx = self.absolute-position.x + self.width / 2;
                                        Tip.cy = self.absolute-position.y + self.height + 10px;
                                    } else if (Tip.text == root.cmp-tip-one-to-one || Tip.text == root.cmp-tip-fit) {
                                        Tip.text = ""; Tip.cy = 0px;
                                    }
                                }
                                clicked => {
                                    if (abs(root.zoom - 1.0) > 0.01) {
                                        root.zoom = 1.0; root.pan-x = 0; root.pan-y = 0; root.cmp-pan-fx = 0; root.cmp-pan-fy = 0;
                                    } else {
                                        root.compare-one-to-one();
                                    }
                                }
                            }
                            Rectangle {
                                width: fitb.preferred-width + 18px; height: 20px; y: (parent.height - self.height) / 2;
                                border-radius: Theme.radius-xs;
                                background: fitta.has-hover ? Theme.hover : transparent;
                                border-width: 1px; border-color: Theme.border-strong;
                                fitb := Text { text: @tr("falcon" => "Center"); color: Theme.text-dim; font-size: Theme.font-sm; font-weight: 700;
                                               x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                                fitta := TouchArea { clicked => { root.cmp-pan-fx = 0; root.cmp-pan-fy = 0; } }
                            }
                            // v0.8.191 (H5): the compare bar's two dividers. HEIGHT STAYS 16 — the
                            // "+20px" idea from the audit's first pass is dead: the host row is 34px
                            // (≡ 2 mod 4), so an even divider y needs h ≡ 2 (mod 4) and 20 gives y = 7,
                            // odd. 16 logical = 24 device rows lands whole at both phases anyway, so
                            // the odd y was never the live defect here; the X axis was (1.0 or 2.0
                            // HARD columns, 8px from four anti-aliased 1px rims drawing ~1.5 soft).
                            // What X-AA buys is CRISPNESS parity with those rims, not weight parity:
                            // divider #333 against `border-strong` #ffffff14 composited is a TOKEN
                            // difference and is left exactly as the owner has always seen it.
                            cmpdiv1 := AaHairline { width: 1px; height: 16px; y: (parent.height - self.height) / 2; vertical: true; tint: Theme.divider; }
                            cmpwheel := SegPill {
                                width: max(124px, Theme.fit-text ? self.fit-width : 0px); y: (parent.height - self.height) / 2;
                                opts: [@tr("falcon" => "Browse"), @tr("falcon" => "Zoom")]; sel: cmp.wheel-eff;
                                // v0.8.125 (C3 / design-sweep O4): while BOTH halves are pinned this
                                // seg paints from a FORCED value (`wheel-eff`), so a click on
                                // "Browse" wrote cmp-wheel and the handle snapped straight back — a
                                // fully live, fully dead control, and the drag-to-compare entry path
                                // LANDS in exactly that state. It now does the obvious thing: unpin
                                // the half the photographer is not judging (the focused one is the
                                // reference he chose) and switch to Browse, so the click means what
                                // its label says. Routed through `compare-toggle-pin`, the shared pin
                                // body, so this can never drift from the pin labels' own toggle.
                                changed(i) => {
                                    if (i == 0 && cmp.bothpin) { root.compare-toggle-pin(root.cmp-focus == 0 ? 1 : 0); }
                                    root.cmp-wheel = i;
                                }
                            }
                            // ── v0.8.158 (B1b, OWNER RULING Q16): THE RAW TOGGLE JOINS THE BAR. ──
                            // The ruling moves the affordance, not the behaviour: `raw-mode` is ONE
                            // global bool (main.rs `on_set_raw` stores a process-wide AtomicBool and
                            // clears the develop caches), so it has always applied to BOTH halves at
                            // once and still does. Identical dispatch, identical component, identical
                            // state-derived labels as the develop panel's `rawseg` — this IS that
                            // control, hosted here while the panel it lived on is hidden.
                            //
                            // THE LABEL, and the L20 reasoning behind it (spec's own branch): the
                            // bar's existing toggle is `cmpwheel`, a SegPill — a two-cell switch that
                            // paints an accent handle over the ACTIVE cell while BOTH states stay
                            // labelled. That is "a pressed/active visual", not a state-derived
                            // imperative, so this control takes the same grammar rather than a "Show
                            // RAW" ↔ "Show JPG" flipping button: a segment whose two cells read
                            // "JPG | RAW" (or "Preview | RAW" on a pair with no finished file, the
                            // Q17 precedent) is honest in BOTH states by construction, which is what
                            // L20 is protecting. Reported as a deliberate reading of the ruling's
                            // "Show RAW" wording — the affordance is here, the noun labels are the
                            // house grammar for it.
                            //
                            // THE GATE IS COMPARE'S OWN (L21). `cur-has-raw` describes the SINGLE
                            // view's cursor and would be the wrong shot here; `cmp-has-raw` is
                            // published by step_compare from the two RESOLVED half indices — either
                            // half having a RAW makes the global toggle meaningful, because it
                            // re-develops whichever half can be.
                            // v0.8.191 (H5): the second of the pair — see `cmpdiv1` above.
                            cmpdiv2 := AaHairline { width: 1px; height: 16px; y: (parent.height - self.height) / 2; vertical: true; tint: Theme.divider; }
                            cmpraw := SegPill {
                                hit: !root.opening-photo;
                                width: max(104px, Theme.fit-text ? self.fit-width : 0px); y: (parent.height - self.height) / 2;
                                opts: root.cmp-raw-only ? [@tr("falcon" => "Preview"), "RAW"] : [root.cmp-finished-format, "RAW"];
                                sel: root.raw-mode ? 1 : 0;
                                opacity: root.cmp-has-raw ? 1.0 : 0.45;
                                changed(i) => { if (root.cmp-has-raw) { root.set-raw(i == 1); } }
                            }
                        }
                    }
                    // v0.8.125 (C3 / design-sweep O4): the one line that closes the gulf of
                    // evaluation while both halves are held. The wheel's behaviour there is a
                    // CONSEQUENCE of the two pins, and a pin dot is the least likely thing a
                    // photographer connects to "why is the wheel zooming". Same over-photo chip
                    // material as the loading pill, so it reads as status rather than a control.
                    //
                    // v0.8.126 (judge-first e / audit N26 + the design question): the material is
                    // now the loading pill's, VERBATIM - Theme.radius (12px post-L41), 26px tall, font-sm at
                    // 600, 13px side padding. It claimed to be that already; it was actually
                    // wearing `radius-xs`, which is this bar's CONTROL radius (the "Center" chip
                    // and the focus badge 6px above it use exactly it), so a persistent
                    // instructional sentence centred under the control cluster read as a fourth,
                    // dead control in it. One over-photo status grammar, one radius.
                    //
                    // And it LINGERS rather than living for as long as the state does: bothpin is
                    // the drag-to-compare entry's permanent default, so this sentence sat over the
                    // two photographs indefinitely in the mode whose purpose is looking at them.
                    // Rust arms it on ENTRY into the state and again on every refusal - the two
                    // moments at which it is explaining something. Both sentences about this state
                    // now open on the same clause ("Both halves are pinned").
                    if cmp.bothpin && root.cmp-bothpin-hint : Rectangle {
                        x: (parent.width - self.width) / 2; y: 8px + ctlbar.height + 6px;
                        width: bothpin-txt.preferred-width + 26px; height: 26px;
                        border-radius: Theme.radius;
                        background: Theme.block;
                        border-width: 1px; border-color: Theme.border-strong;
                        bothpin-txt := Text {
                            x: 13px; text: @tr("falcon" => "Both halves are pinned — the wheel zooms");
                            color: Theme.text-dim; font-size: Theme.font-sm; font-weight: 600;
                            vertical-alignment: center; height: parent.height;
                        }
                    }
                }

                // ── RAW develop + zoom/focus panel (bottom-left). The zoom readout lives INSIDE
                //    this panel (shared glass material) instead of a disconnected floating pill. ──
                //    v0.8.97: `raw-open` leads the gate — the Settings seg's Hidden cell takes BOTH
                //    floating panels off screen, and this panel's minimised magnifier stub below
                //    carries the same term, so Hidden really means gone rather than folded.
                //    v0.8.98 (C2): the gate is the hoisted `raw-panel-mounted` — one predicate, read
                //    here and by the L22 latch clear beside it, so the two cannot drift.
                if root.raw-panel-mounted : rawpanel := GlassPanel {
                    width: 163px;
                    opacity: max(root.chrome-eff, root.raw-reveal-eff-i); // M6 fade + M8 peek (max: the immersive-ENTER crossfade still fades it out with chrome; in immersive raw-reveal-eff-i drives it)
                    x: 18px;
                    y: parent.height - self.height - 18px;
                    height: rawcol.preferred-height;
                    backdrop: root.blur-backdrop;
                    sw: root.content-w; sh: root.content-h; ox: -root.stage-x; oy: 0;
                    // hover-glass: hot = ANY of the panel's touch surfaces (Slint hover is exclusive,
                    // so the swallow area alone would drop out over the child controls). The zoom row
                    // is conditional (`if !compare`), so it reports in via `zoom-hot`; entering compare
                    // destroys it mid-hover without a has-hover change, so the flag resets on `cmp`.
                    property <bool> zoom-hot: false;
                    property <bool> cmp: root.compare;
                    changed cmp => { rawpanel.zoom-hot = false; }
                    changed height => { root.raw-panel-h = self.height; }
                    init => { root.raw-panel-h = self.height; }  // capture the initial height (changed does not fire for the first value)
                    hover-glass: true;
                    // M8: `anyhot` = the existing hover-glass OR, hoisted to a named property so it can
                    // ALSO feed root.raw-panel-hot (the tick's keep-alive while hovering the revealed
                    // panel; v0.8.98: the parked magnifier stub writes the same latch on its own hover —
                    // the two surfaces are mutually exclusive by `raw-min`, so one latch serves both).
                    property <bool> anyhot: rawswallow.has-hover || csta.has-hover || rawminbtn.hovered
                         || rawseg.hovered || rawpanel.zoom-hot;
                    hot: rawpanel.anyhot;
                    changed anyhot => { root.raw-panel-hot = rawpanel.anyhot; }
                    rawswallow := TouchArea { enabled: !root.immersive || root.raw-revealed; } // swallow clicks/drags so they don't pan/zoom the photo behind the panel (M6: dies on the bool; M8: live while the immersive peek is revealed)
                    rawcol := VerticalLayout {
                        padding: Theme.space-3; spacing: Theme.space-2;
                        // top row: colour-space chip (left) + minimise "−" (right, mirrors the EXIF panel)
                        HorizontalLayout {
                            height: 28px; spacing: Theme.space-1;
                            // Colour-space chip (#23/CM-1): names the source space, and when it differs from
                            // the chosen output gamut shows the conversion in accent ("Adobe RGB → Display P3")
                            // — the file IS being colour-managed now, so this is informational, not a warning.
                            // Hover reveals the full explanation.
                            // STRETCH + elide (mirrors the EXIF header): the chip flexes and elides so the
                            // minimise button always sits flush-right, never crowded/clipped by a long chip
                            // (a converting "Adobe RGB -> Custom" ~110px overflows the ~139px content width
                            // of the narrow 163px panel). The row is mode-independent -- the long converting
                            // chip merely SURFACED the clip in compare (half A); a short "sRGB" chip fit, so
                            // single-view looked fine. Button now flush-right in both modes; full text on hover.
                            Rectangle {
                                horizontal-stretch: 1;
                                // no fixed height: fill the row (mirrors the EXIF name cell) so the 11px
                                // chip centres in the row instead of floating as a 14px island in a tall band
                                csta := TouchArea {
                                    enabled: !root.immersive || root.raw-revealed; // M6 gate (root's changed immersive also resets cs-hover); M8: live while revealed
                                    x: 0; width: min(cschip.preferred-width, parent.width); height: parent.height;
                                    changed has-hover => { root.cs-hover = self.has-hover; }
                                }
                                cschip := Text {
                                    width: 100%; height: 100%;
                                    text: root.cs-chip;
                                    color: root.cs-converting ? Theme.accent : Theme.text-dim;
                                    font-size: Theme.font-sm;
                                    font-weight: root.cs-converting ? 700 : 400;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                            rawminbtn := IconBtn {
                                hit: (!root.immersive || root.raw-revealed) && !root.opening-photo; // RAW pairing must be complete
                                width: 28px; height: 28px;   // v0.8.12: unified with the EXIF panel's minimise (exbtn2) — same IconBtn 28x28 + MinimizeIcon + Theme.hover wash (user: match the EXIF panel)
                                clicked => { root.raw-min = true; }
                                MinimizeIcon { } // v0.8.138 (X1): the mark centres itself, floored (28px box)
                            }
                        }
                        // compact JPG / RAW develop toggle (dimmed + inert when the shot has no RAW); it
                        // and the zoom row below fill the panel width so they line up.
                        // ── v0.8.154 (A5, OWNER RULING Q17): "Preview", NOT "JPG", ON A RAW-ONLY SHOT.
                        // On a shot with no finished file, `shot.jpg` is None and BOTH decode tiers
                        // hand back the RAW's EMBEDDED preview — which the decoder itself calls
                        // "small", and which is already upscaled at FIT on a large display. The
                        // segment said "JPG", so nothing on screen told a real full-size JPG apart
                        // from a thumbnail-grade preview of a RAW; this label is the only place the
                        // difference can be stated, and it is state-derived so it is honest in every
                        // state (L20). The RAW-only test is `has RAW && no finished file` — the
                        // develop panel's own two published facts, not a third derivation.
                        //
                        // WHAT THIS DOES NOT TOUCH: `raw-mode` still defaults false, the segment
                        // still selects index 0, and the dim/inert path below is unchanged (it fires
                        // on the OPPOSITE case, a shot with no RAW). Ruling Q17 relabels; it does not
                        // re-default the toggle.
                        rawslot := Rectangle {
                            height: 26px;
                            rawseg := SegPill {
                                width: 100%; height: 100%;
                                visible: root.cur-has-raw;
                                hit: root.cur-has-raw && (!root.immersive || root.raw-revealed) && !root.opening-photo;
                                opts: !root.cur-has-finished ? [@tr("falcon" => "Preview"), "RAW"] : [root.cur-finished-format, "RAW"];
                                sel: root.raw-mode ? 1 : 0;
                                changed(i) => { root.set-raw(i == 1); }
                            }
                            if !root.cur-has-raw : no-raw := Rectangle {
                                width: 100%; height: 100%;
                                border-radius: Theme.radius-ctrl;
                                background: Theme.well;
                                border-width: 1px; border-color: Theme.border-strong;
                                Text {
                                    text: @tr("falcon" => "no RAW for this shot");
                                    color: Theme.text-mute; font-size: Theme.font-sm;
                                    horizontal-alignment: center; vertical-alignment: center;
                                    width: 100%; height: 100%;
                                }
                            }
                        }
                        // zoom / focus-check row — tap to toggle 1:1; accent + "Focus 1:1" at native px.
                        // v0.8.125 (C2): this markup moved WHOLESALE into the shared `FocusBadge`
                        // (controls.slint) so the compare bar can host the IDENTICAL control rather
                        // than a compare-only twin. Every state, colour rule and word is preserved
                        // — the N25 sharp rule, the v0.8.96 "Loading…" wording, the v0.8.96-audit
                        // "Not sharp" third state, the Y69 "Zoomed" band — and the rig still reads
                        // `fbtext`, now under the component's own element id. The three host-specific
                        // bits stay here: the M6 input gate, the click, and the hover push into the
                        // panel's hover-glass OR (a conditional element never fires `changed
                        // has-hover` on unmount, so the component PUSHES it and the panel latches).
                        if !root.compare : fbadge := FocusBadge {
                            pct: root.zoom-pct; pct-valid: root.zoom-pct-valid;
                            detail-live: root.detail-live; zoom: root.zoom; failed: root.detail-failed;
                            pending: root.detail-pending; // item 30 (§1.E): the quiet word at Fit
                            hit: (!root.immersive || root.raw-revealed) && !root.photo-popup-open;
                            clicked => { root.photo-clicked(root.stage-w / 2, root.stage-h / 2); }
                            hover-changed(h) => { rawpanel.zoom-hot = h; }
                        }
                        // formats batch F2: honest animation line for a GIF ("GIF · animated · N frames",
                        // or just "GIF" for a still one). Rust sets anim-info = "" for every other format,
                        // so the row only appears on a GIF shot.
                        if root.anim-info != "" : Text {
                            text: root.anim-info;
                            color: Theme.text-dim;
                            font-size: Theme.font-sm;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                // colour-space hover note — a sibling of the RAW panel (GlassPanel clips, so it can't
                // live inside) floating just above it; explains how the file's colour is being handled.
                // v0.8.120 (design-sweep Y72): the note's gate carries the PEEK's own liveness, the
                // same term the chip's TouchArea has had since v0.8.98 (`enabled: !root.immersive ||
                // root.raw-revealed`). The chip is known to ELIDE at this panel width — "a converting
                // 'Adobe RGB -> Custom' ~110px overflows the ~139px content width", resolved by "full
                // text on hover" — so in the peek, the one state that needs the disclosure was the
                // one state that could not get it. The y binding already anchors above the panel
                // wherever it sits, so the peek needs no separate anchor.
                // v0.8.158 (B1b, Q16): `&& !root.compare` — the note belongs to a panel that is not
                // mounted in compare. `changed raw-panel-mounted` already clears `cs-hover` on that
                // very edge (L22), so this term is the belt: it cannot outlive its chip even if some
                // future edge writes the latch while compare is on.
                if root.cs-hover && root.raw-open && !root.compare && (!root.immersive || root.raw-revealed) && !root.raw-min : Rectangle {
                    x: 18px;
                    width: 232px;
                    height: tiptext.preferred-height + 14px;
                    y: max(47px, parent.height - root.raw-panel-h - 24px - self.height);  // 18px panel bottom-margin + 6px gap = 24px
                    // v0.8.45 (Fix 4): tooltip-family look — the Tip layer's badge-bg pill (same
                    // fill/radius, borderless), keeping this card's bespoke wrapping width, multi-line
                    // text and above-panel anchor. The dropped accent border used to flag "actively
                    // converting"; that signal now lives only in the chip's own accent+bold text
                    // (user call: unify to the tooltip look regardless).
                    background: Theme.badge-bg;
                    border-radius: Theme.radius-sm;
                    tiptext := Text {
                        x: 8px; y: 7px; width: parent.width - 16px;
                        text: root.cs-note;
                        color: Theme.text; font-size: Theme.font-sm; wrap: word-wrap;
                    }
                }

                // Full-res-unavailable notice (#15). The current shot's full-res / RAW decode FAILED, so
                // the stage is showing the SOFTER fast proxy — surface it (never silent) so a sharpness
                // judgement isn't made on a proxy mistaken for 1:1, and make it TAPPABLE to retry (a
                // transient cause — a briefly-locked file, a passing OOM — shouldn't be permanent).
                // …but NOT when the placeholder card already owns the failure (cur-failed = BOTH tiers
                // gone → no proxy on screen): the pill's "you're seeing the soft proxy, tap to sharpen"
                // premise is false there, and the card (tappable-to-retry) is the single coherent affordance
                // (lens self-check: card + pill co-rendered contradictory messages).
                // v0.8.120 (design-sweep O32): the `!root.immersive` term is GONE — this pill now
                // follows the Loading pill's own rule (`!root.compare` only). Immersive used to drop
                // every decode-failure surface, so a corrupt file, a HEIC with no OS codec or a
                // dehydrated OneDrive placeholder rendered as a pure-black stage with no card, no
                // pill, no toast and no filename (the title bar is hidden too) — a persistent state
                // that never self-heals, in which the photographer cannot tell a broken file from a
                // hung app. Honesty about WHAT IS ON STAGE outranks chrome-hiding, exactly as the
                // Loading pill's note argues. The M6 `opacity: chrome-eff` goes with it (chrome-eff
                // is 0 in immersive, which would mount an invisible pill), matching the Loading pill,
                // which carries no opacity term either.
                if root.detail-failed && !root.cur-unsupported && !root.cur-failed && !root.compare : Rectangle {
                    x: (parent.width - self.width) / 2; y: 14px;
                    width: dftext.preferred-width + 26px; height: 26px;
                    border-radius: Theme.radius;
                    background: dfretry.has-hover ? #2a2410 : #201d12; // dark-amber retry card, OPAQUE over the photo (deeper than warn-soft's wash) — intentional one-offs
                    border-width: 1px; border-color: Theme.warn;
                    animate background { duration: Theme.anim; easing: ease; }
                    // v0.8.14 (Item 5): press-lift on the tap-to-retry card (discrete pressable; lifts off the photo, photo-first)
                    dftext := Text {
                        x: 13px; text: @tr("falcon" => "⚠ Full-res unavailable — tap to retry");
                        color: Theme.warn; font-size: Theme.font-sm; font-weight: 600;
                        vertical-alignment: center; height: parent.height;
                    }
                    dfretry := TouchArea { clicked => { root.retry-detail(); } } // v0.8.120 (O32): live in immersive too — the pill says "tap to retry", so the tap must work where the pill is shown
                }

                // Placeholder card for a shot with NO frame: either a recognised-but-undecodable type
                // (Way A: AVIF/JXL/…) OR a supported format whose decode FAILED at runtime (N3: corrupt
                // file / HEIC with no OS codec). Broken-image glyph + the specific reason — never a blank
                // stage and never the PREVIOUS shot's frame while cull keys target this one. The file is
                // still navigable and shows its name below.
                // v0.8.120 (design-sweep O32): the immersive term is gone here too — see the
                // detail-failed pill above. This card IS the explanation for a black stage, and the
                // shot it explains is exactly the one the user cannot navigate away from confidently
                // without it.
                if (root.cur-unsupported || root.cur-failed) && !root.compare : Rectangle {
                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                    width: 300px; height: 118px;
                    border-radius: Theme.radius-ctrl;
                    background: Theme.badge-bg;
                    // v0.8.44 (G9): cloud-pending is CALM — neutral border/glyph (a transient,
                    // self-healing state); amber stays reserved for the genuine decode-FAILED card.
                    border-width: 1px; border-color: (root.cur-failed && !root.cur-cloud) ? Theme.warn : Theme.border;
                    VerticalLayout {
                        padding: 16px; spacing: 8px; alignment: center;
                        HorizontalLayout {
                            alignment: center;
                            if !root.cur-cloud : UnsupportedGlyph { tint: root.cur-failed ? Theme.warn : Theme.text-dim; width: 34px; height: 34px; }
                            if root.cur-cloud : CloudGlyph { width: 34px; height: 34px; } // G9: a cloud, not a broken image — nothing is damaged
                        }
                        Text {
                            text: root.cur-unsupported ? root.cur-unsupported-note : root.cur-failed-note;
                            color: Theme.text; font-size: Theme.font-md;
                            font-weight: 600; horizontal-alignment: center; wrap: word-wrap;
                        }
                        // v0.8.44 (G9): NO manual-retry line on the cloud-pending card — its note already
                        // says the auto-retry sweep is running ("Falcon will retry…"); advertising a manual
                        // tap alongside contradicted it. The card itself stays tappable (a harmless nudge).
                        if !root.cur-cloud : Text {
                            // The failed card carries its OWN retry (the #15 pill is suppressed here) so a
                            // transient cause — a briefly-locked file — isn't a dead end; unsupported can't retry.
                            text: root.cur-unsupported ? @tr("falcon" => "This file type can't be previewed yet") : @tr("falcon" => "Tap to retry — the other photos are unaffected");
                            color: Theme.text-mute;
                            font-size: Theme.font-sm; horizontal-alignment: center; wrap: word-wrap;
                        }
                    }
                    // tappable-to-retry ONLY for a runtime decode failure (unsupported has nothing to retry)
                    if root.cur-failed : TouchArea { clicked => { root.retry-detail(); } } // v0.8.120 (O32): the card's own "Tap to retry" must work in immersive, where the card now mounts
                }

                // ── G1: honest loading state. While the current shot has no decoded frame yet: dim the
                // stage when it still shows the PREVIOUS shot's pixels (stage-stale — never let them read
                // as the current photo), and show a quiet "Loading…" pill. Neutral colours: this is
                // status, not a warning (the pill grammar matches the detail-failed pill above, which is
                // mutually exclusive with this state). Shown in immersive too — honesty about WHICH photo
                // is on stage outranks chrome-hiding while pixels are wrong. No TouchArea: input passes
                // through (zoom/pan/cull are gated in Rust, not swallowed here). ──
                if root.cur-loading && !root.compare : Rectangle {
                    width: 100%; height: 100%;
                    background: root.stage-stale ? Theme.scrim-heavy : transparent;
                    animate background { duration: Theme.anim; easing: ease; }
                    Rectangle {
                        x: (parent.width - self.width) / 2; y: 14px;
                        width: lpill-text.preferred-width + 26px; height: 26px;
                        border-radius: Theme.radius;
                        background: Theme.block;
                        border-width: 1px; border-color: Theme.border-strong;
                        lpill-text := Text {
                            x: 13px; text: @tr("falcon" => "Loading…");
                            color: Theme.text-dim; font-size: Theme.font-sm; font-weight: 600;
                            vertical-alignment: center; height: parent.height;
                        }
                    }
                }

                // ── RAW/zoom panel minimised to a magnifier icon (bottom-left) ──
                //    v0.8.97: `raw-open` gates this stub too — Hidden is not "minimised", it is off
                //    screen, and the way back from HIDDEN is the shared info-side recovery (ruling
                //    4): there is still no second corner reveal for a panel that is off, and the
                //    immersive peek below is a different thing — it reaches a panel that is merely
                //    PARKED, which is a state the user can still see and click their way out of.
                //    v0.8.98 (v0.8.97-audit C13): the stub joins the IMMERSIVE PEEK. The bottom-left
                //    hover has always armed that peek whenever the develop panel exists — parked or
                //    not (tick.rs `raw_ctx` carries no `raw-min` term) — but only the EXPANDED panel
                //    carried the reveal disjunct, so hovering the corner with the panel parked armed
                //    a countdown over nothing at all: a silent dead end, the L25 class. The gate is
                //    now the hoisted `raw-stub-mounted`, which carries the same disjunct the panel's
                //    does, so the hover produces the magnifier and one click expands it.
                if root.raw-stub-mounted : magstub := GlassPanel {
                    width: 40px; height: 40px;
                    // M6 fade + M8 peek — the panel's own `max(...)`, for the same reason: in
                    // immersive chrome-eff is 0, so without the peek term the stub would mount
                    // fully transparent (a 40px invisible click target, which is worse than nothing).
                    opacity: max(root.chrome-eff, root.raw-reveal-eff-i);
                    x: 18px;
                    y: parent.height - self.height - 18px;
                    backdrop: root.blur-backdrop;
                    sw: root.content-w; sh: root.content-h; ox: -root.stage-x; oy: 0;
                    hover-glass: true;
                    hot: magta.has-hover;
                    magta := TouchArea {
                        enabled: !root.immersive || root.raw-revealed; // M6 gate; v0.8.98: live while the peek is revealed
                        // Reveal keep-alive, the raw-panel-hot pattern (Slint hover is EXCLUSIVE, so
                        // the pointer landing on this stub takes the hover away from the stage
                        // TouchArea that feeds raw-corner-hot — without this the peek would fade
                        // while the user was reaching for it). Shares the panel's latch: the two
                        // surfaces are mutually exclusive by `raw-min`, and `changed
                        // raw-stub-mounted` above clears it on this stub's own unmount edge (L22).
                        changed has-hover => { root.raw-panel-hot = self.has-hover; }
                        clicked => { root.raw-min = false; }
                    }
                    // v0.8.139 (AA/M5) SAID: the SAME magnifier is mounted twice — here in this 40x40
                    // stub and on the watermark large-preview button at a literal x/y of 4px in a
                    // 30x30 well. That one is even (device 6.0); this one centred to (40 - 22)/2 = 9,
                    // ODD, i.e. device 13.5 — so one drawing rendered at two phases and the twin on
                    // the watermark sheet was "visibly the crisper of the two". It took L41's floor
                    // arm to the EVEN grid (9 -> 8, device 12.0) and stated its own price: "1px up
                    // and left of true centre in this 40px stub".
                    //
                    // ── v0.8.191 (REVIEW, the R1 class): THAT PRICE BOUGHT NOTHING, SO IT IS NOT PAID.
                    // The even-grid rule is about AA-OFF PLAIN FILLS — a hard-edged span whose
                    // coverage is decided by which sample centres it happens to cover (`GridDotBlock`'s
                    // 2px dots are the case it was minted for). `MagnifierIcon` has no such span: it
                    // is a BORDERED 13px circle (`draw_border_rectangle` — an anti-aliased stroke) plus
                    // a Path handle (also stroked). Both are drawn with anti-aliasing ON at every
                    // sub-pixel phase, so "sharing a phase" with the watermark twin was never a
                    // property either mount could gain or lose. What the floor DID do is what its own
                    // banner admitted: move the ink 1 logical = 1.5 DEVICE px up and left of the
                    // stub's true centre — the same error class the owner reported on the title bar's
                    // asterisk on 08-16, and larger than it. Exact centring: (40 − 22)/2 = 9 on both
                    // axes. The watermark twin's literal 4px in its 30x30 well is (30 − 22)/2 = 4,
                    // i.e. ALREADY exact — so both mounts of the one drawing are now dead centre of
                    // their own wells, which is the property that was actually worth having.
                    MagnifierIcon {
                        hot: magta.has-hover;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                // ── EXIF info: minimised to a small "i" icon (folded view's "−" and the i key land
                //    here) — OR, while the panel is FULLY OFF (the Settings "Info panel" seg's Off
                //    cell), the corner-hover reveal (v0.8.92 L25: the M8 immersive-reveal grammar in
                //    normal view — same bottom-right zone, same linger; Rust's
                //    step_immersive_reveal drives info-revealed; the eff term keeps the mount
                //    through the exit dissolve, the raw-panel mount-linger pattern; the reveal
                //    disjunct also carries `!compare` (v0.8.92-audit) so a mid-fade stub can never
                //    paint over the A/B split — mirrors the cull chip's `!root.compare` gate). ──
                // v0.8.159 (B2): named `infostub` so the rig can assert the L25 half of ruling
                // Q19 — that entering compare leaves a VISIBLE way back, not an empty corner.
                if root.info-stub-mounted : infostub := GlassPanel {
                    width: 40px; height: 40px;
                    opacity: root.info-open ? root.chrome-eff : root.info-reveal-eff; // M6 fade / L25 reveal fade
                    x: parent.width - self.width - 18px;
                    y: parent.height - self.height - 18px;
                    backdrop: root.blur-backdrop;
                    sw: root.content-w; sh: root.content-h; ox: -root.stage-x; oy: 0;
                    hover-glass: true;
                    hot: iconta.has-hover;
                    iconta := TouchArea {
                        enabled: !root.immersive; // M6 gate
                        // fully-off reveal keep-alive (the raw-panel-hot pattern): hovering the
                        // revealed stub holds the tick's linger open. Only written while fully off —
                        // the root `changed info-open` observer clears the latch when the click
                        // below unmounts this area mid-hover (L22).
                        changed has-hover => { if (!root.info-open) { root.info-stub-hot = self.has-hover; } }
                        // minimized → expand (this panel only — per-panel independence); fully-off
                        // (revealed) → the SHARED recovery, which brings the develop panel back with
                        // it whenever the seg's Hidden cell put both away (v0.8.97 ruling 4;
                        // tick::apply_panels_restore is the one body, also reached by the i key's
                        // second press and the context-menu row). The per-folder memory records the
                        // resulting min-states like any other writer.
                        clicked => { if (!root.info-open) { root.restore-panels(); } else { root.info-min = false; } }
                    }
                    // drawn info "i" mark (circle + dot + stem) — brightens on hover
                    //
                    // ── v0.8.139 (AA/H3): ONE GLYPH, DRAWN TO TWO STANDARDS. ───────────────────
                    // The dot and the stem shared an x (correct) and disagreed on everything
                    // vertical. The stem at y 9 with an 8px height landed on whole device rows and
                    // rendered as a hard-edged bar; the dot at y 4.5 with a 2.6px height landed at
                    // device .25 and spread 3.9 device px over five rows with BOTH ends partial —
                    // so the reader saw a razor-sharp stem under a smudged, slightly low, lighter
                    // dot. The 0.75-device-px offset between them was fixed by the literals `4.5px`
                    // vs `9px`, which makes it INVARIANT: present on every frame the minimised EXIF
                    // stub is on screen, wherever the stub sits.
                    //
                    // Both marks are now even in every dimension and sit on a common EVEN PITCH of
                    // 4 (dot y 5, stem y 9), so they share one subpixel phase and rasterise as one
                    // glyph. The ink now spans y 5..17 inside the 22px ring — centre 11, which is
                    // the ring's exact centre (it was 10.75), and the dot-to-stem gap is 2px where
                    // it was 1.9px, so the drawing is unchanged to the eye. THE PRICE, STATED: both
                    // marks go 2.6px -> 2px wide and the dot 2.6px -> 2px tall, a 0.6px trim that
                    // trades a 3.9-device-px smear for a 3-device-px bar with hard edges.
                    //
                    // The 22px RING is left alone: it is a circle, so its own (40 - 22)/2 = 9px
                    // mount buys no crispness either way, and moving it to an even 8 would push the
                    // whole mark 1px off-centre in the stub for nothing. Note the mount being odd is
                    // why the marks' offsets are 5 and 9 rather than 4 and 10 — 9 + 5 = 14 and
                    // 9 + 9 = 18 are both EVEN inside the stub, which is the level that composes
                    // with the stub's own runtime-derived corner position.
                    Rectangle {
                        width: 22px; height: 22px; border-radius: 11px;
                        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                        border-width: 1.6px;
                        border-color: iconta.has-hover ? Theme.text : Theme.text-dim;
                        Rectangle { width: 2px; height: 2px; border-radius: 1px;
                                    x: (parent.width - self.width) / 2; y: 5px;
                                    background: iconta.has-hover ? Theme.text : Theme.text-dim; }
                        Rectangle { width: 2px; height: 8px; border-radius: 1px;
                                    x: (parent.width - self.width) / 2; y: 9px;
                                    background: iconta.has-hover ? Theme.text : Theme.text-dim; }
                    }
                }

                // ── EXIF info panel (bottom-right) ──
                if root.info-panel-mounted : exifpanel := GlassPanel {
                    // ── v0.8.136 (V1, owner report): THE PANEL ADAPTS TO ITS ARMED ROW. ──────────
                    // "the layout of the exif panel is still problematic, perhaps due to the
                    // slightly larger width the numbers introduced, so make the width of the panel
                    // adapt to these buttons" (owner verbatim). While a selection is live the cull
                    // row's two pills carry counted, directed labels ("Unflag 12" / "Un-reject 12")
                    // and v0.8.135 answered the overflow by folding the row onto two lines. This is
                    // the other answer, and the right one for THIS panel: it floats, it is anchored
                    // to the stage's bottom-RIGHT corner, and `x` is solved FROM `width` — so every
                    // pixel it grows, it grows leftward into open stage, never off the glass.
                    //
                    // THE ARITHMETIC: the row publishes `line1-need` (the two hugging pills + the
                    // star CELL + its three 12px halo-separating gaps) and the panel adds its own
                    // 2x16px padding.
                    //
                    // v0.8.137 (W2) — AND THE 308px FLOOR HAS STOPPED BINDING, which is a real cost
                    // and is stated rather than hidden. The plural star signal is now a pill painted
                    // behind the cluster, and its 8px flanks are reserved in BOTH states so that
                    // arming cannot slide five stars sideways — so the star cell is 123px wide
                    // always, not 107. The unarmed need is 70 + 86 + 123 + 3x4 = 291, +32 = 323, and
                    // 323 > 308: the resting EXIF panel is 15px wider than v0.8.136's. That is the
                    // price of "the stars must not move on arm/disarm" (owner), and it is paid
                    // LEFTWARD into open stage like every other pixel this panel grows. The floor is
                    // KEPT because it still guards the one case that can go below it — a future row
                    // whose need shrinks — and because deleting it would silently re-open the
                    // narrow-panel shapes v0.8.133 measured. Armed the panel lands 374px at one
                    // digit, 387 at two and 414 at four (rig-measured, not estimated).
                    //
                    // THE CAP is the honest half: `stage` clips (main_window.slint:2218), so a panel
                    // wider than the stage would lose its left edge — labels and all — on a narrow
                    // window. Capped at the stage minus the 18px inset on both sides, the row's own
                    // hand-split takes over from there and folds, which is what it is for now.
                    //
                    // NOT ANIMATED, deliberately [VD]. `Theme.anim` on this width would sweep the
                    // row's width through every value between the resting row (291 since v0.8.137;
                    // 276 when this was written) and the armed need — and the row's wrap
                    // predicate reads its LIVE width, so it would fold, mount a second line, grow
                    // the panel's height, then unfold and shrink it back, on every arm and disarm.
                    // A 120ms two-line blip plus a height jump is a worse artifact than an instant
                    // resize, and the alternative (feeding the row its target width so it stops
                    // reading its own) would make line 1 overflow the still-shrinking glass on the
                    // way back down. The labels and the two haloes change on this same edge, so the
                    // resize reads as part of one state change rather than a lurch. (v0.8.137: the
                    // star pill's own face and halo DO fade — it is a persistent element, so it can,
                    // and it is the one part of this edge that is not width-coupled.)
                    width: max(308px, min(parent.width - 36px, cullrow.line1-need + 2 * Theme.space-4));
                    opacity: root.chrome-eff; // M6 fade (mount lingers via chrome-fading; input dies on the bool)
                    x: parent.width - self.width - 18px;
                    y: parent.height - self.height - 18px;
                    // hug the content exactly (infobox's 16px padding is the only inset) —
                    // the old +28px left a strange gap under RATING.
                    height: infobox.preferred-height;
                    backdrop: root.blur-backdrop;
                    sw: root.content-w; sh: root.content-h; ox: -root.stage-x; oy: 0;
                    // hover-glass: OR of every touch surface in the panel; while EXPANDED it stays
                    // solid outright — that's a dense reading sheet (and its Flickable owns hover).
                    hover-glass: true;
                    // v0.8.138 (X3): `exbtn0` joins the OR. Slint hover is EXCLUSIVE, so a surface
                    // missing from this list drops the panel out of solid glass the moment the
                    // pointer lands on it — the new "…" button is a hover surface like its two
                    // siblings and has to be named here or hovering it makes the panel flicker.
                    hot: exifswallow.has-hover || exbtn0.hovered || exbtn1.hovered || exbtn2.hovered
                         || nmta.has-hover
                         || cullrow.hot || root.info-view == 2; // FULL stays solid — a dense reading sheet
                    exifswallow := TouchArea { enabled: !root.immersive; } // swallow clicks/drags so they don't pan/zoom the photo behind the panel (M6: dies on the bool)
                    infobox := VerticalLayout {
                        padding: Theme.space-4; spacing: 11px;   // small tier = 16px (tokenized)
                        // Header: filename top-left in BOTH folded + expanded (consistency);
                        // the chevron + minus float top-right in both states.
                        HorizontalLayout {
                            spacing: 2px;
                            Rectangle {
                                horizontal-stretch: 1;
                                // click the filename → copy it (hit area hugs the rendered name)
                                nmta := TouchArea {
                                    enabled: !root.immersive; // M6 gate
                                    x: 0; width: min(nmtxt.preferred-width, parent.width); height: parent.height;
                                    mouse-cursor: pointer;
                                    clicked => { root.copy-name(); }
                                }
                                nmtxt := Text {
                                    width: 100%; height: 100%;
                                    text: root.info-name;
                                    color: nmta.has-hover ? Theme.accent : Theme.text;
                                    font-size: Theme.title-size; font-weight: 600;
                                    vertical-alignment: center; overflow: elide;
                                }
                            }
                            // ── v0.8.138 (X3): THE HEADER IS THREE PERSISTENT BUTTONS. ──────────
                            // "…" (the size ladder's top) · the chevron (the size ladder's bottom)
                            // · "−" (out of the ladder entirely, to the stub). All three are
                            // mounted in ALL THREE views and change only their PAINT and their
                            // target — no `if`, which is both the L4 reading (a control that is
                            // always there cannot surprise you by vanishing) and the rig reading
                            // (a conditional element stops resolving under `find_by_element_id`,
                            // so a mount-gated header could not be probed in both states).
                            //
                            // exbtn0 — "…" = MORE. Standard/simple → FULL; full → back to STANDARD,
                            // and while full it wears `active` (the IconBtn accent-soft wash every
                            // other toggled-on glyph button in the app wears), so the control that
                            // took you there is visibly the one that brings you back. Owner-
                            // confirmed toggle semantics.
                            // [VD] "…" IS PRESENT IN SIMPLE — the owner's own test-and-decide
                            // button. It jumps simple → full, skipping standard, which is the whole
                            // question he wants to look at: whether a two-row panel should be able
                            // to become the tallest one in a single click.
                            exbtn0 := IconBtn {
                                hit: !root.immersive; // M6 gate
                                width: 28px; height: 28px;
                                active: root.info-view == 2;
                                clicked => { root.info-view = root.info-view == 2 ? 1 : 2; }
                                EllipsisGlyph {
                                    // L41: 14px glyph in a 28px button → (28 - 14) / 2 = 7 and
                                    // (28 - 2) / 2 = 13, both integer. The dots' OWN geometry is
                                    // all-even (2px dots, 4px gaps, x = 0/6/12) — see glyphs.slint.
                                    x: (parent.width - 14px) / 2;
                                    y: (parent.height - 2px) / 2;
                                }
                            }
                            // exbtn1 — THE CHEVRON, and it always means "down the size ladder";
                            // from simple it is the only way back up (→ STANDARD). OWNER RULE
                            // (08-03 hotfix): the arrow depicts the ACTION — down = shrink,
                            // up = expand. So standard/full draw a DOWN chevron, simple draws UP.
                            //
                            // v0.8.143 (C3): THE NAMING TRAP IS GONE. ChevronGlyph's vertical
                            // property used to be `up`, and `up: true` DREW A DOWNWARD V — Slint's
                            // y grows downward, so the apex sat BELOW the endpoints. Every older
                            // consumer was written against that inverted reality and v0.8.138,
                            // reading the name at face value, shipped these arrows backwards. The
                            // property is `points-down` now and means exactly what it says; the
                            // expression below carries the SAME value it always did.
                            //
                            // FULL'S DOWN-CHEVRON GOES STRAIGHT TO SIMPLE, and the spec allowed
                            // either that or "full returns through standard" depending on cost. It
                            // costs NOTHING here — same button, same handler, one more arm on an
                            // expression that already had to branch — so the affordance keeps one
                            // meaning in all three views instead of two meanings depending on where
                            // you are. "…" is the way from full to standard; the chevron is the way
                            // to simple. Neither is ambiguous from any view.
                            // v0.8.107: the same drawing, a shared component — the per-display
                            // colour sections reuse THIS icon (owner ruling D1), so there is
                            // exactly one expand/collapse chevron in the app.
                            exbtn1 := IconBtn {
                                hit: !root.immersive; // M6 gate
                                width: 28px; height: 28px;
                                clicked => { root.info-view = root.info-view == 0 ? 1 : 0; }
                                ChevronGlyph {
                                    // v0.8.191 (S2-B) REVERTED IN THE SAME ROUND, and the reason is worth more than the
                                    // snap was: EVEN-FLOORING THIS MOUNT WAS A CATEGORY ERROR. The even-grid rule was
                                    // minted for AA-OFF PLAIN FILLS, whose coverage is decided by which sample centres a
                                    // hard-edged span happens to cover — `FilmFrameBlock`'s frames, `GridGlyph`'s dots.
                                    // `ChevronGlyph` is an anti-aliased Path STROKE on a diagonal: it has no hard edge to
                                    // land, and moving it to an even logical column buys nothing at all. What the floor DID
                                    // buy was 1 logical = 1.5 DEVICE px off this cell's true centre — twice the asterisk
                                    // miscentring the owner reported on 08-16, introduced by the fix for it. Exact centring.
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    // OWNER DIRECTION RULE (2026-08-04): the arrow points where the
                                    // content will move. This panel is BOTTOM-ANCHORED and extends
                                    // UPWARD, so from standard/full the click shrinks it downward
                                    // (down arrow) and from simple it grows upward (up arrow).
                                    points-down: root.info-view != 0;
                                }
                            }
                            exbtn2 := IconBtn {
                                hit: !root.immersive; // M6 gate
                                width: 28px; height: 28px;
                                // v0.8.92 (L25): BOTH views minimise to the "i" stub — closed ≠ gone.
                                // (The expanded view's old close-to-hidden was the misread state;
                                // fully-off lives ONLY behind the Settings "Info panel" seg's Off
                                // cell — v0.8.93 ruling 2 replaced the two-state toggle with it.)
                                // The expanded/folded reading mode is kept, so re-opening returns
                                // to the view the user minimised from.
                                clicked => { root.info-min = true; }
                                MinimizeIcon { } // v0.8.138 (X1): the mark centres itself, floored (28px box)
                            }
                        }
                        // v0.8.138 (X3): the header's rule is the BODY's rule, so it goes with the
                        // body. SIMPLE has no metadata between its two rows — mounting this would
                        // put two rules 11px apart with nothing in between, which reads as a bug.
                        // The rule ABOVE the cull row stays unconditional, so simple lands on
                        // exactly [filename row] · rule · [cull row]: the immersive card's shape.
                        if root.info-view != 0 : HRule { }
                        // STANDARD: a compact 5×3 grid of the essentials (some cells span 2
                        // columns), with thin column rules — see the Figma reference.
                        if root.info-view == 1 : GridLayout {
                            spacing-horizontal: 12px;
                            spacing-vertical: 9px;
                            // The short value cells (col 3 = shutter/EV, col 5 = ISO/focal/
                            // aperture/colour) carry a min-width floor so the wide camera/lens/
                            // date cells (col 1, no floor) elide first instead of squeezing
                            // them — ISO/aperture/shutter stay fully readable. col-5 fits
                            // "ISO 102400"; col-3 fits "1/8000 s".
                            // Language packs (round 2, PLAN §5): of the six floored cells only the
                            // ISO cell draws words Falcon adds ("ISO {iso}", a message). The other
                            // five draw the camera's values as falcon-decode formats them, which are
                            // not translated, so they keep their floors in both states. With
                            // Settings → Developer → Widen controls to fit text on, the ISO cell is
                            // never narrower than its (translated) text and never below 64 px; off,
                            // exactly 64 px. One value expression (L47); its grid column (focal,
                            // aperture, colour space) widens with it.
                            Row {
                                BriefCell { text: root.exif-brief.camera; }
                                BriefSep {}
                                BriefCell { text: root.exif-brief.shutter; min-width: 54px; }
                                BriefSep {}
                                exiso := BriefCell { text: root.exif-brief.iso; min-width: max(64px, Theme.fit-text ? self.preferred-width : 0px); }
                            }
                            Row {
                                BriefCell { text: root.exif-brief.lens; colspan: 3; }
                                BriefSep {}
                                BriefCell { text: root.exif-brief.focal; min-width: 64px; }
                            }
                            Row {
                                BriefCell { text: root.exif-brief.wb; }
                                BriefSep {}
                                BriefCell { text: root.exif-brief.ev; min-width: 54px; }
                                BriefSep {}
                                BriefCell { text: root.exif-brief.aperture; min-width: 64px; }
                            }
                            Row {
                                BriefCell { text: root.exif-brief.datetime; colspan: 3; }
                                BriefSep {}
                                BriefCell { text: root.exif-brief.colorspace; min-width: 64px; }
                            }
                            Row {
                                BriefCell { text: root.exif-brief.artist; }
                                BriefSep {}
                                BriefCell { text: root.exif-brief.files; colspan: 3; }
                            }
                        }
                        // Expanded: all rows in a Flickable whose OWN height is clamped to the
                        // available stage (same proven pattern as the keybind list below).
                        // A clamped explicit `height` is honoured by the parent layout, so
                        // the panel can't overflow off the top of the stage on a small
                        // window (EXIF is ~15-20 rows), and it still hugs the content (no
                        // gap under RATING) when everything fits.
                        // v0.8.116 (D-D, owner ruling: "do the gradient if overflows for better
                        // consistency with settings panel"): the scroll body wears the SAME
                        // `PanelBottomFade` the Settings body, the Selection panel, the events panel
                        // and the welcome columns wear — same component, same `more` mechanism, no
                        // second gradient grammar. It was the one scrolling surface in the app that
                        // cut a row in half at its clip edge with nothing to say so.
                        // OVERFLOW-ONLY, never a veil: `more` is the Settings expression verbatim
                        // (viewport-height + viewport-y > height), so it is 0 while the list fits AND
                        // once the user has scrolled to the bottom — a 15-row EXIF panel on a tall
                        // window shows no smudge at all, and the fade animates out as the last row
                        // arrives.
                        // THE WRAPPER exists because the fade must PAINT OVER the scroll body rather
                        // than sit under it in the column, and because ids inside a mount-gated `if`
                        // are only reachable from within it (the sibling sites read `setflick`/
                        // `wcflick` from an unconditional scope). It is height-pinned to the
                        // Flickable it wraps — an EXPLICIT height, so it is max-BOUNDED and cannot
                        // become a second absorber in this column (the v0.8.3 stretch-class rule);
                        // this panel hugs its content anyway (`height: infobox.preferred-height`),
                        // which the same rule records as immune.
                        // ── v0.8.159 (B2 mechanism 1): THIS BLOCK IS NOW `ExifRowsView`. ─────────
                        // Ruling Q19's floating panel must show a layout IDENTICAL to this one, and
                        // "identical" that is maintained by hand is the L7/L19 divergence machine —
                        // so the markup moved WHOLESALE into panels.slint and both hosts mount the
                        // component. The two things this host knows that the component cannot are
                        // now the two things it passes: the stage-derived height budget (which a
                        // floating panel has no stage for) and the immersive input gate.
                        // The old inline `Rectangle { height: exflick.height; … }` wrapper is gone
                        // with it — the component IS that wrapper, height-pinned to its own
                        // Flickable, so it stays max-BOUNDED and cannot become a second absorber in
                        // this column (the v0.8.3 stretch-class rule).
                        if root.info-view == 2 : ExifRowsView {
                            rows: root.exif-rows;
                            interactive: !root.immersive; // M6 gate (drag-scroll; wheel falls through with it)
                            avail: root.stage-h - 230px > 120px ? root.stage-h - 230px : 120px;
                        }
                        HRule { }
                        cullrow := CullActionRow {
                            hit: !root.immersive; // M6 gate (the EXIF panel dies in immersive)
                            rating: root.rating; flagged: root.flagged; rejected: root.rejected;
                            // v0.8.133 (the visual wave, C): THE ONE ALWAYS-VISIBLE CULL CONTROL joins
                            // the bulk grammar. It arms on `bulk-actions-armed` -- the EXPLICIT-surface
                            // predicate, WITHOUT the `sel-open` term the keyboard keeps (ruling 5) --
                            // because unlike a keystroke this row glows white and says the number and
                            // the direction beside itself. Its immersive twin (the cull card further
                            // down) binds NONE of these and stays single-photo by construction.
                            bulk-armed: root.bulk-actions-armed;
                            bulk-flag-label: root.bulk-flag-label;
                            bulk-reject-label: root.bulk-reject-label;
                            bulk-flag-on: root.bulk-flag-on;
                            bulk-reject-on: root.bulk-reject-on;
                            bulk-uniform-rating: root.bulk-uniform-rating;
                            set-rating(v) => { root.set-rating(v); }
                            set-flag(v) => { root.set-flag(v); }
                            set-reject(v) => { root.set-reject(v); }
                            bulk-mark(k) => { root.bulk-mark(k); }
                            bulk-rate(v) => { root.bulk-rate-ask(v); }
                        }
                    }
                }

                // ── dev HUD (F12) ──
                if root.dev-hud && (!root.immersive || root.chrome-fading) : Rectangle {
                    width: hud-label.preferred-width + 18px;
                    height: hud-label.preferred-height + 14px;
                    x: parent.width - self.width - 18px;
                    y: 14px;
                    opacity: root.chrome-eff; // M6 fade (no input inside)
                    background: #0a0c10ee; // dev-only F12 HUD: intentional off-theme "terminal" palette (slate #0a0c10 bg, #2b313a border, #7af0a6 green) — one-offs, never themed
                    border-radius: Theme.radius-sm;
                    border-width: 1px; border-color: #2b313a;
                    hud-label := Text {
                        x: 9px; y: 7px; text: root.hud-text; color: #7af0a6;
                        font-size: Theme.font-sm; horizontal-alignment: left;
                    }
                }

                // ── v0.8.35: immersive bottom-RIGHT reveal — the EXIF panel's action row (Flag / Reject /
                // interactive stars), lifted into the shared CullActionRow and floated on a GlassPanel card
                // (the BL RAW/zoom panel's material + the same 18px corner insets, so the two corners are
                // symmetric). Replaces the v0.8.33 display-only CullChip: the owner wanted the EXIF panel's real
                // interactive row, not a bespoke twin. FULLY INTERACTIVE while revealed — Flag / Reject / star
                // clicks route through the SAME set-flag / set-reject / set-rating callbacks the EXIF panel uses,
                // which re-arm the linger via the choke points (click → mutate → linger reload → card stays up).
                // Hovering the card keeps it alive via chip-panel-hot (the RAW panel's raw-panel-hot pattern).
                // Non-hittable while fading/hidden: every control + the swallow gate on the chip-revealed BOOL,
                // never opacity (the v0.7.2 click-steal rule), so the stage's 1:1 click / right-click menu / wheel
                // pass through in that corner. Single-view immersive only (absent in compare + normal); opacity
                // crossfades both directions (the M8 exit-fade exception); the mount lingers through the
                // fade-out via chip-reveal-eff, mirroring the chrome-fading mount-linger. ──
                if root.cull-card-mounted : cullcard := GlassPanel {
                    // The card's width follows its row exactly as the EXIF panel's does (v0.8.136 / V1).
                    // It never arms (the predicate is false in immersive and the mount binds none of
                    // the bulk inputs — both halves are rig-pinned), so its need is the single-photo
                    // row's. That need is NOT a constant to bake in: v0.8.137 grew the star cell to
                    // 123px and the row to 291px, and the fixed 308px card (276px of row) kept running
                    // the stars 15px into its right padding — 16px of margin on the left, 1px on the
                    // right — because nothing re-derived it. Binding to `line1-need` keeps the card
                    // centred on whatever the row costs (323px today). Right-anchored: x reads width.
                    width: max(308px, min(parent.width - 36px, cardrow.line1-need + 2 * Theme.space-4));
                    opacity: root.chip-reveal-eff;
                    x: parent.width - self.width - 18px;
                    y: parent.height - self.height - 18px;
                    height: cullcardbox.preferred-height;
                    backdrop: root.blur-backdrop;
                    sw: root.content-w; sh: root.content-h; ox: -root.stage-x; oy: 0;
                    hover-glass: true;
                    // keep-alive: hovering anywhere on the card (the swallow area OR any row control) feeds
                    // chip-panel-hot; the tick reloads the linger from it (mirrors raw-panel-hot). Slint hover is
                    // exclusive, so OR the swallow with the row's own hover-OR.
                    property <bool> anyhot: cullswallow.has-hover || cardrow.hot;
                    hot: cullcard.anyhot;
                    changed anyhot => { root.chip-panel-hot = cullcard.anyhot; }
                    cullswallow := TouchArea { enabled: root.chip-revealed; } // swallow + hover; dies while fading (bool gate)
                    cullcardbox := VerticalLayout {
                        padding: Theme.space-4;             // = the EXIF panel's infobox padding; the card's width adds it to the row's need
                        cardrow := CullActionRow {
                            hit: root.chip-revealed; // live only while revealed; non-hittable while fading/hidden
                            rating: root.rating; flagged: root.flagged; rejected: root.rejected;
                            set-rating(v) => { root.set-rating(v); }
                            set-flag(v) => { root.set-flag(v); }
                            set-reject(v) => { root.set-reject(v); }
                        }
                    }
                }

                // ── empty-state: no folder open / folder has no photos ──
                // ── U1) "Scanning…" indicator: a large folder scans OFF-THREAD, so instead of a frozen
                // window the OLD folder stays visible under a dimming scrim + a centred pill. Swallows
                // input while the swap is pending. Cleared by apply_scan when the ScanDone lands.
                if root.scanning || (root.opening-photo && !root.photo-ready) || root.opening-boundary-wait : folder-scan-overlay := Rectangle {
                    background: Theme.scrim-light; // light scrim — the previous folder shows through, dimmed
                    TouchArea {
                        scroll-event(e) => {
                            if (root.opening-boundary-wait && root.wheel-nav && !root.photo-popup-open) {
                                root.navigate-step(root.wheel-nav-dir(e.delta-x, e.delta-y));
                            }
                            accept
                        }
                    } // loading blocks photo clicks; reverse wheel browsing can cancel the wait
                    Rectangle {
                        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                        width: scanrow.preferred-width + 36px; height: 46px;
                        border-radius: 23px;
                        background: Theme.base;
                        drop-shadow-blur: Theme.shadow-blur; drop-shadow-color: Theme.shadow-control; drop-shadow-offset-y: Theme.shadow-dy; // v0.8.185 (D17, owner): 24/8/shadow-panel -> the app's heaviest class, on the W2 tokens
                        scanrow := HorizontalLayout {
                            padding-left: 18px; padding-right: 18px; spacing: 11px; alignment: center;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 12px; height: 12px; border-radius: 6px;
                                    background: Theme.accent;
                                }
                            }
                            Text {
                                text: @tr("falcon" => "Scanning folder…"); color: Theme.text;
                                font-size: Theme.font-lg; font-weight: 600; vertical-alignment: center;
                            }
                        }
                    }
                }

                // Opaque (covers the RAW/EXIF panels behind it) and swallows input.
                if root.empty-state && !root.scanning : Rectangle {
                    background: Theme.stage;
                    TouchArea {} // swallow clicks/scroll over the empty stage
                    VerticalLayout {
                        alignment: center; spacing: 16px;
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 80px; height: 80px;
                                Path {
                                    x: (parent.width - 60px) / 2; y: (parent.height - 60px) / 2;
                                    width: 60px; height: 60px; viewbox-width: 16; viewbox-height: 16;
                                    stroke: Theme.text-mute; stroke-width: 1.4px; fill: transparent; // 60px empty-state glyph — deliberately NOT icon-stroke (that weight is for <=16px glyphs)
                                    MoveTo { x: 2; y: 5; } LineTo { x: 6; y: 5; } LineTo { x: 7.4; y: 6.4; }
                                    LineTo { x: 14; y: 6.4; } LineTo { x: 14; y: 12.5; } LineTo { x: 2; y: 12.5; }
                                    LineTo { x: 2; y: 5; }
                                }
                            }
                        }
                        Text {
                            text: root.empty-text;
                            color: Theme.text; font-size: Theme.display-md; font-weight: 600;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: @tr("falcon" => "Open a photo, or any photo in a folder, to start culling.\nYou can also drag a photo or folder onto the window.");
                            color: Theme.text-mute; font-size: Theme.font-lg;
                            horizontal-alignment: center;
                        }
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: openbtn.preferred-width + 40px; height: 40px;
                                border-radius: Theme.radius-ctrl;
                                background: openta.has-hover ? Theme.accent : Theme.accent-soft;
                                border-width: 0px; border-color: Theme.accent;
                                animate background { duration: Theme.anim; easing: ease; }
                                openbtn := Text {
                                    text: @tr("falcon" => "Open photo or folder…");
                                    color: openta.has-hover ? Theme.text-on-accent : Theme.text;
                                    font-size: Theme.font-lg; font-weight: 600;
                                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                }
                                // v0.8.65 (C3/M6): same Image | Folder menu as the title-bar Open
                                // button, anchored under THIS button (absolute-position read on the
                                // x=0 TouchArea — the v0.8.45 rule; y converts window → overlay
                                // coords, the overlay starting at 44px when not immersive).
                                openta := TouchArea { clicked => {
                                    root.open-menu-x = self.absolute-position.x;
                                    root.open-menu-y = self.absolute-position.y + parent.height + 3px - (root.content-top);
                                    root.open-menu-open = true;
                                } }
                            }
                        }
                    }
                }

                // ── v0.8.50 (G2): the grid splitter — a 5px ew-resize lane on the stage's left
                // edge (the dock boundary). Dragging writes grid-dock-w SNAPPED to whole columns
                // (width-for-cols = 128·n + 8 — never a clipped part-column), clamped [2 columns ..
                // ⌊window/3⌋ columns, 2-col floor wins on small windows]. Rust (step_folder_grid /
                // grid_snap_width) re-validates the same formula every tick, so a window resize
                // re-snaps automatically. Declared LAST in the stage so it wins the edge's hits
                // (a 5px sliver of the photo's left edge — panels sit at x≥18 and stay clear).
                if root.grid-open && !root.immersive && !root.empty-state : TouchArea {
                    x: 0; width: 5px; height: 100%;
                    mouse-cursor: ew-resize;
                    moved => {
                        if (self.pressed) {
                            root.grid-dock-w = clamp(
                                Math.round(((self.absolute-position.x + self.mouse-x) - 8px) / 128px),
                                2.0,
                                max(2.0, Math.floor((root.width / 3 - 8px) / 128px))
                            ) * 128px + 8px;
                        }
                    }
                }
            }
            } // v0.8.50 (G1): the stage row ([grid dock | stage])

            // ── filmstrip ── (hidden in immersive mode)
            // The current shot is kept CENTRED: the row is a virtualized window positioned
            // by `film-offset-px` so the current thumb sits at the strip's centre and its
            // neighbours overflow + clip at both edges. The offset is driven smoothly by the
            // tick (lerp) for nav and directly by dragging the strip to preview.
            // M6 (v0.8.19): SLOT + INNER split. The slot's height keys on the RAW immersive bool —
            // 102px → 0px the same frame (the stage row stretches instantly, exactly the v0.8.18
            // unmount reflow) — while fsinner keeps the strip's fixed 102px metrics and rides the
            // collapsing slot upward (y: parent.height - 102px ⇒ 0 when open, -102 when collapsed),
            // painting over the stage bottom as it fades by chrome-eff (the filmstrip is declared
            // AFTER the stage, so its overflow shows). clip moved onto fsinner — a clipping slot
            // would cut the overflow. Mount lingers via chrome-fading, then drops = today's cost.
            if (!root.immersive || root.chrome-fading) && !root.empty-state && root.film-visible : Rectangle {
                height: root.immersive ? 0px : 102px;
                fsinner := Rectangle {
                y: parent.height - 102px;
                width: 100%; height: 102px;
                opacity: root.chrome-eff; // M6 fade (input dies on the bool via the gates below)
                background: Theme.base; // strip matches the flat app base
                clip: true;
                // v0.8.27: which thumb the cursor is over — drives the per-thumb hover LIFT through the
                // strip-wide ta (which occludes the thumbs' own TouchAreas, so FilmThumb can't self-hover).
                // Grid coordinate = (mouse-x − film-offset-px) / 128 (120px thumb + 8px gap — the same
                // mapping film-clicked uses in Rust). No lift in the 8px gaps or outside the 11..91px
                // thumb band (the scrollbar strip / bottom edge); −1 whenever the cursor leaves the
                // strip or an overlay (compare-drag dim, a panel) owns hover.
                // v0.8.135 (W2c): the gap fraction is `root.film-thumb-frac`, published from
                // `support::FILM_THUMB_FRAC` — the SAME number the Rust receiver divides by. It was a
                // literal 0.9375 here and a bare `floor()` there, so this site correctly showed no
                // lift over a gap while the click it did not advertise navigated anyway.
                property <float> hov-fx: (ta.mouse-x - root.film-offset-px) / 128px;
                property <int> hover-k: (ta.has-hover
                    && ta.mouse-y >= 11px && ta.mouse-y < 91px
                    && self.hov-fx >= 0.0 && self.hov-fx < root.film.length
                    && self.hov-fx - Math.floor(self.hov-fx) < root.film-thumb-frac)
                    ? Math.floor(self.hov-fx) : -1;
                // v0.8.191 (H2): the title bar's rule and this one are the app's two longest. This
                // one sits at H − 102, so its device row follows the window height's PARITY (1197.0
                // at H 900, 1198.5 at H 901) while the bar's is pinned at 64.5 in every state —
                // opposite phases at even heights, the same phase at odd ones, and a tie either
                // way. See the banner at `barrule`. Slot byte-identical; the ink is the shared
                // anti-aliased hairline. Both parities are swept in the rig row
                // `the_two_longest_rules_are_one_anti_aliased_drawing`.
                fsrule := AaHairline { y: 0; height: 1px; width: 100%; tint: Theme.divider; }
                HorizontalLayout {
                    x: root.film-offset-px;
                    y: 11px; height: parent.height - 22px;
                    spacing: 8px;
                    for item[i] in root.film : FilmThumb {
                        hit: !root.immersive; // M6 gate (see FilmThumb: exposed-once-ta-disables class)
                        lift: i == fsinner.hover-k && item.badge != ""; // v0.8.27: strip-driven hover lift (VOID edge slots never lift)
                        width: 120px; // 3:2 against the ~80 px inner height
                        thumb: item.thumb;
                        number: item.number;
                        badge: item.badge;
                        is-current: item.current;
                        valid: item.valid;
                        loading: item.pending;
                        unsupported: item.unsupported;
                        failed: item.failed; // v0.8.120 (Y48): the runtime decode-failure latch
                        rating: item.rating;
                        flag: item.flag;
                        reject: item.reject;
                        // v0.8.129 (W1-3): SELECTED, or the current photo previewing the range origin
                        // while Shift is held. Composed here (not inside FilmThumb) so the preview
                        // rule is stated once for all three tile surfaces.
                        selected: item.selected || (root.sel-preview && item.current);
                        // v0.8.133 (D): ...and the CTRL ghost. The thumb ANDs this with `lift` (the
                        // strip-wide area drives the per-thumb hover) and with its own badge, so a
                        // VOID edge slot — where a click selects nothing — never promises one.
                        ctrl-preview: root.sel-ctrl-preview;
                    }
                }
                // one strip-wide area handles wheel, drag-to-preview, click-to-jump, and (v0.8.27)
                // drag-UP-to-compare. It sits over the thumbs, so the per-thumb hover lift is driven
                // from HERE (fsinner.hover-k), not from each thumb's occluded TouchArea.
                // v0.8.27 GESTURE CONTRACT: on left-down the press is `gesture` 0 (pending). Every
                // `moved` below the ~10px slop keeps feeding film-drag-move — a horizontal drag is
                // byte-identical to the classifierless strip (it never waits for the slop). Past the
                // slop, film-classify (pure Rust: film_drag_classify) answers ONCE and the result
                // STICKS for the rest of the press — no mid-drag reclassification: 1 = horizontal →
                // the native scrub continues; 2 = compare-up (within ±film-cone-deg of straight up)
                // → the strip STOPS scrubbing (one film-drag-move(0) undoes the ≤ slop·sin(cone) px
                // pre-classification drift) and the press becomes the SHARED Selection compare-drag
                // (sel-drag-* + the centred A/B drop zones + sel-to-compare: drop on a half assigns
                // it, release anywhere else cancels). Downward or outside the cone → horizontal, so
                // the strip's native feel wins every ambiguous case; a press on a VOID edge slot
                // never enters compare (degrades to horizontal).
                ta := TouchArea {
                    enabled: !root.immersive; // M6 gate: dies the frame immersive engages
                    // v0.8.52 (owner fix 1, supersedes the v0.8.50 lower band): the HIDE pill anchors
                    // at the strip's TOP boundary (the strip/stage edge — the owner's sketch), so the
                    // strip-side proximity zone is its TOP band (half the edge-zone; the stage TA's
                    // bottom band covers the boundary's other flank). Same M8 push-to-root observer —
                    // no new hit surface. The strip's seek bar (top 12px, when mounted) owns hover
                    // there, so the effective band is ~12..30px — the stage flank covers the rest.
                    property <bool> fs-edge: self.has-hover && self.mouse-y <= Theme.edge-zone / 2;
                    changed fs-edge => { root.film-edge-hot = self.fs-edge; }
                    property <bool> dragged: false;
                    property <int> gesture: 0;  // v0.8.27: 0 pending / 1 horizontal / 2 compare-up — STICKY per press
                    property <int> press-k: -1; // v0.8.27: thumb-grid index captured at DOWN (pre-drift; film-clicked's mapping)
                    property <int> press-idx: -1; // v0.8.34 (C1): ABSOLUTE shot idx captured at DOWN — classify consumes THIS, not the live model (a tick can rebuild film[] mid-press)
                    property <image> press-thumb; // v0.8.34 (C1): the drag-ghost thumb captured at DOWN alongside press-idx
                    // v0.8.127: the one surface where the horizontal axis is the OBVIOUS one — the
                    // strip runs left-to-right, so a tilt right walks forward along it. (0 = neither
                    // axis moved; `on_film_scroll` treats that as a no-op.)
                    // v0.8.150 (J3): the modal gate again — a modal's scrim starts at y:44 and covers
                    // the filmstrip too, so a wheel notch over the strip under an open Settings sheet
                    // was stepping the shot exactly as one over the stage was.
                    scroll-event(e) => { if (!root.photo-popup-open) { root.film-scroll(root.wheel-nav-dir(e.delta-x, e.delta-y)); } accept } // v0.8.155 (D1a): the third of the three wheel gates — one predicate, no per-surface drift
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                            self.dragged = false;
                            self.gesture = 0;
                            self.press-k = Math.floor((self.mouse-x - root.film-offset-px) / 128px);
                            // v0.8.34 (C1): capture the shot's ABSOLUTE identity NOW, while the row is valid —
                            // classify (past the slop) must not re-index the live model, which a tick can rebuild.
                            if (self.press-k >= 0 && self.press-k < root.film.length && root.film[self.press-k].badge != "") {
                                self.press-idx = root.film[self.press-k].idx;
                                self.press-thumb = root.film[self.press-k].thumb;
                            } else {
                                self.press-idx = -1;
                            }
                            root.film-drag-start();
                        }
                        // v0.8.38 (G2): right-click a thumb → NO navigation. Target THE CLICKED thumb's shot
                        // (its absolute idx) and open the SAME context menu the stage uses, target-scoped. Only
                        // opens over a real thumb (VOID edge slots — badge "" — are ignored). 128px = 120 thumb + 8 gap.
                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                            self.press-k = Math.floor((self.mouse-x - root.film-offset-px) / 128px);
                            if (self.press-k >= 0 && self.press-k < root.film.length && root.film[self.press-k].badge != "") {
                                root.ctx-target = root.film[self.press-k].idx;
                                root.ctx-populate(root.film[self.press-k].idx);
                                root.ctx-x = self.absolute-position.x + self.mouse-x;
                                root.ctx-y = self.absolute-position.y + self.mouse-y - (root.content-top);
                                root.ctx-open = true;
                                root.settings-open = false;
                                root.loading-open = false;
                            }
                        }
                        if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) {
                            if (self.gesture == 2) {
                                // compare-up release: a zone assigns that half, anywhere else cancels —
                                // NEVER a click/jump (the press left the click contract at the slop).
                                // Guarded on sel-dragging so the overlay's safety-net TouchArea can't
                                // double-finalise if the grab was lost mid-drag.
                                if (root.sel-dragging) {
                                    if (root.sel-drag-zone >= 0) { root.sel-to-compare(root.sel-drag-idx, root.sel-drag-zone); }
                                    root.sel-dragging = false;
                                    root.sel-drag-zone = -1;
                                }
                            } else if (!self.dragged) {
                                // v0.8.129 (W1-2): a MODIFIED clean click is a selection gesture, not
                                // a jump. It consumes `press-idx` — the ABSOLUTE shot identity
                                // captured at DOWN, which is also the VOID guard: a press past the
                                // ends (or on an edge slot with badge "") left it at -1, and the
                                // gesture is refused there rather than landing on shot -1.
                                if (root.sel-gesture-kind(e.modifiers.control, e.modifiers.shift) >= 0) {
                                    if (self.press-idx >= 0) {
                                        root.sel-gesture(self.press-idx, root.sel-gesture-kind(e.modifiers.control, e.modifiers.shift), false);
                                    }
                                } else if (root.neighbour-browse-allowed(e.modifiers.control, e.modifiers.shift)) { root.film-clicked(self.mouse-x, self.mouse-y); }
                            }
                            // ALWAYS end the drag on release — a sub-4px jitter fires `moved` (→ film-drag-move
                            // sets film_dragging=true) without ever setting `dragged`, so a guarded end would
                            // strand film_dragging=true and freeze the frosted backdrop (audit ORANGE).
                            root.film-drag-end();
                            self.gesture = 0;
                            self.press-k = -1;
                            self.press-idx = -1;
                        }
                        if (e.kind == PointerEventKind.cancel) {
                            // v0.8.27: grab lost mid-press (focus steal / popup) — abandon WITHOUT
                            // assigning (RankRow's cancel class) and unfreeze the strip state so
                            // film_dragging can't strand true (the same audit-ORANGE hazard as up).
                            if (self.gesture == 2 && root.sel-dragging) {
                                root.sel-dragging = false;
                                root.sel-drag-zone = -1;
                            }
                            root.film-drag-end();
                            self.gesture = 0;
                            self.press-k = -1;
                            self.press-idx = -1;
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            if (self.gesture == 0) {
                                self.gesture = root.film-classify(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                                if (self.gesture == 2 && (root.opening-photo || root.photo-popup-open)) {
                                    self.gesture = 1; self.dragged = true;
                                }
                                if (self.gesture == 2) {
                                    if (self.press-idx >= 0) {
                                        root.film-drag-move(0px); // undo the pre-classification scrub drift (≤ slop·sin(cone) px)
                                        root.sel-drag-idx = self.press-idx;   // v0.8.34 (C1): DOWN-captured identity, not the live model
                                        root.sel-drag-thumb = self.press-thumb;
                                        root.sel-drag-zone = -1;
                                        root.sel-dragging = true;
                                    } else {
                                        self.gesture = 1; // VOID edge slot — nothing to drag; the strip behaves natively
                                    }
                                }
                            }
                            if (self.gesture == 2) {
                                root.sel-drag-x = self.absolute-position.x + self.mouse-x;
                                root.sel-drag-y = self.absolute-position.y + self.mouse-y;
                                root.sel-drag-zone = root.drop-zone-at(root.sel-drag-x, root.sel-drag-y);
                            } else {
                                if ((self.mouse-x - self.pressed-x) > 4px || (self.pressed-x - self.mouse-x) > 4px) {
                                    self.dragged = true;
                                }
                                root.film-drag-move(self.mouse-x - self.pressed-x);
                            }
                        }
                    }
                }
                // TOP mini scrollbar — press/drag to seek anywhere in a big folder fast. At the TOP of
                // the strip (user call: the strip sits on the window's bottom edge, so a bottom bar
                // collided with the OS resize zone). Declared AFTER `ta` so the band wins its hits;
                // wheel still falls through to the strip. Hidden when the whole folder fits.
                if root.film-vis-frac < 0.999 : Rectangle {
                    y: 0; height: 12px; width: 100%;
                    property <length> padl: 8px;
                    property <length> trackw: self.width - 2 * self.padl;
                    property <length> thumbw: max(28px, self.trackw * root.film-vis-frac);
                    barta := TouchArea {
                        enabled: !root.immersive; // M6 gate
                        // centre the thumb on the cursor: frac maps the thumb's travel range
                        moved => { if (self.pressed) { root.film-seek((self.mouse-x - parent.padl - parent.thumbw / 2) / (parent.trackw - parent.thumbw)); } }
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                root.film-seek((self.mouse-x - parent.padl - parent.thumbw / 2) / (parent.trackw - parent.thumbw));
                            }
                        }
                    }
                    Rectangle { // track
                        x: parent.padl; y: 4px; height: 4px; width: parent.trackw;
                        border-radius: 2px;
                        background: barta.has-hover || barta.pressed ? Theme.block : transparent;
                        animate background { duration: Theme.anim; easing: ease; }
                    }
                    Rectangle { // thumb (proportional width, accent while engaged)
                        x: parent.padl + (parent.trackw - parent.thumbw) * max(0.0, min(1.0, root.film-frac));
                        y: 3px; height: 6px; width: parent.thumbw;
                        border-radius: 3px;
                        background: barta.pressed ? Theme.accent : (barta.has-hover ? Theme.text-mute : Theme.block);
                        opacity: barta.has-hover && !barta.pressed ? 0.55 : 1.0;
                        animate background, opacity { duration: Theme.anim; easing: ease; }
                    }
                }
                } // fsinner (M6)
            }
        }

        // ── v0.8.50 (G2): the edge-pill reveal overlays (owner design) ──
        // Mouse near the bottom/left edge → a gradient scrim (Theme-token stops, colour-managed)
        // fades in alongside the pill; away → fades out. TRANSIENT by construction: the whole
        // layer is visible only while revealing/revealed (opacity-0 = unmounted from paint+input),
        // the scrim itself hosts NO input surface, and the pill's TouchArea enables only once
        // meaningfully revealed (a disabled TA passes events through) — so nothing here can
        // click-steal at rest. Proximity comes from the surfaces that already own those pixels
        // (the M8 corner-reveal route): the stage TA's zones, the strip TA's lower band, the
        // dock's pad lane — plus each pill's own hover, which keeps its reveal alive while aimed.
        // Immersive is fully gated off (the corner-reveal system owns immersive); the pills act
        // on click: bottom = show/hide FILMSTRIP (the new capability, edge-pill-only access),
        // left = show/hide the folder-grid dock (the title-bar grid SectionChip's twin trigger —
        // the path pill was a third route until v0.8.192 returned it to click-to-copy).
        // v0.8.52 (owner fix 1): the pills anchor to their SECTION's edge, not the window's —
        // HIDE pills sit on the section's inner boundary (hide-filmstrip at the strip's TOP edge,
        // horizontally centred; hide-grid at the dock's RIGHT edge, vertically centred — the
        // owner's sketch), while SHOW pills stay at the window edges (with the section hidden,
        // the window edge IS the right anchor — v0.8.50 unchanged). Each scrim rides its pill:
        // the same edge-anchored gradient, repositioned to emanate from the section boundary.
        bedge := Rectangle {
            x: 0; width: 100%;
            // ── v0.8.188 (L46, the round's own class at the SECOND host): ─────────────────────
            // The band's bottom edge is the anchor that means something (the strip's top boundary,
            // or the window's bottom); its TOP was `anchor - 60`, so the band's origin — and every
            // mount hanging off it, including the pill that draws the same FilmFrameBlock the title
            // bar does — inherited the WINDOW HEIGHT's parity. The anchor is named once and the top
            // is snapped to the even logical grid, with the height taking up the ≤1px difference so
            // the bottom stays EXACTLY on the anchor (a scrim that is opaque at its bottom edge
            // must not float 1px off it).
            property <length> band-bot: root.film-visible ? parent.height - 102px // band ends AT the strip's top boundary
                                                          : parent.height;        // show mode: the window's bottom edge
            y: Math.round((self.band-bot - Theme.edge-zone) / 2px) * 2px;
            height: self.band-bot - self.y;
            property <bool> target: !root.immersive && !root.empty-state
                && (root.film-edge-hot || root.stage-bot-hot || bpill.hovered);
            property <float> reveal: self.target ? 1.0 : 0.0;
            animate reveal { duration: Theme.anim-med; easing: ease; }
            property <float> eff: root.motion-ui ? self.reveal : (self.target ? 1.0 : 0.0);
            visible: self.eff > 0.001;
            Rectangle { // the gradient scrim — pure paint, no input (opaque stop at the band's bottom = the anchor edge)
                width: 100%; height: 100%;
                background: @linear-gradient(0deg, Theme.scrim-edge 0%, Theme.scrim-edge-clear 100%);
                opacity: bedge.eff;
            }
            bpill := EdgePillBottom {
                // v0.8.188 (L46): the SAME defect the title-bar row carried, at the pill that draws
                // the SAME glyph. `(parent.width - self.width) / 2` over a full-window-width parent
                // cycles this pill's origin through the identical 4-phase set — at W = 1440 it lands
                // on 677, so the block's frame edges sat at ODD logical x (709 / 715 / 717 / …) and
                // every vertical edge fell on a half device column at 150%: the pale-frames phase
                // the owner reported, reachable here too. Snapped to the even grid, at most 1px off
                // exact centre in an 86px pill.
                x: Math.round((parent.width - self.width) / 2 / 2px) * 2px;
                // hide mode: 4px above the strip's top boundary; show mode: 12px above the window
                // bottom (clear of the 8px OS resize border).
                // v0.8.188: and the y half — this offset resolved to an absolute H − 40 (show) /
                // H − 134 (hide), i.e. the WINDOW HEIGHT's parity. The band's top is even now (see
                // `band-bot` above) and this offset is snapped to even on top of it, so the pill's
                // absolute origin is even at BOTH window-height parities. The ≤1px this can move
                // the pill within its band is spent against a 12px (or 4px) breathing gap.
                y: Math.round((parent.height - self.height - (root.film-visible ? 4px : 12px)) / 2px) * 2px;
                opacity: bedge.eff;
                strip-visible: root.film-visible;
                hit: bedge.eff > 0.5;
                clicked => {
                    root.film-visible = !root.film-visible;
                    // the strip (or the stage zone) may unmount/flip mid-hover — a destroyed TA
                    // never fires its changed has-hover, so reset the source flags deterministically
                    // (the v0.8.21 cache-meter-hover rule).
                    root.film-edge-hot = false;
                    root.stage-bot-hot = false;
                }
            }
        }
        ledge := Rectangle {
            // hide mode: the band starts AT the dock's right boundary; show mode: the window's left edge
            x: root.grid-open ? root.grid-dock-w : 0px;
            y: root.content-top;
            width: Theme.edge-zone;
            height: parent.height - self.y - root.film-band; // v0.8.162: the one shared band predicate (was this expression, spelled out)
            property <bool> target: !root.immersive && !root.empty-state
                && (root.dock-lane-hot || root.stage-left-hot || lpill.hovered);
            property <float> reveal: self.target ? 1.0 : 0.0;
            animate reveal { duration: Theme.anim-med; easing: ease; }
            property <float> eff: root.motion-ui ? self.reveal : (self.target ? 1.0 : 0.0);
            visible: self.eff > 0.001;
            Rectangle { // the gradient scrim — pure paint, no input (opaque stop at the band's left = the anchor edge)
                width: 100%; height: 100%;
                background: @linear-gradient(90deg, Theme.scrim-edge 0%, Theme.scrim-edge-clear 100%);
                opacity: ledge.eff;
            }
            lpill := EdgePillLeft {
                // hide mode: 4px right of the dock boundary; show mode: 12px in from the window edge
                x: root.grid-open ? 4px : 12px;
                // v0.8.188 (L46): its own axis. `ledge`'s y is 44 or 0 — both even — so an even
                // offset here is enough to put this pill's absolute origin on the even grid, which
                // the raw halving never did (the band's height is H − 44 − the film band, so the
                // divide handed the pill the window height's parity). Its x needs nothing: 4 and 12
                // are even literals. RESIDUE: in hide mode `ledge.x` is the draggable dock width,
                // which this round does not own.
                y: Math.round((parent.height - self.height) / 2 / 2px) * 2px;
                opacity: ledge.eff;
                grid-open: root.grid-open;
                hit: ledge.eff > 0.5;
                clicked => {
                    root.grid-open = !root.grid-open;
                    root.dock-lane-hot = false; // same stranded-flag rule as the bottom pill
                    root.stage-left-hot = false;
                }
            }
        }

        // ── title bar VISUAL (M6, v0.8.19) ── hoisted OUT of the VerticalLayout: the stage is a
        // LATER sibling there and paints over layout overflow, so an in-layout bar could never show
        // its fade — and keeping it in the layout while fading would hold the stage 44px down. The
        // 44px SLOT left in the layout keys the geometry: it mount-culls on the immersive bool alone,
        // so the stage snaps to full height the SAME frame while this overlay fades by chrome-eff and
        // then unmounts (chrome-fading). motion OFF ⇒ the condition collapses to !immersive = v0.8.18.
        // Content, metrics and every binding inside are byte-identical to the in-layout bar apart
        // from the M6 input gates + M7 chip fade; the 44px cells / hudclip 286+180 / 250px chip
        // threshold / 200px path cap are untouched. All input dies on the bool (see gates within).
        // ── v0.9.69 (OWNER RULING §8b): THE IMMERSIVE REVEAL DISJUNCT IS GONE, AND IT IS THE CLICK
        // DEFECT'S OWN MECHANISM. v0.9.67 mounted this overlay in immersive too, on
        // `bar-reveal-eff`, and its note said the quiet part out loud: "The bar stays VISUAL while
        // immersive: every input gate inside reads `!root.immersive` and is untouched, so the
        // revealed bar is a place for the OS's own buttons to be, not a second route into Falcon's
        // controls." That IS the tester's 7b report — a fullscreen bar whose traffic lights work
        // (AppKit NSViews, which no Slint gate can reach) while Settings, Review and the rest are
        // visible and inert. The owner's ruling deletes the state rather than the gates: immersive
        // shows the STOCK system strip, and this overlay is back to meaning what it meant in
        // v0.9.66 — the chrome is up, or it is fading out. Both bindings below are byte-identical
        // to v0.9.66 on BOTH platforms (`bar-reveal-eff` was a constant 0 off macOS, and on macOS
        // its only writer is deleted). Every `hit:` gate inside is untouched: with the disjunct
        // gone, this bar mounts only where `!root.immersive` is true, so they are all live whenever
        // it is on screen — including §8b's chrome-up fullscreen, the maximize workspace.
        if !root.mac-experiment-host && (!root.immersive || root.chrome-fading) : MainToolbar {
            x: 0; y: 0; width: 100%;
            cache-frac-after: root.cache-frac-after;
            cache-frac-before: root.cache-frac-before;
            cache-len-after: root.cache-len-after;
            cache-len-before: root.cache-len-before;
            cache-meter-hover: root.cache-meter-hover;
            cache-meter-show: root.cache-meter-show;
            chrome-eff: root.chrome-eff;
            compare: root.compare;
            count-all: root.count-all;
            count-picks: root.count-picks;
            count-rejects: root.count-rejects;
            dbg-chrome: root.dbg-chrome;
            efficiency-leaf: root.efficiency-leaf;
            empty-state: root.empty-state;
            film-visible: root.film-visible;
            grid-open: root.grid-open;
            hud-pos: root.hud-pos;
            hud-pos-widest-a: root.hud-pos-widest-a;
            hud-pos-widest-b: root.hud-pos-widest-b;
            immersive: root.immersive;
            loading-open: root.loading-open;
            maximized: root.maximized;
            modal-blocking: root.modal-blocking;
            motion-ui: root.motion-ui;
            native-window-controls: root.native-window-controls;
            notif-open: root.notif-open;
            notif-unread: root.notif-unread;
            path-dir: root.path-dir;
            path-mid: root.path-mid;
            path-text: root.path-text;
            sel-open: root.sel-open;
            settings-open: root.settings-open;
            titlebar-h: root.titlebar-h;
            titlebar-leading-inset: root.titlebar-leading-inset;
            action(a,x,y) => { root.toolbar-action(a, x * 1px, y * 1px); }
            meter-hover(h,x,y) => { root.cache-meter-hover = h; if h { root.cache-meter-cx = x * 1px; root.cache-meter-cy = y * 1px + 3px; } }
            dbg-chips-log(a,b,c,d,e,f,g,h,i) => { root.dbg-chips-log(a,b,c,d,e,f,g,h,i); }
        }

        // ── Settings popup (overlay) ──
        // All popup/modal overlays start UNDER the title bar (y:44) so the title bar stays usable
        // no matter what is open (user rule); inner offsets + `oy` compensate, pixel-identical.
        if root.settings-open : Rectangle {
            y: root.content-top;
            height: parent.height - self.y;
            width: 100%;
            TouchArea { clicked => { root.settings-open = false; } }
            GlassPanel {
                // floating panel — 3px gap from the window edge + title bar (matches the title-bar hover inset).
                // v0.8.81 hotfix: the old literal 360px promoted to Theme.section-w (320, the body the
                // sections actually render at) + the setbox side padding — SAME resolved 360px, but the
                // welcome columns now share the single source (owner ruling: one section width limit).
                // Rounded/opacity layers resample their text at fractional device origins.
                // Snap the absolute panel origin, including the native toolbar inset.
                property <float> sfx: max(root.win-sf, 0.5);
                x: Math.round(3 * self.sfx) / self.sfx * 1px;
                y: Math.round((root.content-top / 1px + 3 - (1.0 - root.set-eff) * 8) * self.sfx) / self.sfx * 1px - root.content-top;
                width: Theme.section-w + 2 * Theme.space-5;
                opacity: root.set-eff; // M5 enter-only fade+slide (eff snaps to 1 on a switch / motion off; hits NOT gated)
                // F6 (v0.7.9): FILLS the available height like the Selection panel (v0.7.0
                // contract) rather than hugging content via setbox.preferred-height — short
                // content now just leaves empty panel space below. `parent` here is the
                // wrapping Rectangle above, already offset past the title bar (y:44, or 0
                // immersive), so this reaches 3px above the window bottom — the same absolute
                // geometry as the Selection panel's `parent.height - 47px - 3px`.
                height: parent.height - 3px - 3px;
                backdrop: root.blur-backdrop;
                sw: root.content-w; sh: root.content-h; ox: 0px; oy: 0px;
                TouchArea {}
                setbox := VerticalLayout {
                    padding: Theme.space-5; spacing: Theme.space-2;
                    PanelHeader { title: @tr("falcon" => "Settings"); dismiss => { root.settings-open = false; } }
                    // The whole body scrolls (controls included), stretching to the panel's remaining height (F6, v0.7.9).
                    setflick := Flickable {
                        // Wheel steps on a Slint Flickable jump INSTANTLY (no easing) — on a tall panel
                        // that reads as "low frame rate" scrolling (user report). A short ease glides
                        // each notch; drag-scroll picks up a subtle ~80ms trail, an acceptable trade.
                        // (80ms stays INLINE — sole consumer; the token rule mints only at a second use.
                        // G12 v0.8.44 audit: the filmstrip's 65ms hover-in became 0ms in Item 7, so NO
                        // 65ms consumers remain and Theme.anim-xfast was deliberately NOT minted.)
                        animate viewport-y { duration: 80ms; easing: ease-out; }
                        // frozen while the pointer is over the copy-list grip OR a reorder is in flight, so
                        // the scroll can't steal the near-vertical reorder gesture. Driven by the list's
                        // hover-computed freeze-scroll (NOT a press-time flag) so the Flickable never grabs
                        // the grip press → no stale scroll-grab that kept the page dragging after release.
                        interactive: !copylist.freeze-scroll;
                        // F6 (v0.7.9): stretches to fill setbox's remaining height (setbox is a
                        // VerticalLayout, so vertical-stretch works) — the Selection panel's grid
                        // Flickable uses the same mechanism, now that the GlassPanel above is fixed-height.
                        vertical-stretch: 1;
                        max-height: 100000px; // stretch-class absorber (v0.8.3 rule): defensive opt-out so a short body can't split surplus to a stretch-0 sibling
                        viewport-height: body.preferred-height;
                        viewport-width: self.width;
                        body := VerticalLayout {
                            width: parent.width;
                            spacing: 8px;
                            Rectangle { height: 4px; }
                            // Owner ruling (4 October): LANGUAGE leads Settings, so someone who cannot
                            // read the current language finds it by position; each language is listed
                            // in its own name.
                            SectionLabel { text: @tr("falcon" => "LANGUAGE"); }
                            SettingsGroup {
                                title: @tr("falcon" => "Language");
                                // A dropdown, not a segmented row: the list grows with every language
                                // pack and a language's own name can be long, so each needs a whole
                                // row (round-1 review R5). The trigger is the watermark Font
                                // selector's grammar; the menu is the sort menu's (mounted below).
                                HorizontalLayout {
                                    padding-left: 12px; padding-right: 12px;
                                    languagebtn := Rectangle {
                                        height: 30px; border-radius: Theme.radius-ctrl; background: Theme.well;
                                        border-width: 1px;
                                        border-color: root.language-menu-open ? Theme.accent
                                                    : (languageta.has-hover ? Theme.hover : Theme.border-strong);
                                        animate border-color { duration: Theme.anim; easing: ease; }
                                        horizontal-stretch: 1;
                                        HorizontalLayout {
                                            padding-left: Theme.space-2h; padding-right: Theme.space-2h; spacing: Theme.space-1h;
                                            Text { text: root.language-options[root.language-sel];
                                                   color: Theme.text; font-size: Theme.font-md; vertical-alignment: center;
                                                   horizontal-stretch: 1; overflow: elide; }
                                            Rectangle {
                                                width: 16px;
                                                ChevronGlyph {
                                                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                                    width: 12px; height: 12px;
                                                    points-down: !root.language-menu-open;
                                                    tint: Theme.text-mute;
                                                }
                                            }
                                        }
                                        languageta := TouchArea {
                                            mouse-cursor: pointer;
                                            // Claim focus first (the O26 idiom): Escape closes this menu
                                            // in the `keys` scope, a sibling of Settings, so a Settings
                                            // text field left focused would swallow it (re-check R5).
                                            clicked => {
                                                keys.focus();
                                                root.language-menu-x = self.absolute-position.x;
                                                root.language-menu-y = self.absolute-position.y + self.height + 4px;
                                                root.language-menu-w = self.width;
                                                root.language-menu-open = true;
                                            }
                                        }
                                    }
                                }
                                if root.language-restart : VerticalLayout {
                                    padding-left: 12px; padding-right: 12px;
                                    Text { text: @tr("falcon" => "Restart Falcon to use the new language.");
                                           color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap; }
                                }
                            }
                            Rectangle { height: 4px; }
                            SectionLabel { text: @tr("falcon" => "INPUT"); }
                            SettingsGroup {
                                title: @tr("falcon" => "While the folder is loading");
                                HorizontalLayout {
                                    padding-left: 12px; padding-right: 12px;
                                    photoopenseg := Seg {
                                        horizontal-stretch: 1;
                                        opts: [@tr("falcon" => "View only"), @tr("falcon" => "Allow photo edits")];
                                        sel: root.photo-open-edits ? 1 : 0;
                                        bg: Theme.well;
                                        changed(i) => { root.photo-open-edits = i == 1; keys.focus(); }
                                    }
                                }
                                VerticalLayout {
                                    padding-left: 12px; padding-right: 12px;
                                    photo-open-caption := Text { text: @tr("falcon" => "Applies when you open a single photo and the rest of its folder is still loading.");
                                           color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap; }
                                }
                            }
                            ToggleRow {
                                bg: Theme.block;
                                label: @tr("falcon" => "Mouse wheel changes photo"); on: root.wheel-nav;
                                toggled => { root.wheel-nav = !root.wheel-nav; }
                            }
                            // v0.8.37 (FIX B): re-press the number key of the current rating to clear it.
                            ToggleRow {
                                bg: Theme.block;
                                label: @tr("falcon" => "Press current rating again to clear"); on: root.same-key-clear;
                                toggled => { root.same-key-clear = !root.same-key-clear; }
                            }
                            // G5: opt-in scrub backpressure — don't advance onto a shot with
                            // nothing to show yet (some prefer to blur through fast).
                            // v0.8.125 (C7): GROUP form, because the row now carries a caption —
                            // the lone `bg: block` standalone never does (the O29 / Adaptive Hi-Res
                            // grammar). The caption exists because the setting's scope changed:
                            // it governs the WHEEL as well as the held keys now, and the owner
                            // report was precisely that the two behaved differently under one
                            // switch. It also no longer waits on a full decode — the bar is the
                            // preview — so the sentence promises what the code does.
                            SettingsGroup {
                                VerticalLayout {
                                    padding-top: 0px; padding-bottom: 12px; spacing: 0px;
                                    ToggleRow {
                                        bg: transparent; bw: 0px;
                                        label: @tr("falcon" => "Never browse onto a blank photo"); on: root.scrub-wait-cache;
                                        toggled => { root.scrub-wait-cache = !root.scrub-wait-cache; }
                                    }
                                    VerticalLayout {
                                        padding-left: 12px; padding-right: 12px; spacing: Theme.space-1h;
                                        Text {
                                            text: @tr("falcon" => "Browsing waits until the next photo has something to show — a thumbnail or a preview — instead of landing on an empty frame. Applies to the wheel and the arrow keys, in single view and in compare.");
                                            color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                            // v0.8.11 (F3 / #16): resume-position memory cap. LRU — the most-recently-opened
                            // folders keep their "you were here" mark; 0 = off (no resume prompt, forget all).
                            // v0.8.14 (Item 1): wrapped in the block card its siblings use (SettingsGroup =
                            // Theme.block + radius-ctrl 9px, concentric with inner hovers); title / subline /
                            // control rhythm mirrors the Fast View card below (pt16 / pb12 / sp9, 12px sides).
                            SettingsGroup {
                                title: @tr("falcon" => "Resume position memory");
                                VerticalLayout {
                                    padding-left: 12px; padding-right: 12px; spacing: Theme.space-1h;
                                    Text { text: root.resume-cap-custom > 0 ? @tr("falcon" => "{n} folder remembered" | "{n} folders remembered" % root.resume-cap-custom)
                                               : [@tr("falcon" => "off — no resume prompt"), @tr("falcon" => "last 3 folders"), @tr("falcon" => "last 10 folders")][root.resume-cap-tier];
                                           color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap; }
                                }
                                VerticalLayout {
                                    padding-left: 12px; padding-right: 12px; spacing: 7px;
                                    CustomSeg {
                                        stops: ["0", "3", "10"];
                                        index: root.resume-cap-tier;
                                        custom: root.resume-cap-custom;
                                        picked(i) => { root.resume-cap-tier = i; root.resume-cap-custom = 0; root.resume-cap-changed(); }
                                        custom-committed(t) => { if (t != "") { root.set-resume-cap-custom(t); } keys.focus(); }
                                    }
                                }
                            }
                            // v0.8.49: sort-memory cap — mirrors the resume-position card above (the
                            // same CustomSeg + cap semantics). LRU of per-folder sort choices; a folder
                            // that has falcon_review_data.json keeps its sort THERE instead (owner rule 3)
                            // and consumes no slot. 0 = off: every folder follows the last-used sort.
                            SettingsGroup {
                                title: @tr("falcon" => "Remember sorting and panel layout");
                                VerticalLayout {
                                    padding-left: 12px; padding-right: 12px; spacing: Theme.space-1h;
                                    Text { text: root.sort-cap-custom > 0 ? @tr("falcon" => "{n} folder remembered" | "{n} folders remembered" % root.sort-cap-custom)
                                               : [@tr("falcon" => "off — every folder opens sorted by name"), @tr("falcon" => "last 3 folders"), @tr("falcon" => "last 10 folders")][root.sort-cap-tier];
                                           color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap; }
                                    // v0.8.119 (design-sweep O18): this cap is not the sort's alone —
                                    // the floating panels' per-folder minimised/expanded memory shares
                                    // it (it needs no second tunable), so 0 switches BOTH off. Named
                                    // here because this is the control that governs it; the Floating
                                    // panels card two sections down drops its own memory promise to
                                    // match whenever the cap is 0.
                                    Text { text: @tr("falcon" => "Remembers each folder's sorting, Info view, and whether the info and image/RAW panels reopen minimised. Set to 0 to turn these memories off.");
                                           color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap; }
                                }
                                VerticalLayout {
                                    padding-left: 12px; padding-right: 12px; spacing: 7px;
                                    CustomSeg {
                                        stops: ["0", "3", "10"];
                                        index: root.sort-cap-tier;
                                        custom: root.sort-cap-custom;
                                        picked(i) => { root.sort-cap-tier = i; root.sort-cap-custom = 0; root.sort-cap-changed(); }
                                        custom-committed(t) => { if (t != "") { root.set-sort-cap-custom(t); } keys.focus(); }
                                    }
                                }
                            }
                            Rectangle { height: 4px; }
                            // v0.8.143 (C1): the chord was WRITTEN INTO both of these lines, and on a
                            // Mac the copy shortcut is ⌘C — so a settings section about a shortcut
                            // named a chord that does not exist on the machine reading it. The prose
                            // now takes the live `sc-copy` (platform-fed at boot and after every
                            // rebind, support.rs — "Ctrl+C" or "⌘C", never empty), and the label drops
                            // its parenthetical rather than mint a caps variant of a platform string:
                            // the sentence directly beneath it names the live chord, so nothing is
                            // lost from the heading and nothing can drift between the two.
                            SectionLabel { text: @tr("falcon" => "COPY SHORTCUT"); }
                            // v0.8.194 (§1F2): the sentence was true of a key that only ever copied
                            // ONE photograph. Since §1C2 the same chord follows a live selection
                            // through the same ranked walk — fed the SET's aggregate — so the
                            // sentence names both subjects in the clause it already had, rather
                            // than growing a second sentence about a second behaviour: there is
                            // one behaviour, asked about one photograph or about twelve.
                            Text {
                                text: @tr("falcon" => "{0} copies the highest-priority option available for the photo — or for every selected photo while a selection is active. Drag the ⠿ handle to reorder; tick which to include.", root.sc-copy);
                                color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap;
                            }
                            copylist := CopyRankList {
                                model: root.copy-pref-model;
                                toggled(mode) => { root.toggle-copy-pref(mode); }
                                moved(from, to) => { root.move-copy-pref(from, to); }
                            }
                            Rectangle { height: 4px; }
                            SectionLabel { text: @tr("falcon" => "PERFORMANCE"); }
                            // v0.8.119 (design-sweep O29): the FIRST row under an always-present
                            // section greyed out with no reason on the app's own stated target device
                            // (a laptop iGPU / an AMD card — the opposite of the dev box). ToggleRow's
                            // disabled state mutes only the LABEL; ToggleTrack has no `enabled` input,
                            // so the switch pill still rendered at full strength and read as live.
                            // The v0.8.71 HEIC-assoc pattern, verbatim: an opacity fade over the whole
                            // row plus a mount-gated INLINE reason line (the shared Tip channel renders
                            // at the title bar, far from this row; inline also reaches visual thinkers
                            // without a hover hunt). The sentence is routed through platform.rs.
                            // Group form because a captioned toggle rides transparent inside the
                            // group's block card (the Adaptive Hi-Res grammar below; the lone
                            // bg:block standalone form never carries a caption anywhere in Settings).
                            // With the accelerator PRESENT the note is empty, the bottom padding is 0
                            // and the group renders exactly the 44px block row it did before.
                            SettingsGroup {
                                VerticalLayout {
                                    padding-top: 0px; padding-bottom: root.nvjpeg-avail ? 0px : 12px; spacing: 0px;
                                    ToggleRow {
                                        bg: transparent; bw: 0px;
                                        label: root.accel-toggle-label; // v0.9.9 (P6): macOS names Image I/O
                                        on: root.use-nvjpeg; enabled: root.nvjpeg-avail;
                                        opacity: root.nvjpeg-avail ? 1.0 : 0.55;
                                        toggled => { root.use-nvjpeg = !root.use-nvjpeg; root.set-nvjpeg(root.use-nvjpeg); }
                                    }
                                    if !root.nvjpeg-avail && root.accel-unavail-note != "" : VerticalLayout {
                                        padding-left: 12px; padding-right: 12px;
                                        Text { text: root.accel-unavail-note; color: Theme.text-mute;
                                               font-size: Theme.font-sm; wrap: word-wrap; }
                                    }
                                }
                            }
                            // ── Adaptive hi-res group: how full resolution is loaded for very
                            //    large images (pixel-peek). On = tile the zoomed region (low VRAM). ──
                            SettingsGroup {
                                VerticalLayout {
                                    // F7 (v0.7.9): the title lives IN the ToggleRow below (shares its row with the
                                    // toggle) — that row alone already reproduces the standalone ToggleRow's own
                                    // centered padding exactly (44px row, centered Theme.font-body label), so this
                                    // wrapper should add NONE of its own (was 10px top / 9px below, double-counting
                                    // on top of the row's built-in symmetry).
                                    padding-top: 0px; padding-bottom: 12px; spacing: 0px;
                                    ToggleRow {
                                        label: @tr("falcon" => "Adaptive Hi-Res"); on: root.roi-hi-res;
                                        bg: transparent; bw: 0px;
                                        toggled => { root.roi-hi-res = !root.roi-hi-res; root.set-roi-hi-res(root.roi-hi-res); }
                                    }
                                    VerticalLayout {
                                        padding-left: 12px; padding-right: 12px; spacing: Theme.space-1h;
                                        Text {
                                            text: root.roi-hi-res
                                                ? @tr("falcon" => "Full resolution for the zoomed-in area, and the whole image too when there's enough VRAM. Recommended.")
                                                : @tr("falcon" => "Loads the whole image up to the limit below — uses more GPU memory.");
                                            color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap;
                                        }
                                        // OFF → a manual whole-image resolution cap the user types in.
                                        if !root.roi-hi-res : HorizontalLayout {
                                            spacing: 8px;
                                            Text { text: @tr("falcon" => "Resolution limit"); color: Theme.text-mute; font-size: Theme.font-md;
                                                   vertical-alignment: center; horizontal-stretch: 1; }
                                            TextField { field-width: 86px; value: root.res-limit-text;
                                                accepted(t) => { if (t != "") { root.set-res-limit(t.to-float()); } keys.focus(); } }
                                            Text { text: @tr("falcon" => "px"); color: Theme.text-mute; font-size: Theme.font-md; vertical-alignment: center; }
                                        }
                                    }
                                }
                            }
                            // ── v0.8.171 (OWNER RULING): HEIC SPEED PRIORITY. Sits in PERFORMANCE
                            //    with Adaptive Hi-Res and Fast View — the three rows that trade
                            //    decode work against what you see while browsing — and NOT in
                            //    Developer, because its effect is visible in the viewer rather than
                            //    in a log. The subtitle states BOTH halves of the trade in the
                            //    second person, which is the house voice for a setting that costs
                            //    the reader something (compare Adaptive Hi-Res above). ──
                            SettingsGroup {
                                VerticalLayout {
                                    padding-top: 0px; padding-bottom: 12px; spacing: 0px;
                                    ToggleRow {
                                        label: @tr("falcon" => "HEIC speed priority"); on: root.heic-speed-priority;
                                        bg: transparent; bw: 0px;
                                        toggled => { root.heic-speed-priority = !root.heic-speed-priority; root.set-heic-speed-priority(root.heic-speed-priority); }
                                    }
                                    VerticalLayout {
                                        padding-left: 12px; padding-right: 12px; spacing: Theme.space-1h;
                                        Text {
                                            text: root.heic-speed-priority
                                                ? @tr("falcon" => "Frees the decoder for the photo you are on: a HEIC you have already browsed past stops decoding instead of finishing. Photos you skipped re-decode if you come back to them.")
                                                : @tr("falcon" => "Every HEIC finishes decoding once it starts, even after you have browsed past it. Turn this on if browsing a phone folder feels like it is lagging behind you.");
                                            color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                            // ── v1.0.0-rc TAIL (OWNER RULING): CMYK JPEG DECODING. Sits with the
                            //    other rows that trade decode work against what you SEE, directly
                            //    after HEIC speed priority because both are one-format levers, and
                            //    it is WINDOWS-ONLY: its words name Windows' codec (L26 — a
                            //    platform noun and its behaviour travel together). The caption
                            //    states both halves in the second person, the house voice for a
                            //    setting that costs the reader something, and it deliberately does
                            //    NOT promise the two differ on every file — a 4-component JPEG
                            //    written without an Adobe APP14 marker is inverted by BOTH decoders
                            //    (measured), so "colour-managed" is the honest claim and "correct"
                            //    would not be. WORDING IS ON THE OWNER-VETO LIST. ──
                            if root.cmyk-route-visible : SettingsGroup {
                                VerticalLayout {
                                    padding-top: 0px; padding-bottom: 12px; spacing: 0px;
                                    ToggleRow {
                                        label: @tr("falcon" => "Colour-managed CMYK JPEGs"); on: root.cmyk-os-route;
                                        bg: transparent; bw: 0px;
                                        toggled => { root.cmyk-os-route = !root.cmyk-os-route; root.set-cmyk-os-route(root.cmyk-os-route); }
                                    }
                                    VerticalLayout {
                                        padding-left: 12px; padding-right: 12px; spacing: Theme.space-1h;
                                        Text {
                                            text: root.cmyk-os-route
                                                ? @tr("falcon" => "Print-ready CMYK JPEGs are decoded by Windows, through the same default print profile Photoshop assumes — so they look the way they do everywhere else on this PC. Slightly slower to browse, and the colours differ from a Mac's.")
                                                : @tr("falcon" => "Falcon converts print-ready CMYK JPEGs itself: identical on every computer, and faster to browse. Turn this on if these files look heavier or more saturated here than in Photoshop.");
                                            color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                            // ── v0.8.195 (OWNER RULING 2026-08-30, option c): EFFICIENCY MODE. ────
                            //    Sits in PERFORMANCE with Adaptive Hi-Res, HEIC speed priority and
                            //    Fast View — the rows that trade decode work against what you see
                            //    while browsing — and NOT in Developer: this one is user-facing.
                            //    Placed directly after HEIC speed priority and before Fast View so
                            //    the section reads narrowest-subject-first (one format, then the
                            //    whole machine, then the proxy's own tier).
                            //
                            //    CARD GRAMMAR is the "Fast View" card below, verbatim: a
                            //    SettingsGroup title slot, one description Text on the 12px-side
                            //    wrapper, and the labelled Seg row underneath. Not the ToggleRow
                            //    grammar of the two rows above it, because this is three states and
                            //    a toggle cannot say Auto.
                            SettingsGroup {
                                title: @tr("falcon" => "Efficiency mode");
                                VerticalLayout {
                                    padding-left: 12px; padding-right: 12px; spacing: Theme.space-1h;
                                    // v0.8.195 fix tail (skeptic B, R1 — CONFIRMED): SECOND PERSON,
                                    // AND BOTH HALVES OF THE TRADE. The shipped caption said "Cuts
                                    // background work", and two of the five consumers are not
                                    // background at all: the browse rate itself caps at 20 fps, and
                                    // after a window grow each neighbour lands on its kept-soft
                                    // frame and sharpens a beat later. The house voice for a
                                    // setting that costs the reader something is stated by this
                                    // card's own upstairs neighbour (the HEIC row, ~30 lines up):
                                    // "the subtitle states BOTH halves of the trade in the second
                                    // person". The Auto sentence also names Windows' Battery saver,
                                    // which is a real arm of the predicate (`Dc || saver`) and had
                                    // its own toast sentence while the caption did not mention it.
                                    Text {
                                        // v0.8.196 (WAVE 2, §E): the "20 fps" literal had to go —
                                        // the ceiling is derived from what THIS machine sustains
                                        // now, so a caption naming a constant would be false on
                                        // every box that cannot reach it and on every box that is
                                        // held below it. The card's own live-state line underneath
                                        // names the number; this sentence names the TRADE.
                                        // v0.8.196 fix tail (skeptic B, R4): "a lighter sampling"
                                        // becomes **Subsample** — the word the Fast View card two
                                        // groups below prints on the control the user has actually
                                        // touched. Three vocabularies for one thing (L11/L20) is
                                        // what made the two cards contradict each other.
                                        // **Owner veto.**
                                        // v1.0 MERGE TAIL [B-R1]: the TRADE is platform-neutral and stays a
                                        // literal here; the AUTO clause is routed (see
                                        // `efficiency-auto-clause`). Concatenated rather than split into
                                        // two Text elements so the paragraph still wraps as one.
                                        text: @tr("falcon" => "Cuts background loading to save power. While it's on, browsing is capped to the rate this machine can actually keep up with, browsing uses Faster preview, and large previews can sharpen a moment late. {0}", root.efficiency-auto-clause);
                                        color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap;
                                    }
                                }
                                // v0.8.195 fix tail (skeptic B, R2/O1): THE LIVE-STATE LINE, in the
                                // nvJPEG row's inline-reason grammar (mount on "Rust composed
                                // something to say"). Inline rather than a Tip for that row's own
                                // stated reason: "inline also reaches visual thinkers without a
                                // hover hunt."
                                if root.efficiency-note != "" : VerticalLayout {
                                    padding-left: 12px; padding-right: 12px;
                                    // `effnote` is named for the rig: a Text bound to an empty
                                    // string is findable by neither label nor text, so only an
                                    // element id can tell "mount-gated" from "empty".
                                    effnote := Text { text: root.efficiency-note; color: Theme.text-mute;
                                           font-size: Theme.font-sm; wrap: word-wrap; }
                                }
                                // The Seg is MOUNT-GATED on the env lever (L4: a hidden body keeps
                                // its space and steals its clicks). With FALCON_EFFICIENCY=0 the
                                // card shows only its note, exactly as the lane-cap card does.
                                if !root.efficiency-env : VerticalLayout {
                                    padding-left: 12px; padding-right: 12px; spacing: 7px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        // v0.8.195 fix tail (skeptic B, O4): "When to save" read as
                                        // a file-writing preference in a photo app — "save" is the
                                        // one verb here that already means writing an image to
                                        // disk, and every sibling row label in this grammar is a
                                        // noun naming the axis ("Detail", "Benchmark with",
                                        // "Target size", "Resolution limit").
                                        Text { text: @tr("falcon" => "When it runs"); color: Theme.text-mute; font-size: Theme.font-md; vertical-alignment: center; }
                                        // `effseg` is named for the rig: the label-fit row measures
                                        // every one of these three strings against this instance's
                                        // own pill. Seg centres its labels over a clipped track and
                                        // does NOT elide, so an over-long label is cut off at both
                                        // ends with nothing on screen to say so — the v0.8.194
                                        // hotfix's finding, one round later.
                                        effseg := Seg {
                                            horizontal-stretch: 1;
                                            opts: [@tr("falcon" => "Auto"), @tr("falcon" => "On"), @tr("falcon" => "Off")];
                                            sel: root.efficiency-mode;
                                            bg: Theme.well;
                                            changed(i) => { root.efficiency-mode = i; root.set-efficiency-mode(i); keys.focus(); }
                                        }
                                    }
                                }
                            }
                            // ── Fast View group (§43): the scrubbing proxy always follows the
                            //    window; the one control is which DCT tier brackets it. The
                            //    benchmark times both tiers (+ native full res for the zoomed
                            //    rate) at a target image size, so the pick is informed. ──
                            SettingsGroup {
                                // F7 (v0.7.9) title rhythm (pt16 / pb12 / sp9 + the ~16px title row) now comes
                                // from SettingsGroup's title slot (G12, v0.8.44) — the Detail/Benchmark rows
                                // below keep their original rhythm untouched.
                                title: @tr("falcon" => "Fast View");
                                VerticalLayout {
                                    padding-left: 12px; padding-right: 12px; spacing: Theme.space-1h;
                                    Text {
                                        text: @tr("falcon" => "The fast preview shown while browsing matches your window size. Pick its detail tier: one step below your window (faster) or one above, downsampled (sharper).");
                                        color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap;
                                    }
                                }
                                VerticalLayout {
                                    padding-left: 12px; padding-right: 12px; spacing: 7px;
                                    // The fast decode only lands on 1/2ⁿ DCT stops, so the binary tier
                                    // IS the real lever (PLAN §35.14). Figma 83:248 segmented styling.
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: @tr("falcon" => "Detail"); color: Theme.text-mute; font-size: Theme.font-md; vertical-alignment: center; }
                                        // `detailseg` is named for the rig: it is the CONTROL instance
                                        // in the info-seg commit test — same component, same Settings
                                        // Flickable, `deferred-commit` left at its default FALSE, so
                                        // it must write the crossed cell WHILE the button is still
                                        // down. That is what makes the info seg's deferred assertions
                                        // non-vacuous: if synthetic drags ever stopped reaching Segs
                                        // through the Flickable, this row fails first.
                                        detailseg := Seg {
                                            horizontal-stretch: 1;
                                            opts: [@tr("falcon" => "Faster preview"), @tr("falcon" => "Sharper preview")];
                                            sel: root.quality-super;
                                            bg: Theme.well;
                                            changed(i) => { root.quality-super = i; keys.focus(); }
                                        }
                                    }
                                    // v0.8.196 fix tail (skeptic B, R4 — CONFIRMED): WHILE THE POSTURE
                                    // HOLDS THE TIER, THIS SEG'S PILL IS NOT WHAT THE APP IS DECODING.
                                    // The efficiency posture forces Subsample; the pill above stayed on
                                    // the user's own stop with nothing anywhere connecting the two —
                                    // the v0.8.195 R1c defect ("the title IS the setting and the pill
                                    // sits on it") re-cut on the card next door, in the round that
                                    // quotes it. Same grammar as `efficiency-note` and the nvJPEG row:
                                    // Rust-composed, mount-gated on having something to say (L4), and
                                    // silent for a user already on Subsample, who sees no change.
                                    // `fvnote` is named for the rig — only an element id can tell
                                    // "unmounted" from "empty".
                                    if root.fastview-eff-note != "" : fvnote := Text {
                                        text: root.fastview-eff-note; color: Theme.text-mute;
                                        font-size: Theme.font-sm; wrap: word-wrap;
                                    }
                                    // Benchmark source: the open folder's real photos, or synthetic
                                    // images the app generates at a target size (then deletes) — so
                                    // you can test for a bigger camera without that folder open.
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: @tr("falcon" => "Benchmark with"); color: Theme.text-mute; font-size: Theme.font-md; vertical-alignment: center; }
                                        Seg {
                                            horizontal-stretch: 1;
                                            opts: [@tr("falcon" => "Current folder"), @tr("falcon" => "Target size")];
                                            sel: root.bench-use-synthetic ? 1 : 0;
                                            bg: Theme.well;
                                            changed(i) => { root.bench-use-synthetic = i == 1; keys.focus(); }
                                        }
                                    }
                                    // Only meaningful for the synthetic source: the image size the
                                    // temporary test frames are generated at (45 MP ≈ an R5 II frame).
                                    if root.bench-use-synthetic : HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: @tr("falcon" => "Target size"); color: Theme.text-mute; font-size: Theme.font-md;
                                               vertical-alignment: center; horizontal-stretch: 1; }
                                        TextField { field-width: 64px; value: root.bench-target-mp-text;
                                            accepted(t) => { if (t != "") { root.set-bench-target-mp(t); } keys.focus(); } }
                                        Text { text: @tr("falcon" => "MP"); color: Theme.text-mute; font-size: Theme.font-md; vertical-alignment: center; }
                                    }
                                }
                                HorizontalLayout {
                                    padding-left: 12px; padding-right: 12px; spacing: 12px;
                                    PillBtn {
                                        text: root.bench-running ? @tr("falcon" => "Benchmarking…") : @tr("falcon" => "Run benchmark");
                                        // false = no forcing: this card's "Benchmark with" seg is the mode.
                                        clicked => { if (!root.bench-running) { root.run-benchmark(false); } }
                                    }
                                    Text { text: root.bench-text; color: Theme.text-mute; font-size: Theme.font-md;
                                           vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
                                }
                                // v0.8.82 (tester issue 9): the displayed result may be the welcome's
                                // forced-synthetic run while the seg above still reads "Current
                                // folder" (the seg is the user's deliberate choice and is never
                                // auto-flipped). When they disagree, this one honest caption names
                                // the real source; seg on "Target size" needs no caption (the seg
                                // itself says it) and folder-sourced results carry none. Standard
                                // description ramp (font-sm muted, the sibling-caption grammar).
                                // v0.8.119 (design-sweep Y64): the mismatch is SYMMETRIC. The
                                // caption only covered synthetic-result-under-a-folder-seg; flip the
                                // seg to "Target size", type 61 MP and DON'T press Run and the card
                                // read "Benchmark with [Target size] · Target size 61 MP" over a
                                // result from a 24 MP folder run, with nothing saying so — the same
                                // lie in the other direction. Derive the mount from the disagreement
                                // itself; Rust composes the folder-provenance twin string.
                                if root.bench-synthetic != root.bench-use-synthetic && root.bench-synth-note != "" : VerticalLayout {
                                    padding-left: 12px; padding-right: 12px;
                                    Text { text: root.bench-synth-note; color: Theme.text-mute;
                                           font-size: Theme.font-sm; wrap: word-wrap; }
                                }
                                // v0.8.174 (F2c): the Full tier's clamp caption — same description
                                // ramp as the provenance caption above, and mounted on the ONE
                                // condition that matters (Rust composed something to say).
                                if root.bench-clamp-note != "" : VerticalLayout {
                                    padding-left: 12px; padding-right: 12px;
                                    Text { text: root.bench-clamp-note; color: Theme.text-mute;
                                           font-size: Theme.font-sm; wrap: word-wrap; }
                                }
                                // ── v0.8.156 (C2, owner ruling Q3): the recommendation, HERE ──
                                // "Beside the raw numbers" = inside the very card that owns the
                                // Run-benchmark button and prints the fps, directly under the
                                // result line and its provenance caption — so the measurement and
                                // what to do about it are read in one place. Until now the one-tap
                                // Apply existed ONLY on the welcome panel, the surface a
                                // photographer dismisses first and reopens least, while the card he
                                // does come back to (this one) left him to translate two fps
                                // figures into a scrub stop and a detail tier by hand. The welcome
                                // instance is untouched and is still the first-run path.
                                // Same 12px-side wrapper every sibling row in this card uses.
                                VerticalLayout {
                                    padding-left: 12px; padding-right: 12px;
                                    BenchRecCard {
                                        rec-text: root.bench-rec-text;
                                        applied: root.bench-rec-applied;
                                        // v0.9.66: both hosts read the SAME Rust-composed hint —
                                        // a card that refuses a recommendation must say why on
                                        // whichever surface the reader is looking at.
                                        hint: root.bench-rec-hint;
                                        // LIVE-COMMIT, like every other control on this sheet: the
                                        // SAME callback the welcome's Apply invokes, which writes
                                        // scrub-fps + quality-super straight onto the properties
                                        // build_settings persists. Settings has no staged
                                        // Edit/Save/Cancel layer and this adds none.
                                        apply => { root.apply-bench-rec(); }
                                    }
                                }
                            }
                            Rectangle { height: 4px; }
                            SectionLabel { text: @tr("falcon" => "DISPLAY"); }
                            // v0.8.0: honor the EXIF Orientation tag (default on). Live flip re-composes
                            // every tier from RAM (item a) — no re-decode for the fast tier.
                            ToggleRow {
                                bg: Theme.block;
                                label: @tr("falcon" => "Auto-orient (EXIF)"); on: root.auto-orient;
                                toggled => { root.auto-orient = !root.auto-orient; root.set-auto-orient(root.auto-orient); }
                            }
                            // v0.8.19 (M4–M7): ONE live A/B for the whole motion language — toast
                            // slide+fade (M4), panel-open slide (M5), the immersive chrome crossfade
                            // (M6) and the HUD chip fades (M7). OFF = every one of them instant
                            // (v0.8.18 behavior; toasts fully opaque + clickable the same frame).
                            // v0.8.44 (G4): moved DEVELOPER → DISPLAY — the app-wide motion language is
                            // a user preference, not an engine lever. Same live binding, nothing renamed.
                            // v0.8.119 (design-sweep Y65): the row's name promises the whole motion
                            // language; the gate covers the *-eff reveal/opacity families — panel
                            // slides, toast slide+fade, the immersive chrome crossfade, the HUD chip
                            // fades. NOT gated: the ToggleTrack knob slide, the Seg accent-pill glide,
                            // hover washes and the Settings page ease — so a user who turns it off
                            // watches the very switch he just flipped slide, with nothing on screen
                            // naming the scope. No gate widening this round (that would touch
                            // Theme.anim/anim-fast, i.e. every control in the app); the caption states
                            // what it does cover, in the captioned-toggle group grammar the Adaptive
                            // Hi-Res card below uses.
                            SettingsGroup {
                                VerticalLayout {
                                    padding-top: 0px; padding-bottom: 12px; spacing: 0px;
                                    ToggleRow {
                                        bg: transparent; bw: 0px;
                                        label: @tr("falcon" => "Interface motion"); on: root.motion-ui;
                                        toggled => { root.motion-ui = !root.motion-ui; }
                                    }
                                    VerticalLayout {
                                        padding-left: 12px; padding-right: 12px;
                                        Text { text: @tr("falcon" => "Panel, toast and full-screen transitions. Control animations are unaffected.");
                                               color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap; }
                                    }
                                }
                            }
                            // v0.8.65 (C3/H5): opt-in window-geometry memory — OFF (default) is
                            // today's behaviour untouched (~88%-of-desktop size, OS placement). ON
                            // persists the last normal-state size/position/maximized (never
                            // fullscreen/immersive; latched off winit Moved/Resized, debounced by
                            // the periodic save) and restores it at boot behind a monitor sanity
                            // clamp. Persisted straight off this property (the motion-ui pattern).
                            ToggleRow {
                                bg: Theme.block;
                                label: @tr("falcon" => "Remember window size & position"); on: root.remember-geometry;
                                toggled => { root.remember-geometry = !root.remember-geometry; }
                            }
                            // v0.8.93 (owner ruling 2): the info panel's THREE states got a three-cell
                            // seg, replacing the v0.8.92 on/off toggle, which could only say "on" for
                            // two visibly different states. The stock house `Seg` (L7: zero geometry
                            // overrides — same component, same 34px track, as the "Benchmark with" /
                            // "GPU backend" rows), inside the titled-card grammar those rows use
                            // (SettingsGroup title + control + caption).
                            //
                            // v0.8.97 (owner ruling 2026-07-26) — the card is now the FLOATING-PANELS
                            // LAUNCH PREFERENCE, for BOTH panels (develop bottom-left, info & EXIF
                            // bottom-right), and "Off" is re-worded to "Hidden". The v0.8.93→96
                            // two-way live mirror is GONE: `sel` binds to `panels-default`, which only
                            // this control writes, so the i key / the − buttons / the stub clicks /
                            // the menus move the panels without dragging the highlight around behind
                            // the user's back ("each panel's controls stay independent"). A cell click
                            // routes through Rust (set-panels-default → tick::apply_panels_seg →
                            // support::PanelsSegCell) and does BOTH halves of owner Q2: persist the
                            // preference (build_settings, the motion-ui pattern) and apply it to both
                            // panels immediately. The per-folder memory still wins at every folder
                            // open where it exists (owner Q1, tick::apply_panels_open).
                            SettingsGroup {
                                title: @tr("falcon" => "Floating panels");
                                VerticalLayout {
                                    padding-left: 12px; padding-right: 12px; spacing: 7px;
                                    infoseg := Seg {
                                        opts: root.panels-seg-opts; // = support::PanelsSegCell::label(), in index order — PINNED by a rig test (v0.8.98/C4)
                                        sel: root.panels-default;   // the PREFERENCE, not the live panels
                                        bg: Theme.well;
                                        // v0.8.96 (owner ruling 2026-07-26): one of THREE
                                        // deferred-commit `Seg`s — `infoseg`, `infoviewseg` (item 33)
                                        // and `hoverappearsseg` (item 31) [09-07, verifier N3: this
                                        // said "the ONLY" one, which was true when it was written and
                                        // false from `b5fefbf`] — and it DRAGS like every other one again
                                        // (v0.8.94's `drag-select: false` made this row the single
                                        // non-draggable control in Falcon; the owner called that
                                        // inconsistent). The reason it needs the deferral survives
                                        // v0.8.97 intact, and doubled: Hidden is a strict-subset write
                                        // (it deliberately touches NEITHER min flag, so both panels
                                        // keep the view they were left in), so a LIVE drag On → Hidden
                                        // crossing Minimised committed `info-min = true` on the way
                                        // past and the per-folder memory kept it — the folder later
                                        // re-opened as the stub. Now the pill follows the finger and
                                        // exactly ONE write lands, at release, for the cell released
                                        // on; a tap is unchanged. (Under the immediate-apply ruling a
                                        // live drag would ALSO strobe both panels across the stage.)
                                        deferred-commit: true;
                                        changed(i) => { root.set-panels-default(i); keys.focus(); }
                                    }
                                    Text {
                                        // v0.8.97: the caption follows the SELECTED CELL (the
                                        // preference) rather than the live panels, and every variant
                                        // has to carry the three things the control's three words
                                        // cannot say — that this is a LAUNCH default, that a folder
                                        // you have already arranged overrides it, and that picking a
                                        // cell also acts right now. The two shared sentences are
                                        // declared ONCE below and appended, so the six composed
                                        // strings cannot drift apart.
                                        //
                                        // Caption names the LIVE key via
                                        // sc-info (mirrors the ctx-menu chip; falls back cleanly when the
                                        // action is unbound). The OFF caption teaches the v0.8.93 reveal:
                                        // the panels are never unreachable, and never keyboard-only.
                                        // v0.8.94 (audit C11/C24): the OFF caption branches on COMPARE —
                                        // there the i key (`info_key_action` → Nothing while fully-off in
                                        // compare) and the corner hover (the zone's TouchArea is inside
                                        // `if !root.compare`, and the tick's info context carries
                                        // `&& !compare`) are BOTH deliberate no-ops, so teaching them
                                        // there sends the user to two dead ends.
                                        // v0.8.95 (v0.8.94-audit V7): …and it named a THIRD dead end.
                                        // The PHOTO's right-click menu does not exist in compare: the
                                        // stage right-click handler lives inside `if !root.compare :
                                        // TouchArea` and the compare stage's own TouchArea handles the
                                        // left button only. The context menu itself is fine — the
                                        // FILMSTRIP thumb right-click (and the grid dock tile's) opens
                                        // the very same menu, and neither mount gate carries a compare
                                        // term — so the caption now names that surface instead. Ruling
                                        // 3's real compare-recovery paths: this control, a filmstrip
                                        // thumbnail's right-click menu (+ the View menu on macOS).
                                        // v0.8.94 (audit C9/C25): the captions name the SCOPE. Under
                                        // v0.8.97 the split is sharper and it is what `memory-note`
                                        // says: the min-states are per-folder (apply_scan restores
                                        // them on a cross-folder swap), while THIS control is a
                                        // global default that only applies where a folder has no
                                        // remembered layout of its own.
                                        // v0.9.25 (audit C11): on macOS the View menu is a fourth
                                        // recovery surface (and a compare-safe one — ruling 3/4
                                        // added it for exactly that), so every HIDDEN variant ends
                                        // with a shared suffix that names it. Each recovery clause
                                        // below therefore stops BEFORE its final full stop, and the
                                        // two shared sentences are appended AFTER that suffix.
                                        // v0.8.96-audit (C5): "appears for a few seconds, then fades"
                                        // read as a countdown the user has to beat — but HOVER HOLDS
                                        // THE STUB (tick.rs: `info_hot` = the corner zone OR the stub
                                        // itself, and the linger only counts down when neither is
                                        // hot), so the one thing that never makes it fade is looking
                                        // at it. "…if you leave it alone" names the real condition,
                                        // and with the deadline gone the recovery clause drops its
                                        // "while it's there".
                                        //
                                        // The two shared clauses. `memory-note` is the Q1 ruling in
                                        // one sentence (and the honest warning that Hidden is not
                                        // absolute); `apply-note` is Q2's "immediate + default".
                                        // v0.8.98 (v0.8.97-audit C12/F1): `memory-note` is now
                                        // STRICTLY true — "folders you have already arranged" means
                                        // arranged panel by panel, and since v0.8.98 that is the
                                        // only thing that writes the memory: clicking a cell here,
                                        // and recovering from Hidden, are both invisible to the
                                        // recorder (tick::apply_panels_seg / apply_panels_restore).
                                        // Before that this sentence quietly described a memory the
                                        // control was itself creating. `apply-note` drops "Picking
                                        // a cell", which named an implementation ("cell") the UI
                                        // never says out loud, for the plain second person.
                                        // v0.8.119 (design-sweep O18): this sentence is FALSE while
                                        // Settings → INPUT → "Sort memory" is 0. The per-folder
                                        // floating-panel min-state memory has no cap of its own — it
                                        // SHARES the sort cap (support::resolve_panel_min returns None
                                        // at cap 0, and tick::record_panel_min_toggle never writes),
                                        // including for folders that already carry a
                                        // falcon_review_data.json with an info_min key. So a photographer
                                        // who set Sort memory to 0 because he wants one sort everywhere
                                        // silently lost panel memory too, while this card kept
                                        // promising it and nothing linked the two. Option (b) of the
                                        // ruling: drop the clause when the cap is 0 (owner option (a),
                                        // giving panel memory its own tunable, is a feature decision),
                                        // and name the coupling on the Sort memory card itself so the
                                        // link is discoverable from the control that governs it.
                                        // Gated in ALL THREE cells: the sentence is equally untrue in
                                        // the Hidden one.
                                        property <string> memory-note: @tr("falcon" => "Folders you have already arranged reopen the way you left them, which wins over this.");
                                        // the clause WITH its separator, so a 0 cap leaves no double space.
                                        property <string> memory-clause: root.sort-cap-eff > 0 ? " " + self.memory-note : "";
                                        property <string> apply-note: @tr("falcon" => "Choosing one of these applies it to both panels right away and saves it as your default.");
                                        // …and the independence clause, on the two cells where the
                                        // panels are actually on screen to be moved. Deliberately NOT
                                        // on Hidden: there are no per-panel controls visible there.
                                        property <string> indep-note: @tr("falcon" => "After that, each panel's own controls move it on its own.");
                                        // Language packs: each recovery sentence is marked whole, with
                                        // and without the Mac suffix, so a pack never joins pieces.
                                        text: root.panels-default == 0
                                            ? (@tr("falcon" => "Both floating panels start hidden when you open a folder or photo, and stay hidden until you bring them back.")
                                               + " "
                                               + (root.compare
                                                    // v0.8.95 (V17): the compare variant ENDS on the same
                                                    // "Also on …" shape as its two siblings, so the shared Mac
                                                    // suffix's preposition lands ("…right-click menu, and on the
                                                    // View menu."). It read "from X or Y, and on Z" before.
                                                    ? (root.is-mac
                                                        ? @tr("falcon" => "While comparing, bring them back from this control. Also on a filmstrip thumbnail's right-click menu, and on the View menu.")
                                                        : @tr("falcon" => "While comparing, bring them back from this control. Also on a filmstrip thumbnail's right-click menu."))
                                                    : (root.sc-info == ""
                                                        ? (root.is-mac
                                                            ? @tr("falcon" => "Hover the photo's bottom-right corner and the \"i\" button appears for a few seconds, then fades if you leave it alone — click it to bring both panels back. Also on the photo's right-click menu, and on the View menu.")
                                                            : @tr("falcon" => "Hover the photo's bottom-right corner and the \"i\" button appears for a few seconds, then fades if you leave it alone — click it to bring both panels back. Also on the photo's right-click menu."))
                                                        : (root.is-mac
                                                            ? @tr("falcon" => "Press {0} or hover the photo's bottom-right corner and the \"i\" button appears for a few seconds, then fades if you leave it alone — press {0} again (or click it) to bring both panels back. Also on the photo's right-click menu, and on the View menu.", root.sc-info)
                                                            : @tr("falcon" => "Press {0} or hover the photo's bottom-right corner and the \"i\" button appears for a few seconds, then fades if you leave it alone — press {0} again (or click it) to bring both panels back. Also on the photo's right-click menu.", root.sc-info))))
                                               + self.memory-clause + " " + self.apply-note)
                                            // v0.8.98 (v0.8.97-audit C12): the bottom-left panel is
                                            // no longer called "develop" here. No UI surface shows
                                            // that word — the panel's own controls read RAW / JPG
                                            // and a zoom percentage, its parked form is a MAGNIFIER
                                            // (which reads as zoom, not as develop), and Settings
                                            // already spends the word on its DEVELOPER section a
                                            // few cards away. Both cells now name the panel by what
                                            // the user can see it do: "image/RAW & zoom", matched
                                            // against the existing "shot info & EXIF" on the right.
                                            : (root.panels-default == 1
                                                ? (@tr("falcon" => "Both floating panels start parked as small buttons in the photo's bottom corners — a magnifier bottom-left for image/RAW & zoom, an \"i\" bottom-right for shot info & EXIF. Click either to open that panel.")
                                                   + " " + self.indep-note + self.memory-clause + " " + self.apply-note)
                                                : (@tr("falcon" => "Both floating panels start open — image/RAW & zoom over the photo's bottom-left corner, shot info & EXIF bottom-right.")
                                                   + " " + self.indep-note + self.memory-clause + " " + self.apply-note));
                                        color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap;
                                    }
                                    // ── v1.0.0-rc (queue item 33, OWNER RULING 2.4a): THE SECOND
                                    // ── ROW — THE INFO PANEL'S VIEW, AS A FLOOR. ───────────────
                                    // The 08-12 review's F4-1: the panel's view was persisted off
                                    // the LIVE property, so a folder you had once read in Simple
                                    // rewrote the GLOBAL launch default to Simple about a second
                                    // after you opened it — and there was no Settings control for
                                    // that default at all. The owner ruled (a), "the Settings
                                    // value is a FLOOR; folders keep their own memory": so the
                                    // default gets a control, and the control is the only thing
                                    // that moves it (build_settings now reads main.rs'
                                    // `info_view_pref`, which only this row writes).
                                    //
                                    // IT BELONGS IN THIS CARD, not in one of its own: the card
                                    // already owns "how the floating panels come up when you open
                                    // a folder", and the view is the same question one axis over.
                                    // GRAMMAR REUSED, nothing minted — the inline row label plus a
                                    // stretch-1 stock `Seg` that "Detail", "Benchmark with" and
                                    // "When it runs" already wear, with a NOUN naming the axis
                                    // (v0.8.195/O4's rule). The first row keeps its full-width
                                    // shape untouched.
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: @tr("falcon" => "Info panel view"); color: Theme.text-mute; font-size: Theme.font-md; vertical-alignment: center; }
                                        // `infoviewseg` is named for the rig: the label-fit leg of
                                        // `the_settings_view_row_names_its_three_views` measures
                                        // all three strings against this instance's own pill,
                                        // because `Seg` centres its labels over a clipped track
                                        // and does NOT elide (the v0.8.194 finding).
                                        infoviewseg := Seg {
                                            horizontal-stretch: 1;
                                            opts: root.info-view-seg-opts; // = support::InfoView::label(), in index order — PINNED by a rig test
                                            sel: root.info-view-default;   // the PREFERENCE, not the live view
                                            bg: Theme.well;
                                            // DEFERRED, like the row above and for its reason one
                                            // axis over: a live drag Simple → Full crosses
                                            // Standard, and every crossed cell would both repaint
                                            // the open panel and move the persisted floor. One
                                            // write lands, at release, for the cell released on.
                                            deferred-commit: true;
                                            changed(i) => { root.set-info-view-default(i); keys.focus(); }
                                        }
                                    }
                                    Text {
                                        // [VD] the caption carries the three things the cells
                                        // cannot say: that this is a LAUNCH default, that a folder
                                        // you have already read in another view keeps its own, and
                                        // — the half the ruling is about — that the panel's own
                                        // header buttons move the view you are reading in while
                                        // nothing but this row moves the default.
                                        text: @tr("falcon" => "A launch default for folders you have not arranged; a folder you have already read in Simple or Full keeps its own. The panel's own header buttons change the view you are in now — only this row changes the default.");
                                        color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap;
                                    }
                                }
                            }
                            // ── v0.8.116 (D-C, owner ruling): the reveal-linger card, moved
                            // DEVELOPER → DISPLAY. "Include it in display as you recommended since it
                            // also touches full screen mode hover-linger time." It is the G4 rule
                            // applied to the one card G4 missed: DEVELOPER holds engine levers, under a
                            // note warning that changing them "can degrade performance" — and this
                            // knob governs a RECOVERY affordance (how long the "i" button stays up
                            // after a hover reveals it) plus every full-screen hover reveal. Neither is
                            // an engine lever; both are pacing, which is a user preference and belongs
                            // beside Interface motion.
                            // Placed directly under Floating panels: that card's Hidden caption teaches
                            // the "i" stub, and this is how long the stub waits — the teaching and its
                            // one tunable now read as one pair.
                            // The card itself is UNCHANGED (SettingsGroup title slot + status subline +
                            // CustomSeg — the tuner-card standard); only its section and its caption
                            // move. LIVE: step_immersive_reveal reads reveal-linger-sec each tick.
                            //
                            // THE CAPTION names BOTH roles, in common-case order (the reveal-copy word
                            // bans hold: nothing here "flashes").
                            // v0.8.117 (F2, owner-ruled option (a)): the ORDER is inverted from v0.8.116.
                            // It led with the normal-view "i" corner reveal, which is armed ONLY while
                            // the info panel is FULLY OFF — and the fresh-install default is both panels
                            // ON (the owner's 2026-07-26 ruling, support.rs `default_panels_on`). So the
                            // caption's first and longest clause described a state the reader has to opt
                            // into from Settings: the COMMON-CASE COPY inversion, and L25's explicit
                            // Settings-only state. It also re-taught, in different words, what the
                            // Floating panels card two lines above already teaches — correctly gated
                            // there to its Hidden cell, unconditionally here.
                            // The FULL-SCREEN reveals are the half every user reaches from the shipped
                            // default (one keybind), so they lead; the normal-view half shrinks to a
                            // POINTER clause, which also retires the garden-path reduced relative ("the
                            // \"i\" button a bottom-right hover brings back" — a reduced relative stacked
                            // on a demonstrative). Naming both halves is still why the card sits in
                            // DISPLAY at all, and the rig row pins both halves AND the new order.
                            SettingsGroup {
                                title: @tr("falcon" => "Corner controls stay visible");
                                VerticalLayout {
                                    padding-left: 12px; padding-right: 12px; spacing: Theme.space-1h;
                                    Text { text: @tr("falcon" => "Keep corner controls visible for {n} second after the pointer leaves with no new action." | "Keep corner controls visible for {n} seconds after the pointer leaves with no new action." % root.reveal-linger-sec) + " " + @tr("falcon" => "In immersive mode this includes rating, flag and reject controls and the image/RAW panel. When panels are hidden in normal view, it includes the info button in the corner.");
                                           color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap; }
                                }
                                VerticalLayout {
                                    padding-left: 12px; padding-right: 12px; spacing: 7px;
                                    CustomSeg {
                                        stops: ["1", "2", "3", "5", "10"];
                                        suffix: @tr("falcon" => "s");
                                        index: root.reveal-linger-sec == 1 ? 0 : (root.reveal-linger-sec == 2 ? 1 : (root.reveal-linger-sec == 5 ? 3 : (root.reveal-linger-sec == 10 ? 4 : 2)));
                                        custom: (root.reveal-linger-sec == 1 || root.reveal-linger-sec == 2 || root.reveal-linger-sec == 3 || root.reveal-linger-sec == 5 || root.reveal-linger-sec == 10) ? 0 : root.reveal-linger-sec;
                                        picked(i) => { root.reveal-linger-sec = i == 0 ? 1 : (i == 1 ? 2 : (i == 2 ? 3 : (i == 3 ? 5 : 10))); }
                                        custom-committed(t) => { if (t != "") { root.set-reveal-linger-custom(t); } keys.focus(); }
                                    }
                                }
                            }
                            Rectangle { height: 4px; }
                            // ── v1.0.0-rc (queue item 31, sheet 2.5d/2.5a — Q6): REVIEW IS A NEW
                            // SECTION. There was none: the sections read INPUT / COPY SHORTCUT /
                            // PERFORMANCE / DISPLAY / COLOUR / FILE ASSOCIATIONS / DEVELOPER /
                            // CONTROLS, and the one Review-affecting row ("Direct bulk rating")
                            // stays under DEVELOPER, where item 33 left it. It sits AFTER DISPLAY
                            // and BEFORE COLOUR so the sheet reads input -> performance -> display
                            // -> review -> colour: what you see, then how you judge it. Like its
                            // eight siblings it is a bare label preceded by the 4px spacer, never a
                            // container — the sections of this body are FLAT SIBLINGS delimited by
                            // SectionLabels, as the COLOUR note below says.
                            SectionLabel { text: @tr("falcon" => "REVIEW"); }
                            SettingsGroup {
                                VerticalLayout {
                                    padding-top: 0px; padding-bottom: 12px; spacing: 0px;
                                    // The HEIC-speed-priority shape exactly: a captioned toggle
                                    // rides TRANSPARENT inside the group's own block card (the lone
                                    // `bg: block` standalone form never carries a caption anywhere
                                    // in Settings). Persist-only — no callback — so there is nothing
                                    // to dispatch; `build_settings` reads the property this writes.
                                    ToggleRow {
                                        label: @tr("falcon" => "Hover to preview"); on: root.hover-to-preview;
                                        bg: transparent; bw: 0px;
                                        toggled => { root.hover-to-preview = !root.hover-to-preview; }
                                    }
                                    VerticalLayout {
                                        padding-left: 12px; padding-right: 12px; spacing: Theme.space-1h;
                                        Text {
                                            text: @tr("falcon" => "Rest the mouse on a Review thumbnail for a moment to see it larger beside the panel. A narrow window has no room for it.");
                                            color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap;
                                        }
                                    }
                                    // The A/B row the owner asked for on 09-06: he tests both
                                    // timings and names the winner, and the losing cell retires in a
                                    // later round (the field stays, for old files). The inline label
                                    // plus a stretch-1 stock `Seg` is item 33's own row grammar one
                                    // card over; `deferred-commit` is that row's reason too — a
                                    // drag across the pair must write once, on release.
                                    VerticalLayout {
                                        padding-left: 12px; padding-right: 12px; padding-top: 10px; spacing: Theme.space-1h;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text { text: @tr("falcon" => "Appears"); color: Theme.text-mute; font-size: Theme.font-md; vertical-alignment: center; }
                                            // Named for the rig: the label-fit leg of
                                            // `hover_appears_labels_are_pinned_to_the_cells`
                                            // measures both strings against this instance's own
                                            // pill, because `Seg` centres its labels over a clipped
                                            // track and does NOT elide (the v0.8.194 finding).
                                            hoverappearsseg := Seg {
                                                horizontal-stretch: 1;
                                                opts: root.hover-appears-seg-opts; // = support::HoverAppears::label(), in index order — PINNED by a rig test
                                                sel: root.hover-preview-instant ? 1 : 0;
                                                bg: Theme.well;
                                                deferred-commit: true;
                                                // The P5 mute, never `visible:` and never `opacity:`
                                                // (L4/L49 — unmounting would jump the sheet under
                                                // the switch above; an Opacity item over this many
                                                // children is an offscreen layer, L48).
                                                enabled: root.hover-to-preview;
                                                // ONE writer: `tick::apply_hover_appears` parses the
                                                // cell, writes `hover-preview-instant` and logs it —
                                                // the `set-info-view-default` shape, whose reason is
                                                // that an out-of-range cell must write nothing at all.
                                                changed(i) => { root.set-hover-appears(i); keys.focus(); }
                                            }
                                        }
                                        Text {
                                            text: @tr("falcon" => "The taskbar's third of a second, or the instant the pointer lands — try both.");
                                            color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                            Rectangle { height: 4px; }
                            // ── v0.8.156 (C1, owner ruling Q6): COLOUR IS ITS OWN SECTION ────
                            // The output-colour-management card was DISPLAY's tail — the section's
                            // other four cards are auto-orient / interface motion / window memory /
                            // floating panels + reveal linger, i.e. how the app behaves on screen,
                            // while this one is what every pixel is converted THROUGH. It now sits
                            // under its own label, immediately after DISPLAY so its neighbours are
                            // the ones it always had (ruling: it moves OUT of DISPLAY, not across
                            // the sheet).
                            //
                            // The sections of this body are FLAT SIBLINGS delimited by SectionLabels
                            // (INPUT / COPY SHORTCUT / PERFORMANCE / DISPLAY / … — each one a bare
                            // label preceded by the 4px spacer, never a container), so the card's
                            // membership IS the label above it: this label is the move. Nothing is
                            // hidden, gated or faded to achieve it (L4 — there is no `visible:` or
                            // opacity anywhere in this change), the card itself is byte-unchanged,
                            // and the SectionLabel is the stock component with the stock grammar its
                            // eight siblings use.
                            //
                            // Appendix B (the stretch-absorber rule) after the move: `setflick` is
                            // still the panel's ONE absorber (vertical-stretch 1 + the explicit
                            // max-height 100000px opt-out) and `body`, its viewport column, is
                            // height-pinned to `body.preferred-height` — so a ninth bare Text in
                            // that column competes for no surplus, exactly like the eight already
                            // there.
                            SectionLabel { text: @tr("falcon" => "COLOUR"); }
                            SettingsGroup {
                                VerticalLayout {
                                    // F7 (v0.7.9): same ~16px title rhythm as Fast View — padding-top absorbs the
                                    // top gap; the title's new wrapper padding-bottom absorbs the rest of the bottom
                                    // gap on top of the unchanged 9px spacing, so the gamut-chip rows below keep
                                    // their original rhythm untouched.
                                    padding-left: 12px; padding-right: 12px; padding-top: 16px; padding-bottom: 12px; spacing: 9px;
                                    HorizontalLayout {
                                        padding-bottom: 7px;
                                        Text { text: @tr("falcon" => "Output colour gamut"); color: Theme.text; font-size: Theme.font-body; }
                                    }
                                    // ── v0.8.107: THE PER-DISPLAY SECTION STACK ───────────────────────
                                    // The card is a stack of per-display sections (design §5). Falcon
                                    // still installs exactly ONE output transform at a time — what became
                                    // per-display is the CONFIGURATION, so each section edits its own
                                    // display's entry and only the ACTIVE section's edits move the live
                                    // transform (through the unchanged `set-output-gamut` chokepoint,
                                    // reached from Rust).
                                    //
                                    // Sections open and close INDEPENDENTLY (owner ruling D1 — NOT a
                                    // one-open accordion): the ACTIVE display comes first and starts
                                    // expanded in full, every other display is a compact collapsed row
                                    // reading "<name> — <its colour setting>" with the expand chevron at
                                    // the right end. The open set lives in Rust, so opening a second
                                    // display does not close the first — and (v0.8.108) collapsing the
                                    // ACTIVE section really collapses it, in every state.
                                    //
                                    // A configured-but-DISCONNECTED display (owner ruling D2) is the same
                                    // row, its TEXT faded, saying "· not connected" — and it IS
                                    // expandable, with a Remove button in its body that forgets the
                                    // display. v0.8.108 (owner ruling): the fade covers the header and the
                                    // descriptive text only. Its CONTROLS render at full strength, because
                                    // they all work — pre-configuring a dock you are about to plug in is
                                    // the point — and 50% opacity is this app's DISABLED language.
                                    //
                                    // v0.8.108 (owner ruling, audit A13): a card with only ONE section
                                    // renders NO header row at all, so a single-display machine reads a
                                    // card VISUALLY AND GEOMETRICALLY IDENTICAL to v0.8.106's — same
                                    // strings, same spacing, no section chrome (Rust mounts that lone row
                                    // open — with no header there is no control to re-open it with). Same
                                    // answer, same reason, as the D3 welcome line this card's own round
                                    // mount-gated. v0.8.109 (V14): stated that way deliberately — the
                                    // render TREE is not the same tree (a repeater instance, `dsecwrap`,
                                    // two nested layouts and five opacity wrappers, all provable no-ops at
                                    // 1.0 and adding no padding), and "byte-identical" was a claim nothing
                                    // could check. `heads == 0` in the rig carries the pin.
                                    //
                                    // The body is MOUNT-GATED (`if`, never `visible:` — a hidden body
                                    // would keep its space and steal every click in it, and this one is
                                    // ~360 px of controls), so a collapsed section costs its header row.
                                    //
                                    // BOUNDING: `setflick` remains THE absorber for this panel; `body`
                                    // (the Flickable's viewport column) is height-pinned to its own
                                    // preferred height, so nothing inside this card ever competes for
                                    // surplus. `dsecwrap` is the SettingsGroup shape verbatim (a
                                    // Rectangle wrapping one layout, which propagates its layout info),
                                    // the header is FIXED-height, and every expanded row is one of the
                                    // shapes this card already carried.
                                    for sec[si] in root.display-sections : dsecwrap := Rectangle {
                                        // D2's fade, scoped to the words (owner ruling, v0.8.108): every
                                        // Text in a disconnected section carries this, every CONTROL does
                                        // not. "This screen is not here" — not "these buttons don't work".
                                        property <float> fade: sec.connected ? 1.0 : 0.5;
                                        VerticalLayout {
                                        spacing: 9px;
                                        if root.display-sections.length > 1 : dsechead := Rectangle {
                                            height: 30px;
                                            border-radius: Theme.radius-ctrl;
                                            background: dseckta.has-hover ? Theme.hover : transparent;
                                            animate background { duration: Theme.anim; easing: ease; }
                                            // v0.8.109 (V11): the fade sits on the WORDS, not on the
                                            // header. Slint composites `opacity` as a layer over the
                                            // whole subtree, so a child cannot opt out of an
                                            // ancestor's — and the one thing that must not fade is
                                            // the marker that STATES the disconnection. Ruling 13
                                            // already exempts controls from D2's fade in the body;
                                            // the chevron and its hover wash are this row's control,
                                            // so they now follow the same rule here.
                                            HorizontalLayout {
                                                padding-left: Theme.space-1; padding-right: 2px;
                                                spacing: Theme.space-1h;
                                                // The head line ABSORBS the row and elides (the house
                                                // pattern for long text in a fixed row), so no monitor
                                                // name or profile name can push the chevron off the card.
                                                Text {
                                                    text: sec.head;
                                                    color: sec.active ? Theme.text : Theme.text-dim;
                                                    font-size: Theme.font-body;
                                                    font-weight: sec.active ? 500 : 400;
                                                    vertical-alignment: center;
                                                    horizontal-stretch: 1; overflow: elide;
                                                    opacity: dsecwrap.fade;
                                                }
                                                if sec.active : Text {
                                                    text: @tr("falcon" => "· this screen");
                                                    color: Theme.text-mute; font-size: Theme.font-sm;
                                                    vertical-alignment: center;
                                                    opacity: dsecwrap.fade; // always 1.0 here: an active row is always connected
                                                }
                                                // v0.8.108 (audit A10/A14): the DISCONNECT marker is its
                                                // own hugging, non-eliding sibling — the "· this screen"
                                                // shape. It used to be the tail of `head`, i.e. the tail
                                                // of the one elided Text in a 260 px row, so for a
                                                // display with a Custom profile (exactly what D2 exists
                                                // for) the words that state the disconnection were the
                                                // first thing cut, leaving a 50% wash as the only cue —
                                                // and 50% reads as "disabled" in this app.
                                                //
                                                // v0.8.109 (V11): …and it is EXEMPT from the fade.
                                                // v0.8.108 rescued it from elision and then put it
                                                // inside the 50 % header wash at the card's TERTIARY
                                                // colour — so the words that state the disconnection
                                                // rendered fainter than the head line beside them
                                                // (~2.5:1 on the card), which is the same "the
                                                // honesty-critical words are the least legible thing
                                                // in the row" defect wearing different clothes. Full
                                                // opacity, `text-dim`: it is a FACT about the row,
                                                // not part of the greyed-out state it describes.
                                                if !sec.connected : dsecnc := Text {
                                                    text: @tr("falcon" => "· not connected");
                                                    color: Theme.text-dim; font-size: Theme.font-sm;
                                                    vertical-alignment: center;
                                                }
                                                // THE expand/collapse indicator, at the right end — the
                                                // info/EXIF panel's own chevron (owner ruling D1: the
                                                // same icon, not new art). v0.8.108 (audit): a PLAIN
                                                // glyph, not an IconBtn. The IconBtn's own TouchArea and
                                                // hover wash were buried under the full-row `dseckta`
                                                // (later sibling = on top), so both were dead — an
                                                // interactive layer that could never be reached. One
                                                // hit target, one hover wash, honestly.
                                                VerticalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        width: 24px; height: 24px;
                                                        ChevronGlyph {
                                                            // v0.8.191 (S2-B) REVERTED: an
                                                            // AA'd Path stroke gains nothing
                                                            // from an even mount and loses
                                                            // 1.5 device px of centring — see
                                                            // the EXIF header's chevron.
                                                            x: (parent.width - self.width) / 2;
                                                            y: (parent.height - self.height) / 2;
                                                            // v0.8.143 (C3, OWNER RULING 2026-08-04
                                                            // — this consumer's direction was the
                                                            // one parked question and it is now
                                                            // answered): the arrow points where the
                                                            // content will move. This section
                                                            // extends DOWNWARD, so collapsed shows
                                                            // DOWN ("it will grow down") and
                                                            // expanded shows UP ("it will fold back
                                                            // up"). It read the other way round
                                                            // before — collapsed ^ / expanded V —
                                                            // which was the accordion idiom the
                                                            // ruling supersedes.
                                                            points-down: !sec.expanded;
                                                        }
                                                    }
                                                }
                                            }
                                            // The whole header row is THE hit target.
                                            dseckta := TouchArea {
                                                clicked => { root.toggle-display-section(sec.key); }
                                            }
                                        }
                                        if sec.expanded : dsecbody := VerticalLayout {
                                            spacing: 9px;
                                    // v0.8.108 (owner ruling, audit): an expanded NON-ACTIVE section says
                                    // so, in one line. Before this it was visually identical to the active
                                    // one — same chips, same buttons, same present-tense OS paragraph —
                                    // and its only difference was that clicking a chip changed
                                    // configuration without changing anything on screen.
                                    if !sec.active : dsecscope := Text {
                                        text: @tr("falcon" => "Applies to this screen when the Falcon window is on it.");
                                        color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap;
                                        opacity: dsecwrap.fade;
                                    }
                                    // v0.8.109 (the owner's TWINS ruling): this display shares its
                                    // whole identity with an identical sibling, so the only thing
                                    // telling them apart is where they sit in the arrangement — and
                                    // a rearrangement swaps that. Persisting under such a key would
                                    // mean each panel silently inheriting the other's calibration
                                    // (V15, the RED), so nothing here reaches disk. Said once,
                                    // muted, and ONLY in that state — there is nothing to act on.
                                    if sec.session-only : dsecsess := Text {
                                        text: @tr("falcon" => "This display can't be uniquely identified — settings apply this session only.");
                                        color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap;
                                        opacity: dsecwrap.fade;
                                    }
                                    // v0.8.110 (owner ruling): the WEAK key's own one line. It is the
                                    // same positional shape as the twin above, but it PERSISTS — V3
                                    // restored the (size, position) fallback exactly so a display the
                                    // walk could not name still keeps the edits made on it, and making
                                    // it session-only would have thrown that away again. So the card
                                    // says what it is recognised BY, which is the one thing that
                                    // explains why the settings can follow the arrangement instead of
                                    // the monitor. Rust never sets this together with `session-only`
                                    // (a `twin:` key is weak too, and its line says more).
                                    if sec.weak : dsecweak := Text {
                                        text: @tr("falcon" => "This display is recognised by its position and size — its settings follow that arrangement.");
                                        color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap;
                                        opacity: dsecwrap.fade;
                                    }
                                    // v0.8.110 (the twins ruling, SECOND HALF): the saved setting on
                                    // this key was written for a DIFFERENT panel of the same model —
                                    // a Windows key names the PORT, so swapping two identical
                                    // monitors' cables hands each panel the other's saved
                                    // calibration, with adoption never consulted. Falcon refuses it
                                    // and runs sRGB; this is the line that says so, in the same
                                    // muted voice and the same slot as its two siblings above.
                                    // v0.8.111 (rider b): …and what SETTING it costs. The saved
                                    // entry is not held in reserve — the first choice made here is
                                    // written under this key and replaces it. Saying only "on sRGB
                                    // until you set it" left a reader free to assume the other
                                    // monitor's calibration was waiting behind the sRGB fallback.
                                    if sec.unit-mismatch : dsecunit := Text {
                                        text: @tr("falcon" => "This entry belongs to a different physical monitor of the same model — this screen is on sRGB until you set it, which replaces the setting saved here.");
                                        color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap;
                                        opacity: dsecwrap.fade;
                                    }
                                    // v0.8.65 (C3/M9): the RECOMMENDED path leads the section — auto-detect
                                    // reads the OS-assigned profile for THIS monitor and arms Custom with
                                    // it (accurate-by-default; the chips below stay the manual override).
                                    // v0.8.107: it is aimed at the SECTION's display (its own DisplayHint,
                                    // built in Rust from the enumeration entry), not at the window's.
                                    // v0.8.108 (audit): …and it SAYS which one, where "this monitor" would
                                    // name a different screen from the one the window is on. The
                                    // active/single case keeps the pinned copy verbatim.
                                    // v0.8.76 (owner): marker demoted from the Chip HINT dialect to PLAIN
                                    // small muted text — no background/border, vertically centred beside
                                    // the button. v0.8.77 (owner): at the STANDARD description size
                                    // (font-sm — the gamut-copy ramp); font-xs is for over-image badges
                                    // only, never explanatory text.
                                    // v0.8.109 (V8): the label is composed IN RUST, length-gated. It
                                    // used to be `"Auto-detect " + sec.name` — an unbounded name
                                    // inside a PillBtn whose Text has no elide and no max width, so
                                    // the label WAS the pill's minimum width; a clone-group name
                                    // ("A + B (mirrored)", introduced the same wave) overflowed the
                                    // 296 px card, and `setflick` pins its viewport width to its own,
                                    // so the surplus was clipped rather than scrollable. Same answer
                                    // as `custom-long` (v0.8.76): Slint cannot measure text, so the
                                    // decision belongs to Rust.
                                    HorizontalLayout {
                                        spacing: Theme.space-2;
                                        dsecauto := PillBtn {
                                            text: sec.auto-label;
                                            clicked => { root.detect-display-icc(sec.key); }
                                        }
                                        Text {
                                            text: @tr("falcon" => "Recommended"); color: Theme.text-mute; font-size: Theme.font-sm;
                                            vertical-alignment: center; opacity: dsecwrap.fade;
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                    // v0.8.65 (C3/M9, M12 pattern): OS-concept copy routes through
                                    // platform.rs — Windows byte-identical (pinned); Mac names
                                    // ColorSync / System Settings → Displays. v0.8.107: reused
                                    // VERBATIM per section — deliberately NOT forked (the Windows
                                    // string is byte-identity-pinned by `windows_strings_unchanged`).
                                    // v0.8.108 (owner ruling, audit): the paragraph describes what the OS
                                    // is doing for the screen you are LOOKING at, so it mounts in the
                                    // ACTIVE section only. The string itself is untouched — this gates the
                                    // MOUNT, not the bytes, so the Windows pin still holds.
                                    if sec.active : dseccopy := Text {
                                        text: root.gamut-copy;
                                        color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap;
                                        opacity: dsecwrap.fade;
                                    }
                                    // v0.8.67 (D): + DCI-P3 (true cinema — DCI white, γ2.6; settings
                                    // index 5, appended so 0..4 stay stable). Display order follows the
                                    // approved Figma (sRGB · P3 · DCI-P3 · Adobe · Rec.2020); Custom now
                                    // shares the third row — the card keeps its three chip rows.
                                    HorizontalLayout {
                                        spacing: 8px;
                                        // v0.8.119 (design-sweep Y66/Y77): labels from the shared
                                        // `gamut-labels` array (Rust-filled from falcon_color's
                                        // Gamut::label), so Settings, the welcome card and the info
                                        // panel's conversion chip can no longer spell one option three
                                        // ways. This card's "Rec.2020" was the odd one out.
                                        OptionChip { label: root.gamut-labels[0]; active: sec.gamut == 0; clicked => { root.set-display-gamut(sec.key, 0); } }
                                        OptionChip { label: root.gamut-labels[1]; active: sec.gamut == 1; clicked => { root.set-display-gamut(sec.key, 1); } }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        OptionChip { label: root.gamut-labels[5]; active: sec.gamut == 5; clicked => { root.set-display-gamut(sec.key, 5); } }
                                        OptionChip { label: root.gamut-labels[2]; active: sec.gamut == 2; clicked => { root.set-display-gamut(sec.key, 2); } }
                                    }
                                    // Custom output gamut (#76): the chip shows the loaded profile's name
                                    // (or "Custom…" when none). Clicking it selects the profile if one is
                                    // loaded, else opens the file picker. The action below loads a profile.
                                    // v0.8.76 (owner): a LONG Custom label ("Custom: <profile>") no longer
                                    // squeezes Rec.2020 — Rust sets custom-gamut-long and the grid MOUNT-
                                    // gates (if, never visible/opacity — hidden elements keep their space
                                    // and steal clicks) between the shared row and a split: Rec.2020 keeps
                                    // its half-width column (the spacer's pref matches the chip's, so the
                                    // solo chip lands at W/2 − 4px, the two-chip-row cell width) and Custom
                                    // SPANS a full row below. The spanning chip STRETCHES (options are grid
                                    // cells and stretch; only actions hug — the Load profile… pill), so it
                                    // reads as a 2-column cell, not a stray action.
                                    if !sec.custom-long : HorizontalLayout {
                                        spacing: 8px;
                                        OptionChip { label: root.gamut-labels[3]; active: sec.gamut == 3; clicked => { root.set-display-gamut(sec.key, 3); } }
                                        OptionChip {
                                            label: sec.custom-label;
                                            active: sec.gamut == 4;
                                            // v0.8.104 (owner ruling): a failed profile makes the chip
                                            // LOOK unavailable while staying the picker shortcut.
                                            dimmed: sec.custom-failed;
                                            // v0.8.106: no `tip:` — OptionChip is not a Tip host (it
                                            // has no cy plumbing, so the tip rendered at the title
                                            // bar). The warning row below this grid names the
                                            // recovery in place; hover keeps the affordance cue.
                                            // v0.8.107: select-or-pick is decided in RUST now, per
                                            // entry — "does THIS display have a usable profile?" is a
                                            // question about its map entry, not about the live one.
                                            clicked => { root.set-display-gamut(sec.key, 4); }
                                        }
                                    }
                                    if sec.custom-long : HorizontalLayout {
                                        spacing: 8px;
                                        rec-solo := OptionChip { label: root.gamut-labels[3]; active: sec.gamut == 3; clicked => { root.set-display-gamut(sec.key, 3); } }
                                        // plain Rectangle spacer: no TouchArea, so the empty right cell
                                        // can't click-steal; pref-matched so Rec.2020 stays half-width.
                                        Rectangle { preferred-width: rec-solo.preferred-width; horizontal-stretch: 1; }
                                    }
                                    if sec.custom-long : HorizontalLayout {
                                        spacing: 8px;
                                        OptionChip {
                                            label: sec.custom-label;
                                            active: sec.gamut == 4;
                                            // v0.8.100 (A4): a remembered path is no longer proof a
                                            // profile is INSTALLED — selecting gamut 4 with none
                                            // loaded would render through a fallback curve while the
                                            // chip claimed Custom. A failed profile re-opens the
                                            // picker, which is also the recovery.
                                            // v0.8.104 (owner ruling): ...and now LOOKS unavailable
                                            // while it does, instead of reading as a normal chip.
                                            dimmed: sec.custom-failed;
                                            // v0.8.106: no `tip:` — see the short-label chip above.
                                            clicked => { root.set-display-gamut(sec.key, 4); }
                                        }
                                    }
                                    // v0.8.68 (D-audit FIX 2): the DCI-P3-vs-Display-P3 caption directly
                                    // under the chip grid — consumer monitors market P3-D65 as "DCI-P3",
                                    // and picking the wrong one magenta-casts neutrals. Same string on
                                    // the welcome col-3 chips. v0.8.77 (owner): standard description
                                    // size (font-sm), not the badge-only font-xs.
                                    Text {
                                        text: root.dci-p3-caption;
                                        color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap;
                                        opacity: dsecwrap.fade;
                                    }
                                    Text {
                                        text: @tr("falcon" => "Custom converts photos to your monitor's own ICC/ICM profile — a calibrated or native display profile — so colours are accurate on this screen. Matrix-based display profiles only (not printer/CMYK profiles).");
                                        color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap;
                                        opacity: dsecwrap.fade;
                                    }
                                    // ── v0.8.100 (A4 / design-sweep O31): the honest failure state ──
                                    // A remembered profile that didn't load leaves the session on the
                                    // sRGB fallback. The chips above already tell the truth by
                                    // construction (they bind `output-gamut`, so sRGB is the lit one
                                    // and Custom is not), and this row supplies the WHY the chips
                                    // can't: which file, what is happening now, and what happens
                                    // next. Mount-gated (never a permanently reserved empty row);
                                    // the sentence itself is Rust-composed, so this card and the boot
                                    // toast are the same words by construction. Calm, not alarming —
                                    // the warn colour, no icon, no modal, no retry button (the retry
                                    // IS the next launch, or "Load profile…" directly below).
                                    if sec.custom-failed : Text {
                                        // v0.8.104 (Round-A C12): the Rust-composed FACT plus THIS
                                        // surface's own direction. One sentence used to serve all
                                        // three surfaces and it ended "or load it again below" --
                                        // true only here. "Below" is the Load profile pill on the
                                        // very next row.
                                        // v0.8.105 (W13): ...and WHICH control depends on the state.
                                        // A profile Falcon auto-detected is its own artifact in the
                                        // app's config dir -- the photographer never loaded it,
                                        // cannot recognise it in a file dialog, and the real
                                        // recovery is the Auto-detect button on THIS section, above.
                                        // v0.8.107: the FACT names the display too, so two sections
                                        // can never show the same sentence about different screens.
                                        text: sec.custom-warn + " " + (sec.custom-auto
                                                ? @tr("falcon" => "Or run Auto-detect again above.")
                                                : @tr("falcon" => "Or load it again below."));
                                        color: Theme.warn; font-size: Theme.font-sm; wrap: word-wrap;
                                        opacity: dsecwrap.fade;
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        // v0.8.65 (C3/M9): auto-detect moved UP to the recommended row;
                                        // the manual profile load stays with the Custom copy it serves.
                                        PillBtn { text: @tr("falcon" => "Load profile…"); clicked => { root.pick-display-icc(sec.key); } }
                                        // v0.8.107 (owner ruling D2): a display that is not plugged in
                                        // can be FORGOTTEN from here — the primary removal affordance,
                                        // and the only one that does not require plugging it back in.
                                        // Mount-gated: a connected display has nothing to forget (turning
                                        // it back to plain sRGB already drops its entry), and never on
                                        // the ACTIVE row — the handler refuses that key, so mounting it
                                        // there would be an ungated invoker over a gated body (L26).
                                        //
                                        // v0.8.108 (owner ruling 9, audit A15): it is DESTRUCTIVE — one
                                        // click used to irreversibly forget a hand-calibrated profile
                                        // path with no confirmation, no undo and no danger signifier,
                                        // pixel-adjacent to the benign "Load profile…" in identical
                                        // styling. It now carries the danger tint AND routes through the
                                        // app's own confirm grammar (the delete-preset shape), which is
                                        // also where "Enter never destroys" comes from.
                                        if !sec.connected && !sec.active : dsecrm := PillBtn {
                                            text: @tr("falcon" => "Remove");
                                            danger: true;
                                            clicked => {
                                                root.display-del-name = sec.name;
                                                root.display-del-key = sec.key;
                                                root.display-del-confirm = true;
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                        }
                                        }
                                    }
                                }
                            }
                            Rectangle { height: 4px; }
                            if root.file-assoc-visible : SectionLabel { text: @tr("falcon" => "FILE ASSOCIATIONS"); }
                            // ── v0.9.16 (Round B assoc): the Mac DEFAULT-HANDLER card ──
                            // macOS lets an app set itself as default (LaunchServices per-user
                            // preference), so the Mac card is per-family [Make default]/[Reset to
                            // previous] + a Rust-composed read-back line — the same list-driven
                            // families, the same SettingsGroup/PillBtn grammar as the Windows card
                            // below (assoc-mac-mode picks which card mounts; Windows byte-identical).
                            if root.file-assoc-visible && root.assoc-mac-mode : SettingsGroup {
                                VerticalLayout {
                                    padding-top: Theme.space-2h; padding-bottom: 12px; spacing: 9px;
                                    VerticalLayout {
                                        padding-left: 12px; padding-right: 12px; spacing: Theme.space-1h;
                                        Text {
                                            text: @tr("falcon" => "Falcon is in Finder's “Open With” menu for all supported formats. Make it the default app per format below — Reset restores the previous default. (Takes effect when running the installed Falcon.app.)");
                                            color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap;
                                        }
                                    }
                                    VerticalLayout { spacing: 3px;
                                        for r[i] in root.mac-assoc-rows : VerticalLayout {
                                            spacing: 2px;
                                            padding-left: 12px; padding-right: 12px;
                                            padding-top: 4px; padding-bottom: 4px;
                                            HorizontalLayout {
                                                spacing: 8px;
                                                Text {
                                                    text: r.label; color: Theme.text; font-size: Theme.font-body;
                                                    vertical-alignment: center; horizontal-stretch: 1;
                                                    overflow: elide;
                                                }
                                                PillBtn { text: @tr("falcon" => "Make default"); enabled: root.mac-assoc-change-enabled; clicked => { root.mac-assoc-make-default(i); } }
                                                PillBtn { text: @tr("falcon" => "Reset"); enabled: root.mac-assoc-change-enabled && r.reset-enabled; clicked => { root.mac-assoc-reset(i); } }
                                            }
                                            Text {
                                                // the read-back line ("Default: Preview"), plus the
                                                // disabled-Reset reason when one applies.
                                                text: r.note == "" ? r.current : @tr("falcon" => "{0} — {1}", r.current, r.note);
                                                color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap;
                                            }
                                        }
                                    }
                                }
                            }
                            // W1/D5: per-user Open-With registration. Windows won't let an app make
                            // itself the DEFAULT — we register, the user picks Falcon once in the OS
                            // dialog. Toggles live-apply while registered; the copy carries the
                            // "register again after moving the app" caveat (the command embeds the path).
                            if root.file-assoc-visible && !root.assoc-mac-mode : SettingsGroup {
                                VerticalLayout {
                                    padding-top: Theme.space-2h; padding-bottom: 12px; spacing: 9px;
                                    VerticalLayout {
                                        padding-left: 12px; padding-right: 12px; spacing: Theme.space-1h;
                                        Text {
                                            text: root.assoc-registered
                                                ? @tr("falcon" => "Falcon is in Windows' “Open with” menu for the formats below. To make it the default, right-click a photo → Open with → Always, or use the Windows Settings button. If you move Falcon.exe, press Update.")
                                                : @tr("falcon" => "Adds Falcon to Windows' “Open with” menu for these formats. Windows doesn't let apps set themselves as default — after adding, pick Falcon once in the “Open with” dialog.");
                                            color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap;
                                        }
                                    }
                                    // V2 (v0.8.2): tighten ONLY the inter-row gaps between the assoc rows to 3px (== the ToggleRow hover's 3px L/R inset). The intro-to-first-row and last-row-to-actions gaps keep the outer 9px per the user's annotation; rows stay 44px, only the inter-row gaps shrink.
                                    // v0.8.59: +GIF/BMP/JPEG XL rows (the v0.8.55 formats batch, now associable) and the
                                    // PNG label names .apng (registered with the PNG family since v0.8.56). Row order
                                    // mirrors support.rs ASSOC_FAMILIES — finished formats, then the RAW opt-in.
                                    VerticalLayout { spacing: 3px;
                                        ToggleRow {
                                            label: "JPEG (.jpg, .jpeg)"; on: root.assoc-jpeg; bg: transparent; bw: 0px;
                                            toggled => { root.assoc-jpeg = !root.assoc-jpeg; if (root.assoc-registered) { root.assoc-apply(); } }
                                        }
                                        ToggleRow {
                                            label: "PNG (.png, .apng)"; on: root.assoc-png; bg: transparent; bw: 0px;
                                            toggled => { root.assoc-png = !root.assoc-png; if (root.assoc-registered) { root.assoc-apply(); } }
                                        }
                                        ToggleRow {
                                            label: "TIFF (.tif, .tiff)"; on: root.assoc-tiff; bg: transparent; bw: 0px;
                                            toggled => { root.assoc-tiff = !root.assoc-tiff; if (root.assoc-registered) { root.assoc-apply(); } }
                                        }
                                        // v0.8.71 (Round B assoc): HEIC is the ONE conditional row — WIC decodes it only
                                        // through the installable HEVC/HEIF Image Extensions, so with no codec the row
                                        // fades (opacity + ToggleRow's own enabled-mute) and its explanation line mounts
                                        // below (an INLINE element per the colour-chip-note precedent — the shared Tip
                                        // channel renders at the title bar, far from this row; inline also reaches
                                        // visual thinkers without a hover hunt). Codec present → byte-identical to the
                                        // pre-v0.8.71 row (avail defaults true, the tip line never mounts).
                                        ToggleRow {
                                            label: "HEIC (.heic, .heif)"; on: root.assoc-heic; bg: transparent; bw: 0px;
                                            enabled: root.assoc-heic-avail;
                                            opacity: root.assoc-heic-avail ? 1.0 : 0.55;
                                            toggled => { root.assoc-heic = !root.assoc-heic; if (root.assoc-registered) { root.assoc-apply(); } }
                                        }
                                        if !root.assoc-heic-avail : VerticalLayout {
                                            padding-left: 12px; padding-right: 12px;
                                            Text { text: root.assoc-heic-tip; color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap; }
                                        }
                                        ToggleRow {
                                            label: "WebP (.webp)"; on: root.assoc-webp; bg: transparent; bw: 0px;
                                            toggled => { root.assoc-webp = !root.assoc-webp; if (root.assoc-registered) { root.assoc-apply(); } }
                                        }
                                        ToggleRow {
                                            label: "GIF (.gif)"; on: root.assoc-gif; bg: transparent; bw: 0px;
                                            toggled => { root.assoc-gif = !root.assoc-gif; if (root.assoc-registered) { root.assoc-apply(); } }
                                        }
                                        ToggleRow {
                                            label: "BMP (.bmp)"; on: root.assoc-bmp; bg: transparent; bw: 0px;
                                            toggled => { root.assoc-bmp = !root.assoc-bmp; if (root.assoc-registered) { root.assoc-apply(); } }
                                        }
                                        ToggleRow {
                                            label: "JPEG XL (.jxl)"; on: root.assoc-jxl; bg: transparent; bw: 0px;
                                            toggled => { root.assoc-jxl = !root.assoc-jxl; if (root.assoc-registered) { root.assoc-apply(); } }
                                        }
                                        ToggleRow {
                                            label: "RAW (.cr3, .nef, .arw, …)"; on: root.assoc-raw; bg: transparent; bw: 0px;
                                            toggled => { root.assoc-raw = !root.assoc-raw; if (root.assoc-registered) { root.assoc-apply(); } }
                                        }
                                    }
                                    raw-icon-option := ToggleRow {
                                        label: @tr("falcon" => "Distinct RAW-format icons");
                                        on: root.distinct-raw-icons; bg: transparent; bw: 0px;
                                        toggled => { root.distinct-raw-icons-toggled(); }
                                    }
                                    HorizontalLayout {
                                        padding-left: 12px; padding-right: 12px; spacing: 12px;
                                        // Plain ACTIONS (not toggles) → PillBtn, which centres its
                                        // label (default-stretch layout + Text horizontal-alignment:
                                        // center). OptionChip's alignment:center left-shifted the text.
                                        PillBtn {
                                            text: root.assoc-registered ? @tr("falcon" => "Update") : @tr("falcon" => "Add to Open With");
                                            clicked => { root.assoc-apply(); }
                                        }
                                        if root.assoc-registered : PillBtn {
                                            text: @tr("falcon" => "Remove");
                                            clicked => { root.assoc-remove(); }
                                        }
                                        if root.assoc-registered : PillBtn {
                                            text: @tr("falcon" => "Windows Settings…");
                                            clicked => { root.assoc-open-defaults(); }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                    if root.assoc-status != "" : VerticalLayout {
                                        padding-left: 12px; padding-right: 12px;
                                        Text { text: root.assoc-status; color: Theme.warn; font-size: Theme.font-sm; wrap: word-wrap; }
                                    }
                                }
                            }
                            Rectangle { height: 4px; }
                            SectionLabel { text: @tr("falcon" => "DEVELOPER"); }
                            // v0.8.44 (G4): DEVELOPER holds the true engine levers (Interface motion →
                            // DISPLAY stays a user preference). This muted note demotes the section so a
                            // never-touch knob can't read as a daily preference. v0.8.50 (G4, owner): the
                            // drag-up tolerance card returned here from INPUT (owner placement call).
                            Text { text: @tr("falcon" => "Engine levers — defaults are tuned for this machine. Changing them can degrade performance.");
                                   color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap; }
                            // (The glass/opaque A-B toggle retired in W2/v0.3.57 — opaque is the design.)
                            ToggleRow {
                                bg: Theme.block;
                                label: @tr("falcon" => "Dev panel (HUD)"); on: root.dev-hud;
                                toggled => { root.dev-hud = !root.dev-hud; }
                            }
                            // ── v0.8.169 (item 3+6, OWNER RULING): THE LOG, MOVED HERE FROM THE ──
                            // ── RIGHT-CLICK MENU. ────────────────────────────────────────────────
                            // "Show log file" was a row on the photo context menu — a dev tool on the
                            // surface a photographer opens over a photograph, between "Reveal in
                            // Explorer" and "Delete…". It is the same CALLBACK (`show-log`, which
                            // reveals falcon.log in Explorer with the file selected); only the
                            // surface moved, so nothing about the action changed and no handler was
                            // orphaned. It stays in the VISIBLE tier of this section by the ruling's
                            // own words ("except the dev panel (HUD) and the new locate logs button").
                            //
                            // GRAMMAR REUSED, nothing minted: the left-aligned `PillBtn` + trailing
                            // stretch spacer that CONTROLS' "Reset to defaults" foot row and the
                            // panel footer's "Show welcome" already use — the section's quiet
                            // action dialect.
                            diagnosticlog := ToggleRow {
                                bg: Theme.block;
                                label: @tr("falcon" => "Diagnostic logging"); on: root.diagnostic-logging;
                                toggled => {
                                    root.diagnostic-logging = !root.diagnostic-logging;
                                    root.diagnostic-logging-toggled(root.diagnostic-logging);
                                }
                            }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                devlog := PillBtn {
                                    text: @tr("falcon" => "Show log file");
                                    clicked => { root.show-log(); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Text { text: @tr("falcon" => "Opens the diagnostic log's folder. When logging is on, it records bulk review, copy, move and export activity.");
                                   color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap; }
                            // ── v0.8.169 (item 7, OWNER RULING): THE HEIC LANE CAP, TESTABLE. ────
                            // "add a dev settings slider for this - with the following 3 options
                            // custom|4|uncapped so that I can test them."
                            //
                            // VISIBLE TIER, deliberately and by the ruling: it is the one lever in
                            // this section the owner is actively using on the laptop, so folding it
                            // with the legacy rows would defeat the reason it exists. Card grammar
                            // is the "Filmstrip drag-up tolerance" tuner card directly below,
                            // verbatim (SettingsGroup title slot + a status subline + a CustomSeg on
                            // its own 12px-side wrapper) — the same shape every typed dev tuner in
                            // this panel has worn since G12.
                            //
                            // THE CONTROL IS NOT MOUNTED WHEN THE ENV LEVER IS SET (L15/L21). With
                            // `FALCON_HEIC_LANE_CAP` exported, `support::heic_lane_cap` answers from
                            // the environment for the whole boot and this setting cannot move the
                            // live value — so instead of a lit control that silently refuses, the
                            // card shows only its note, which names the env value and says the
                            // setting resumes on the next launch without it. Dev levers win; the UI
                            // says so rather than pretending otherwise.
                            SettingsGroup {
                                title: @tr("falcon" => "HEIC hardware lane: speculative decode cap");
                                VerticalLayout {
                                    padding-left: 12px; padding-right: 12px; spacing: Theme.space-1h;
                                    // State-derived, published by Rust (`support::lane_cap_note`):
                                    // it carries a number, and Slint has no int+string concat.
                                    Text { text: root.heic-lane-cap-note;
                                           color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap; }
                                }
                                if !root.heic-lane-cap-env : VerticalLayout {
                                    padding-left: 12px; padding-right: 12px; spacing: 7px;
                                    // Custom is CustomSeg's own built-in leading segment, so the
                                    // rendered order is exactly the owner's: Custom | 4 | Uncapped.
                                    // `custom > 0` is the component's contract for "a typed value is
                                    // active", which is why 0 means UNCAPPED here and the typed slot
                                    // clamps to 1..18 rather than admitting 0 (Rust owns the clamp).
                                    lanecapseg := CustomSeg {
                                        stops: ["4", @tr("falcon" => "Uncapped")];
                                        index: root.heic-lane-cap == 4 ? 0 : 1;
                                        custom: (root.heic-lane-cap == 0 || root.heic-lane-cap == 4) ? 0 : root.heic-lane-cap;
                                        picked(i) => { root.heic-lane-cap = i == 0 ? 4 : 0; root.set-heic-lane-cap(root.heic-lane-cap); }
                                        custom-committed(t) => { if (t != "") { root.set-heic-lane-cap-custom(t); } keys.focus(); }
                                    }
                                }
                            }
                            // Owner ruling (4 October): widths tuned to English stay by default; this
                            // lets a translator and the owner see each translated label at full width.
                            // Visible tier, because it is how a language pack's layout is checked.
                            SettingsGroup {
                                VerticalLayout {
                                    padding-top: 0px; padding-bottom: 12px; spacing: 0px;
                                    fittextrow := ToggleRow {
                                        bg: transparent; bw: 0px;
                                        label: @tr("falcon" => "Widen controls to fit text"); on: Theme.fit-text;
                                        toggled => { Theme.fit-text = !Theme.fit-text; root.fit-text-toggled(); }
                                    }
                                    VerticalLayout {
                                        padding-left: 12px; padding-right: 12px;
                                        Text { text: @tr("falcon" => "For checking translations. Off keeps the standard layout.");
                                               color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap; }
                                    }
                                }
                            }
                            // ── v1.0.0-rc (queue item 33, OWNER RULING 2.4b): THE ADVANCED FOLD ─
                            // *"(c) split into 'Advanced' and 'Legacy', both with the '· N
                            // changed' badge."* The 08-12 review's F5-4: nine persisted levers sat
                            // behind ONE fold whose header was a literal, so a lever flipped weeks
                            // ago had zero on-screen trace the moment the fold closed — and the
                            // fold resets closed on every open, so that is the state it is always
                            // in. Two folds answer the first half ("Legacy" described the
                            // developer's attention, not the rows; after the split each name
                            // describes its own contents, ledger L17), and the state-derived
                            // suffix answers the second.
                            //
                            // ADVANCED = the levers with a reason to be touched: direct bulk
                            // rating, the posture benchmark, the filmstrip drag-up cone, the GPU
                            // backend pin, and the dev-hud-gated Simulate VRAM chips. The HEIC
                            // lane cap is NOT here — it stays in the visible tier by the owner's
                            // v0.8.169 item-7 ruling, re-confirmed for this round ("Proceed with
                            // (a)", 2026-09-06).
                            //
                            // GRAMMAR: the legacy header below, verbatim — which is itself the
                            // per-display colour sections' disclosure header (v0.8.107 D1): a 30px
                            // `radius-ctrl` row, `Theme.hover` wash on the WHOLE row, a stretch-1
                            // eliding label, the app's ONE expand/collapse `ChevronGlyph` in a
                            // 24px box, and a full-row TouchArea as the single hit target.
                            //
                            // THE SUFFIX IS PART OF THE SAME `Text`, in the same `text-dim`, not a
                            // chip: this row is a disclosure header, not a control row, and a chip
                            // is the app's grammar for a value you can act on (L8 — the nearest
                            // component over-delivers). `dev-advanced-changed` counts only
                            // PERSISTED levers; see `support::dev_fold_counts` for why Simulate
                            // VRAM and the benchmark are excluded.
                            devadvancedhead := Rectangle {
                                height: 30px;
                                border-radius: Theme.radius-ctrl;
                                background: devadvancedta.has-hover ? Theme.hover : transparent;
                                animate background { duration: Theme.anim; easing: ease; }
                                HorizontalLayout {
                                    padding-left: Theme.space-1; padding-right: 2px;
                                    spacing: Theme.space-1h;
                                    Text {
                                        text: root.dev-advanced-changed > 0 ? @tr("falcon" => "Advanced · {0} changed", root.dev-advanced-changed) : @tr("falcon" => "Advanced");
                                        color: Theme.text-dim; font-size: Theme.font-body;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1; overflow: elide;
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 24px; height: 24px;
                                            ChevronGlyph {
                                                // exact centring — an AA'd stroke has no hard edge
                                                // to land on the even grid (v0.8.191 S2-B).
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                points-down: !root.dev-advanced-open;
                                            }
                                        }
                                    }
                                }
                                devadvancedta := TouchArea {
                                    clicked => { root.dev-advanced-open = !root.dev-advanced-open; }
                                }
                            }
                            // ── the Advanced fold's rows, MOVED VERBATIM out of the single fold:
                            // direct bulk rating · posture benchmark · filmstrip drag-up tolerance
                            // · GPU backend · the dev-hud-gated Simulate VRAM chips. Bindings,
                            // callbacks, comments and `enabled` gates are UNTOUCHED — this is the
                            // same mount gate around the same rows, one fold over.
                            if root.dev-advanced-open : VerticalLayout {
                                // `body`'s own 8px, restated — this wrapper must reproduce the
                                // column rhythm it interposes in (L10), exactly as its twin does.
                                spacing: 8px;
                            // v0.8.130 (W2-2, owner ruling Q1): skip the ask-first question when a
                            // digit key (or a glowing panel star) rates a whole selection. OFF by
                            // default — the ask is the only thing between one keypress and a
                            // hundred rewritten ratings. Persist-only, like pool18: no callback,
                            // the rate path reads this property live.
                            ToggleRow {
                                bg: Theme.block;
                                label: @tr("falcon" => "Direct bulk rating (no ask)"); on: root.direct-bulk-rating;
                                toggled => { root.direct-bulk-rating = !root.direct-bulk-rating; }
                            }
                            // v0.9.9 (P6): the TEMPORARY dev "posture benchmark" — a measurement
                            // instrument for the upcoming battery/posture design. LOG-ONLY (writes
                            // posture-bench: … lines to falcon.log); shares the §43 bench-running guard
                            // so the two can't run at once. Removed once the posture design lands.
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 12px; spacing: 12px;
                                Text { text: @tr("falcon" => "Posture benchmark (dev)"); color: Theme.text-mute; font-size: Theme.font-md;
                                       vertical-alignment: center; horizontal-stretch: 1; }
                                PillBtn {
                                    text: root.bench-running ? @tr("falcon" => "Running…") : @tr("falcon" => "Run");
                                    enabled: !root.bench-running;
                                    clicked => { if (!root.bench-running) { root.run-posture-bench(); } }
                                }
                            }
                            // v0.8.27: the filmstrip drag-UP → A/B compare cone — ± degrees from
                            // straight up that classify a strip drag as a compare drag (anything
                            // flatter scrubs; downward never triggers). LIVE: the classifier reads
                            // this per gesture (film_drag_classify), so tuning needs no restart.
                            // Row grammar = the tuner-card standard (SettingsGroup title slot +
                            // status subline + CustomSeg with a typed Custom slot — clamps 5..45).
                            // v0.8.50 (G4, owner 2026-07-16): moved back INPUT → DEVELOPER (reverses
                            // the v0.8.44 G4 move) — card byte-identical, placement only.
                            SettingsGroup {
                                title: @tr("falcon" => "Filmstrip drag-up tolerance");
                                VerticalLayout {
                                    padding-left: 12px; padding-right: 12px; spacing: Theme.space-1h;
                                    Text { text: @tr("falcon" => "{0}° each side of straight up sends the thumb to A/B compare — flatter drags scrub the strip.", root.film-cone-deg);
                                           color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap; }
                                }
                                VerticalLayout {
                                    padding-left: 12px; padding-right: 12px; spacing: 7px;
                                    CustomSeg {
                                        stops: ["10", "15", "20", "25", "30"];
                                        suffix: "°";
                                        index: root.film-cone-deg == 10 ? 0 : (root.film-cone-deg == 15 ? 1 : (root.film-cone-deg == 25 ? 3 : (root.film-cone-deg == 30 ? 4 : 2)));
                                        custom: (root.film-cone-deg == 10 || root.film-cone-deg == 15 || root.film-cone-deg == 20 || root.film-cone-deg == 25 || root.film-cone-deg == 30) ? 0 : root.film-cone-deg;
                                        picked(i) => { root.film-cone-deg = i == 0 ? 10 : (i == 1 ? 15 : (i == 2 ? 20 : (i == 3 ? 25 : 30))); }
                                        custom-committed(t) => { if (t != "") { root.set-film-cone-custom(t); } keys.focus(); }
                                    }
                                }
                            }
                            // v0.8.43: GPU backend auto-tune + override. Read-only status (this boot's
                            // backend + adapter + the last measured per-backend init times) plus a 3-way
                            // pin. Auto re-tunes next launch; Vulkan/DX12 pin that backend. The backend is
                            // chosen once at boot, so a change takes effect on the NEXT launch. Row grammar
                            // = the reveal-linger card (SettingsGroup + status sublines + a picker), which moved to
                            // DISPLAY in v0.8.116 (D-C).
                            SettingsGroup {
                                title: @tr("falcon" => "GPU backend");
                                VerticalLayout {
                                    padding-left: 12px; padding-right: 12px; spacing: Theme.space-1h;
                                    Text { text: root.gpu-cur-adapter == "" ? (root.gpu-cur-backend == "" ? @tr("falcon" => "detecting…") : root.gpu-cur-backend) : @tr("falcon" => "{0} · {1}", root.gpu-cur-backend == "" ? @tr("falcon" => "detecting…") : root.gpu-cur-backend, root.gpu-cur-adapter);
                                           color: Theme.text; font-size: Theme.font-sm; wrap: word-wrap; }
                                    Text { text: root.gpu-timings == "" ? @tr("falcon" => "No measured times yet — Auto tunes on the next normal launch.") : @tr("falcon" => "Measured: {0}", root.gpu-timings);
                                           color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap; }
                                }
                                // v0.9.12 (C2/M10): the Vulkan/DX12 override is meaningless on macOS (only
                                // the Metal backend exists), so the picker is hidden there — the read-only
                                // status line above still reports the live backend ("Metal · <adapter>").
                                // Windows: is-mac is false → this mounts exactly as before (pixel-identical).
                                if !root.is-mac : VerticalLayout {
                                    padding-left: 12px; padding-right: 12px; spacing: 7px;
                                    Seg {
                                        opts: [@tr("falcon" => "Auto"), "Vulkan", "DX12"];
                                        sel: root.gpu-backend-sel;
                                        changed(i) => { root.gpu-backend-sel = i; root.set-gpu-backend-override(i); }
                                    }
                                    Text { text: @tr("falcon" => "Takes effect at next launch — the backend is chosen once at startup.");
                                           color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap; }
                                }
                            }
                            // Dev-only: pretend the GPU has this much VRAM, to test the
                            // low-VRAM cache behaviour (smaller budget + window) on this machine.
                            if root.dev-hud : VerticalLayout {
                                padding-left: 12px; padding-right: 12px; spacing: Theme.space-1h;
                                Text { text: @tr("falcon" => "Simulate VRAM (re-sizes the texture budget live)");
                                       color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    OptionChip { stretch: false; label: @tr("falcon" => "Auto"); active: root.sim-vram-gb == 0; clicked => { root.sim-vram-gb = 0; root.set-sim-vram(0); } }
                                    OptionChip { stretch: false; label: @tr("falcon" => "{0} GB", 4); active: root.sim-vram-gb == 4; clicked => { root.sim-vram-gb = 4; root.set-sim-vram(4); } }
                                    OptionChip { stretch: false; label: @tr("falcon" => "{0} GB", 8); active: root.sim-vram-gb == 8; clicked => { root.sim-vram-gb = 8; root.set-sim-vram(8); } }
                                    OptionChip { stretch: false; label: @tr("falcon" => "{0} GB", 12); active: root.sim-vram-gb == 12; clicked => { root.sim-vram-gb = 12; root.set-sim-vram(12); } }
                                }
                            }
                            } // v1.0.0-rc (item 33): end of the Advanced dev fold
                            // ── v0.8.169 (item 6, OWNER RULING): THE LEGACY FOLD'S HEADER ───────
                            // Everything below this row is a lever the owner has not touched in
                            // months. It is MOUNT-GATED (`if`, never `visible:` — a hidden body
                            // keeps its space and steals every click in it, ledger L4), so a
                            // collapsed fold costs this one 30px row and the section's own scroll
                            // geometry shrinks with it. `setflick` remains THE absorber for this
                            // panel and nothing here competes for surplus, so the height change is
                            // absorbed exactly as the display sections' collapse already is.
                            //
                            // GRAMMAR REUSED — the per-display colour sections' disclosure header
                            // (v0.8.107 D1), verbatim: a 30px `radius-ctrl` row, `Theme.hover` wash
                            // on the WHOLE row, a stretch-1 eliding label, the app's ONE
                            // expand/collapse `ChevronGlyph` in a 24px box, and a full-row TouchArea
                            // as the single hit target (that round's audit found the IconBtn variant
                            // buried under the row TouchArea and dead — one hit target, honestly).
                            //
                            // WORDING [VD]: a NOUN plus the chevron, not the imperative "Show legacy
                            // dev settings". The chevron already carries the direction under the
                            // owner's own 2026-08-04 rule (the arrow points where the content will
                            // move: collapsed = down, expanded = up), and a static imperative over a
                            // two-state disclosure is L20's "always wrong in some state" — it would
                            // read "Show…" while the rows are already showing. The words say what
                            // the fold contains; the glyph says what a click does.
                            //
                            // v1.0.0-rc (queue item 33, OWNER RULING 2.4b): "Legacy dev settings"
                            // becomes "Legacy". The section label two cards up already says
                            // DEVELOPER, so "dev settings" was the section's word repeated inside
                            // it; and with a sibling fold beside it the one word that has to do
                            // work is the one that tells the two apart. The header is now
                            // STATE-DERIVED (L20) for the same reason its twin is: a constant
                            // "Legacy" over a fold holding a non-default lever is a header that is
                            // wrong in exactly the state the split exists to surface.
                            devlegacyhead := Rectangle {
                                height: 30px;
                                border-radius: Theme.radius-ctrl;
                                background: devlegacyta.has-hover ? Theme.hover : transparent;
                                animate background { duration: Theme.anim; easing: ease; }
                                HorizontalLayout {
                                    padding-left: Theme.space-1; padding-right: 2px;
                                    spacing: Theme.space-1h;
                                    Text {
                                        text: root.dev-legacy-changed > 0 ? @tr("falcon" => "Legacy · {0} changed", root.dev-legacy-changed) : @tr("falcon" => "Legacy");
                                        color: Theme.text-dim; font-size: Theme.font-body;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1; overflow: elide;
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 24px; height: 24px;
                                            ChevronGlyph {
                                                // v0.8.191 (S2-B) REVERTED — exact centring; an AA'd
                                                // stroke has no hard edge to land on the even grid.
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                points-down: !root.dev-legacy-open;
                                            }
                                        }
                                    }
                                }
                                devlegacyta := TouchArea {
                                    clicked => { root.dev-legacy-open = !root.dev-legacy-open; }
                                }
                            }
                            // ── the Legacy fold's rows — the FIVE ENGINE LEVERS and the note that
                            // annotates two of them: async frosted blur · RAM frame cache (L2) ·
                            // browse-priority detail scheduling · frost from thumbnails · 18-worker
                            // decode pool. Bindings, callbacks and order are UNTOUCHED; v1.0.0-rc
                            // (item 33) moved the other five items into the Advanced fold above
                            // and changed nothing inside any of them.
                            if root.dev-legacy-open : VerticalLayout {
                                // `body`'s own 8px, restated — this wrapper must reproduce the
                                // column rhythm it interposes in, or every folded row would sit on
                                // a different pitch from the visible ones above it (L10).
                                spacing: 8px;
                            // B1 (v0.7.6): frosted-glass blur mip in the parallel decode pool
                            // (default ON — the maximized-4K browse fix) vs the old serial
                            // upload-thread downscale (spikes-decode-bench/browse_cost proved it).
                            ToggleRow {
                                bg: Theme.block;
                                label: @tr("falcon" => "Async frosted blur (decode pool)"); on: root.async-blur;
                                toggled => { root.async-blur = !root.async-blur; root.set-async-blur(root.async-blur); }
                            }
                            // v0.7.7 (§57): keep fast frames' bytes alive in RAM after VRAM
                            // eviction (default ON — a backward pass / direction flip re-uploads
                            // from RAM with no re-decode) vs dropping them (the pre-v0.7.7 path).
                            // v0.8.119 (design-sweep O28): `on:` reads the EFFECTIVE gate, and on a
                            // platform that forces the cache off the row is honestly dead rather than
                            // silently inert. See `dev-l2-on` / `dev-levers-live`.
                            ToggleRow {
                                bg: Theme.block;
                                label: @tr("falcon" => "RAM frame cache (L2)"); on: root.dev-l2-on;
                                enabled: root.dev-levers-live;
                                opacity: root.dev-levers-live ? 1.0 : 0.55;
                                toggled => { root.ram-l2 = !root.ram-l2; root.set-ram-l2(root.ram-l2); }
                            }
                            // v0.7.9 (§60): browse-priority detail scheduling — the
                            // velocity-gated detail prefetch burst (Lever 2) + fast-lane upload
                            // priority (Lever 1). OFF = pre-v0.7.9 (settle-only burst + arrival order).
                            ToggleRow {
                                bg: Theme.block;
                                label: @tr("falcon" => "Browse-priority detail scheduling"); on: root.detail-sched;
                                toggled => { root.detail-sched = !root.detail-sched; root.set-detail-sched(root.detail-sched); }
                            }
                            // A3 (§61): source the frosted-blur mip from the 256px thumbnail
                            // (default ON — a fast decode then skips the ~44.8 MB per-frame
                            // downscale) vs building it per-frame. A miss falls back to the frame.
                            ToggleRow {
                                bg: Theme.block;
                                label: @tr("falcon" => "Frost from thumbnails"); on: root.frost-thumb;
                                toggled => { root.frost-thumb = !root.frost-thumb; root.set-frost-thumb(root.frost-thumb); }
                            }
                            // A3 (§61): fast decode pool up to 18 workers (default ON) vs the old 16.
                            // Boot-only — the pool is sized at startup, so this applies on the NEXT
                            // launch (no live callback; persisted like dev-hud).
                            // v0.8.119 (design-sweep O28): the same treatment — this row promises a
                            // restart-applied effect the Mac one-pool build does not honour.
                            ToggleRow {
                                bg: Theme.block;
                                label: @tr("falcon" => "Decode pool: 18 workers (restart)"); on: root.pool18;
                                enabled: root.dev-levers-live;
                                opacity: root.dev-levers-live ? 1.0 : 0.55;
                                toggled => { root.pool18 = !root.pool18; }
                            }
                            // v0.9.63 (merge): the dev-levers note stays IMMEDIATELY under the two
                            // rows it annotates (RAM frame cache L2, pool18) — it is the O28
                            // honest-dead-row line for exactly those two `dev-levers-live` gates, and
                            // a row inserted between it and them would read as annotating the wrong
                            // control.
                            // v1.0.0-rc (queue item 33, 2.4b): everything that USED to follow this
                            // note — the persist-only toggle and the dev instrument — is in the
                            // Advanced fold now, so the note is the LAST item in Legacy and sits
                            // directly under pool18. That is stricter than what v0.9.63 asked for
                            // and satisfies it for the same reason.
                            if !root.dev-levers-live && root.dev-levers-note != "" : VerticalLayout {
                                padding-left: 12px; padding-right: 12px;
                                Text { text: root.dev-levers-note; color: Theme.text-mute;
                                       font-size: Theme.font-sm; wrap: word-wrap; }
                            }
                            } // v0.8.169 (item 6) / v1.0.0-rc (item 33): end of the Legacy dev fold
                            Rectangle { height: 4px; }
                            SectionLabel { text: @tr("falcon" => "CONTROLS"); }
                            Text { text: @tr("falcon" => "Click a key to rebind, then press a new key.");
                                   color: Theme.text-mute; font-size: Theme.font-sm; }
                            // plain layout (no inner scroll) so it scrolls with the rest
                            VerticalLayout {
                                spacing: 4px;
                                // v0.8.65 (C3, J5-3): each row gains an optional inline warning line
                                // (kb.warn) under it — a refused capture collision. A "" warn adds NO
                                // child, so warning-free rows render byte-identically.
                                for kb in root.keybinds : VerticalLayout {
                                    spacing: 2px;
                                    HorizontalLayout {
                                        height: 32px; spacing: 8px;
                                        // v0.8.96-audit (owner amendment): the ONE row whose label is
                                        // state-derived — see `info-bind-label`. The model's static
                                        // label still backs every other use of the row (conflict
                                        // messages via support::action_label); only what the user
                                        // READS here follows the panel, live. The keycap is untouched.
                                        Text { text: kb.action == "info" ? root.info-bind-label : kb.label;
                                               color: Theme.text; font-size: Theme.font-body;
                                               vertical-alignment: center; horizontal-stretch: 1; }
                                        // v0.8.44 (G10): the shared Chip primitive, KEYCAP role — the prominent
                                        // control dialect (96×28, state-coloured; DELIBERATELY louder than the
                                        // menu hint chips per the user's role split). Look byte-identical; the
                                        // rebind TouchArea stays here so the wiring never moved.
                                        Chip {
                                            role: ChipRole.keycap;
                                            active: kb.capturing;
                                            hover: kbta.has-hover;
                                            text: kb.capturing ? @tr("falcon" => "Press a key…") : kb.key;
                                            // v0.8.120 (design-sweep O26): claim focus BEFORE arming.
                                            // The capture funnel lives inside the `keys` FocusScope,
                                            // which is a SIBLING of this panel — so with any Settings
                                            // TextInput still focused (the Custom resume-cap cell, a
                                            // res-limit field), every subsequent keystroke went to
                                            // that TextInput and the row said "Press a key…" for ever.
                                            // The idiom is the one the sibling fields already use.
                                            kbta := TouchArea { clicked => { keys.focus(); root.rebind(kb.action); } }
                                        }
                                    }
                                    if kb.warn != "" : Text {
                                        text: kb.warn; color: Theme.warn; font-size: Theme.font-sm;
                                        horizontal-alignment: right; wrap: word-wrap;
                                    }
                                }
                            }
                            // ── v0.8.156 (C3, owner ruling Q8+Q32): CONTROLS GETS THE PILL ────
                            // "…like BASIC SHORTCUTS'" — so it IS that pill: the same `PillBtn`,
                            // the same words, the same left-aligned foot row with the same
                            // Theme.space-2 gap and trailing stretch spacer (its twin is ~150
                            // lines down, at the unlocked BASIC list's foot). MIRRORED BEHAVIOUR:
                            // that pill CONFIRMS NOTHING — one click restores the table — so
                            // neither does this one. Live-commit, like every rebind in this
                            // section and like the ruling says (no staged Edit/Save/Cancel was
                            // ordered here, and CONTROLS has no Edit mode to stage into).
                            // Its FOOT, not the section header: the header here is a bare
                            // SectionLabel with no pills at all, and the BASIC header's own
                            // comment records why its Reset sits at the list foot — a third
                            // hugging pill overflowed that row (L5), and a destructive-ish verb
                            // is better parked away from the buttons the user aims for.
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                // `cullreset` is named for the rig (the BASIC twin needs no id —
                                // its section's own mount gate is what a test would assert).
                                cullreset := PillBtn {
                                    text: @tr("falcon" => "Reset to defaults");
                                    // the BASIC pill's arm, verbatim: one call, nothing else. No
                                    // `keys.focus()` — that idiom (O26) belongs to controls that
                                    // ARM a capture; this one ends any capture that is running.
                                    clicked => { root.reset-cull-binds(); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Rectangle { height: 4px; }
                            // ── v0.8.65 (C3/H4+M7) → v0.8.77 (owner redesign, two-mode): BASIC
                            // SHORTCUTS as a real SECTION with TWO mount-gated renders.
                            // VIEW (locked, default): the WELCOME panel's compact keycaps-FIRST list
                            // (Figma 262:11's row grammar — the small Chip hint dialect left,
                            // description right, tight rows) wrapped in the SettingsGroup card, Edit
                            // top-right; purely informative — NO rebind affordances.
                            // EDIT (unlocked): the section EXPANDS into the STANDARD key-binding view
                            // — the CONTROLS row grammar (full-width 32px rows, label left, 96×28
                            // keycap control right, "Press a key…" capture state, inline conflict/PUA
                            // warn lines) — and collapses back on Save OR Cancel. Mount-gated (if:),
                            // never overlaid (the click-steal rule). The capture funnel itself
                            // (rebind / key-typed tokens / warns) is untouched.
                            // Save = keep (bindings commit live; basics-locked clears capture/warn).
                            // Cancel = HONEST revert: basics-unlocked snapshots the basics' bindings
                            // at Edit-press; basics-cancelled restores that snapshot (basics ids
                            // only, CONTROLS untouched) — so Reset-then-Cancel also reverts.
                            // One row = one BINDING in both modes. Esc / ↑↓ / Click stay
                            // informational: Esc is a context CASCADE (innermost-popup close +
                            // immersive exit + the capture-cancel key itself — rebinding away the
                            // universal cancel would strand capture mode); ↑↓ are grid-gated
                            // compound arms; Click is a mouse gesture. Compact mode renders them
                            // keycaps + muted label (the ↑↓ pair splits into two caps, the welcome
                            // Keys idiom); edit mode keeps the v0.8.65 keycap-right rows, no wiring. ──
                            // Header = label + (Cancel +) Save/Edit ONLY. Computed fit at the 320px
                            // body (360 panel − 2×20 setbox padding): label ~103 + Cancel ~53 +
                            // Save ~42 + 2×8 gaps ≈ 214px. A third "Reset to defaults" pill (~111px)
                            // summed to ~333px and CLIPPED Save off the panel edge (owner-caught —
                            // hugging pills in a row overflow silently, they never shrink); Reset
                            // now lives at the unlocked list's FOOT, which also parks the
                            // destructive-ish action away from Save/Cancel (misclick proximity).
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                SectionLabel { text: @tr("falcon" => "BASIC SHORTCUTS"); vertical-alignment: center; horizontal-stretch: 1; }
                                if root.basics-edit : PillBtn {
                                    text: @tr("falcon" => "Cancel");
                                    clicked => { root.basics-cancelled(); root.basics-edit = false; }
                                }
                                PillBtn {
                                    text: root.basics-edit ? @tr("falcon" => "Save") : @tr("falcon" => "Edit");
                                    clicked => {
                                        if (root.basics-edit) { root.basics-locked(); root.basics-edit = false; }
                                        else { root.basics-unlocked(); root.basics-edit = true; }
                                    }
                                }
                            }
                            Text { text: root.basics-edit ? @tr("falcon" => "Click a key to rebind, then press a new key.")
                                                          : @tr("falcon" => "Fixed keys — press Edit to rebind.");
                                   color: Theme.text-mute; font-size: Theme.font-sm; }
                            // VIEW mode — the compact onboarding-grammar card (read-only).
                            if !root.basics-edit : SettingsGroup {
                                VerticalLayout {
                                    padding-left: 12px; padding-right: 12px;
                                    padding-top: Theme.space-2h; padding-bottom: Theme.space-2h;
                                    spacing: 2px;
                                    for kb in root.basic-binds : HorizontalLayout {
                                        height: 26px; spacing: Theme.space-1;
                                        VerticalLayout { alignment: center; Chip { text: kb.key; } }
                                        // fixed spacer (the WkRow idiom) → caps-to-label lands on 8px
                                        Rectangle { width: Theme.space-1; }
                                        Text { text: kb.label; color: Theme.text-dim; font-size: Theme.font-md;
                                               vertical-alignment: center; horizontal-stretch: 1; }
                                    }
                                    HorizontalLayout {
                                        height: 26px; spacing: Theme.space-1;
                                        VerticalLayout { alignment: center; Chip { text: "↑"; } }
                                        VerticalLayout { alignment: center; Chip { text: "↓"; } }
                                        Rectangle { width: Theme.space-1; }
                                        Text { text: @tr("falcon" => "Grid: row up / down"); color: Theme.text-mute; font-size: Theme.font-md;
                                               vertical-alignment: center; horizontal-stretch: 1; }
                                    }
                                    HorizontalLayout {
                                        height: 26px; spacing: Theme.space-1;
                                        VerticalLayout { alignment: center; Chip { text: "Esc"; } }
                                        Rectangle { width: Theme.space-1; }
                                        Text { text: @tr("falcon" => "Close / exit fullscreen"); color: Theme.text-mute; font-size: Theme.font-md;
                                               vertical-alignment: center; horizontal-stretch: 1; }
                                    }
                                    scclick := HorizontalLayout {
                                        height: 26px; spacing: Theme.space-1;
                                        VerticalLayout { alignment: center; Chip { text: @tr("falcon" => "Click"); } }
                                        Rectangle { width: Theme.space-1; }
                                        Text { text: @tr("falcon" => "Zoom 1:1 at cursor / reset"); color: Theme.text-mute; font-size: Theme.font-md;
                                               vertical-alignment: center; horizontal-stretch: 1; }
                                    }
                                    // v0.8.184 (D1, OWNER RULING): the cull-history chords, in the
                                    // VIEW card's display-only grammar — two caps, one label, the
                                    // grid row's exact pattern. DISPLAY ONLY: `basic-binds`, the
                                    // EDIT-mode list and the capture funnel are untouched — the
                                    // ruling is explicit that no capture contract changes.
                                    // Placed with the other fixed extras (arrows / Esc / Click).
                                    //
                                    // THE CAPS ARE `sc-undo` / `sc-redo`, NOT LITERALS, and the
                                    // axis is PLATFORM, not rebindability (v0.8.184 review W2 —
                                    // the first draft argued the wrong one). These chords cannot be
                                    // rebound, which is why they are not in `basic-binds`; but they
                                    // are spelled differently per OS, and the table already
                                    // publishes both spellings (⌘Z / ⇧⌘Z on the mac arm) through
                                    // `support::refresh_menu_shortcuts`. A literal here would ship
                                    // a Windows keycap into the Mac build — exactly the defect
                                    // `sc-copy` exists to prevent, and the one the v0.9.3 §66 pass
                                    // removed from every other fixed chip in the app.
                                    scundo := HorizontalLayout {
                                        height: 26px; spacing: Theme.space-1;
                                        VerticalLayout { alignment: center; Chip { text: root.sc-undo; } }
                                        VerticalLayout { alignment: center; Chip { text: root.sc-redo; } }
                                        Rectangle { width: Theme.space-1; }
                                        Text { text: @tr("falcon" => "Undo / redo the last change"); color: Theme.text-mute; font-size: Theme.font-md;
                                               vertical-alignment: center; horizontal-stretch: 1; }
                                    }
                                }
                            }
                            // EDIT mode — the standard key-binding view (the CONTROLS grammar; the
                            // v0.8.65 rows byte-alike, hover always live since this mode IS unlocked).
                            if root.basics-edit : VerticalLayout {
                                spacing: 4px;
                                for kb in root.basic-binds : VerticalLayout {
                                    spacing: 2px;
                                    HorizontalLayout {
                                        height: 32px; spacing: 8px;
                                        Text { text: kb.label; color: Theme.text; font-size: Theme.font-body;
                                               vertical-alignment: center; horizontal-stretch: 1; }
                                        Chip {
                                            role: ChipRole.keycap;
                                            active: kb.capturing;
                                            hover: bbta.has-hover;
                                            text: kb.capturing ? @tr("falcon" => "Press a key…") : kb.key;
                                            // v0.8.120 (design-sweep O26): the BASIC-edit twin — same reason, same idiom.
                                            bbta := TouchArea { clicked => { keys.focus(); root.rebind(kb.action); } }
                                        }
                                    }
                                    if kb.warn != "" : Text {
                                        text: kb.warn; color: Theme.warn; font-size: Theme.font-sm;
                                        horizontal-alignment: right; wrap: word-wrap;
                                    }
                                }
                                // informational rows — same row grammar, no wiring (see section comment)
                                // v0.8.119 (design-sweep O27 / Y50 / Y61): they wore the KEYCAP
                                // dialect. widgets.slint records the split as binding — "the quiet
                                // HINT dialect (menu chips — a hint, not a control) and the
                                // prominent KEYCAP dialect (the Settings rebind key — a real
                                // control) stay deliberately distinct" — and these three rows have
                                // no TouchArea, no `hover:` binding and no capture: they are
                                // annotation. Rendered in 96×28 keycaps, pixel-identical to the
                                // seven LIVE rebind controls directly above, a user who wanted Esc
                                // on another key clicked one and got no press feedback, no hover
                                // wash, no cursor change and no message. Now: HINT chips, one cap
                                // per key (L13 — "↑ ↓" was two keys in one cap, the notation the
                                // owner already rejected on the rating caps), and the label drops to
                                // text-mute so the row reads as annotation before it is clicked.
                                // This is the section's OWN View-mode idiom (the hint chips + muted
                                // labels a Cancel away), so the two modes stop contradicting each
                                // other. L5: the hint chips are ~21-50px against the keycap's fixed
                                // 96px, so every row's stretch-1 label gains width in its widest
                                // state — this cannot clip.
                                HorizontalLayout {
                                    height: 32px; spacing: 8px;
                                    Text { text: @tr("falcon" => "Grid: row up / down"); color: Theme.text-mute; font-size: Theme.font-body;
                                           vertical-alignment: center; horizontal-stretch: 1; }
                                    VerticalLayout { alignment: center; Chip { text: "↑"; } }
                                    VerticalLayout { alignment: center; Chip { text: "↓"; } }
                                }
                                HorizontalLayout {
                                    height: 32px; spacing: 8px;
                                    Text { text: @tr("falcon" => "Close / exit fullscreen"); color: Theme.text-mute; font-size: Theme.font-body;
                                           vertical-alignment: center; horizontal-stretch: 1; }
                                    VerticalLayout { alignment: center; Chip { text: "Esc"; } }
                                }
                                HorizontalLayout {
                                    height: 32px; spacing: 8px;
                                    Text { text: @tr("falcon" => "Zoom 1:1 at cursor / reset"); color: Theme.text-mute; font-size: Theme.font-body;
                                           vertical-alignment: center; horizontal-stretch: 1; }
                                    VerticalLayout { alignment: center; Chip { text: @tr("falcon" => "Click"); } }
                                }
                                // Reset at the list foot (see the header-fit note above) — left-
                                // aligned, the section's own quiet PillBtn dialect, spatially clear
                                // of the top-right Save/Cancel pair.
                                HorizontalLayout {
                                    spacing: Theme.space-2;
                                    PillBtn {
                                        text: @tr("falcon" => "Reset to defaults");
                                        clicked => { root.reset-basic-binds(); }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }
                            Rectangle { height: 4px; }
                            // v0.8.65 (C3): the quiet version footer. v0.8.67 (D): the reserved
                            // stretch slot gains "Show welcome" — reopens the onboarding panel on
                            // demand (Settings closes so the modal doesn't stack over it; the
                            // panel's own footer link leads back here, symmetric).
                            about-footer := Rectangle {
                                height: 24px; background: transparent;
                                about-version := Rectangle {
                                    width: about-caption.preferred-width; height: 100%;
                                    // Centre normal versions; reserve the existing gap for long diagnostic suffixes.
                                    x: 0px;
                                    background: transparent;
                                    about-caption := Text { width: 100%; height: 100%; text: @tr("falcon" => "Falcon v{0}", root.app-version);
                                        color: about-version-hit.has-hover ? Theme.accent : Theme.text-mute;
                                        font-size: Theme.font-sm; vertical-alignment: center; horizontal-alignment: left; }
                                    about-version-hit := TouchArea { mouse-cursor: pointer; clicked => { root.show-about(); } }
                                }
                                about-welcome := Rectangle {
                                    x: parent.width - self.width; height: 100%;
                                    width: about-welcome-hit.preferred-width; background: transparent;
                                    about-welcome-hit := PillBtn {
                                        text: @tr("falcon" => "Show welcome");
                                        clicked => { root.settings-open = false; root.welcome-open = true; }
                                    }
                                }
                            }
                        }
                    }
                }
                // v0.8.65 (C3, owner rule): the panel-bottom fade — overlaid AFTER setbox (paints
                // above the scroll body), sized to the Flickable's bottom edge (panel bottom − the
                // setbox 20px padding), width inset by the same padding so it covers exactly the
                // scroll viewport. Pure paint (no input element — wheel/clicks reach the Flickable);
                // `more` hides it once the body is scrolled to (or fits within) the bottom.
                PanelBottomFade {
                    x: setflick.x; width: setflick.width;
                    y: setflick.y + setflick.height - self.height;
                    more: setflick.viewport-height + setflick.viewport-y > setflick.height + 1px;
                }
                // Reuse Review's bar in the existing 20px padding: 6px gap + 8px band + 6px edge.
                // Settings has a content-top wrapper, so snap the complete window-space origin.
                if setflick.viewport-height > setflick.height : MiniVBar {
                    property <float> sfx: max(root.win-sf, 0.5);
                    property <length> panel-top: root.content-top + parent.y;
                    property <length> snap-top: Math.round((self.panel-top + setflick.y) / 1px * self.sfx) / self.sfx * 1px;
                    property <length> snap-bot: Math.round((self.panel-top + setflick.y + setflick.height) / 1px * self.sfx) / self.sfx * 1px;
                    x: Math.round((parent.x + setflick.x + setflick.width + 6px) / 1px * self.sfx) / self.sfx * 1px - parent.x;
                    width: 8px;
                    y: self.snap-top - self.panel-top;
                    height: self.snap-bot - self.snap-top;
                    vp-h: setflick.height; content-h: setflick.viewport-height; vp-y: setflick.viewport-y;
                    seek(y) => { setflick.viewport-y = y; }
                }
            }
        }

        // ── Scrub-speed popup (overlay, under the speed button; starts below the title bar) ──
        if root.loading-open : Rectangle {
            y: root.content-top;
            height: parent.height - self.y;
            width: 100%;
            TouchArea { clicked => { root.loading-open = false; } }
            GlassPanel {
                // floating panel, docked under the » button; 3px gap below the title bar (matches the others).
                property <float> sfx: max(root.win-sf, 0.5);
                x: Math.round(44 * self.sfx) / self.sfx * 1px;
                y: Math.round((root.content-top / 1px + 3 - (1.0 - root.speed-eff) * 8) * self.sfx) / self.sfx * 1px - root.content-top;
                width: 440px;
                opacity: root.speed-eff; // M5 enter-only fade+slide (eff snaps to 1 on a switch / motion off; hits NOT gated)
                height: spdbox.preferred-height + 20px;
                backdrop: root.blur-backdrop;
                sw: root.content-w; sh: root.content-h; ox: 0px; oy: 0px;
                TouchArea {}
                spdbox := VerticalLayout {
                    padding: Theme.space-5; spacing: Theme.space-3;
                    // Header: the live fps IS the title; the description moved to a SUBTITLE under it (off the
                    // header ROW) so a long "Max (up to 120 fps)" title no longer clips the pill (user report).
                    VerticalLayout {
                        spacing: 3px;
                        PanelHeader { title: root.fps-text; dismiss => { root.loading-open = false; } }
                        Text { text: @tr("falcon" => "Continuous browsing speed"); color: Theme.text-mute; font-size: Theme.font-sm; }
                        // v0.8.195 fix tail (skeptic B, R1c): …and what is actually in force. The
                        // title above IS the setting and the pill below sits on it, so while the
                        // efficiency posture holds the browse to 20 fps this popup was stating a
                        // rate the app was not delivering — the same class v0.8.123 exists for, on
                        // this popup's own title. Mount-gated on the composer having something to
                        // say, so a user at or under the ceiling sees nothing new.
                        if root.fps-eff-note != "" : fpsnote := Text {
                            text: root.fps-eff-note; color: Theme.text-mute;
                            font-size: Theme.font-sm; wrap: word-wrap;
                        }
                    }
                    // Speed = a CustomSeg (Custom | 5 | 12 | 20 | 30 | Max) matching the other tier sliders:
                    // the built-in Custom cell replaces the old separate fps field; number labels replace the
                    // dots; a blue value-line marks where a CUSTOM fps lands among the stops. `instant` =
                    // commit on DOWN (snappier; safe here since the popup has no Flickable).
                    CustomSeg {
                        instant: true;
                        stops: ["5", "12", "20", "30", @tr("falcon" => "Max")];
                        index: root.scrub-fps <= 8 ? 0 : root.scrub-fps <= 16 ? 1 : root.scrub-fps <= 25 ? 2 : root.scrub-fps <= 60 ? 3 : 4;
                        custom: (root.scrub-fps == 5 || root.scrub-fps == 12 || root.scrub-fps == 20 || root.scrub-fps == 30 || root.scrub-fps == 120) ? 0 : Math.round(root.scrub-fps);
                        indicator-frac: (root.scrub-fps == 5 || root.scrub-fps == 12 || root.scrub-fps == 20 || root.scrub-fps == 30 || root.scrub-fps == 120) ? -1.0
                            : root.fps-frac(root.scrub-fps);
                        // device-max veil: how fast THIS browse detail tier (Sub/Supersample) benched —
                        // frosts the stops the hardware can't sustain. The veil starts at the limit stop's
                        // CENTRE (the shared indicator-frac convention, same as the blue value-line above);
                        // once the device rate reaches the scale max (≥120) the veil is hidden entirely —
                        // nothing on the scale is unreachable, so there is nothing to frost.
                        // v0.9.60 (W2-5d): …and only from a result that may speak for THIS folder.
                        // `bench-governs` is `benchmarked` on Windows by construction; on macOS a
                        // synthetic run no longer frosts stops it never measured. The veil simply
                        // does not mount then — the honest line below says why, rather than the
                        // slider quietly implying every stop is reachable.
                        limit-frac: (root.quality-super == 1 ? root.bench-super-fps : root.bench-sub-fps) > 0 && root.bench-governs
                            && root.fps-frac(root.quality-super == 1 ? root.bench-super-fps : root.bench-sub-fps) < 1.0
                            ? root.fps-frac(root.quality-super == 1 ? root.bench-super-fps : root.bench-sub-fps) : -1.0;
                        picked(i) => { root.set-fps(i == 0 ? 5.0 : i == 1 ? 12.0 : i == 2 ? 20.0 : i == 3 ? 30.0 : 120.0); }
                        custom-committed(t) => { if (t != "") { root.set-fps-custom(t); } keys.focus(); }
                    }
                    // v0.9.60 (W2-5d [VD]): a benchmark exists but it cannot speak for this
                    // folder, so the device-limit veil above is absent — SAY SO rather than let
                    // the missing frost read as "everything is reachable" (H1 status visibility;
                    // the L30 spirit applied to an ABSENCE). Mount-gated on the pair, so it can
                    // never appear next to a veil; unreachable on Windows (bench-governs there is
                    // `benchmarked`, making the condition `benchmarked && !benchmarked`).
                    if root.benchmarked && !root.bench-governs : Text {
                        text: @tr("falcon" => "Speed limits aren't measured for this folder yet — the last benchmark used generated test images. Run it again with this folder open (Settings → Fast View).");
                        color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap;
                    }
                    // §43: zoomed browse policy — Speed (today's blur→sharp on landing) vs Always sharp
                    // (held/wheel browse rate-caps to the measured full-res decode rate and the stage
                    // holds the last sharp frame — no proxy blur flash). The scrub slider above stays
                    // the UNZOOMED browse rate; this cap overrides it only while zoomed in.
                    VerticalLayout {
                        spacing: Theme.space-1h;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: @tr("falcon" => "When zoomed"); color: Theme.text-mute; font-size: Theme.font-md; vertical-alignment: center; }
                            Seg {
                                horizontal-stretch: 1;
                                opts: [@tr("falcon" => "Speed"), @tr("falcon" => "Always sharp")];
                                sel: root.zoom-always-sharp ? 1 : 0;
                                // This Seg sits on the speed POPUP and keeps the default track, which is
                                // now Theme.well + an M3 hairline (H2, v0.7.2) — visible on the base popup
                                // (the CustomSeg above uses the same default).
                                changed(i) => { root.zoom-always-sharp = i == 1; }
                            }
                        }
                        // v0.9.62 (B2.2 / D-R1, the RED): THREE arms, because there are three
                        // states and v0.9.60 had two. The benched line quotes a NUMBER, so it may
                        // only appear when the result that produced it may speak for this folder —
                        // otherwise the popup said "not measured for this folder" a few rows above
                        // and "benched ≈ 14 fps" here, from the same synthetic run, and the honest
                        // one read as the mistake. `bench-governs` is `benchmarked` on Windows by
                        // construction, so this arm is byte-identical there and the third is
                        // unreachable (`benchmarked && !benchmarked`).
                        if root.zoom-always-sharp && root.bench-governs : sharpbenched := Text {
                            text: root.zoom-sharp-note; // built in Rust (fps + engine — slint! strings can't interpolate)
                            color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap;
                        }
                        if root.zoom-always-sharp && !root.benchmarked : sharpunbenched := Text {
                            text: @tr("falcon" => "Held to ~10 fps while zoomed. Run a benchmark (Settings → Fast View) to use your device's real full-res rate.");
                            color: Theme.warn; font-size: Theme.font-sm; wrap: word-wrap;
                        }
                        // The NEW state: a benchmark exists, it cannot speak for this folder, and
                        // §43's cap has fallen back to its floor accordingly (B2.1). It describes
                        // the mode WITHOUT a figure and says why there is none. One Rust producer
                        // (`support::zoom_sharp_unmeasured_note`) so the mode description cannot
                        // drift against the benched arm's.
                        if root.zoom-always-sharp && root.benchmarked && !root.bench-governs : sharpunmeasured := Text {
                            text: root.zoom-sharp-unmeasured-note;
                            color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap;
                        }
                        // v0.8.123 (I3, owner-ruled 2026-07-28): the slow-format caveat, rendered
                        // under the WHOLE Always-sharp branch — both the benched rate line above and
                        // the unbenched "~10 fps" warning quote a JPEG figure that a 48 MP HEIC lane
                        // (~1.1 shots/s measured) is an order of magnitude under, and neither said
                        // so. One producer (`support::zoom_sharp_slow_note`), one mount, so it can
                        // never go stale against only one arm. Speed mode needs no caveat: its own
                        // line below already promises full speed and after-the-fact sharpening.
                        //
                        // v0.8.124 (R8): the producer is CAPABILITY-GATED — it returns "" where the
                        // HEIC lane is hardware-accelerated, because there the binary's own cost
                        // model calls no format costly. So the mount tests the string as well as the
                        // mode (L4: gate with `if`, never a zero-height Text): on such a trunk the
                        // sentence is ABSENT, not blank and not softened into a tautology.
                        if root.zoom-always-sharp && root.zoom-sharp-slow-note != "" : slownote := Text {
                            text: root.zoom-sharp-slow-note;
                            color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap;
                        }
                        if !root.zoom-always-sharp : Text {
                            text: @tr("falcon" => "Zoomed browsing keeps full speed; detail sharpens moments after each landing.");
                            color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap;
                        }
                    }
                }
            }
        }

        // ── Selection / cull-management panel — a docked WORK surface (no click-away scrim):
        //    a tile light-table of the reviewed set for confirming, refining (re-rate / un-flag /
        //    un-reject in place) and handing off (copy / move / export). ──
        if root.sel-open && !root.immersive : GlassPanel {
            property <length> backdrop-x: self.absolute-position.x;
            property <length> backdrop-y: self.absolute-position.y - root.content-top;
            init => { root.review-backdrop-x = self.backdrop-x; root.review-backdrop-y = self.backdrop-y;
                root.review-backdrop-w = self.width; root.review-backdrop-h = self.height; }
            changed backdrop-x => { root.review-backdrop-x = self.backdrop-x; }
            changed backdrop-y => { root.review-backdrop-y = self.backdrop-y; }
            changed width => { root.review-backdrop-w = self.width; }
            changed height => { root.review-backdrop-h = self.height; }

            x: 3px; y: root.content-top + 3px - (1.0 - root.sel-eff) * 8px; width: 500px;
            opacity: root.sel-eff; // M5 enter-only fade+slide (eff snaps to 1 on a switch / motion off; hits NOT gated)
            // docked under its Selection button; floats all-rounded (no conditional/sharp corner)
            border-bottom-left-radius: Theme.radius; border-bottom-right-radius: Theme.radius;
            // FILL the available height (from y:47 to 3px above the window bottom) rather than hugging
            // content: with a tall stage + no filmstrip (nothing open), the old preferred-height ran the
            // grid + actions past the window bottom and winroot's clip cut the last action button (v0.7.0).
            height: parent.height - root.content-top - 6px;
            backdrop: root.blur-backdrop;
            sw: root.content-w; sh: root.content-h; ox: 0px; oy: root.content-top;
            review-swallow := TouchArea { scroll-event(e) => { accept } } // Review owns its area; stage stays live elsewhere.
            selbox := VerticalLayout {
                padding: Theme.space-5; spacing: Theme.space-3;   // standard tier = 20px
                PanelHeader { vertical-stretch: 0; title: @tr("falcon" => "Review"); dismiss => { root.sel-open = false; } }
                // v0.8.129 (W1-4, owner ruling Q5) — THE HIDDEN "Selected" CATEGORY, mount-gated on a
                // non-empty selection (L4: genuinely absent, not merely invisible). Its nested × is
                // the in-panel clearing affordance.
                //
                // WHY ITS OWN ROW (ledger L5 — the widest state, measured, not eyeballed). The panel
                // body is 500 − 2×20 = 460px. The four category chips are content-hugging at their
                // MINIMUM (a Slint layout never shrinks a child below its content, and these Texts do
                // not elide): 24px padding + label + 4px + count each, which measures ~382px for the
                // four plus their three 8px gaps. "Selected · 8888" with its nested × needs ~122px
                // plus a fourth gap — 512px against a 460px body, i.e. the fifth chip would push
                // itself (or the Rotated chip) off the panel edge. So the chip takes the row above,
                // which also keeps it FIRST in reading order, which is what "No.1 in the row" was
                // for. Pinned by `the_selected_chip_row_fits_the_panel` in the rig.
                if root.count-selected > 0 : HorizontalLayout {
                    vertical-stretch: 0;
                    alignment: start;
                    SelectedChip {
                        label: root.selected-chip-label;
                        active: root.filter-mode == 5;
                        clicked => { root.set-filter(5); }
                        cleared => { root.clear-selection(); }
                    }
                }
                // filter bar — one aligned row; default 'Reviewed' = everything the user acted on.
                HorizontalLayout {
                    vertical-stretch: 0;
                    spacing: Theme.space-2;
                    OptionChip { label: @tr("falcon" => "Reviewed"); count: root.count-reviewed; active: root.filter-mode == 0; clicked => { root.set-filter(0); } }
                    OptionChip { label: @tr("falcon" => "Picks"); icon: 1; count: root.count-picks; active: root.filter-mode == 1; clicked => { root.set-filter(1); } }
                    OptionChip { label: @tr("falcon" => "Rejects"); icon: 2; count: root.count-rejects; active: root.filter-mode == 2; clicked => { root.set-filter(2); } }
                    OptionChip { label: @tr("falcon" => "Rotated"); icon: 3; count: root.count-rotated; active: root.filter-mode == 4; clicked => { root.set-filter(4); } }
                }
                // Rating filter — ONE light-gray pill (Figma nested control). The LABEL toggles the
                // "all rated (1–5)" filter (mode 3 — lights GOLD; click again → Reviewed default), with
                // the 0–5 EXACT-rating chips nested INSIDE it (one tier darker). A digit shows shots rated
                // exactly N (0 = unrated-but-reviewed), click again to clear; it ANDs with the mode.
                HorizontalLayout {
                    vertical-stretch: 0;
                    Rectangle {
                        horizontal-stretch: 0;
                        // v0.8.3: hard content pin - 22px digit chips + 5px pad x2. The centered
                        // interior (alignment: center wrappers) reports max-height = inf, which
                        // made this card the balloon's landing zone whenever the grid Flickable
                        // couldn't absorb the panel's spare height.
                        max-height: 32px;
                        border-radius: Theme.radius-ctrl;
                        background: Theme.block; // raised container on the base panel
                        HorizontalLayout {
                            padding-left: Theme.space-2h; padding-right: Theme.space-1h; padding-top: 5px; padding-bottom: 5px; spacing: 8px;
                            // clickable label → toggle the all-rated (mode 3) filter, gold when active.
                            // Wrapped in a Rectangle so it lightens on hover like the sibling filter
                            // chips (the bare TouchArea had NO hover feedback — user report).
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    border-radius: Theme.radius-sm;
                                    background: rlblta.has-hover ? Theme.hover-flat-block : transparent;  // v0.8.48: the v0.8.17 Fix-C opaque flatten of Theme.hover over the Theme.block card behind it is the hover-flat-block TOKEN now (recomputed from the TRANSFORMED hover/block) -- still pixel-identical to the translucent composite, artifact-safe if a lift returns (the only hover wash on a block card)
                                    animate background { duration: Theme.anim; easing: ease; }
                                    // v0.8.14 (Item 3): press-lift on the Rated pill
                                    HorizontalLayout {
                                        padding: 3px; spacing: 5px;
                                        Text { text: "★"; color: root.filter-mode == 3 ? Theme.star : Theme.text-dim;
                                               font-size: Theme.font-md; vertical-alignment: center; }
                                        Text { text: @tr("falcon" => "Rated"); color: root.filter-mode == 3 ? Theme.star : Theme.text;
                                               font-size: Theme.font-md; font-weight: 600; vertical-alignment: center; }
                                        Text { text: root.count-rated; color: Theme.text-mute;
                                               font-size: Theme.font-sm; font-weight: 600; vertical-alignment: center; }
                                    }
                                    rlblta := TouchArea { clicked => { root.set-filter(root.filter-mode == 3 ? 0 : 3); } }
                                }
                            }
                            // nested 0–5 exact-rating chips — one tier darker than the pill
                            VerticalLayout {
                                alignment: center;
                                HorizontalLayout {
                                    spacing: Theme.space-1h;
                                    // v0.8.119 (design-sweep Y59): named for the rig — the digit
                                    // chips' interaction with the Rated pill is a real predicate now
                                    // (clicking 0 while Rated is active drops the mode), and it can
                                    // only be pinned by clicking the chip the user clicks.
                                    for v in [0, 1, 2, 3, 4, 5] : dchip := Rectangle {
                                        // v0.8.123 (I1d, L15/L21 — PER-DIGIT HONESTY): is there
                                        // anything behind this digit in the CURRENT mode? The count
                                        // comes from the tile feed's own mode arm
                                        // (`support::sel_mode_ok`, via the gated count sweep), so a
                                        // chip and the grid it builds cannot disagree. A lit control
                                        // that can only produce an empty view is the enablement
                                        // defect L15 names, and this panel had six of them.
                                        //
                                        // The ACTIVE chip is always live, whatever its bucket says:
                                        // un-rate the last ★3 while the ★3 filter is on and the
                                        // bucket empties under a chip that is the only way to clear
                                        // it — an inert one would be a trap with no exit (L25).
                                        // Muted, not unmounted: the row keeps its six chips and its
                                        // geometry, so nothing reflows as ratings change (L4 is
                                        // about mount-gating LAYOUT, and this is not layout).
                                        // v0.8.124 (R3, the v0.8.123 audit): the predicate models
                                        // the click's LANDING view, not the current one. Under
                                        // "★ Rated" the mode arm is `r >= 1`, so `dchip-counts[0]`
                                        // is STRUCTURALLY zero for every folder — I1d's gate
                                        // therefore made the 0 chip permanently inert and killed
                                        // the v0.8.119 (Y59) route the TouchArea below still
                                        // implements and the I1g comment still documents as live.
                                        // Clicking 0 under Rated does not build a Rated view: it
                                        // drops the mode to Reviewed FIRST, so the honest question
                                        // is how many shots that landing view would hold, which is
                                        // `dchip-landing-zero` — computed Rust-side in the same
                                        // gated sweep, through `support::sel_mode_ok`, so the chip
                                        // still reads ONE number the tile feed's own arm produced.
                                        // (The equivalent arithmetic `count-reviewed - count-rated`
                                        // is exact, but writing it here would re-derive mode 0's
                                        // arm in the UI layer — the divergence the extraction was
                                        // for.)
                                        property <bool> live: root.dchip-counts[v] > 0
                                            || root.sel-rating-filter == v
                                            || (v == 0 && root.filter-mode == 3 && root.dchip-landing-zero > 0);
                                        width: 22px; height: 22px; border-radius: Theme.radius-sm;
                                        // a real rating (1–5) lights GOLD; 0 = unrated-but-reviewed stays BLUE (not a star rating)
                                        border-width: 1px; border-color: root.sel-rating-filter == v ? transparent : Theme.border-strong; // v0.8.18 (rating-chip edge): constant hairline so the hovered chip keeps a defined edge -- well-hover #2e2e2e nearly matches the block #262626 card behind it; matches the sibling filter-chip rim (active gold/blue keeps no border)
                                        // v0.8.124 (N18): the INERT state is TOKEN SUBSTITUTION, the
                                        // house grammar (OptionChip: text-mute digit, rest fill, no
                                        // hover step), not a 0.4 opacity fade. The fade was a fourth
                                        // disabled idiom in this file (the three existing ones are
                                        // 0.55 and 0.45), it composited the v0.8.18 hairline away
                                        // into the card behind, and it dropped the digit to ~3:1.
                                        // Keeping the chip opaque holds the rim and ~7.8:1, and the
                                        // `enabled: parent.live` gate below already removes the
                                        // hover step, so nothing else is needed to read as "off".
                                        // v0.8.154 (A4, owner ruling Q12): …and the inert chip's FILL
                                        // drops to the base colour too, "so empty digits read as
                                        // empty". Theme.base IS the ruled #171717 (theme.slint:31) —
                                        // the token, not the literal, because the ruling names the
                                        // app's base colour and that is the property that carries it.
                                        //
                                        // ONE CORRECTION TO THE RULING'S WORDING, stated because it
                                        // is a divergence: the ruling says "whose count is ZERO", and
                                        // this keys on `!live` instead. The two sets differ in
                                        // exactly one reachable case — the v0.8.119 Y59 escape, where
                                        // the 0 chip under "★ Rated" has a count of zero and is still
                                        // LIVE, because clicking it drops the mode to Reviewed and
                                        // shows the unrated set. That chip is not empty in the sense
                                        // the ruling is about (there IS something behind it), and
                                        // painting a clickable chip as empty would be a fresh L20
                                        // label-lies-about-state bug. `live` is also already the
                                        // predicate the digit colour and the TouchArea's `enabled`
                                        // read, so the fill now says exactly what those two say.
                                        background: root.sel-rating-filter == v ? (v == 0 ? Theme.accent : Theme.star)
                                                  : (!self.live ? Theme.base
                                                  : (dta.has-hover ? Theme.well-hover : Theme.well)); // solid one-step lift on hover (a wash barely showed)
                                        animate background { duration: Theme.anim; easing: ease; }
                                        Text { text: v; color: root.sel-rating-filter == v ? (v == 0 ? Theme.text-on-accent : Theme.text-on-star) : (!parent.live ? Theme.text-mute : (dta.has-hover ? Theme.text : Theme.text-dim)); // v0.8.18 (rating-chip legibility): hover bumps the digit to full Theme.text -- text-dim washed out on the well-hover fill that nearly matches the block card behind. v0.8.124 (N18): inert = Theme.text-mute, the house disabled token
                                               font-size: Theme.font-md; font-weight: 600;
                                               x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                                        // v0.8.119 (design-sweep Y59): mode 3 ("★ Rated") is
                                        // `r >= 1` and the 0 chip ANDs `r == 0` — together an
                                        // empty set for every shot, always, with a lit gold
                                        // parent and a lit blue child both claiming a filter.
                                        // Asking for the unrated ones is a coherent intent, so
                                        // honour it: drop the parent to Reviewed first, then
                                        // apply the digit. Any other digit is compatible with
                                        // Rated and is untouched.
                                        //
                                        // v0.8.123 (I1g, RULED — comment only). This guard and F14's
                                        // (main.rs `on_set_filter`) protect the SAME unsatisfiable
                                        // pair from opposite ends and sacrifice opposite halves of
                                        // it. The rule behind both is THE NEWEST CLICK WINS: the
                                        // control the user just pressed keeps its value and the
                                        // older conflicting one yields. Here the CHIP was clicked,
                                        // so the chip keeps its digit and the mode drops to
                                        // Reviewed; at the pill, the pill keeps mode 3 and the digit
                                        // drops to -1. A fixed winner would instead make one of the
                                        // two clicks silently do nothing.
                                        //
                                        // v0.8.123 (I1d): `enabled` mirrors the chip's own `live`
                                        // — the L21 rule that a surface's enablement states the
                                        // handler's guard rather than merely looking like it.
                                        dta := TouchArea { enabled: parent.live; clicked => { if (v == 0 && root.filter-mode == 3) { root.set-filter(0); } root.sel-rating-filter = root.sel-rating-filter == v ? -1 : v; } }
                                    }
                                }
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; } // absorber — the pill holds left, the XMP control hugs right
                    // v0.8.75 (owner redesign): "Sync ratings to XMP" relocated from a full-width
                    // bottom ToggleRow + two-line caption to THIS compact right-aligned control (the
                    // owner circled the Rated row's empty trailing space). Backing is UNCHANGED:
                    // `on` mirrors root.xmp-sync exactly as the old row did, click routes through the
                    // same toggle-xmp-sync — Rust still gates OFF→ON behind the kind-7 backfill
                    // confirm, whose body carries the sidecar explanation the removed caption held;
                    // OFF stays immediate. The pill is the shared ToggleTrack (the Settings toggle's
                    // exact 46×26 track / 20px knob), 3px slack in this 32px row. Discipline: the
                    // wrapper is max-height-pinned (v0.8.3 balloon class — its centered interior
                    // reports max=inf) and stretch-0 content-hugging (preferred width = label + 6px
                    // + 46px pill), so the filter pill at the left can never be pushed or crushed.
                    // Hover follows the toggle grammar: track border-strong (the ToggleRow track's
                    // own response) + the label lifts to full text (the v0.8.18 chip-legibility
                    // pattern) — no wash card, so the pill stays flush with the content right edge.
                    Rectangle {
                        horizontal-stretch: 0;
                        max-height: 32px;
                        HorizontalLayout {
                            spacing: Theme.space-1h;
                            Text { text: @tr("falcon" => "XMP sync"); color: xmpta.has-hover ? Theme.text : Theme.text-mute;
                                   font-size: Theme.font-sm; font-weight: 500; vertical-alignment: center; // v0.8.80 (3B rider): match the ToggleRow label weight — one toggle-label weight app-wide (this is the only label beside a ToggleTrack outside ToggleRow). Size unchanged.
                                   animate color { duration: Theme.anim; easing: ease; } }
                            VerticalLayout {
                                alignment: center;
                                ToggleTrack { on: root.xmp-sync; hovered: xmpta.has-hover; }
                            }
                        }
                        xmpta := TouchArea {
                            // v0.8.84: the shared-Tip hover report (IconBtn's G11 grammar) — the first
                            // POSITIONED host. cy = this TouchArea's window-space bottom + space-2, so
                            // the pill renders just BELOW the Rated row (above would cover the filter
                            // chips; below sits over the HRule/grid top — display-only, steals nothing).
                            // cx/cy read SELF — an x:0/y:0 fill child of the wrapper, the v0.8.45
                            // absolute-position rule (the element's OWN offset is what double-counts).
                            // No hand offsets: the panel moving/re-laying-out moves this anchor with it
                            // (L7 derived-geometry discipline). The leave branch clears cy
                            // UNCONDITIONALLY: on an A→B move to a sentinel host the text equality
                            // guard keeps B's tip in EITHER handler order, but a stale cy > 0 would
                            // re-anchor B's title-bar tip down here — cy belongs to the sole
                            // positioned host, so a blanket reset is always correct.
                            changed has-hover => {
                                if (self.has-hover) {
                                    Tip.text = root.xmp-tip;
                                    Tip.cx = self.absolute-position.x + self.width / 2;
                                    Tip.cy = self.absolute-position.y + self.height + Theme.space-2;
                                } else {
                                    if (Tip.text == root.xmp-tip) { Tip.text = ""; }
                                    Tip.cy = 0px;
                                }
                            }
                            clicked => {
                                // v0.8.84: the SectionChip v0.8.53 click-clear — the OFF→ON flip can
                                // mount the kind-7 backfill confirm under the pointer, and the tip
                                // pill (window-top z) must never float over a modal.
                                if (Tip.text == root.xmp-tip) { Tip.text = ""; }
                                Tip.cy = 0px;
                                root.toggle-xmp-sync();
                            }
                        }
                    }
                }
                HRule { vertical-stretch: 0; }
                // v0.8.123 (I1c) — THE EMPTY STATE LEFT THE VIEWPORT. This block used to be the
                // last child of `gridcol`, i.e. INSIDE the scrolled Flickable, where a residual
                // scroll offset from the previous filter could carry the only thing explaining an
                // empty grid out of view. It is a SIBLING of `selflick` now, gated on the row
                // count, so it cannot be scrolled anywhere; and `gridcol.preferred-height` shrinks
                // to the rows alone, which is what `viewport-height` was always supposed to mean.
                // Placed BEFORE the Flickable so it reads at the TOP of the grid area: selflick
                // is the panel body's one stretch-1 absorber and would otherwise push it down
                // to the action row. stretch-0 here keeps that absorber uncontested (v0.8.3).
                //
                // v0.8.124 (N20) — WHAT IS AND IS NOT CLAIMED. v0.8.123 stated the residual-scroll
                // case as the likeliest thing the owner saw. It is NOT measured, and i-slint-core
                // 1.17's Flickable installs an out-of-bounds ChangeTracker that appears to clamp
                // exactly that offset once `viewport-height` shrinks — so the honest rationale is
                // the structural one, which stands on its own: `viewport-height` should mean the
                // ROWS, an explanation is not scrolled content, and nothing on screen should depend
                // on a Flickable's out-of-bounds recovery to be visible. The owner's reported cause
                // was I1a, fixed separately; this hoist is a structural improvement.
                //
                // v0.8.124 (N4/N19) — AND IT IS MAX-BOUNDED, like every other stretch-0 sibling in
                // this panel (the filter row 32px, the action captions 20px). Bare Texts report
                // max=inf vertically; as a direct child of `selbox` this was the panel's only
                // stretch-0 child with inf headroom, which is the v0.8.3 balloon this very panel
                // has shipped twice, and its ~90-112px of preferred height was also entering a
                // FIXED panel height that the action buttons have to fit inside at a 400px window.
                // 120px degrades the copy on a short panel rather than clipping the actions, and a
                // too-small max degrades to min, so a font bump cannot clip (the :5729 reasoning).
                if root.sel-rows.length == 0 : VerticalLayout {
                    vertical-stretch: 0; max-height: 120px; padding-top: Theme.space-6; spacing: Theme.space-2;
                    Text {
                        text: root.sel-rating-filter >= 0 ? @tr("falcon" => "Nothing matches the rating filter.")
                            : root.filter-mode == 1 ? @tr("falcon" => "No picks yet.")
                            : root.filter-mode == 2 ? @tr("falcon" => "No rejects.")
                            : root.filter-mode == 3 ? @tr("falcon" => "Nothing rated yet.")
                            : root.filter-mode == 4 ? @tr("falcon" => "No rotations yet.")
                            // v0.8.129 (W1-4): mode 5 has an arm of its own. It is a BELT — the chip
                            // that reaches this view unmounts at count 0 and the A-4 fallback leaves
                            // the category in the same event — but a category with no empty-state arm
                            // would inherit "Nothing reviewed yet.", which is the Reviewed view's answer,
                            // something else entirely.
                            : root.filter-mode == 5 ? @tr("falcon" => "Nothing selected.")
                            : (root.count-all > 0 ? @tr("falcon" => "Nothing reviewed yet.") : @tr("falcon" => "Open a folder to start culling."));
                        color: Theme.text; font-size: Theme.font-lg; font-weight: 600; horizontal-alignment: center;
                    }
                    Text {
                        // v0.8.119 (design-sweep Y60): the four action hints are composed in
                        // Rust from the LIVE keymap (see the sel-hint-* properties). They were
                        // fixed strings naming P / X / R / 1–5 while all four actions are
                        // rebindable — so a user who swapped Flag to K and Reject to P was
                        // told "Press P on a photo to flag a keeper" by the one surface whose
                        // whole job is to teach the empty state, and pressing P rejected the
                        // photo. The rating-filter line names a CLICK, not a key, and stays.
                        text: root.sel-rating-filter >= 0 ? @tr("falcon" => "Click the highlighted digit chip again to clear it.")
                            : root.filter-mode == 1 ? root.sel-hint-picks
                            : root.filter-mode == 2 ? root.sel-hint-rejects
                            : root.filter-mode == 3 ? root.sel-hint-rated
                            : root.filter-mode == 4 ? root.sel-hint-rotated
                            : root.filter-mode == 5 ? root.sel-hint-selected
                            : root.sel-hint-any;
                        color: Theme.text-mute; font-size: Theme.font-sm; horizontal-alignment: center; wrap: word-wrap;
                    }
                    // v0.8.121 (Round-B fix F18 = audit Y15): the rotation-only dead end.
                    // Mode 0 ("Reviewed") is `rated || flagged || rejected` — rotation is
                    // mode 4 alone — so straightening twelve horizons and opening this panel
                    // the ORDINARY way says "Nothing reviewed yet." while the Rotated chip
                    // directly above it reads 12. O25 scoped the two REMINDER invokers to
                    // filter 4 and left the commoner door alone. Pure copy: naming the chip
                    // that IS the answer, not widening what Reviewed means (that is the
                    // queued Selection round's call).
                    if root.filter-mode == 0 && root.sel-rating-filter < 0 && root.count-rotated > 0 : Text {
                        text: @tr("falcon" => "Rotations aren't in this view — see the Rotated filter above.");
                        color: Theme.text-mute; font-size: Theme.font-sm; horizontal-alignment: center; wrap: word-wrap;
                    }
                }
                // ── v0.8.135 (W2a) — THE PANEL'S EMPTY SPACE CLEARS ──────────────────────────
                // The panel carries ONE bare `TouchArea {}` at its top (the swallow, so the stage
                // under it stays inert). Every real control is declared after it and wins its own
                // hits; everything else was absorbed — including the grid's 18px gutters, its
                // margins and the whole area past the last tile, which is the largest expanse of
                // genuine empty space in the app and the one place the owner most expected a click
                // to clear. It answered nothing, silently.
                //
                // This wrapper is the fix's shape: the clearing TouchArea is the FIRST child of a
                // Rectangle that holds the grid Flickable, so it covers exactly the grid's own
                // rectangle and the tiles (declared after it, inside the Flickable) still win every
                // hit they used to. It is deliberately NOT inside the Flickable's viewport — a
                // viewport child SCROLLS, so the "empty space" would slide out from under the
                // pointer with the rows and stop covering the gutters at any scroll offset.
                //
                // THE ABSORBER MOVES WITH IT (ledger L1, the v0.8.3 balloon): the Flickable used to
                // be the panel's one unbounded stretch-1 child. That role is this Rectangle's now —
                // stretch 1 plus the explicit 100000px max — and the Flickable fills it at 100%,
                // which is why its own stretch/max lines are gone rather than duplicated.
                selgrid := Rectangle {
                    vertical-stretch: 1;
                    max-height: 100000px;
                    TouchArea { clicked => { if (!root.compare) { root.clear-selection(); } } }
                // tile grid (2 columns, row-chunked in Rust). Untouched photos are hidden here —
                // selection happens while browsing; this panel confirms + refines.
                selflick := Flickable {
                    width: 100%; height: 100%;
                    // Drag-to-SCROLL is OFF so a press-drag on a tile ALWAYS starts a drag-to-compare in ANY
                    // direction (this vertical scroller used to steal non-horizontal drags). The grid scrolls
                    // with the mouse WHEEL instead (user: "disable the panel up/down dragging when over image").
                    interactive: false;
                    // Fill the panel's remaining height (below the filter/rating rows, above the pinned
                    // action buttons) so the actions stay visible + the grid scrolls — the clip fix (v0.7.0).
                    // v0.8.135 (W2a): `vertical-stretch` and the 100000px max moved OUT to `selgrid`,
                    // the wrapper that is now the panel's stretch-1 absorber; this fills it at 100%.
                    // v0.8.3 ROOT CAUSE of the twice-shipped balloon (8e23319 captions wedge,
                    // c7cea6d Rated card): Slint's flickable pass binds an unsized Flickable's
                    // max-height to its CONTENT's max-height, so with few grid rows this
                    // Flickable maxed out at ~one tile and left the growable set - and the box
                    // solver's zero-stretch fallback then splits the panel's spare height EQUALLY
                    // among stretch-0 siblings that still have max headroom (stretch is a
                    // PRIORITY, not a lock; only min/max actually bound). The explicit large max
                    // (MainWindow's 100000px idiom) keeps this the panel's one true unbounded
                    // stretch-1 absorber, so every sibling holds its preferred height. (v0.8.135:
                    // that role sits on `selgrid` now — see its note; the reasoning is unchanged,
                    // only the element it applies to moved out by one wrapper.)
                    property <length> backdrop-x: self.absolute-position.x;
                    property <length> backdrop-y: self.absolute-position.y - root.content-top;
                    changed backdrop-x => { root.review-grid-x = self.backdrop-x; }
                    changed backdrop-y => { root.review-grid-y = self.backdrop-y; }
                    changed width => { root.review-grid-w = self.width; }
                    viewport-height: gridcol.preferred-height;
                    viewport-width: self.width;
                    // v0.8.42 (Item 1): mirror the grid viewport to root so the tick's Selection
                    // step can demand-load + pin EXACTLY the visible tiles (independent of the
                    // filmstrip window). init re-zeros the mirror because it OUTLIVES this
                    // conditional element — a re-opened panel must still start at the top (the
                    // fresh-element behaviour users have today). Both observers live HERE, on the
                    // property owner (the child-wrapper observer trap, v0.7.x memory).
                    //
                    // v0.8.123 (I1b) — ONE-WAY, BECAUSE ONE WAY IS THE DIRECTION THIS MIRROR HAS.
                    // Rust only ever READS it (`app.get_sel_vp_y()` in `tick::step_selection`), so
                    // the write-back half of `<=>` bought nothing and carried a real hazard: Slint's
                    // Flickable calls `viewport_y.remove_binding()` on every non-Ended wheel/touch
                    // phase (i-slint-core 1.17 `items/flickable.rs`), and with `interactive: false`
                    // there is no second writer that would ever re-establish a link it dropped. A
                    // `changed` handler is an observer, not a binding, so no assignment can remove
                    // it — the property that Rust reads cannot be orphaned by a gesture.
                    //
                    // MEASURED, and stated because the investigation this round acts on predicted
                    // otherwise: on Slint 1.17 the two-way form does NOT in fact freeze. Six wheel
                    // notches leave `sel-vp-y` at -720 under BOTH forms (the compiler resolves this
                    // alias to one property, so `remove_binding` and the following `set` land on the
                    // same storage the getter reads). So this is a direction/robustness change, NOT
                    // a fix for the reported "Selection tiles go dark" — the demand-loader really
                    // does see the live offset today, and that report's cause is still open.
                    // v1.0.0-rc (queue item 31, §3.A.4): …and it clears the hovered index. A
                    // scroll under a RESTING pointer changes which tile is under it with no pointer
                    // event of any kind, so `changed hot` never fires and the card would keep
                    // describing the tile that used to be there. The next pointer motion re-arms it.
                    changed viewport-y => { root.sel-vp-y = self.viewport-y; root.sel-hover-idx = -1; }
                    init => { root.sel-vp-y = 0; root.sel-vp-h = self.height;
                        root.review-grid-x = self.backdrop-x; root.review-grid-y = self.backdrop-y;
                        root.review-grid-w = self.width; root.review-grid-h = self.height; }
                    changed height => { root.sel-vp-h = self.height; root.review-grid-h = self.height; }
                    // v0.8.154 (A3, ruling Q11): the RECENTER channel — Rust → this Flickable.
                    // Mirrored as a LOCAL property because a `changed` observer lives on the element
                    // that DECLARES the property (the child-wrapper observer trap), and this element
                    // is inside `if root.sel-open`, so a handler at the window root could not name
                    // it. `sel-scroll-y` is read at apply time, not latched, so the seq is the only
                    // thing that has to move. Assigning `viewport-y` directly is what the wheel path
                    // does internally — no binding to lose.
                    property <int> scroll-seq: root.sel-scroll-seq;
                    changed scroll-seq => {
                        self.viewport-y = root.sel-scroll-y;
                        root.sel-vp-y = root.sel-scroll-y; // the read mirror, same frame (its own `changed` also fires)
                    }
                    // ── v0.8.135 (W4, ruled geometry) — THE HALO GETS ITS CLEARANCE ──────────
                    // v0.8.133 made the glow renderable by casting it INWARD from an inset caster,
                    // which cost the photograph 6px on every side and put a permanent mat around
                    // every tile. The owner's second feel-test rejected the mat, so the halo goes
                    // back OUTWARD with the filmstrip's exact grammar (blur 9 / offset-y 2) and the
                    // GRID makes room for it instead of the tile shrinking around it.
                    //
                    // MEASURED, per side, against a 9px blur biased +2px down:
                    //   left / right  need 9   → 9px of padding on each flank
                    //   top           needs 9−2 = 7  → 7px of top padding
                    //   bottom        needs 9+2 = 11 → 11px of bottom padding
                    //   column gap    needs 2×9 = 18 (no horizontal bias) → 18px
                    //   row gap       needs 11 down + 7 up = 18 → 18px
                    // Zero overlap between two selected neighbours, and nothing for `selflick`'s
                    // clip to cut on any flank of any tile — which is what "the glow was half
                    // missing" was.
                    //
                    // THE PHOTOGRAPH IS THE SAME SIZE IT IS TODAY. The body is 460px; two 9px
                    // flanks and one 18px gutter leave (460 − 18 − 18) / 2 = 212px per tile, and
                    // 212px is EXACTLY what the v0.8.133 photograph measured (224px cell minus two
                    // 6px mat sides). The mat's removal pays for the clearance to the pixel — which
                    // is why 9/2 wins here and 12/3 would not have.
                    gridcol := VerticalLayout {
                        width: parent.width;
                        padding-left: 9px; padding-right: 9px; padding-top: 7px; padding-bottom: 11px;
                        spacing: 18px;
                        // v0.8.4 tile parity: every stretching cell in a row carries the IDENTICAL
                        // constraint quadruple {min 0, preferred 0, max inf, stretch 1}. The solver
                        // starts cells at PREFERRED and distributes only the surplus by stretch - a
                        // tile's content-derived preferred (its caption row, ~125px) was a permanent
                        // head start over the pref-0 filler, so a lone last tile rendered ~60% wide
                        // vs the ~47% two-column tiles (the v0.8.3 stretch class, horizontal cut).
                        for row in root.sel-rows : HorizontalLayout {
                            spacing: 18px; // v0.8.135 (W4): two 9px haloes, edge to edge, zero overlap
                            SelTile {
                                item: row.a; cur-idx: root.cur-idx; edits-enabled: !root.modal-open; horizontal-stretch: 1; preferred-width: 0px; min-width: 0px;
                                cmp-a: root.compare && row.a.idx == root.cmp-a-idx;
                                cmp-b: root.compare && row.a.idx == root.cmp-b-idx;
                                // v0.8.135 (W6, OWNER VETO): the tile's BADGES are single-photo too,
                                // now and permanently. v0.8.130 gave them the bulk glow + dispatch
                                // and v0.8.133 kept it after taking it off the stars; the owner's
                                // second feel-test ruled the whole tile out. A contact-sheet tile
                                // shows ONE photograph — every control drawn on top of it edits that
                                // photograph, whatever else is selected. The plural flag/reject mouse
                                // surfaces are the EXIF cull row and the two context menus, both of
                                // which glow and carry a counted, DIRECTED label; a 22px corner
                                // square over a thumbnail can carry neither.
                                preview: root.sel-preview; // v0.8.129 (W1-3)
                                ctrl-preview: root.sel-ctrl-preview; // v0.8.133 (D): ANDed with this tile's own hover inside the component
                                // v0.8.129 (W1-2): a range started HERE walks the panel's own
                                // displayed feed (the `true` argument), never the whole folder.
                                // v1.0.0-rc (queue item 31, §3.A.3): the hover push, ONE handler,
                                // and the `else if` guard is what makes an A -> B move safe. Slint
                                // may run B's arrival before A's departure in the same frame, and
                                // an unguarded `else` clear would then wipe the index B had just
                                // set. A press pushes `hot: false` too, from `jta`'s own down arm,
                                // and additionally raises `sel-hover-press` for the step.
                                hover-changed(idx, hot, cy, pressed) => {
                                    if (pressed) { root.sel-hover-press = true; }
                                    if (hot) { root.sel-hover-idx = idx; root.sel-hover-cy = cy; }
                                    else if (root.sel-hover-idx == idx) { root.sel-hover-idx = -1; }
                                }
                                clicked-with(ctrl, shift) => {
                                    if (root.sel-gesture-kind(ctrl, shift) >= 0) { root.sel-gesture(row.a.idx, root.sel-gesture-kind(ctrl, shift), true); }
                                    else if (root.neighbour-browse-allowed(ctrl, shift)) { root.sel-jump(row.a.idx); }
                                }
                                // v0.8.133 (A-F6, OWNER RULING): a tile star is SINGLE-PHOTO, forever. The
                                // bulk arm and the glow that advertised it are both gone -- see the star row
                                // in filmstrip.slint for why (five 36px-wide halos at an 18px pitch merged
                                // into the container box the grammar forbids, over a rating gesture on a
                                // contact-sheet tile that silently meant twelve photographs). The BADGES above
                                // keep theirs: they are two controls, not five, at a measured 4px radius.
                                rate(v) => { root.sel-set-rating(row.a.idx, row.a.rating == v ? 0 : v, false); }
                                toggle-flag => { root.sel-toggle-flag(row.a.idx, false); }   // v0.8.135 (W6): this tile's own photograph, always
                                toggle-reject => { root.sel-toggle-reject(row.a.idx, false); } // v0.8.135 (W6): ditto
                                ctx(x, y) => { root.ctx-populate(row.a.idx); root.sel-ctx-idx = row.a.idx; root.sel-ctx-x = x; root.sel-ctx-y = y; root.sel-ctx-open = true; } // v0.8.42 (Item 2): populate fills THIS tile's copy availability/label (G2 pattern)
                                drag-start => { if (!root.opening-photo && !root.photo-popup-open) { root.sel-drag-idx = row.a.idx; root.sel-drag-thumb = row.a.thumb; root.sel-drag-zone = -1; root.sel-dragging = true; } }
                                drag-move(x, y) => { if (root.sel-dragging) { root.sel-drag-x = x; root.sel-drag-y = y; root.sel-drag-zone = root.drop-zone-at(x, y); } }
                                drag-end => { if (root.sel-dragging && !root.opening-photo && root.sel-drag-zone >= 0) { root.sel-to-compare(root.sel-drag-idx, root.sel-drag-zone); } root.sel-dragging = false; root.sel-drag-zone = -1; }
                            }
                            if row.has-b : SelTile {
                                item: row.b; cur-idx: root.cur-idx; edits-enabled: !root.modal-open; horizontal-stretch: 1; preferred-width: 0px; min-width: 0px;
                                cmp-a: root.compare && row.b.idx == root.cmp-a-idx;
                                cmp-b: root.compare && row.b.idx == root.cmp-b-idx;
                                // v0.8.135 (W6, OWNER VETO): the tile's BADGES are single-photo too,
                                // now and permanently. v0.8.130 gave them the bulk glow + dispatch
                                // and v0.8.133 kept it after taking it off the stars; the owner's
                                // second feel-test ruled the whole tile out. A contact-sheet tile
                                // shows ONE photograph — every control drawn on top of it edits that
                                // photograph, whatever else is selected. The plural flag/reject mouse
                                // surfaces are the EXIF cull row and the two context menus, both of
                                // which glow and carry a counted, DIRECTED label; a 22px corner
                                // square over a thumbnail can carry neither.
                                preview: root.sel-preview; // v0.8.129 (W1-3)
                                ctrl-preview: root.sel-ctrl-preview; // v0.8.133 (D): ANDed with this tile's own hover inside the component
                                // v1.0.0-rc (queue item 31, §3.A.3): the hover push, ONE handler,
                                // and the `else if` guard is what makes an A -> B move safe. Slint
                                // may run B's arrival before A's departure in the same frame, and
                                // an unguarded `else` clear would then wipe the index B had just
                                // set. A press pushes `hot: false` too, from `jta`'s own down arm,
                                // and additionally raises `sel-hover-press` for the step.
                                hover-changed(idx, hot, cy, pressed) => {
                                    if (pressed) { root.sel-hover-press = true; }
                                    if (hot) { root.sel-hover-idx = idx; root.sel-hover-cy = cy; }
                                    else if (root.sel-hover-idx == idx) { root.sel-hover-idx = -1; }
                                }
                                clicked-with(ctrl, shift) => {
                                    if (root.sel-gesture-kind(ctrl, shift) >= 0) { root.sel-gesture(row.b.idx, root.sel-gesture-kind(ctrl, shift), true); }
                                    else if (root.neighbour-browse-allowed(ctrl, shift)) { root.sel-jump(row.b.idx); }
                                }
                                // v0.8.133 (A-F6, OWNER RULING): a tile star is SINGLE-PHOTO, forever. The
                                // bulk arm and the glow that advertised it are both gone -- see the star row
                                // in filmstrip.slint for why (five 36px-wide halos at an 18px pitch merged
                                // into the container box the grammar forbids, over a rating gesture on a
                                // contact-sheet tile that silently meant twelve photographs). The BADGES above
                                // keep theirs: they are two controls, not five, at a measured 4px radius.
                                rate(v) => { root.sel-set-rating(row.b.idx, row.b.rating == v ? 0 : v, false); }
                                toggle-flag => { root.sel-toggle-flag(row.b.idx, false); }   // v0.8.135 (W6): this tile's own photograph, always
                                toggle-reject => { root.sel-toggle-reject(row.b.idx, false); } // v0.8.135 (W6): ditto
                                ctx(x, y) => { root.ctx-populate(row.b.idx); root.sel-ctx-idx = row.b.idx; root.sel-ctx-x = x; root.sel-ctx-y = y; root.sel-ctx-open = true; } // v0.8.42 (Item 2)
                                drag-start => { if (!root.opening-photo && !root.photo-popup-open) { root.sel-drag-idx = row.b.idx; root.sel-drag-thumb = row.b.thumb; root.sel-drag-zone = -1; root.sel-dragging = true; } }
                                drag-move(x, y) => { if (root.sel-dragging) { root.sel-drag-x = x; root.sel-drag-y = y; root.sel-drag-zone = root.drop-zone-at(x, y); } }
                                drag-end => { if (root.sel-dragging && !root.opening-photo && root.sel-drag-zone >= 0) { root.sel-to-compare(root.sel-drag-idx, root.sel-drag-zone); } root.sel-dragging = false; root.sel-drag-zone = -1; }
                            }
                            if !row.has-b : Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }
                } // selgrid — the clearing wrapper (v0.8.135, W2a)
                HRule { vertical-stretch: 0; }
                // hand-off / publish actions (safe ones first; destructive Move set apart below)
                // Three captioned columns: Picks · Rejects · Rotations (small-card-title captions).
                // v0.8.3: the caption Texts carry max-height 20px - a bare Text reports max=inf
                // vertically, which left each column unbounded (caption + two fixed 34px buttons)
                // and let this row silently share the v0.8.1 spare-height split with the Rated
                // card (8e23319's caption wedge, round 2). A too-small max degrades to min, so a
                // future font bump can't clip.
                HorizontalLayout {
                    vertical-stretch: 0;
                    spacing: Theme.space-2;
                    VerticalLayout {
                        horizontal-stretch: 1; vertical-stretch: 0; spacing: Theme.space-2;
                        // v0.8.130 (W2-1, design section 6): THE ADAPTING COLUMN. Heading, both
                        // labels and the enablement follow the active category, and the set they
                        // act on is the panel's own DISPLAYED feed — so on "Selected" with a digit
                        // chip lit the button targets selected∩rating and the confirm names that
                        // count. The Rejects and Rotations columns beside it are untouched (the
                        // standing 07-21 ruling): Move-rejected stays rejects-only whatever the
                        // filter says.
                        Text { text: root.out-col1-title; color: Theme.text; font-size: Theme.font-body; max-height: 20px; }
                        ActionBtn {
                            label: root.out-copy-label; variant: 0; primary: true;
                            enabled: root.count-out-col1 > 0 && !root.sel-busy;
                            // Enter confirms kind 1 ONLY (see the Return handler); copy-content Seg lives in the modal.
                            clicked => { root.confirm-kind = 1; }
                        }
                        ActionBtn {
                            label: root.out-web-label; variant: 0; web: true;
                            enabled: root.count-out-col1 > 0 && !root.sel-busy;
                            clicked => { root.open-export(); }
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1; vertical-stretch: 0; spacing: Theme.space-2;
                        Text { text: @tr("falcon" => "Rejects"); color: Theme.text; font-size: Theme.font-body; max-height: 20px; }
                        ActionBtn {
                            label: @tr("falcon" => "Move rejected"); variant: 1;
                            enabled: root.count-rejects > 0 && !root.sel-busy;
                            clicked => { root.confirm-kind = 2; }
                        }
                        ActionBtn {
                            label: root.empty-action-label; variant: 1; // v0.8.119 (O24): platform-routed noun
                            // W3d: red only when ./Rejected actually has files (probed on panel-open / op-finish).
                            // v0.8.119 (Y45): the probe returns a COUNT now — `> 0` is the same set.
                            enabled: root.count-bin > 0 && !root.sel-busy;
                            clicked => { root.confirm-kind = 3; }
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1; vertical-stretch: 0; spacing: Theme.space-2;
                        Text { text: @tr("falcon" => "Rotations"); color: Theme.text; font-size: Theme.font-body; max-height: 20px; }
                        // ── v0.8.163 (§7 item 4, OWNER RULING): THE TWO ROTATION ACTIONS GET RIMS.
                        // "blue-apply, red-discard, no need for inner fill color just the rim …
                        // still fade like empty->bin if there's nothing to rotate." `rim` is
                        // ActionBtn's own border override (see its note): the variant-2 fill, hover
                        // lift and label are untouched, and the enabled arm is the only place the
                        // colour is stated — so with no pending rotations both fall to the same
                        // `Theme.well` + transparent-border fade "Empty → Bin" wears beside them,
                        // which is what the ENABLEMENT (unchanged: `count-rotated > 0 &&
                        // !sel-busy`) has always produced.
                        ActionBtn {
                            label: @tr("falcon" => "Apply rotations"); variant: 2; rim: 1; // blue — the destination the rotations travel to
                            enabled: root.count-rotated > 0 && !root.sel-busy;
                            clicked => { root.confirm-kind = 5; }
                        }
                        ActionBtn {
                            label: @tr("falcon" => "Discard rotations"); variant: 2; rim: 2; // red — the same rim "Move rejected" wears, for the same reason
                            enabled: root.count-rotated > 0 && !root.sel-busy;
                            clicked => { root.confirm-kind = 4; }
                        }
                    }
                }
                // (Op results now surface in the unified top-right events centre, not an inline banner.)
                // v0.8.75: the XMP-sync ToggleRow + caption that closed the panel here moved up into
                // the Rated filter row as the compact right-aligned control — the action grid ends
                // the panel now (selbox's own 20px bottom padding closes it; no orphaned rule).
            }
            // v0.8.65 (C3, owner rule): panel-bottom fade over the tile grid — sized to the grid
            // Flickable's own edges by id (the actions row below keeps its full contrast), painted
            // after selbox so it overlays the scrolled tiles. Pure paint; `more` hides it when the
            // grid is at (or fits within) its bottom, so drag-to-compare targets never sit under a
            // permanent smudge.
            // v0.8.135 (W2a): the fade's RECTANGLE is `selgrid`'s (the Flickable is that wrapper's
            // 100%-sized child now, so `selflick.x/y` are 0 relative to it); the SCROLL question it
            // asks is still the Flickable's own.
            PanelBottomFade {
                x: selgrid.x; width: selgrid.width;
                y: selgrid.y + selgrid.height - self.height;
                more: selflick.viewport-height + selflick.viewport-y > selflick.height + 1px;
            }
            // ── v1.0.0-rc (queue item 37, sheet 2.9) — THE REVIEW PANEL'S MINI SCROLL BAR ────────
            // The owner, verbatim: "the review panel does not have the scroll bar like the
            // filmstrip/grid, add it". This is the dock grid's own bar (`MiniVBar`, widgets.slint)
            // in the panel's 20px right pad, driven by the panel's own Flickable. The fade above and
            // this bar answer different questions and coexist: the fade says "there is more", the
            // bar says where you are and how much. Wheel scrolling is untouched.
            //
            // WHERE (sheet 2.9a, ★ (a) — centred in the right pad): `selgrid`'s right edge + 6px, so
            // the 8px band runs 486..494 in panel space — 6px clear of the panel's rounded edge at
            // 500 and 6px clear of the 9px halo clearance the tiles reserve at 451. It overlays no
            // tile, steals no tile hit and moves nothing: the body stays 460px, the tiles 212px.
            // Declared at the GlassPanel's level after `selbox`, beside `PanelBottomFade`, which
            // already reads `selgrid` and `selflick` by id from this exact scope — and OUTSIDE
            // `selflick`, so it does not scroll away with the rows it measures.
            //
            // THE SNAP (ledger L48). The panel sits at window x 3 and this band at panel x 486, so
            // the band's WINDOW x is 489 — 733.5 device px at the owner's 150%, a half column under a
            // 4px track and a 6px thumb, which is the class that made round 31 snap every edge of the
            // hover card. `parent.x` / `parent.y` are the panel's own origin, so the rounding happens
            // on the WINDOW-space edge and is then carried back into the panel's frame: that is the
            // frame `HoverPreview` and the modal dialogs snap in, and the frame the rig measures.
            // The HEIGHT comes from snapping the bottom edge too, never from carrying
            // `selgrid.height` through — that height is layout-derived and fractional, so a snapped
            // top over a raw height would put the bottom straight back off the device grid. Measured
            // cost, at 100 / 125 / 150 / 200%: the band moves 0 / 0.2 / 0.333 / 0 logical px, all
            // under the half-pixel the design brief allowed (§C.1).
            // NOT CLAIMED: the enclosing `GlassPanel` is a clip+radius LAYER host and its own origin
            // (window x 3 → device 4.5 at 150%) is not something this markup can move. The band is
            // exactly as crisp as the panel that holds it; no row here asserts more than that.
            if selflick.viewport-height > selflick.height : MiniVBar {
                property <float> sfx: max(root.win-sf, 0.5);
                property <length> snap-top: Math.round((parent.y + selgrid.y) / 1px * self.sfx) / self.sfx * 1px;
                property <length> snap-bot: Math.round((parent.y + selgrid.y + selgrid.height) / 1px * self.sfx) / self.sfx * 1px;
                x: Math.round((parent.x + selgrid.x + selgrid.width + 6px) / 1px * self.sfx) / self.sfx * 1px - parent.x;
                width: 8px;
                y: self.snap-top - parent.y;
                height: self.snap-bot - self.snap-top;
                vp-h: selflick.height; content-h: selflick.viewport-height; vp-y: selflick.viewport-y;
                seek(y) => { selflick.viewport-y = y; } // the recenter channel's own spelling: a direct write, no binding to lose
            }
        }

        // ── web-export progress card (#18) — determinate bar + live count + Cancel. Non-blocking
        //    (the op buttons are already dimmed via sel-busy); reuses the shared GlassPanel. ──
        if root.export-running : GlassPanel {
            // Language packs (round 2, owner request, 4 October): with Settings → Developer → Widen
            // controls to fit text on, the card grows to fit its title row — the run's title, then
            // the done / total counts with the done count held at the total's width (so the card
            // does not step wider as the run counts up), plus the column's padding — capped at the
            // window less 8px a side, the context menus' rule; never below 300px. Off: exactly 300px.
            // The filename (it elides) and the phase line never count. English never moves below
            // six-digit totals: its widest title, "Exporting 99999 displayed photos", needs 283px
            // (at six digits it needs 302px, already 2px into the padding with the toggle off).
            // Review R2: Inter's digits are proportional, so a smaller done count ("100") can be
            // wider than the total ("111"). The done count is reserved at the total's digit count
            // times the widest digit (`expd0`–`expd9`, never drawn), which no count can exceed.
            property <length> exp-digit-w: max(max(max(expd0.preferred-width, expd1.preferred-width), max(expd2.preferred-width, expd3.preferred-width)),
                                               max(max(max(expd4.preferred-width, expd5.preferred-width), max(expd6.preferred-width, expd7.preferred-width)),
                                                   max(expd8.preferred-width, expd9.preferred-width)));
            width: max(300px, Theme.fit-text ? min(exptitle.preferred-width + 3 * Theme.space-1 + expslash.preferred-width + exptotal.preferred-width + exptotal.text.character-count * self.exp-digit-w + 2 * Theme.space-3, root.width - 16px) : 0px);
            x: (parent.width - self.width) / 2;
            y: 60px;
            height: expprog.preferred-height;
            backdrop: root.blur-backdrop; sw: root.content-w; sh: root.content-h; ox: 0px; oy: (root.content-top);
            TouchArea {}
            expd0 := Text { visible: false; text: "0"; font-size: Theme.font-sm; }
            expd1 := Text { visible: false; text: "1"; font-size: Theme.font-sm; }
            expd2 := Text { visible: false; text: "2"; font-size: Theme.font-sm; }
            expd3 := Text { visible: false; text: "3"; font-size: Theme.font-sm; }
            expd4 := Text { visible: false; text: "4"; font-size: Theme.font-sm; }
            expd5 := Text { visible: false; text: "5"; font-size: Theme.font-sm; }
            expd6 := Text { visible: false; text: "6"; font-size: Theme.font-sm; }
            expd7 := Text { visible: false; text: "7"; font-size: Theme.font-sm; }
            expd8 := Text { visible: false; text: "8"; font-size: Theme.font-sm; }
            expd9 := Text { visible: false; text: "9"; font-size: Theme.font-sm; }
            expprog := VerticalLayout {
                padding: Theme.space-3; spacing: Theme.space-2;
                HorizontalLayout {
                    spacing: Theme.space-1;
                    exptitle := Text { text: root.web-progress-run-title; color: Theme.text; font-weight: 500; // v0.8.134 (R2): CAPTURED at run start // v0.8.131 (F-P7)
                           font-size: Theme.font-md; horizontal-stretch: 1; vertical-alignment: center; }
                    Text { text: root.export-done; color: Theme.text-dim; font-size: Theme.font-sm; vertical-alignment: center; }
                    expslash := Text { text: "/"; color: Theme.text-mute; font-size: Theme.font-sm; vertical-alignment: center; }
                    exptotal := Text { text: root.export-total; color: Theme.text-dim; font-size: Theme.font-sm; vertical-alignment: center; }
                }
                Rectangle {
                    height: 6px; border-radius: 3px; background: Theme.block;
                    Rectangle {
                        x: 0px; height: parent.height; border-radius: 3px; background: Theme.accent;
                        width: root.export-total > 0 ? parent.width * root.export-done / root.export-total : 0px;
                        animate width { duration: Theme.anim; easing: ease; }
                    }
                }
                if root.export-filename != "" : Text {
                    text: root.export-filename; color: Theme.text-dim; font-size: Theme.font-sm;
                    overflow: elide;
                }
                Text {
                    text: root.export-stopping ? @tr("falcon" => "Stopping…") : root.export-phase;
                    color: Theme.text-mute; font-size: Theme.font-sm;
                }
                ActionBtn { label: @tr("falcon" => "Cancel"); variant: 2; enabled: !root.export-stopping;
                            clicked => { root.cancel-export(); } }
            }
        }

        // ── unified events / notifications centre — the single top-right sink ──
        // Transient TOAST (latest event) at top-right, below the bell. Non-modal; auto-dismisses on a
        // tick countdown (an undoable move persists while Undo is still available). Actions live here so
        // "just did it" corrections don't require opening any panel.
        // Styled as a FLOATING EVENTS ROW — the same card grammar as the events-panel rows (block
        // card, severity dot, font-body text + a muted time line, top-right ×) but panel-class radius
        // (Theme.radius 13, v0.7.1) not the rows' radius-sm, so the popped-out notification and the
        // panel read as one system (user call, §35.21). Only a soft shadow is added for separation
        // from the photo behind.
        // N9: persistent DEGRADED banner — the per-frame pipeline is failing repeatedly (a
        // deterministic tick panic). Set/cleared from Rust OUTSIDE the panicking pipeline, so it
        // renders no matter which step is broken. Same card grammar as the toast (block card,
        // severity dot, font-body) with a danger tint; not dismissable — it clears itself when the
        // tick recovers, and the honest advice is to restart.
        if root.tick-degraded : Rectangle {
            width: min(parent.width - 24px, 560px);
            x: (parent.width - self.width) / 2;
            y: 52px;
            height: degradedrow.preferred-height + 12px;
            background: Theme.block; border-radius: Theme.radius-sm;
            border-width: 1px; border-color: Theme.danger;
            drop-shadow-blur: Theme.shadow-blur; drop-shadow-color: Theme.shadow-control; drop-shadow-offset-y: Theme.shadow-dy; // v0.8.185 (D17, owner): 24/8/shadow-panel -> the app's heaviest class, on the W2 tokens
            TouchArea {} // swallow clicks (don't zoom the photo behind)
            degradedrow := HorizontalLayout {
                padding: Theme.space-2; spacing: Theme.space-2;
                Rectangle { width: 8px; height: 8px; border-radius: 4px; y: 5px; background: Theme.danger; }
                Text {
                    text: @tr("falcon" => "Internal error — the display pipeline keeps failing. Your ratings are still being saved; please restart Falcon.");
                    color: Theme.text; font-size: Theme.font-body; wrap: word-wrap; horizontal-stretch: 1;
                }
            }
        }
        // v0.8.8 (M4): the toast is ALWAYS MOUNTED so it can slide+fade in and fade out. `reveal`
        // (0 hidden -> 1 shown; anim-med, ease-out) drives the opacity, the 8px slide, AND the
        // hit-test gate `hot`. Enter = slide-down + fade; a REPLACE (toast-show stays true) is a plain
        // content swap (no re-slide); exit = fade (with a symmetric 8px slide-up, flagged in the
        // report). CLICK-STEAL GATE (v0.7.2 class): a mounted-but-faded TouchArea still steals a stage
        // click, so every interactive child is gated on `hot` = toast-show && the enter animation has
        // essentially completed (reveal > 0.99). On EXIT toast-show flips false -> hot false AT ONCE
        // (opacity still fading) -> the body-swallow + dismiss pass the click THROUGH and the action
        // pills unmount, so a fading toast can never swallow a click meant for the stage beneath.
        toastcard := Rectangle {
            property <float> reveal: root.toast-show ? 1.0 : 0.0;
            animate reveal { duration: Theme.anim-med; easing: ease-out; }
            // v0.8.12 (M4 dev-toggle): the EFFECTIVE reveal every consumer reads (opacity, the 8px
            // slide, AND the `hot` hit-test gate). motion ON → follows the animated `reveal`
            // (byte-identical to v0.8.11); motion OFF → snaps to toast-show (1.0 shown / 0.0 hidden)
            // with NO interpolation, so a freshly-shown toast is fully opaque, at final y, and
            // clickable the SAME frame — and a mid-animation flip can't strand it half-visible
            // (eff-reveal recomputes to 1.0 at once). '+N' superseded counter is unaffected.
            property <float> eff-reveal: root.motion-ui ? self.reveal : (root.toast-show ? 1.0 : 0.0);
            property <bool> hot: root.toast-show && self.eff-reveal > 0.99;
            // Language packs (round 2, PLAN §5): Settings → Developer → Widen controls to fit text.
            // The [Yes][No] row (below) was tuned into a 124 px budget beside the 320 px card; this
            // is what the row needs in this language — both pills' words (the two measurers at the
            // end of the card) plus their padding, the gap between them and the column's padding —
            // and the card grows by however much that passes the budget. ONE width binding, off =
            // exactly 320 px (L47); English needs less than 124 px, so it never moves.
            property <length> ask-row-need: tyesm.preferred-width + tnom.preferred-width + Theme.space-2 * 5 + Theme.space-3 * 2;
            width: max(320px, Theme.fit-text ? 320px + self.ask-row-need - 124px : 0px);
            x: parent.width - self.width - 3px;
            y: root.content-top + 3px - (1.0 - self.eff-reveal) * 8px;
            opacity: self.eff-reveal;
            height: toastcol.preferred-height + 12px;
            background: Theme.block; border-radius: Theme.radius;
            drop-shadow-blur: Theme.shadow-blur; drop-shadow-color: Theme.shadow-control; drop-shadow-offset-y: Theme.shadow-dy; // v0.8.185 (D17, owner): 34/12/shadow-panel -> the app's heaviest class, on the W2 tokens
            // swallow body clicks so they don't zoom the photo behind -- ONLY while hot (a disabled
            // TouchArea passes the click THROUGH to the stage during enter/exit).
            //
            // ── v1.0.0-rc (queue item 30, §1.B): …AND IT IS THE CARD'S HOVER SENSOR NOW. ────────
            // Which is why it became the PARENT of the column instead of its sibling. Slint sets
            // `has-hover` in `input_event_filter_before_children` on EVERY enabled TouchArea on the
            // path down to the hit item, and delivers `Exit` to the whole previous chain, so an
            // ancestor keeps its hover while a child pill holds the pointer. A sibling does not —
            // which is exactly why the RAW panel's `anyhot` has to OR its buttons in one by one.
            // Children still receive the click first (the filter returns ForwardAndInterceptGrab),
            // so every pill's `clicked` is untouched, and the geometry is untouched too: a
            // TouchArea inside a Rectangle fills it, and the column inside the TouchArea fills
            // that, which is what the column did before.
            //
            // MEASURED, NOT READ (ledger L49): `the_toast_countdown_pauses_under_everything_that_
            // covers_it` hovers the card, the [Yes] pill, the [Recover] pill and the × at each
            // element's OWN box and asserts the freeze at every one.
            tbody := TouchArea { enabled: toastcard.hot;
            // v0.8.105 (W9 / ledger L1 — widest state): the card is a HARD 320px 3px from the window
            // edge, with no `clip`, and Slint layouts never shrink a child below its content minimum.
            // The "Open Settings" pill (~100px hugging its label) was added to the SAME row that
            // carries the app's longest toast sentence AND its longest unbreakable token — the quoted
            // profile filename, e.g. “Dell_S2725QS_Native_v2.icm” at ~190px in Theme.font-body.
            // v0.8.106 (Round-A final check): the arithmetic below is the CORRECTED one — the
            // v0.8.105 note counted 4 spacing gaps for a 4-child row (3) and reached 380, and it
            // ignored the "+N" variant entirely. Both totals still clear the bar, by less.
            // Row minimum WITH the pill (4 children: dot · text · pill · dismiss ⇒ 3 gaps)
            //   = 12+12 padding + 8 dot + 26 dismiss + 3×8 spacing + 100 pill + 190 token = 372px,
            // and with the "+N" chip present (5 children ⇒ 4 gaps, chip ≈ 30px for "+12")
            //   = 372 + 8 + 30 = 410px — either way > 320 ⇒ the dismiss × (and possibly the pill)
            // pushed off the card and off the window. Moving the pill to its OWN row leaves
            // 320 − 74 = 246px for the text (74 = 12+12 padding + 8 dot + 26 dismiss + 2×8 spacing),
            // which the token fits with ~56px to spare; with the "+N" chip also present the text
            // budget is 320 − 74 − 8 − ~34 ≈ 204px, still above the ~190px token — the tightest
            // real state, and the one to re-derive if any child here changes. The pill row needs
            // 12+12+100 = 124px.
            // v0.8.160 (Y6, L5 re-derivation): the "+N" chip's ramp moved font-xs → font-sm (9 → 11px)
            // and its height 18 → 24px, so its hug widened by ~4px ("+12" ≈ 30 → ≈ 34). The text
            // budget above is re-derived for that; the card's height is set by the 26px dismiss
            // button and the wrapped text, both taller than 24, so the row does not grow.
            // v1.0.0-rc (queue item 30, §1.C): the WIDTH arithmetic above is untouched by the
            // cancellation notice — it is a second line inside the SAME `Text` (`wrap: word-wrap`
            // honours the newline), so it consumes the same 246px budget and adds no child. The
            // card's height is content-driven (`toastcol.preferred-height + 12px`), so it simply
            // grows: measured 98px → 128px on the widest card the rig mounts (the question with
            // [Yes][No] and a [Recover]), i.e. the notice's two wrapped lines and nothing else.
            // The column is a NO-OP for every other toast: one child, same padding, same height
            // formula, so the ordinary card is geometrically unchanged.
            toastcol := VerticalLayout {
                padding: Theme.space-3; spacing: Theme.space-2;
            toastrow := HorizontalLayout {
                spacing: Theme.space-2;
                Rectangle {
                    width: 8px; height: 8px; border-radius: 4px; y: 5px;
                    background: root.toast-kind == 3 ? Theme.danger : root.toast-kind == 2 ? Theme.warn
                              : root.toast-kind == 1 ? Theme.accent : Theme.text-mute;
                }
                VerticalLayout {
                    horizontal-stretch: 1; spacing: 2px;
                    Text { text: root.toast-text; color: Theme.text; font-size: Theme.font-body; wrap: word-wrap; }
                    Text { text: @tr("falcon" => "Just now"); color: Theme.text-mute; font-size: Theme.font-sm; }
                }
                // D1: "+N" chip -- how many notifications were superseded (replaced before their
                // timeout) since this toast chain began; the rest live in the events centre (bell).
                // Badge grammar: small, text-dim on the dark well.
                //
                // ── v0.8.154 (A9, OWNER RULING Q29): THE COUNTER IS A CONTROL NOW. ───────────────
                // It told the user that N things had happened which they could not see, sitting
                // between three or four pills that ARE clickable, with nothing connecting it to the
                // bell 300 px away — a read-out in a row of buttons. Clicking it opens the events
                // centre, where those N things actually are.
                //
                // ONE CALL, DELIBERATELY (ledger L39): this arm invokes and does NOT dismiss.
                // `on_toggle_notif` already tears the toast down itself when it OPENS ("the open
                // panel supersedes the transient toast" — it clears toast_show, toast_more and the
                // bulk-ask), so the teardown lives in Rust, before the panel appears, which is
                // exactly what L39 asks for after the three-pill wave. `toggle` cannot close here
                // either: `step_notifs` suppresses the toast while `notif_open`, so a visible +N
                // chip proves the panel is shut and this is always an open.
                if root.toast-more > 0 : VerticalLayout {
                    alignment: center;
                    // v0.8.44 (G10): the shared Chip primitive, COUNTER role (well pill, text-dim +N).
                    Chip {
                        role: ChipRole.counter; text: "+" + root.toast-more;
                        hover: tmta.has-hover; // v0.8.154 (A9): the signifier — it must LOOK clickable
                        // Same `toastcard.hot` gate as every sibling pill: while the card is fading
                        // out its controls are inert, so a click cannot land on a leaving toast.
                        tmta := TouchArea {
                            enabled: toastcard.hot; mouse-cursor: pointer;
                            clicked => { root.toggle-notif(); }
                        }
                    }
                }
                // The toast card is a block; its action pills use the standard dark well.
                if root.toast-undoable && root.can-undo-move && toastcard.hot : VerticalLayout {
                    alignment: center;
                    PillBtn { text: @tr("falcon" => "Undo"); clicked => { root.undo-move(); root.dismiss-toast(); } }
                }
                // D2 (W4): the resume-at-last-shot ASK — jumps via the same path as a Selection-
                // list click (the user decided: ask, never auto-jump).
                if root.toast-jump >= 0 && toastcard.hot : VerticalLayout {
                    alignment: center;
                    PillBtn { text: @tr("falcon" => "Resume"); clicked => { root.sel-jump(root.toast-jump); root.dismiss-toast(); } }
                }
                if root.toast-reveal-path != "" && toastcard.hot : VerticalLayout {
                    alignment: center;
                    PillBtn { text: @tr("falcon" => "Show"); clicked => { root.reveal-path(root.toast-reveal-path); root.dismiss-toast(); } }
                }
                // v0.8.37 (FIX A1): the delete toast Recover action — restore from the OS Recycle Bin.
                if root.toast-recover && toastcard.hot : VerticalLayout {
                    alignment: center;
                    // v0.8.131 (the F-P4 rule-4 class, same defect one pill over): ONE call. This
                    // handler raises an honest refusal toast on a cross-folder recover, and the
                    // paired dismissal killed it in the same event.
                    PillBtn { text: @tr("falcon" => "Recover"); clicked => { root.recover-delete(); } }
                }
                // v0.8.129 (W1-5, owner ruling Q12+N2): the clear-recovery pill — a drop-in clone of
                // Recover above (same PillBtn, same `hot` gate, same dismiss-on-act). Selection
                // changes stay OFF the undo stack; THIS is their recovery, and it is offered only
                // when a clear cost three or more photos. The pill carries no entry identity, so the
                // demotion discipline lives at the raisers: `show_transient_toast` and the logged
                // toast path both clear `toast-restore`, i.e. a newer toast never inherits it.
                // v0.8.131 (F-P4 rule 2): + the two MODE terms its handler has (and its four
                // siblings already had). The selection is dormant in compare and immersive, so a
                // pill that would act on it must not be reachable there either — L21/L26, the
                // enablement mirrors the handler.
                if root.toast-restore && toastcard.hot && !root.compare && !root.immersive : VerticalLayout {
                    alignment: center;
                    // v0.8.131 (F-P4 rule 4): ONE call — the handler dismisses, then speaks. The
                    // pair killed the sentence the restore had just written (the F-P1 class).
                    PillBtn { text: @tr("falcon" => "Restore"); clicked => { root.restore-selection(); } }
                }
                VerticalLayout {
                    alignment: start;
                    Rectangle {
                        width: 26px; height: 26px; border-radius: Theme.radius-sm; // standard dismiss square (v0.7.1)
                        background: tdisa.has-hover ? Theme.hover : transparent;
                        // v0.8.44 (G7): the canonical drawn X (CloseGlyph), 11px in the 26px square —
                        // the "×" TEXT glyph is gone (tofu-risk in Inter; the old -1px optical nudge
                        // was a font-baseline artefact — a drawn Path centres true).
                        CloseGlyph { width: 11px; height: 11px;
                                     x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                        tdisa := TouchArea { enabled: toastcard.hot; clicked => { root.dismiss-toast(); } }
                    }
                }
            }
            // v0.8.104 (Round-A C12): the colour-profile failure's recovery route. Plain open —
            // the gear button's own flip sequence (close welcome first, record panel-switch,
            // close the siblings), so the sheet lands exactly as it does from the title bar.
            // v0.8.105 (W9): on its OWN row, right-aligned under the sentence — see the width
            // arithmetic on the column above. This is the only action pill that shares a card with
            // the boot-failure sentence, so it is the only one that needs the second row.
            // v0.8.130 (W2-2, owner ruling Q1 + spec 2.2): THE ASK-FIRST [Yes][No] PAIR, on the
            // SECOND ROW. The card is a hard 320px with no clip and the v0.8.105 arithmetic above
            // proves ONE inline pill already reaches 372-410px, so a fifth and sixth inline pill
            // were never options. On their own row: 12+12 padding + "Yes" (~46px hugging) + 8px
            // spacing + "No" (~42px) = ~120px, inside the 124px the settings row already budgets.
            // Right-aligned, like that row, so the sentence above keeps the full text width.
            //
            // L18: this pair is the ONLY Yes. Esc, the dismiss ×, the timeout and any newer toast
            // all clear `toast-bulk-ask` (Rust-side, through ONE teardown helper), and [Yes] cannot
            // be reached without it — so every other dismissal is a clean No with no third behaviour.
            //
            // v0.8.131 (F-P1 rule 4) — THE DISMISSAL MOVED RUST-SIDE, and this pill is now a single
            // call. `bulk-rate-yes` RAISES the counted result on this same card; the old
            // `yes(); dismiss-toast();` pair killed that sentence in the same event, so the user
            // pressed Yes and saw nothing at all. The obvious repair — swapping the two calls — is
            // WRONG here: `dismiss-toast` is one of F-P5's teardown sites now, so dismissing first
            // clears the arming flag and the captured subject that `bulk-rate-yes` gates on, and
            // [Yes] becomes a no-op. The handler therefore takes its capture, performs the
            // dismissal itself, and only then applies and re-raises. One transaction, one owner.
            if root.toast-bulk-ask && toastcard.hot : HorizontalLayout {
                alignment: end;
                spacing: Theme.space-2;
                PillBtn { text: @tr("falcon" => "Yes"); clicked => { root.bulk-rate-yes(); } }
                PillBtn { text: @tr("falcon" => "No"); clicked => { root.bulk-rate-no(); root.dismiss-toast(); } }
            }
            if root.toast-settings && toastcard.hot : HorizontalLayout {
                alignment: end;
                PillBtn { text: @tr("falcon" => "Open Settings"); clicked => {
                    root.welcome-open = false;
                    root.panel-switch = root.loading-open || root.sel-open;
                    root.settings-open = true; root.loading-open = false; root.sel-open = false;
                    root.dismiss-toast();
                } }
            }
            }
            }
            // The [Yes][No] words, measured for `ask-row-need` whether or not the question is on
            // the card (the row itself is mount-gated, so it cannot be read from out here). Same
            // text style as `PillBtn`'s label; never drawn.
            tyesm := Text { visible: false; text: @tr("falcon" => "Yes"); font-size: Theme.font-sm; font-weight: 600; }
            tnom := Text { visible: false; text: @tr("falcon" => "No"); font-size: Theme.font-sm; font-weight: 600; }
        }

        // Events dropdown PANEL (bell click) — a scrollable list of recent notifications. Reuses the
        // shared GlassPanel (blurred backdrop + tint + shadow) like every other panel, at the standard
        // 3px edge margin + 44px title-bar offset used by the window-rooted sheets.
        if root.notif-open : Rectangle {
            y: root.content-top;
            height: parent.height - self.y;
            width: 100%;
            TouchArea { clicked => { root.notif-open = false; } } // click-away to close
            evpanel := GlassPanel {
                // v0.7.1: the 3px edge/title-bar gap rule (was 18px/8px ad-hoc margins).
                width: 360px; height: min(parent.height - 3px - 3px, 440px);
                x: parent.width - self.width - 3px; y: 3px;
                backdrop: root.blur-backdrop; sw: root.content-w; sh: root.content-h; ox: 0px; oy: 0px;
                TouchArea {} // swallow clicks inside the panel
                VerticalLayout {
                    // v0.8.44 (G7): outer padding = the panel standard space-5 (20px) — the old space-4
                    // comment claimed parity with Selection/Export, but those sit at space-5 — and the
                    // header is the real PanelHeader (canonical drawn dismiss X; this was the ONLY
                    // panel without one). The Undo/Clear pills ride the header's @children slot.
                    padding: Theme.space-5; spacing: Theme.space-3;
                    PanelHeader {
                        title: @tr("falcon" => "Events");
                        dismiss => { root.notif-open = false; }
                        // ── v0.8.186 (U2): THE HEADER COLLAPSES, AND THE 6px OVERRIDE GOES BACK. ──
                        // v0.8.184 spent 10px of gap (`Theme.space-2` 8 → `Theme.space-1h` 6, five
                        // gaps) to fit SIX cells — title · Undo · Redo · Undo move · Clear · X — at
                        // 317 of 320, a 3px budget it pinned with a rig row. The owner's unified
                        // design retires the separate "Undo move" pill: one button, one chord, a
                        // label that follows the context. That returns the whole 76px cell, so this
                        // instance goes back to the INHERITED standard gap and the round spends the
                        // slack on the divider the owner asked for instead ("Implement the divider
                        // line (as now there should be sufficient space for it)").
                        //
                        // THE ARITHMETIC, re-measured by the same rig row in the new WIDEST state —
                        // the one where the label reads "Undo move" (`cull-undo-label`), which is
                        // now a state of the Undo pill rather than a sixth cell:
                        //
                        //   title "Events" 50 · Undo move 76 · Redo 44 · divider 1 · Clear 44 · X 28
                        //     + five gaps × 8px = 40  ⇒  **283** vs 320, **37px of slack**
                        //
                        // v0.8.184 shipped 317/320 with three. The divider costs 9 of the 34 the
                        // collapse returned (its 1px cell plus the gap it adds), and the rest is
                        // headroom the next label can grow into instead of clipping. The spacing
                        // line is DELETED, not set: the header inherits `PanelHeader`'s own
                        // `Theme.space-2`, so there is no instance override left to drift.
                        //
                        // ── v0.8.184 (D1, OWNER RULING): CULL HISTORY ON THE EVENTS HEADER. ──────
                        // The panel that already carries every OTHER reversal ("Undo move",
                        // "Recover") gains the one the keyboard has owned alone since v0.3.x.
                        // UNCONDITIONALLY MOUNTED and enabled-gated (never `if`-gated) for two
                        // reasons: a pair that appeared and vanished would reflow the header under
                        // the pointer, and the WIDEST STATE has to be a fixed, measurable row.
                        // v0.8.186 keeps that discipline through the collapse: the pill's LABEL
                        // changes, the cell never unmounts, and the widest label is the measured
                        // state.
                        //
                        // THE PANEL STAYS OPEN, and each arm INVOKES ONLY (L39): the jump to the
                        // reverted shot happens behind it, which is the feature, and `on_undo`'s
                        // grouped arms raise a card sentence that a dismissal in the same event
                        // would destroy.
                        //
                        // THE RIM (U3) is persistent while the pill is armed — the owner ruled
                        // "Persistent blue rim" — and it is the SAME accent the matched event row
                        // wears, which is the whole point of the cue: the button and the row it
                        // would reverse are visibly one thing.
                        VerticalLayout {
                            alignment: center;
                            // Language packs (round 2): `cull-undo-label` is an English id (the
                            // context menus compare it too); only the words drawn are translated.
                            evundo := PillBtn { text: root.cull-undo-label == "Undo move" ? @tr("falcon" => "Undo move") : @tr("falcon" => "Undo");
                                                enabled: root.can-cull-undo;
                                                rim: root.can-cull-undo ? 1 : 0;
                                                clicked => { root.undo(); } }
                        }
                        VerticalLayout {
                            alignment: center;
                            evredo := PillBtn { text: @tr("falcon" => "Redo"); enabled: root.can-cull-redo;
                                                rim: root.can-cull-redo ? 3 : 0;
                                                clicked => { root.redo(); } }
                        }
                        // ── v0.8.186 (U2, OWNER RULING D19): THE DIVIDER ─────────────────────────
                        // It separates the REVERSAL family (Undo · Redo) from the destructive Clear,
                        // which wipes the whole log and is the one control here that cannot be taken
                        // back. `Theme.divider` at 1px is the app's rule weight — the same hairline
                        // the menu separator and the compare bar's two dividers draw.
                        // v0.8.191 (H6): …and that sentence is TRUE IN THE RENDERING now, where it
                        // used to be true only in the bytes. Those three sites shared a token and a
                        // nominal weight while drawing at different device weights, because an
                        // AA-off fill's coverage is decided by where its 1.5 device px land and each
                        // of them lands somewhere else. ONE component draws all of them now.
                        //
                        // 20px TALL, NOT THE ~18 THE SPEC SKETCHED, AND THAT IS AN L41 DECISION: the
                        // row is `Theme.hit-primary` 28px, so a centred bar sits at (28 − h) / 2 —
                        // h = 18 gives y = 5, which at the owner's 150% scale is device y 7.5 and
                        // straddles a pixel row at BOTH ends, the MinimizeIcon defect exactly. Only
                        // h ≡ 0 (mod 4) keeps the origin even: h = 20 → y = 4 → device 6 / 30, both
                        // integers, and 20 sits 2px inside the 24px pills either side of it, which
                        // is the inset a rule should have.
                        // v0.8.191 (H6): the shared `AaHairline`, vertical. The ID STAYS ON THE SLOT,
                        // so the existing header-fit pins (which read this element's 1 × 20 box and its
                        // centring) measure exactly what they measured before; only the ink changed.
                        evdiv := AaHairline {
                            width: 1px; height: 20px; y: (parent.height - self.height) / 2;
                            vertical: true; tint: Theme.divider;
                        }
                        VerticalLayout {
                            alignment: center;
                            evclear := PillBtn { text: @tr("falcon" => "Clear"); enabled: root.notif-model.length > 0; clicked => { root.notif-clear(); } }
                        }
                    }
                    // v0.8.186 (fix wave, review finding 1): …AND ONLY WHILE THERE IS NOTHING TO
                    // SAY AT ALL. The empty-state line used to gate on the MODEL alone, so a fresh
                    // folder where the photographer had just flagged a photo rendered "No recent
                    // events." directly above "● Flagged — HWU_1234" — the panel contradicting
                    // itself, in the owner's own headline case (the whole point of the pinned row is
                    // the act that raises no event, which is exactly the state with an empty model).
                    // The two sentences are mutually exclusive now, by construction.
                    if root.notif-model.length == 0 && root.last-act-text == "" : notifempty := Text {
                        text: @tr("falcon" => "No recent events."); color: Theme.text-mute; font-size: Theme.font-sm;
                    }
                    // ── v0.8.186 (U4, OWNER RULING): THE PINNED LAST-ACTION ROW ──────────────────
                    // "add a temporary row describing the last action (which is for things that
                    // does not trigger a notification - like flagged HWU_1234) … plus a blue circle
                    // indicator before the start of the sentence to indicate it is the one to be
                    // undone", and "keep it simple and minimalistic".
                    //
                    // It sits ABOVE the Flickable and OUTSIDE the model, which is what gives it the
                    // four properties the ruling implies for free: it is not an event, so Clear does
                    // not touch it, the bell does not count it, nothing persists it, and there is
                    // always exactly ONE (it is a property, not a list). It YIELDS to a real row —
                    // Rust publishes "" the moment a live row carries the same act stamp, and that
                    // row takes the accent rim instead, so the cue never appears twice.
                    //
                    // HEIGHT-BOUNDED BY CONSTRUCTION (L4 / the v0.8.3 absorber rule): one line,
                    // `overflow: elide`, no wrap, so `notifflick` stays this column's ONE unbounded
                    // stretch-1 element and this row can never absorb the panel.
                    //
                    // ── THE TIER (v0.8.186 fix wave, review finding 2 / lens) ─────────────────
                    // `font-body`, not `font-sm`. The first draft put this sentence at the
                    // TIMESTAMP tier — the ramp the rows beneath use for "2m ago" — which is the one
                    // ramp it must not be at: this is the sentence the whole feature exists to be
                    // read, and it was set one step smaller than the event text it stands in for.
                    // It stays minimal through COLOUR (`text-dim`, the secondary step, against the
                    // rows' `text`), which is the house way of saying "quieter, not smaller" and is
                    // also L9's rule — the description ramp is the floor for readable text.
                    //
                    // ── THE COLUMN (same finding) ──────────────────────────────────────
                    // `padding-left: Theme.space-3` is what makes the dot COLUMN-ALIGN with the dots
                    // beneath it. The event rows are `Rectangle { nrow := HorizontalLayout { padding:
                    // Theme.space-3 … } }`, so every sibling dot sits at (row x + 12); this row is a
                    // direct child of the same column, so with no padding its dot sat 12px to the
                    // LEFT of all of them — under a comment claiming sibling parity. The right
                    // padding is deliberately NOT added: the sentence elides at the panel edge and
                    // has no dismiss × to clear, unlike the rows.
                    //
                    // ── THE CIRCLE, AND ITS ARITHMETIC RE-DERIVED FOR *THIS* HOST (same finding) ──
                    // 8px square, radius 4, `Theme.accent` — the events rows' own severity-dot
                    // grammar, because it means the same thing they do (this row is about THAT act).
                    // What it does NOT inherit is their `y: 5px`. That 5 is an optical drop onto the
                    // FIRST LINE of a wrapping `font-body` block inside a 12px-padded card; this row
                    // is a single elided line in an unpadded column, and 5px in its line box put the
                    // dot flush against the bottom of it (the row measured 13px at the old font-sm:
                    // 5 + 8 = 13). The y is DERIVED from the host it actually has, with the L41 floor
                    // idiom `MinimizeIcon` uses, so it stays integer whatever the ramp's metrics do:
                    //
                    //   MEASURED at Theme.font-body (rig `the_pinned_last_action_row…`): the row's
                    //   line box is 15px  ⇒  (15 − 8) / 2 = 3.5  →  floored to 3px.
                    //
                    // INTEGER, NOT EVEN, AND THAT IS THE CORRECT L41 READING FOR THIS MARK — stated
                    // because the divider eight lines up took the opposite treatment and a reader
                    // deserves to know why. L41's even rule protects the TANGENT POINTS where an arc
                    // meets a straight axis-aligned edge, and the straight edges either side of them:
                    // that is what makes a 1px RULE at a half-pixel y read thinner on one panel than
                    // another. This mark is a FULL CIRCLE (border-radius 4 on an 8px square), so it
                    // has no axis-aligned edge anywhere on its outline — every pixel of it is
                    // antialiased whatever y it lands on, at any scale. The floor is what matters,
                    // and it is what the sibling dots effectively get from their own fixed 5px.
                    // (Forcing an even offset would need an explicit even ROW height, which would
                    // clip the line on any machine whose metrics run taller than this one's 15px —
                    // trading a real robustness for a difference no eye can see on a round mark.)
                    if root.last-act-text != "" : lastact := HorizontalLayout {
                        spacing: Theme.space-2;
                        padding-left: Theme.space-3;
                        lastactdot := Rectangle {
                            width: 8px; height: 8px; border-radius: 4px;
                            y: Math.floor((parent.height - self.height) / 2 / 1px) * 1px;
                            background: Theme.accent;
                        }
                        lastacttext := Text {
                            text: root.last-act-text; color: Theme.text-dim; font-size: Theme.font-body;
                            horizontal-stretch: 1; overflow: elide; vertical-alignment: center;
                        }
                    }
                    notifflick := Flickable {
                        vertical-stretch: 1;
                        max-height: 100000px; // stretch-class absorber (v0.8.3 rule): keep this the one unbounded stretch-1 element so the empty-state Text can't absorb surplus
                        viewport-height: notiflist.preferred-height;
                        notiflist := VerticalLayout {
                            spacing: Theme.space-2; // standard intra-group gap (v0.7.1; was 4px)
                            for row[i] in root.notif-model : Rectangle {
                                height: nrow.preferred-height + 12px;
                                background: Theme.block; border-radius: Theme.radius-sm;
                                // ── v0.8.186 (U3, OWNER RULING): THE LINKAGE RIM ─────────────────
                                // The row the Undo button would reverse wears the SAME accent rim
                                // the button does; the row Redo would re-apply wears the light one.
                                // Both indices are published by ONE Rust derivation from the act
                                // stamp (L44) — this row asks only "is that me?", so no per-row
                                // state exists to go stale, and the rims move together by
                                // construction. Same 1px weight as every other rim in the app, so
                                // the pair reads as one system in two colours.
                                border-width: (i == root.undo-target-row || i == root.redo-target-row) ? 1px : 0px;
                                border-color: i == root.undo-target-row ? Theme.accent : Theme.border-lift;
                                nrow := HorizontalLayout {
                                    padding: Theme.space-3; spacing: Theme.space-2; // settings-card 12px inset (v0.7.1)
                                    nrowdot := Rectangle {
                                        width: 8px; height: 8px; border-radius: 4px; y: 5px;
                                        background: row.kind == 3 ? Theme.danger : row.kind == 2 ? Theme.warn
                                                  : row.kind == 1 ? Theme.accent : Theme.text-mute;
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1; spacing: 2px;
                                        Text { text: row.text; color: Theme.text; font-size: Theme.font-body; wrap: word-wrap; }
                                        Text { text: row.when; color: Theme.text-mute; font-size: Theme.font-sm; }
                                    }
                                    // inline Undo for a still-reversible "Move rejected" (brought back per-row)
                                    // Each event ROW is a block card; its pills use the standard dark well.
                                    if row.undoable && root.can-undo-move : VerticalLayout {
                                        alignment: center;
                                        PillBtn { text: @tr("falcon" => "Undo"); clicked => { root.undo-move(); } }
                                    }
                                    // D2: a persisted Resume — the toast is transient, so the resume ask
                                    // must be actionable from the events panel too (the toast's twin).
                                    if row.jump-to >= 0 : VerticalLayout {
                                        alignment: center;
                                        PillBtn { text: @tr("falcon" => "Resume"); clicked => { root.sel-jump(row.jump-to); root.notif-open = false; } }
                                    }
                                    if row.reveal-path != "" : VerticalLayout {
                                        alignment: center;
                                        PillBtn { text: @tr("falcon" => "Show"); clicked => { root.reveal-path(row.reveal-path); } }
                                    }
                                    // v0.8.120 (design-sweep O5): the delete result's persisted
                                    // Recover — the D2 Resume-twin pattern, applied to the one op
                                    // result that never reached this panel at all. The delete used
                                    // to publish itself by writing the toast properties DIRECTLY, so
                                    // ANY later notification (a save-failure warning, a finished
                                    // background copy, the unapplied-rotations notice) replaced the
                                    // text AND cleared `toast_recover` — and because the delete was
                                    // never logged, the bell badge and this list showed no trace of
                                    // it: the ~30 s recovery window closed silently. `can-recover` is
                                    // the live gate (record still held, still the same folder), so
                                    // the pill disappears the moment a recovery would be wrong
                                    // rather than firing a refusal.
                                    if row.recover && root.can-recover : VerticalLayout {
                                        alignment: center;
                                        PillBtn { text: @tr("falcon" => "Recover"); clicked => { root.recover-delete(); } }
                                    }
                                    // v0.8.121 (Round-B fix F19 = audit Y16): the colour-profile
                                    // failure's own route, persisted. It was the last toast action
                                    // with no row twin, on the notice whose loss costs a whole
                                    // session culled in the wrong profile. Same body as the toast's
                                    // pill — the gear button's flip sequence — so the sheet lands
                                    // exactly as it does from the title bar. No live gate: Settings
                                    // is always openable, so this pill cannot go stale.
                                    if row.open-settings : VerticalLayout {
                                        alignment: center;
                                        PillBtn { text: @tr("falcon" => "Open Settings"); clicked => {
                                            root.welcome-open = false;
                                            root.panel-switch = root.loading-open || root.sel-open;
                                            root.settings-open = true; root.loading-open = false; root.sel-open = false;
                                            root.notif-open = false;
                                        } }
                                    }
                                    // per-row × dismiss, pinned to the top-right corner — matches the toast's ×
                                    // so a single notification can be cleared without wiping the whole log.
                                    VerticalLayout {
                                        alignment: start;
                                        Rectangle {
                                            width: 26px; height: 26px; border-radius: Theme.radius-sm; // standard dismiss square (v0.7.1)
                                            background: ndxta.has-hover ? Theme.hover : transparent;
                                            // v0.8.44 (G7): canonical drawn X — matches the toast's (one X everywhere)
                                            CloseGlyph { width: 11px; height: 11px;
                                                         x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                                            ndxta := TouchArea { clicked => { root.notif-dismiss(i); } }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                // v0.8.65 (C3, owner rule): panel-bottom fade over the events list (the Settings /
                // Selection panels' sibling — same scaffold, same hard clip). Pure paint, id-sized.
                PanelBottomFade {
                    x: notifflick.x; width: notifflick.width;
                    y: notifflick.y + notifflick.height - self.height;
                    more: notifflick.viewport-height + notifflick.viewport-y > notifflick.height + 1px;
                }
            }
        }

        // ── confirm overlay for the copy/move/export file operations (modal) ──
        if root.confirm-kind != 0 : Rectangle {
            y: root.content-top;
            height: parent.height - self.y;
            width: 100%;
            background: Theme.scrim;
            TouchArea {} // block everything behind (title bar stays live above)
            SolidPanel {
                // v0.8.187 (W1 ii): kind 8 takes kind 6's 480px, for kind 6's reason — it is the
                // other THREE-button row in this family, and the L5 audit is against this number.
                // Language packs (round 2, owner request, 4 October): the copy sheet's three content
                // choices are fixed thirds of its control row. With Settings → Developer → Widen
                // controls to fit text on, the copy sheet (kind 1) grows until every third holds its
                // widest word plus Theme.space-3 a side (OptionChip's label inset), capped at the window
                // less 8px a side, the context menus' rule; never below today's width. Off: exactly
                // today's widths. English never moves (its widest choice needs 347px of 392px).
                width: max((root.confirm-kind == 6 || root.confirm-kind == 8) ? 480px : 392px,
                           Theme.fit-text && root.confirm-kind == 1
                               ? min(2 * Theme.space-4 + 3px + 3 * (max(cfm0.preferred-width, max(cfm1.preferred-width, cfm2.preferred-width)) + 2 * Theme.space-3 + 3px), root.width - 16px)
                               : 0px);
                height: cfbox.preferred-height;
                x: (parent.width - self.width) / 2;
                // v0.8.46 (Item 2): device-pixel snap. Centring on a preferred-height that carries
                // fractional TEXT metrics parks the footer ActionBtns' 1px borders on fractional
                // device y — at 150% the 1.5-device-px stroke then splits ASYMMETRICALLY across two
                // pixel rows (thin-top/thick-bottom, owner report), while bottom-anchored sites (the
                // Selection footer's "Export for web") inherit the physically-integer window bottom and
                // rasterize mirror-symmetric. The button row is bottom-anchored here too (last child,
                // space-4 pad, 34px tall), so its top edge sits EXACTLY at panel-bottom − 50px: shift
                // the whole panel by the sub-pixel delta that lands that edge on an integer device
                // pixel (round(v·sf)/sf). |delta| ≤ 0.5px/sf — invisible. Rig: tipgeom_tests.rs.
                property <float> sfx: max(root.win-sf, 0.5);
                property <length> raw-y: (parent.height - self.height) / 2;
                property <length> btn-top: parent.y + self.raw-y + self.height - 50px;
                y: self.raw-y + Math.round(self.btn-top / 1px * self.sfx) / self.sfx * 1px - self.btn-top;
                cfbox := VerticalLayout {
                    padding: Theme.space-4; spacing: Theme.space-3;
                    // count headline: a standalone number (no int→string concat) + a static label.
                    HorizontalLayout {
                        spacing: Theme.space-2;
                        // v0.8.119 (design-sweep Y45): kind 3 JOINS the count grammar. It was the one
                        // destructive confirm with no magnitude — on the op with the widest reach —
                        // because the ./Rejected probe deliberately returned a bool, so a
                        // photographer who had been culling for weeks was asked to confirm without
                        // being told whether it was 8 files or 800, while the far smaller "12
                        // rejects → move to ./Rejected" right above it leads with a big red 12.
                        // Danger-coloured like its kind-2 sibling. Kind 6 keeps no count: delete-body
                        // names the exact file(s), so its magnitude is already explicit.
                        if root.confirm-kind != 6 : Text {
                               text: root.confirm-kind == 8 ? root.web-collide-count : (root.confirm-kind == 2 ? root.count-rejects : (root.confirm-kind == 3 ? root.count-bin : (root.confirm-kind == 7 ? root.count-rated : ((root.confirm-kind == 4 || root.confirm-kind == 5) ? root.count-rotated : root.count-out-col1)))); // v0.8.130 (W2-1): kind 1 leads with the REAL target count, not the whole folder's picks
                               // v0.8.187 (W1 ii): kind 8 is WARN, not danger and not accent — the
                               // number is neither a destruction nor a deliverable, it is a
                               // condition the user did not ask for (the same reading the
                               // include-rejects row's warn colour carries).
                               color: root.confirm-kind == 8 ? Theme.warn : ((root.confirm-kind == 2 || root.confirm-kind == 3) ? Theme.danger : ((root.confirm-kind == 4 || root.confirm-kind == 5) ? Theme.text : Theme.accent));
                               font-size: Theme.display-md; font-weight: 700; vertical-alignment: center; }
                        Text { text: root.confirm-kind == 8 ? root.web-collide-title
                                   : root.confirm-kind == 1 ? root.out-confirm-title
                                   : root.confirm-kind == 3 ? root.empty-confirm-title
                                   : root.confirm-kind == 6 ? root.delete-title
                                   : root.confirm-kind == 7 ? @tr("falcon" => "rated photo → write XMP sidecar" | "rated photos → write XMP sidecars" % root.count-rated)
                                   : root.confirm-kind == 4 ? @tr("falcon" => "manual rotation → discard" | "manual rotations → discard" % root.count-rotated)
                                   : root.confirm-kind == 5 ? @tr("falcon" => "rotation → write to photos" | "rotations → write to photos" % root.count-rotated)
                                   // Language packs (round 2): English keeps "rejects" for every count.
                                   : @tr("falcon" => "rejects → move to ./Rejected" | "rejects → move to ./Rejected" % root.count-rejects);
                               color: Theme.text; font-size: Theme.font-lg; font-weight: 600;
                               vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
                    }
                    confirmbody := Text {
                        // v0.8.187 (X8): the SAFETY sentence states what the user stands to lose, not
                        // how carefully the bytes are written. "The write is atomic" answered a
                        // question nobody in this dialog is asking and read as reassurance about the
                        // very thing that needs a warning: an overwritten deliverable does NOT go to
                        // the Recycle Bin, because it is replaced in place rather than deleted. The
                        // atomicity is true and is still worth a clause, subordinated to the fact.
                        // The escape route the modal's own advice points at is named LAST, which is
                        // why Cancel returns to the sheet that carries it (X13).
                        text: root.confirm-kind == 8 ? root.overwrite-confirm-body
                            : root.confirm-kind == 6 ? root.delete-body
                            : root.confirm-kind == 7 ? @tr("falcon" => "Writes an .xmp sidecar beside each rated photo so Lightroom, Bridge and others can read the star rating. Existing sidecars are updated in place; unrated photos are skipped; the image files are never changed. Previously written ratings for now-unrated photos are cleared to 0. Turning sync off later leaves these sidecars untouched.")
                            : root.confirm-kind == 3 ? root.empty-confirm-body
                            // v0.8.194 HOTFIX (§1F, OWNER): "RAW + image", not "RAW + JPG" — the
                            // move takes `Shot::jpg`, the FINISHED-image slot of whatever format
                            // the folder holds (support::export_marked's `CopyContent::Both` arm
                            // is `[s.jpg, s.raw]`, with no extension test anywhere on the path).
                            : root.confirm-kind == 2 ? @tr("falcon" => "Moves the RAW + image out of the folder — reversible (they go to ./Rejected, not the bin).")
                            : root.confirm-kind == 4 ? @tr("falcon" => "Removes the manual rotations recorded for this folder — image files are untouched.")
                            : root.confirm-kind == 5 ? @tr("falcon" => "Writes the rotation into each photo's EXIF (JPGs) or an XMP sidecar (RAW) — pixels untouched, timestamps update.")
                            // v0.8.130 (W2-1): counted, and it names the destination — the
                            // three copy-content captions moved into the Rust composer with it
                            // (support::out_confirm_body), which is where the count has to live.
                            : root.out-confirm-body;
                        color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap;
                    }
                    // copy-content choice — only for picks (the editing-handoff direction). The
                    // photographer often wants only the RAW; Move-rejects always takes both files.
                    // v0.8.194 HOTFIX (§1F, OWNER): the segments name the SLOT. "Image only" rather
                    // than the §33 list's "Image only (non-RAW)" — a Seg segment is a fixed-width
                    // third of the sheet's control row and the parenthetical does not fit one,
                    // while the body text directly above it now says "just the image" and carries
                    // the meaning in full. The two surfaces therefore diverge by a parenthetical;
                    // that divergence is deliberate and is on the veto list.
                    if root.confirm-kind == 1 : Seg {
                        opts: [@tr("falcon" => "RAW + image"), @tr("falcon" => "RAW only"), @tr("falcon" => "Image only")];
                        sel: root.copy-content;
                        changed(i) => { root.copy-content = i; }
                    }
                    // v0.8.132 (OQ1, owner-ruled 08-03): THE REJECTED-PHOTOGRAPHS ROW. Mount-gated on
                    // there being any in the target set (L4 — never a permanently-present control
                    // that says "0"), warning-yellow because it reports a state the user did not ask
                    // for, and it sits ABOVE the two advisories on purpose: those describe the copy,
                    // this one CHANGES it, and the count in the headline above already follows it.
                    // queue 34 (§1.B, ledger L26): THE ROW IS THE SHARED `ToggleRow` NOW, on BOTH
                    // surfaces that ask this question — the export sheet's twin moved in the same
                    // commit. "One question, asked identically on both surfaces" has to mean one
                    // COMPONENT, or the two drift the next time either is styled; they already had,
                    // at 32 px and `font-sm` against Settings' 44 px and `font-body`. STANDALONE
                    // here (`bg: Theme.block`) rather than in a group, because on this sheet it is a
                    // lone toggle among captions — `ToggleRow`'s own rule: groups for related rows,
                    // standalone cards for lone toggles. The warn colour rides the component's new
                    // `label-color`; the mount gate is unchanged.
                    // queue 36 (§1.E, ledger L26 — ANSWERED, NOT SKIPPED): the RAW-only question
                    // this round adds to the export sheet gets NO TWIN HERE, and the reason is that
                    // the question does not arise on this path. OQ1's parity rule is about one
                    // QUESTION being asked identically on both surfaces; the copy path copies the
                    // RAW FILE ITSELF (the Seg above offers "RAW + image" / "RAW only" / "Image
                    // only"), so a RAW-only pick is already copied whole and there is no embedded
                    // preview to opt into. Asking it here would be a control that changes nothing.
                    if root.confirm-kind == 1 && root.out-reject-count > 0 : ToggleRow {
                        bg: Theme.block;
                        label: root.out-include-label; label-color: Theme.warn;
                        on: root.include-rejects;
                        toggled => { root.include-rejects = !root.include-rejects; }
                    }
                    // v0.8.22 RIDER: informational line — ONLY for Copy-selected (kind 1) and ONLY when
                    // some included pick still carries an unapplied rotation (copy-rot-notice non-empty,
                    // composed Rust-side). No blocking, no new dialog; the copy proceeds if confirmed.
                    if root.confirm-kind == 1 && root.copy-rot-notice != "" : Text {
                        text: root.copy-rot-notice;
                        color: Theme.warn; font-size: Theme.font-sm; wrap: word-wrap;
                    }
                    // v0.8.24 (D4): pre-op download advisory — Copy-selected (kind 1) / Move-rejected
                    // (kind 2) when the op's file set includes cloud-only (OneDrive not-downloaded) files
                    // (Rust-composed; empty = hidden). Informational, not blocking; the op proceeds if confirmed.
                    if root.confirm-kind == 1 && root.copy-cloud-notice != "" : Text {
                        text: root.copy-cloud-notice;
                        color: Theme.warn; font-size: Theme.font-sm; wrap: word-wrap;
                    }
                    if root.confirm-kind == 2 && root.move-cloud-notice != "" : Text {
                        text: root.move-cloud-notice;
                        color: Theme.warn; font-size: Theme.font-sm; wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: Theme.space-2;
                        // v0.8.187 (W1 ii): kind 8's Cancel also DROPS THE PARKED RUN — the modal is
                        // the only surface holding a resolved export, so its dismissal has to say so
                        // rather than leaving one parked. Every other kind's Cancel is unchanged.
                        //
                        // v0.8.187 (X13): …AND IT RETURNS TO THE EXPORT SHEET. Cancel here means
                        // "take me back", not "abandon what I was doing": the body's own advice
                        // ("turn on Append the preset name…") points at a control on that sheet, and
                        // the sheet closed itself on the way into this modal. Dropping the user onto
                        // the bare stage would make the advice unfollowable without re-navigating,
                        // which is the one thing a dialog that gives instructions must not do.
                        cfcancel := ActionBtn { label: @tr("falcon" => "Cancel"); variant: 2; clicked => { if (root.confirm-kind == 8) { root.export-collide-cancel(); root.export-open = true; } root.confirm-kind = 0; } } // v0.8.38 (G5): quiet ghost (Enter still cancels kinds 2-6; the target ring was owner-revoked, v0.8.46)
                        // v0.8.13: the third, mount-gated MIDDLE button — the safe alternative to deleting.
                        // MOUNT-gated (`if kind == 6`, not merely disabled) so it can't swallow clicks in the
                        // other kinds. v0.8.15 (F3): now routes through delete-flag-reject() — the SAME folder-
                        // scoped identity check as delete-recycle, then SETS reject on the VERIFIED index (idempotent).
                        if root.confirm-kind == 6 : ActionBtn {
                            label: @tr("falcon" => "Mark as rejected"); variant: 0;
                            clicked => { root.delete-flag-reject(); } // v0.8.15 (F3): gated Rust reject on the VERIFIED index, not the raw current-shot set-reject
                        }
                        // v0.8.187 (W1 ii): the THIRD arm of the collision question, mount-gated on
                        // its own kind exactly like the delete popup's — never merely disabled, so
                        // it cannot swallow a click in any other kind. It is the SAFE alternative
                        // (nothing on disk changes), so it takes the quiet non-primary treatment
                        // and leaves the solid fill to the consequential Overwrite beside it.
                        if root.confirm-kind == 8 : ecskip := ActionBtn {
                            label: @tr("falcon" => "Skip existing"); variant: 0;
                            clicked => { root.confirm-kind = 0; root.export-collide-skip(); }
                        }
                        cfprimary := ActionBtn {
                            label: root.confirm-kind == 2 ? @tr("falcon" => "Move rejects") : root.confirm-kind == 3 ? root.empty-confirm-label : root.confirm-kind == 4 ? @tr("falcon" => "Discard rotations") : root.confirm-kind == 5 ? @tr("falcon" => "Apply rotations") : root.confirm-kind == 6 ? root.delete-confirm-label : root.confirm-kind == 7 ? @tr("falcon" => "Write sidecars") : root.confirm-kind == 8 ? @tr("falcon" => "Overwrite") : @tr("falcon" => "Copy picks");
                            // v0.8.187 (W1 ii): kind 8's Overwrite is WARN (variant 3), the tier the
                            // rotation pair already uses — it replaces a deliverable Falcon itself
                            // wrote and can re-render, which is not the danger tier that Move /
                            // Empty / Delete occupy, and not the safe accent either.
                            variant: (root.confirm-kind == 1 || root.confirm-kind == 7) ? 0 : ((root.confirm-kind == 4 || root.confirm-kind == 5 || root.confirm-kind == 8) ? 3 : 1);
                            // v0.8.132 (OQ1 rule 2 / L15): a Reviewed view holding nothing but
                            // rejects, with the toggle off, has NOTHING to copy — say so in the
                            // control instead of accepting a press that copies zero files and
                            // reports it as a success. Every other kind keeps its unconditional
                            // enablement (their counts are gated at the button that opens them).
                            enabled: root.confirm-kind != 1 || root.count-out-col1 > 0;
                            primary: true; // v0.8.38 (G5): ONE ladder — the consequential action OWNS its severity colour prominently (Copy=accent solid; Move/Empty/Delete=danger solid; Discard/Apply=warn solid). Cancel = quiet ghost. v0.8.69 (E): the XMP backfill (kind 7) is a safe constructive write → accent, like Copy.
                            // Enter confirms ONLY the safe copy (kind 1); every other kind's Enter cancels (incl. kind 7 — the backfill is two-button by design, never a single keypress). G5 target ring owner-revoked, v0.8.46.
                            clicked => {
                                if (root.confirm-kind == 1) { root.copy-picks(root.copy-content); }
                                if (root.confirm-kind == 2) { root.move-rejects(); }
                                if (root.confirm-kind == 3) { root.empty-rejected(); }
                                if (root.confirm-kind == 4) { root.discard-rotations(); }
                                if (root.confirm-kind == 5) { root.apply-rotations(); }
                                if (root.confirm-kind == 6) { root.delete-recycle(); }
                                if (root.confirm-kind == 7) { root.xmp-backfill-confirm(); }
                                // v0.8.187 (W1 ii): the modal is the only surface holding the
                                // parked run, and its verb CONSUMES it — so this arm closes the
                                // modal itself rather than relying on `start_op`'s own clear,
                                // which does not run when another op is already busy. Last in
                                // the chain, so no later `if` reads the cleared kind.
                                if (root.confirm-kind == 8) { root.export-collide-overwrite(); root.confirm-kind = 0; }
                            }
                        }
                    }
                }
                // The three copy-content words, measured for the width rule above whether or not
                // their Seg is mounted (it is `if`-gated, so it cannot be read from out here). Same
                // text style as `Seg`'s labels; never drawn.
                cfm0 := Text { visible: false; text: @tr("falcon" => "RAW + image"); font-size: Theme.font-md; font-weight: 600; }
                cfm1 := Text { visible: false; text: @tr("falcon" => "RAW only"); font-size: Theme.font-md; font-weight: 600; }
                cfm2 := Text { visible: false; text: @tr("falcon" => "Image only"); font-size: Theme.font-md; font-weight: 600; }
            }
        }

        // ── unapplied-rotations close reminder (modal). Shown from on_close_requested when
        //    in-folder rotations are pending AND new since the last apply/acknowledge. Enter = Open
        //    Selection (safe default); Esc / Close-anyway resolve it (see the key handler + callbacks).
        if root.rot-reminder-open : Rectangle {
            y: root.content-top;
            height: parent.height - self.y;
            width: 100%;
            background: Theme.scrim;
            TouchArea {} // block everything behind (title bar stays live above)
            SolidPanel {
                width: 392px; height: rmbox.preferred-height;
                x: (parent.width - self.width) / 2;
                // v0.8.46 (Item 2): device-pixel snap — same bottom-anchored-footer arithmetic as the
                // confirm dialog above (button top edge = panel-bottom − 50px, onto an integer device px).
                property <float> sfx: max(root.win-sf, 0.5);
                property <length> raw-y: (parent.height - self.height) / 2;
                property <length> btn-top: parent.y + self.raw-y + self.height - 50px;
                y: self.raw-y + Math.round(self.btn-top / 1px * self.sfx) / self.sfx * 1px - self.btn-top;
                rmbox := VerticalLayout {
                    padding: Theme.space-4; spacing: Theme.space-3;
                    HorizontalLayout {
                        spacing: Theme.space-2;
                        Text { text: root.count-rotated; color: Theme.text; font-size: Theme.display-md;
                               font-weight: 700; vertical-alignment: center; }
                        // Language packs (round 2): beside the big count; English keeps "rotations" for every count.
                        Text { text: @tr("falcon" => "rotations not applied" | "rotations not applied" % root.count-rotated); color: Theme.text; font-size: Theme.font-lg;
                               font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
                    }
                    Text { text: @tr("falcon" => "Check them in the Review panel and Apply to write them into your photos — or close without applying.");
                        color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: Theme.space-2;
                        ActionBtn { label: @tr("falcon" => "Close anyway"); variant: 2; clicked => { root.reminder-close-anyway(); } }
                        rmopen := ActionBtn { label: @tr("falcon" => "Open Review"); variant: 0; primary: true; // Enter opens Selection (the safe default; the G5 target ring was owner-revoked, v0.8.46)
                            // v0.8.120 (design-sweep O25): scope the view this button PROMISES. A
                            // manual rotation matches the Selection filter's mode 4 only — the
                            // default mode 0 ("Reviewed") is `r >= 1 || flag || reject`, so a
                            // photographer who straightened five verticals and rated nothing was
                            // sent from "Review them in the Selection panel and Apply" straight to
                            // the big "Nothing reviewed yet." empty state. `sel-rating-filter` is
                            // cleared with it: a digit chip left lit from an earlier session would
                            // AND itself against the Rotated set and empty the grid again. The Enter
                            // arm on the same dialog runs the identical two lines (L26).
                            // v0.8.122 (M9): the SHARED open body (L26) — writing `sel-open`
                            // inline bypassed `open-sel-panel()`'s welcome-close and its top-left
                            // exclusivity, and was safe only as an emergent property of two other
                            // fixes. `rot-reminder-open` is cleared FIRST because it is a
                            // `modal-blocking` term the shared gate reads.
                            clicked => { root.set-filter(4); root.sel-rating-filter = -1; root.rot-reminder-open = false; root.open-sel-panel(); } }
                    }
                }
            }
        }

        // ── web-export sheet. Two modes: a simple PRESET LIST (pick + Export), and a PRESET
        //    EDITOR (all the controls + a live preview) reached via "+ New custom preset". With
        //    a preset saved, day-to-day export is just: pick a preset → Export. ──
        if root.export-open : exov := Rectangle {
            // Language packs (round 2, PLAN §5): the preset editor's two LABEL COLUMNS were sized for
            // the English words — 52 px on the left (Font, Colour, and the spacer under the font
            // warning) and 56 px on the right (Opacity, Size, Position, Format, Size, Quality,
            // Colour). With Settings → Developer → Widen controls to fit text on, each column takes
            // its widest label's width, never below today's, and every label in it shares that one
            // width so the controls still line up; off, exactly today's. One value expression per
            // column (L47), read by every label's `width`.
            property <length> lbl-left-w: max(52px, Theme.fit-text ? max(exmfont.preferred-width, exmcolour.preferred-width) : 0px);
            property <length> lbl-right-w: max(56px, Theme.fit-text ? max(max(exmopacity.preferred-width, exmsize.preferred-width), max(max(exmposition.preferred-width, exmformat.preferred-width), max(exmquality.preferred-width, exmcolour.preferred-width))) : 0px);
            y: root.content-top;
            height: parent.height - self.y;
            width: 100%;
            background: Theme.scrim;
            TouchArea {} // block everything behind (title bar stays live above)
            // The two columns' words in the labels' own text style, measured whether or not their
            // rows are mounted (the source and placement rows are mount-gated). Never seen
            // (transparent) and silent to accessibility; the rig reads them by id.
            exmfont := Text { text: @tr("falcon" => "Font"); color: transparent; accessible-role: none; font-size: Theme.font-md; }
            exmcolour := Text { text: @tr("falcon" => "Colour"); color: transparent; accessible-role: none; font-size: Theme.font-md; }
            exmopacity := Text { text: @tr("falcon" => "Opacity"); color: transparent; accessible-role: none; font-size: Theme.font-md; }
            exmsize := Text { text: @tr("falcon" => "Size"); color: transparent; accessible-role: none; font-size: Theme.font-md; }
            exmposition := Text { text: @tr("falcon" => "Position"); color: transparent; accessible-role: none; font-size: Theme.font-md; }
            exmformat := Text { text: @tr("falcon" => "Format"); color: transparent; accessible-role: none; font-size: Theme.font-md; }
            exmquality := Text { text: @tr("falcon" => "Quality"); color: transparent; accessible-role: none; font-size: Theme.font-md; }
            GlassPanel {
                // editor is two columns (wider, shorter so the Save/Cancel row stays on-screen in a
                // non-maximized window); the preset list stays narrow.
                // queue 34 (§1.A, OWNER): the LIST sheet goes 420 → 520. Its title
                // (`support::out_web_sentence`, `Theme.font-lg` / 600) sits beside a `display-md` /
                // 700 count, and at 420 it wrapped to TWO lines for every plural noun — the owner's
                // report, and the sentence he reads before a 300-file batch. 520 is MEASURED, not
                // eyeballed: `the_export_sheet_title_is_one_line_at_the_ruled_width` solves the
                // widest noun ("displayed photos") beside a four-digit count and pins ONE line with
                // the ruled 12 px of margin still in hand. The editor's 720 and the
                // `parent.width - 12px` clamp are untouched.
                width: min(root.export-mode == 1 ? 720px : 520px, parent.width - 12px);
                x: (parent.width - self.width) / 2;
                y: ((parent.height - self.height) / 2 > 0px ? (parent.height - self.height) / 2 : 0px) - (1.0 - root.export-eff) * 8px;
                height: min(expbox.preferred-height, parent.height - 6px);
                opacity: root.export-eff; // M5 enter-only fade+slide (modal sheet — always animates a fresh open; hits NOT gated)
                // The overlay itself starts at the stage top now, so panel y is stage-relative → oy 0
                // keeps the backdrop sample aligned (no seam).
                backdrop: root.blur-backdrop; sw: root.content-w; sh: root.content-h; ox: 0px; oy: 0px;
                TouchArea {}
                expbox := VerticalLayout {
                    padding: Theme.space-5; spacing: Theme.space-3;   // standard tier = 20px
                    HorizontalLayout {
                        spacing: Theme.space-2;
                        VerticalLayout {
                            horizontal-stretch: 1; spacing: Theme.space-1;
                            // W3c: the LIST mode heads with the copy-dialog grammar (big accent
                            // count + sentence + description) — the two sheets now read as one
                            // family (user request). The EDITOR keeps its form title.
                            if root.export-mode == 1 : Text {
                                text: @tr("falcon" => "Export preset");
                                color: Theme.text; font-size: Theme.title-size; font-weight: 600;
                            }
                            if root.export-mode == 0 : HorizontalLayout {
                                spacing: Theme.space-2;
                                // v0.8.131 (F-P7): the ADAPTING column's count and its noun — the
                                // same pair the Copy button beside it enables on, and the same set
                                // `on_export_web` actually walks. Reading `count-picks` here made
                                // the sheet contradict the button that opened it.
                                Text { text: root.count-out-col1; color: Theme.accent-web;
                                       font-size: Theme.display-md; font-weight: 700; vertical-alignment: center; }
                                expsent := Text { text: root.out-web-sentence;
                                       color: Theme.text; font-size: Theme.font-lg; font-weight: 600;
                                       vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
                            }
                        }
                        // v0.8.120 (design-sweep O10 / L18): from the EDITOR this X is a
                        // Cancel-equivalent (revert, then close) — enumerating every exit path and
                        // giving each one of exactly two semantics. From the LIST it is the plain
                        // close it always was.
                        // v0.8.143 (C2): the shared `CloseGlyph` at the canonical 16-in-28, replacing
                        // an inline copy of its exact four coordinates drawn at 12px. TWO defects in
                        // one line: a fourth private duplicate of the app's most repeated glyph, and
                        // 12-in-a-16-viewbox is 8 units of ink over a 0.75 scale — the mark landed at
                        // logical 11..17, which at the owner's 150 % is device 16.5..25.5, a HALF
                        // device pixel at both ends for the AA to smear (L41). 16px is the only size
                        // the arithmetic allows: the ink is even-symmetric about the 14px centre, so
                        // it lands whole at every scale, and (28 − 16) / 2 = 6 exactly.
                        IconBtn { width: 28px; height: 28px; clicked => { if (root.export-mode == 1) { root.export-editor-cancel(); } root.export-open = false; }
                            CloseGlyph {
                                x: (parent.width - 16px) / 2; y: (parent.height - 16px) / 2;
                                width: 16px; height: 16px;
                            }
                        }
                    }

                    // ── queue 34 (§1.A, OWNER): EVERYTHING THAT IS NOT THE HEADER LEFT THE HEADER. ──
                    //    The description, the font warning, both run-scoped toggles and the filename
                    //    example all lived INSIDE the header's title column — the `horizontal-stretch: 1`
                    //    VerticalLayout that shares its row with the 28 px close button and its `space-2`
                    //    gap. So every one of them stopped 36 px short of the sheet's inner right edge
                    //    while the preset cards, the rule and the Cancel/Export row below used the full
                    //    width: that 36 px is exactly what the two vertical red lines on the owner's
                    //    screenshot measure. They are `expbox` children now, at the sheet's full inner
                    //    width, and the header row is [count · sentence] · X and nothing else.
                    if root.export-mode == 0 : VerticalLayout {
                        spacing: Theme.space-1; // warning + description read as one paragraph
                        // v0.8.120 (design-sweep O12): the silent-fallback typeface, surfaced on
                        // the path that actually EXPORTS. `wm-font-missing` had exactly one
                        // on-screen home — a warn line inside `if root.wm-type == 2` inside the
                        // EDITOR's left column — while day-to-day export is "open the sheet, pick
                        // a preset, Export", and opening the sheet auto-applies a preset, which
                        // re-rasters its text watermark in a system fallback. Presets travel
                        // between machines and licensed brand fonts get uninstalled, so 300 web
                        // JPEGs could go out with the studio signature in the wrong typeface and
                        // the only trace was a line in falcon.log. The `wm-type == 2` conjunction
                        // is deliberate: the flag is written only by `raster_text_watermark`, and
                        // applying a None/Image preset does not run it, so the flag can be a
                        // stale leftover from a text preset selected earlier in the same session.
                        // v0.8.121 (Round-B fix F16 = audit Y11): ONE sentence (root.wm-font-warn,
                        // composed in Rust), and the `wm-text != ""` conjunction — the same
                        // "there IS an applied text watermark" predicate the export-time warn is
                        // behind. `wm-font-missing` is recomputed only inside
                        // `raster_text_watermark`, which RETURNS EARLY on blank text, so
                        // selecting a missing-font text preset and then an empty-text one left
                        // the flag true and warned that the second preset's installed font was
                        // not installed — a false statement about the user's machine, on the
                        // export surface.
                        if root.wm-font-missing && root.wm-type == 2 && root.wm-text != "" : Text {
                            text: @tr("falcon" => "⚠ {0}", root.wm-font-warn);
                            color: Theme.warn; font-size: Theme.font-sm; wrap: word-wrap;
                        }
                        Text {
                            // v0.8.105 (W6): …"converted to sRGB for web & social". The owner's
                            // ruling put the colour fact in the preset EDITOR's OUTPUT section —
                            // but day-to-day export is "pick a preset → Export" in THIS mode,
                            // and a photographer who saved a preset once may never open the
                            // editor again. Same words as the OUTPUT row, on the surface every
                            // routine export actually passes through.
                            // v0.8.131 (F-P7): set-aware. "every flagged pick" described a
                            // button that no longer exists.
                            text: root.out-web-description;
                            color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap;
                        }
                    }
                    // ───────── LIST mode: pick a saved preset ─────────
                    if root.export-mode == 0 : VerticalLayout {
                        spacing: Theme.space-2;
                        elistflick := Flickable {
                            // D1 (REWRITTEN by the queue 34 tail, T-1): THE BODY SCROLLS AND THE
                            // Cancel/Export ROW BELOW STAYS PINNED — because the SCROLLER is the one
                            // child the solver may shrink, not because a constant guessed how tall
                            // the chrome around it would be. The old idiom capped this Flickable at
                            // `stage-h - 108px`: 108 was a frozen reserve for the sheet's fixed rows,
                            // and queue 34 moved them past it (two 32 px rows became 44 px ToggleRows
                            // and five conditionals moved from the header column's 4 px gaps to
                            // `expbox`'s 12 px ones), taking the sheet's preferred height 364 -> 391.
                            // At the window's own `min-height: 400px` (:177) the panel clamps to 350,
                            // a Slint layout never shrinks a fixed-height child and never clips, and
                            // the action row landed at 418 — 21 px past the panel's bottom and 18 px
                            // BELOW the window, on the control that dismisses or commits the batch,
                            // while this Flickable sat on 138 px of reserve it could never use.
                            // THE IDIOM IS `setflick`'s (F6, v0.7.9), the v0.8.3 stretch class: ONE
                            // absorber that is stretch-1 AND truly unbounded-max — `max-height` is
                            // explicit because the compiler's flickable pass otherwise binds it to
                            // the CONTENT's preferred height, which is the silent cripple that makes
                            // "just give it stretch 1" do nothing. `min-height` is ONE preset row, so
                            // a short window leaves a real scroller under the section label rather
                            // than a slot. With no explicit `height:` that same pass binds
                            // `preferred-height` to the VIEWPORT COLUMN's, WHICH IS `ebody` — the column
                            // queue 36 adds below. It was `elist`, the preset column, until that round
                            // moved the run-scoped card in beside it, and the number is the same either
                            // way because only the owning layout changed; the old spelling is recorded
                            // here because it is still the one a reverting hand would reach for, and
                            // `tipgeom_tests.rs` now reddens if it does. Either way it is the value the
                            // old expression already resolved to on every window tall enough to matter,
                            // which is why nothing moves when nothing is constrained.
                            //
                            // ── queue 36: …AND THE BODY IS THE WHOLE BODY NOW, WHICH IS WHAT THE
                            // TAIL'S OWN RULE ALWAYS SAID. T-1 made the SCROLLER the one child the
                            // solver may shrink; it left the run-scoped card OUTSIDE it, as frozen
                            // chrome. This round adds a third question and its caption to that card
                            // (+82 px measured), and at 560x400 — the window the app itself declares
                            // it can open in (:176-177) — the tail's own defect came straight back:
                            // the Cancel/Export row solved to a bottom edge of 431 against a panel
                            // that ends at 397, and with the missing-font warning up it was not
                            // rendered at all, while this Flickable sat on its 40 px floor with
                            // nothing left to give. The BOUNDARY was wrong, not the constant: the
                            // header (count · sentence · X) and the actions are CHROME, and
                            // everything between them — the run-scoped questions AND the preset
                            // list — is BODY. Body is what scrolls. Moving the card inside this
                            // viewport changes no gap and no height (the column below carries
                            // `space-3`, the gap the card had as an `expbox` child), so every
                            // window tall enough to hold the sheet is byte-identical; what changes
                            // is that a short one can now scroll to the card instead of pushing the
                            // actions off the screen.
                            //
                            // L26 — WRITTEN OUT BECAUSE NO ROW CAN READ IT. `interactive: true` is the
                            // Flickable default, and it is spelled here anyway because the twin `edflick`
                            // below carries an explicit `interactive: false` under an L26 note of its own,
                            // so a parity pass reading the two side by side finds one idiom with the line
                            // and one without. THAT `false` IS THE DELIBERATE EXCEPTION, not the house
                            // spelling: the preset editor's live preview owns the wheel and the drag, so
                            // its body must not steal the DRAG. Copied onto THIS Flickable it would take
                            // drag-scrolling away from the preset list — a loss of one input path, NOT of
                            // reach: Slint 1.17's `interactive` gates the drag only, the wheel scrolls a
                            // Flickable regardless (the item-36 verifier measured it: with `false` here the
                            // 560x400 cell still walks to the bottom stop and finds all three preset cards;
                            // this file's other Flickable notes record the same). `interactive` is not geometry and
                            // no `ElementHandle` exposes it (the L49 class), so this comment is the pin,
                            // and it is STATED rather than dressed as tested.
                            interactive: true;
                            vertical-stretch: 1;
                            max-height: 100000px; // stretch-class absorber (v0.8.3): opt out of the flickable pass's content cap
                            min-height: 40px;     // one row of the body — the actions never yield, the scroller does
                            viewport-height: ebody.preferred-height;
                            viewport-width: self.width;
                            ebody := VerticalLayout {
                                width: parent.width;
                                // `expbox`'s own child gap: the card sat at `space-3` above the
                                // section label before it moved in here, and it still does — so
                                // the sheet's preferred height and every gap in it are the same
                                // numbers they were, and only what may scroll has changed.
                                spacing: Theme.space-3;
                                // ── queue 34 (§1.B, OWNER): THE TWO RUN-SCOPED QUESTIONS, IN THE APP'S ONE TOGGLE
                                //    GRAMMAR. The owner: "the text size for the 2 toggleable options are not
                                //    consistent with the settings panel, unify them so the information hierarchy is
                                //    clear." They were hand-built 32 px rows whose labels sat at `Theme.font-sm`
                                //    (11 px) / 500 — the SAME size as the muted description above them — beside a bare
                                //    `ToggleTrack`. Settings' `ToggleRow` is 44 px at `Theme.font-body` (13 px) / 500,
                                //    the one toggle-label weight the owner ruled app-wide in v0.8.80.
                                //
                                //    GROUP FORM, per `ToggleRow`'s own doc (groups for related rows, standalone cards
                                //    for lone toggles) and per v0.8.125 (C7), which made a CAPTION the trigger for the
                                //    group: both questions are run-scoped — properties of THIS export, not of the
                                //    preset — and the first one carries X12's example filename as its caption. The
                                //    padding follows the Settings cards: 12 px below a trailing CAPTION, 0 below a
                                //    trailing ROW (the accelerator card's `nvjpeg-avail ? 0px : 12px`, same reason).
                                // queue 36: the `if root.export-mode == 0` gate that stood here
                                // is gone rather than lost — this block's new home IS the
                                // LIST-mode column, which is the same condition.
                                exruns := SettingsGroup {
                                    VerticalLayout {
                                        padding-top: 0px;
                                        // queue 34 (§C.2) + queue 36: the Settings cards' rule — 12 px below a
                                        // trailing CAPTION, 0 below a trailing ROW — for this card's FOUR
                                        // shapes, read from the bottom up. The trailing child is: the RAW-only
                                        // caption when there are RAW-only picks (12); else the rejects ROW when
                                        // there are rejects (0); else the filename-example CAPTION when there is
                                        // one (12); else the suffix ROW (0). Written 12-first because that is
                                        // the rule's own polarity — a caption needs the padding, a row brings
                                        // its own.
                                        padding-bottom: (root.out-raw-only-count > 0
                                            || (root.out-reject-count == 0 && root.wm-name-example != "")) ? 12px : 0px;
                                        spacing: 0px;
                                        // ── v0.8.187 (W1 i, OWNER DESIGN D24): THE FILENAME-SUFFIX TOGGLE ──
                                        // LIST mode only, and it sits with the other run-scoped questions
                                        // rather than in the preset EDITOR: it is not part of a preset's
                                        // recipe, it is a property of THIS export. Same ToggleTrack grammar as
                                        // the rejected-photographs row below it (the app has one toggle), and
                                        // it is NOT mount-gated on anything — unlike that row it is a
                                        // permanently meaningful question, and hiding it would leave the
                                        // filename rule invisible on exactly the runs it changes.
                                        ToggleRow {
                                            bg: transparent; bw: 0px;
                                            label: @tr("falcon" => "Append the preset name to filenames"); on: root.wm-append-preset-name;
                                            toggled => { root.wm-append-preset-name = !root.wm-append-preset-name; }
                                        }
                                        // v0.8.187 (X12): the decision made SIGHTED. The toggle asks the reader
                                        // to accept a naming rule whose result he cannot see -- and the result
                                        // is not always the preset's name, because it is sanitized on the way
                                        // into a filename. This caption is the actual output name, from the
                                        // same producer the run uses. Mount-gated on having something to show.
                                        if root.wm-name-example != "" : VerticalLayout {
                                            padding-left: 12px; padding-right: 12px; spacing: Theme.space-1h;
                                            Text { text: root.wm-name-example; color: Theme.text-mute;
                                                   font-size: Theme.font-sm; wrap: word-wrap; }
                                        }
                                        // v0.8.132 (OQ1): the same row as the copy confirm's, on the sheet that
                                        // exports the same set — one question, asked identically on both
                                        // surfaces. Mount-gated (L4) and LIST-mode only: the editor is about a
                                        // preset, not about a set of photographs.
                                        if root.out-reject-count > 0 : ToggleRow {
                                            bg: transparent; bw: 0px;
                                            label: root.out-include-label; label-color: Theme.warn;
                                            on: root.include-rejects;
                                            toggled => { root.include-rejects = !root.include-rejects; }
                                        }
                                        // ── RAW-only source choice; same run-scoped group and caption grammar ──
                                        if root.out-raw-only-count > 0 : VerticalLayout {
                                            padding-left: 12px; padding-right: 12px;
                                            padding-top: Theme.space-2; spacing: Theme.space-2;
                                            Text { text: root.out-include-raw-label; color: Theme.warn;
                                                   font-size: Theme.font-body; font-weight: 500; }
                                            Seg {
                                                opts: [@tr("falcon" => "Skip"), @tr("falcon" => "Camera preview"), @tr("falcon" => "Develop RAW")];
                                                sel: root.raw-export-mode;
                                                changed(i) => { root.raw-export-mode = i; }
                                            }
                                        }
                                        // …AND THE LIMITATION, WHERE THE DECISION IS MADE. The owner asked that
                                        // the user be told what a RAW-only export actually ships; the honest
                                        // place for that is under the control that ships it, not only in the
                                        // toast afterwards. X12's caption grammar (12 px in, `font-sm` mute,
                                        // word-wrap), composed in Rust with every other worded string on this
                                        // sheet. Gated on the SAME count as the row above, so the pair mounts
                                        // and unmounts as one thing.
                                        if root.out-raw-only-count > 0 : VerticalLayout {
                                            padding-left: 12px; padding-right: 12px; spacing: Theme.space-1h;
                                            Text { text: root.raw-export-mode == 2 ? root.raw-develop-caption : root.include-raw-caption; color: Theme.text-mute;
                                                   font-size: Theme.font-sm; wrap: word-wrap; }
                                        }
                                    }
                                }
                                elist := VerticalLayout {
                                    width: parent.width;
                                    spacing: Theme.space-2;
                                    SectionLabel { text: @tr("falcon" => "CHOOSE A PRESET"); }
                                    for n[i] in root.wm-preset-names : pcard := Rectangle {
                                        // ── v0.8.154 (A7, OWNER RULING Q25): THE RECIPE IS A HOVER TIP ──
                                        // REVERSED FOR FOUR TERMS by the owner on 2026-09-05 (queue item
                                        // 34): this row renders the name AND the four chips built in the
                                        // block below (search "queue 34 (§1.D, OWNER ASK)" in this card) —
                                        // format, resolution, compression, and the mark if the watermark
                                        // is on. The tooltip STAYS and is unchanged: it alone carries the
                                        // placement, which no chip states. The paragraph below is the
                                        // SUPERSEDED ruling, kept because it records why the row was
                                        // name-only for eight versions — read it in the past tense:
                                        // The row still renders the NAME and only the name — the ruling
                                        // is explicit that this is a tooltip, not a visible summary line
                                        // (the owner's minimal-chip instinct; the sheet's own note calls
                                        // this list "the day-to-day path" and a second line per row
                                        // would double its weight). The recipe reaches the reader on
                                        // dwell, which is the one moment it is wanted: "which of my
                                        // three presets is this" before a 300-file batch.
                                        property <string> row-tip: root.wm-preset-tips[i];
                                        // queue 34 (§1.D): this row's four chip terms, read ONCE from
                                        // the model `publish_presets` fills in the same walk as the
                                        // names and the tips. An empty term mounts no chip.
                                        property <PresetBrief> brief: root.wm-preset-briefs[i];
                                        // A DYNAMIC TIP MUST RE-PUBLISH ON THE FLIP (v0.8.118's rule,
                                        // and the reason it applies here): deleting preset 0 while the
                                        // pointer rests on preset 1 shifts every later row DOWN an index
                                        // without unmounting the hovered TouchArea, so this row's tip
                                        // becomes a different preset's recipe under a stationary cursor.
                                        // Re-publish while WE are the hovered host — never an
                                        // unconditional write; another Tip host may own the channel.
                                        changed row-tip => {
                                            if (pcta.has-hover) { Tip.text = self.row-tip; root.wm-tip-owned = self.row-tip; }
                                        }
                                        height: 40px; border-radius: Theme.radius-ctrl;
                                        background: root.sel-preset == i ? Theme.accent-soft : (pcta.has-hover ? Theme.block-hover : Theme.block);
                                        border-width: 1px; border-color: root.sel-preset == i ? Theme.accent : Theme.border-strong;
                                        animate background { duration: Theme.anim; easing: ease; }
                                        // ── queue 34 (§1.C, OWNER): THE THREE CELLS TAKE THE APP'S 4 PX GAP RULE. ──
                                        // The owner's arrows land on the trash button's hover square: its
                                        // 30 px wash sat 5 px from the card's top and bottom, 10 px from
                                        // the card's right edge and 8 px from its neighbour — four
                                        // different gaps around one control, on a sheet whose own title
                                        // bar was ruled to a single gap TWICE. `IconBtn`'s note states
                                        // the convention (owner rulings v0.8.180, "the third visit to
                                        // this rule"): uniformity is a property of the GAPS — every
                                        // visible gap the same 4 px, integers at 1× AND 1.5×.
                                        //
                                        // THE DERIVATION, in this 40 px card. `IconBtn` draws its wash as
                                        // a centred square of side `min(w, h) - 4`, so a 36 px cell draws
                                        // 32 with a 2 px inset all round; at `y: 2px` — which is
                                        // (40 - 36) / 2 — that is 4 above the wash and 4 below it. The
                                        // trash cell at `parent.width - 38px` puts the wash's right edge
                                        // at W - 4. One cell PITCH is 36, so a neighbour 36 px left puts
                                        // two 2 px insets between the washes: 4 again. Every number even
                                        // ⇒ whole device pixels at 150 % (L41).
                                        //
                                        // …and the name row's `padding-right` is that arithmetic rather
                                        // than a literal: the cell block starts at W - 110 (the tick
                                        // cell) and the row must stop `Theme.space-2` short of it, so
                                        // 110 + 8 = 118. (The shipped 34 px rhythm reached the same 118
                                        // from three different numbers — 34 px cells, a 4 px gap and an
                                        // 8 px right margin — which is why its comment is REPLACED here
                                        // rather than corrected on top of.)
                                        HorizontalLayout {
                                            padding-left: Theme.space-3; padding-right: 118px; spacing: Theme.space-2;
                                            // The name HUGS (stretch 0) so the chips sit beside it rather
                                            // than being shoved against the cells, and the slack below
                                            // takes the surplus. On a name too long for the row the
                                            // solver shrinks the only child that CAN shrink — an elided
                                            // Text's layout minimum is one ellipsis wide, while a Chip's
                                            // explicit width pins min == max — so the NAME elides and no
                                            // chip is ever pushed under the three cells.
                                            pname := Text { text: n; color: Theme.text; font-size: Theme.font-md; font-weight: 600;
                                                   vertical-alignment: center; horizontal-stretch: 0; overflow: elide; }
                                            // ── queue 34 (§1.D, OWNER ASK): THE PRESET BRIEF, IN THE CONTEXT
                                            //    MENU'S KEYCAP GRAMMAR. The owner asked for "a brief overview of
                                            //    the key characteristics of this preset (format, resolution,
                                            //    compression, plus watermark if watermark is on)" and pointed at
                                            //    the menu's Ctrl+Y / Ctrl+D keycaps for the styling: "reuse
                                            //    existing designs when possible". That keycap is the shared
                                            //    `Chip` in its default HINT role — 18 px, `Theme.well`,
                                            //    hairline, `font-sm` / 600 mute, hug + 12 — mounted exactly as
                                            //    `MenuItem` mounts it, with NO new component and no role.
                                            //
                                            //    Owner ruling Q25 (v0.8.154) had kept this row to its name with
                                            //    the recipe on dwell; the owner now reverses that for these four
                                            //    terms. THE TOOLTIP STAYS: it alone carries the placement
                                            //    ("bottom-right"), which no chip states.
                                            //
                                            //    Each chip is an `if` SIBLING — a false `if` contributes no
                                            //    child (L4), and never a ternary on a class-selecting property
                                            //    (L47). An empty term is "this preset has no such
                                            //    characteristic": a PNG has no compression term, an unmarked
                                            //    preset no mark term. The words come from `support`'s three
                                            //    term helpers, the same ones the tooltip's recipe reads, so a
                                            //    chip cannot describe a different export from the row it labels.
                                            //
                                            //    The `VerticalLayout { alignment: center }` wrapper is not
                                            //    decoration: a HorizontalLayout does NOT cross-axis-centre a
                                            //    fixed-height child (09-02, owner-caught), so an 18 px chip in a
                                            //    40 px card would sit at y 0 without it.
                                            if pcard.brief.fmt != "" : VerticalLayout { alignment: center; Chip { text: pcard.brief.fmt; } }
                                            if pcard.brief.size != "" : VerticalLayout { alignment: center; Chip { text: pcard.brief.size; } }
                                            if pcard.brief.quality != "" : VerticalLayout { alignment: center; Chip { text: pcard.brief.quality; } }
                                            if pcard.brief.mark != "" : VerticalLayout { alignment: center; Chip { text: pcard.brief.mark; } }
                                            // THE SLACK — the one stretch-carrier in the row.
                                            Rectangle { horizontal-stretch: 1; }
                                        }
                                        pcta := TouchArea {
                                            clicked => { root.sel-preset = i; root.apply-preset(i); }
                                            // v0.8.154 (A7): the POSITIONED-host Tip grammar, copied
                                            // from `xmpta` (the Review panel's XMP toggle, v0.8.84):
                                            // cx/cy read SELF — a TouchArea fills its parent at x/y 0,
                                            // so this is the row's own window rect and never the
                                            // double-counted component root (the v0.8.45 rule). cy is
                                            // the row's BOTTOM + space-2, so the pill hangs under the
                                            // row it describes rather than over the next one, and the
                                            // leave branch resets cy UNCONDITIONALLY (a stale cy > 0
                                            // would re-anchor the NEXT title-bar tip down inside this
                                            // sheet — xmpta's own reasoning, verbatim).
                                            changed has-hover => {
                                                if (self.has-hover) {
                                                    Tip.text = parent.row-tip;
                                                    root.wm-tip-owned = parent.row-tip;
                                                    Tip.cx = self.absolute-position.x + self.width / 2;
                                                    Tip.cy = self.absolute-position.y + self.height + Theme.space-2;
                                                } else {
                                                    if (Tip.text == parent.row-tip) { Tip.text = ""; }
                                                    if (root.wm-tip-owned == parent.row-tip) { root.wm-tip-owned = ""; }
                                                    Tip.cy = 0px;
                                                }
                                            }
                                        }
                                        // queue 34 (§1.C): the FIRST of the three 36 px cells. It draws no
                                        // wash of its own, so what it carries is the PITCH — 36 px wide at
                                        // W - 110, one whole cell left of the edit cell, so the three tile
                                        // without a seam and the name row's 118 px right padding is the
                                        // block's own left edge plus `Theme.space-2`.
                                        if root.sel-preset == i : ptick := Text {
                                            text: "✓"; color: Theme.accent; font-weight: 700;
                                            width: 36px; horizontal-alignment: center; vertical-alignment: center;
                                            x: parent.width - 110px; y: 2px; height: 36px;
                                        }
                                        // Edit (pencil) — load this preset into the editor with its name pre-filled, so
                                        // re-saving (same name) updates it in place. Declared AFTER pcta → captures its
                                        // own click. Sits left of the trash button.
                                        pedit := IconBtn {
                                            width: 36px; height: 36px; visible-flat-hover: false; // v0.8.17 (Fix C): this row is Theme.block, not base -> keep the translucent hover (a base-flatten would read too dark here)
                                            x: parent.width - 74px; y: 2px; // queue 34 (§1.C): 36 px cell, wash 32, every gap 4
                                            // v0.8.120 (design-sweep O10): snapshot FIRST. `apply-preset`
                                            // on the next statement overwrites the live wm-*/out-* state
                                            // (that is what makes the editor a live-commit editor), so
                                            // this is the last instruction at which the pre-edit recipe
                                            // still exists. `changed export-mode` also fires on the flip
                                            // below, and the Rust arm is idempotent — the second call is
                                            // a no-op while a snapshot is already held.
                                            clicked => { root.export-editor-open(); root.sel-preset = i; root.apply-preset(i); root.wm-preset-name = n; root.wm-edit-orig = n; root.export-mode = 1; }
                                            Path {
                                                x: (parent.width - 13px) / 2; y: (parent.height - 13px) / 2;
                                                width: 13px; height: 13px; viewbox-width: 16; viewbox-height: 16;
                                                stroke: Theme.accent; stroke-width: Theme.icon-stroke; fill: transparent;
                                                // eraser end cap + the two shaft edges converging to the writing tip
                                                MoveTo { x: 10.5; y: 3; } LineTo { x: 13; y: 5.5; }
                                                MoveTo { x: 10.5; y: 3; } LineTo { x: 3.5; y: 10; }
                                                MoveTo { x: 13; y: 5.5; } LineTo { x: 6; y: 12.5; }
                                                MoveTo { x: 3.5; y: 10; } LineTo { x: 2.5; y: 13.5; } LineTo { x: 6; y: 12.5; }
                                            }
                                        }
                                        // Delete (trash) — declared AFTER pcta so it sits on top and captures its
                                        // own click (the row-select TouchArea below never sees it). Opens a confirm.
                                        pdel := IconBtn {
                                            width: 36px; height: 36px; danger: true;
                                            x: parent.width - 38px; y: 2px; // queue 34 (§1.C): wash right edge at W - 4
                                            clicked => { root.wm-del-name = n; root.wm-del-confirm = i; }
                                            Path {
                                                x: (parent.width - 12px) / 2; y: (parent.height - 13px) / 2;
                                                width: 12px; height: 13px; viewbox-width: 16; viewbox-height: 17;
                                                stroke: Theme.danger; stroke-width: Theme.icon-stroke; fill: transparent;
                                                // lid + handle
                                                MoveTo { x: 2.5; y: 4; } LineTo { x: 13.5; y: 4; }
                                                MoveTo { x: 6; y: 4; } LineTo { x: 6.5; y: 2.5; } LineTo { x: 9.5; y: 2.5; } LineTo { x: 10; y: 4; }
                                                // can body
                                                MoveTo { x: 4; y: 4; } LineTo { x: 4.8; y: 14.5; } LineTo { x: 11.2; y: 14.5; } LineTo { x: 12; y: 4; }
                                                // ribs
                                                MoveTo { x: 6.6; y: 6.5; } LineTo { x: 6.9; y: 12; }
                                                MoveTo { x: 9.4; y: 6.5; } LineTo { x: 9.1; y: 12; }
                                            }
                                        }
                                    }
                                    Rectangle {
                                        height: 40px; border-radius: Theme.radius-ctrl;
                                        background: ncta.has-hover ? Theme.hover : transparent;
                                        border-width: 1px; border-color: Theme.border-strong;
                                        animate background { duration: Theme.anim; easing: ease; }
                                        Text { text: @tr("falcon" => "＋  New custom preset"); color: Theme.accent; font-size: Theme.font-md; font-weight: 600;
                                               x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                                        ncta := TouchArea { clicked => { root.wm-preset-name = ""; root.wm-edit-orig = ""; root.new-preset(); } }
                                    }
                                }
                            }
                        }
                        HRule { }
                        exactrow := HorizontalLayout {
                            spacing: Theme.space-2;
                            ActionBtn { label: @tr("falcon" => "Cancel"); variant: 2; clicked => { root.export-open = false; } }
                            ActionBtn { label: @tr("falcon" => "Export"); variant: 0; primary: true; web: true;
                                        enabled: root.sel-preset >= 0 && root.count-out-col1 > 0 && !root.sel-busy; // v0.8.131 (F-P7): the set the handler exports
                                        clicked => { root.export-open = false; root.export-web(); } }
                        }
                    }

                    // ───────── EDITOR mode: build a preset (live preview) ─────────
                    if root.export-mode == 1 : VerticalLayout {
                        spacing: Theme.space-3;
                        // Two columns so the sheet stays short enough that Save/Cancel are always on
                        // screen in a non-maximized window: LEFT = preview + watermark source, RIGHT =
                        // placement + output. The Save/Cancel row spans full width at the bottom.
                        edflick := Flickable {
                            // D1 (REWRITTEN by the queue 34 tail, T-1 — THE TWIN, L26): the two-column
                            // body scrolls and the Save/Cancel row below stays pinned, through the SAME
                            // idiom as the list body above (see its note for why the frozen 108 px
                            // reserve had to go). This mode's chrome did not move this round, but the
                            // reserve was the same expression on the same sheet: one of two identical
                            // idioms fixed alone is the next round's surprise.
                            // `interactive: false` is PRE-EXISTING and out of scope here — it keeps the
                            // DRAG for the preview's logo positioning; Slint 1.17's `interactive` gates
                            // the drag only, so a body clamped shorter than its content is still reached
                            // by the WHEEL (corrected 09-06 after the item-36 verifier). What changes is
                            // only that the Save/Cancel row stays on screen instead of being pushed
                            // off it, which is what this comment always claimed.
                            interactive: false;
                            vertical-stretch: 1;
                            max-height: 100000px; // stretch-class absorber (v0.8.3): opt out of the flickable pass's content cap
                            min-height: 40px;     // the body yields before the action row does
                            viewport-height: edbody.preferred-height;
                            viewport-width: self.width;
                            edbody := VerticalLayout {
                                spacing: Theme.space-3;
                                HorizontalLayout {
                                    spacing: Theme.space-4;
                                    // ── LEFT column: live preview + the watermark source. STATIC width (user,
                                    // v0.7.2): stretch-based columns re-balanced whenever the watermark type or
                                    // font changed the content's preferred size — the whole sheet bounced.
                                    // 292 + 16 gap + 372 = the panel's 680 inner width; preview ≈ 3:2.
                                    VerticalLayout {
                                        width: 292px; spacing: Theme.space-2; // long font names in the picker may clip — accepted
                                        // live preview — drag the logo to position; it SNAPS to the centre lines.
                                        // The photo is image-fit:contain (centred sub-rect ix/iy/iw/ih, letterboxed
                                        // by bars); the drag maps onto THAT rect so the logo lands under the cursor.
                                        pvbox := Rectangle {
                                            height: 195px; border-radius: Theme.radius-ctrl; background: Theme.stage; clip: true; // 292x195 = 3:2
                                            border-width: 1px; border-color: Theme.border;
                                            property <bool> has-logo: (root.wm-type == 1 && root.wm-image-name != "") || (root.wm-type == 2 && root.wm-text != "");
                                            property <bool> can-drag: self.has-logo;
                                            property <bool> wbound: (self.width / self.height) < root.wm-aspect;
                                            property <length> iw: self.wbound ? self.width : self.height * root.wm-aspect;
                                            property <length> ih: self.wbound ? self.width / root.wm-aspect : self.height;
                                            property <length> ix: (self.width - self.iw) / 2;
                                            property <length> iy: (self.height - self.ih) / 2;
                                            // base photo + watermark, clipped to the IMAGE display rect so an
                                            // oversized watermark crops at the image edge (matching the export
                                            // stamp), not the preview edge. The clip rect IS the image aspect,
                                            // so image-fit:fill on the base is distortion-free.
                                            Rectangle {
                                                x: pvbox.ix; y: pvbox.iy; width: pvbox.iw; height: pvbox.ih; clip: true;
                                                Image { source: root.wm-photo; image-fit: fill; width: 100%; height: 100%; }
                                                if root.wm-box-show : Image {
                                                    source: root.wm-logo; image-fit: fill; opacity: root.wm-logo-op;
                                                    x: root.wm-box-x * parent.width;
                                                    y: root.wm-box-y * parent.height;
                                                    width: root.wm-logo-w * parent.width;
                                                    height: root.wm-logo-h * parent.height;
                                                }
                                            }
                                            // centre snap guides — shown when the logo is aligned to a centre line
                                            // ── v0.8.191 (H10): AN INSTRUMENT, SO IT HAS TO BE ABLE TO MARK A CENTRE. ─
                                            // The `- 0.5px` is CORRECT centring of a 1px mark and stays. The defect
                                            // was the drawing: these sit on FLOAT bases (ix/iw are solved from the
                                            // preview box and the photo's aspect), so an AA-off 1.5-device fill
                                            // flickered between one and two hard columns as the drag moved the
                                            // base across ±0.5 device — a centre line that changes weight while you
                                            // are using it to judge a centre. An anti-aliased stroke walks the
                                            // centre it is given at every sub-pixel phase.
                                            // `opacity: 0.7` → `tint: …with-alpha(0.7)`: same composite, and no
                                            // Opacity item over the hairline (M2 — an opacity binding is a layer
                                            // source the moment the element has more than one drawable child).
                                            if pvbox.can-drag && root.wm-pos-x == 0.5 : AaHairline {
                                                x: pvbox.ix + pvbox.iw / 2 - 0.5px; y: pvbox.iy; width: 1px; height: pvbox.ih;
                                                vertical: true; tint: Theme.accent.with-alpha(0.7);
                                            }
                                            if pvbox.can-drag && root.wm-pos-y == 0.5 : AaHairline {
                                                x: pvbox.ix; y: pvbox.iy + pvbox.ih / 2 - 0.5px; width: pvbox.iw; height: 1px;
                                                tint: Theme.accent.with-alpha(0.7);
                                            }
                                            // W3a: accent bounding box at the watermark's EXACT composited
                                            // rect (Rust publishes the stamp's own math) — makes the mark's
                                            // location + size legible even on busy photos (user request).
                                            if pvbox.can-drag && root.wm-box-show : Rectangle {
                                                x: pvbox.ix + root.wm-box-x * pvbox.iw;
                                                y: pvbox.iy + root.wm-box-y * pvbox.ih;
                                                width: root.wm-box-w * pvbox.iw;
                                                height: root.wm-box-h * pvbox.ih;
                                                background: transparent;
                                                border-width: 1px; border-color: Theme.accent;
                                                border-radius: 2px;
                                            }
                                            if root.wm-type != 0 : Rectangle {
                                                x: Theme.space-2; y: Theme.space-2; height: 20px; width: dh.preferred-width + 14px;
                                                border-radius: Theme.radius-xs; background: Theme.badge-bg;
                                                dh := Text { x: 7px;
                                                             text: pvbox.can-drag ? @tr("falcon" => "drag the logo to position")
                                                                 : (root.wm-type == 1 ? @tr("falcon" => "choose a PNG below to add a watermark") : @tr("falcon" => "type your watermark text below"));
                                                             color: Theme.text-mute; font-size: Theme.font-sm; vertical-alignment: center; }
                                            }
                                            pvta := TouchArea {
                                                enabled: pvbox.can-drag;
                                                // snap to a centre line when within ~4% of it (each axis independent)
                                                pointer-event(e) => {
                                                    if (e.kind == PointerEventKind.down) {
                                                        root.wm-pos-x = abs((self.mouse-x - pvbox.ix) / pvbox.iw - 0.5) < 0.04 ? 0.5 : clamp((self.mouse-x - pvbox.ix) / pvbox.iw, 0.0, 1.0);
                                                        root.wm-pos-y = abs((self.mouse-y - pvbox.iy) / pvbox.ih - 0.5) < 0.04 ? 0.5 : clamp((self.mouse-y - pvbox.iy) / pvbox.ih, 0.0, 1.0);
                                                        root.wm-changed();
                                                    }
                                                }
                                                moved => {
                                                    if (self.pressed) {
                                                        root.wm-pos-x = abs((self.mouse-x - pvbox.ix) / pvbox.iw - 0.5) < 0.04 ? 0.5 : clamp((self.mouse-x - pvbox.ix) / pvbox.iw, 0.0, 1.0);
                                                        root.wm-pos-y = abs((self.mouse-y - pvbox.iy) / pvbox.ih - 0.5) < 0.04 ? 0.5 : clamp((self.mouse-y - pvbox.iy) / pvbox.ih, 0.0, 1.0);
                                                        root.wm-changed();
                                                    }
                                                }
                                            }
                                            // W3b: open the STAGE-SIZED preview (the same magnifier glyph
                                            // as the minimised RAW/zoom panel — user request). AFTER pvta
                                            // in the markup so it sits above the drag surface.
                                            Rectangle {
                                                x: parent.width - 36px; y: 6px; width: 30px; height: 30px;
                                                border-radius: Theme.radius-sm;
                                                background: wmlgta.has-hover ? Theme.well-hover : Theme.badge-bg;
                                                animate background { duration: Theme.anim; easing: ease; }
                                                MagnifierIcon { hot: wmlgta.has-hover; x: 4px; y: 4px; }
                                                wmlgta := TouchArea {
                                                    clicked => { root.wm-large = true; root.wm-request-sample(2176); }
                                                }
                                            }
                                        }
                                        SectionLabel { text: @tr("falcon" => "WATERMARK"); }
                                        HorizontalLayout {
                                            spacing: Theme.space-2;
                                                            OptionChip { label: @tr("falcon" => "None"); active: root.wm-type == 0; clicked => { root.set-wm-type(0); } }
                                            OptionChip { label: @tr("falcon" => "Image"); active: root.wm-type == 1; clicked => { root.set-wm-type(1); } }
                                            OptionChip { label: @tr("falcon" => "Text"); active: root.wm-type == 2; clicked => { root.set-wm-type(2); } }
                                        }
                                        // ── source: a PNG logo (Image) or typed text (Text) ──
                                        if root.wm-type == 1 : HorizontalLayout {
                                            spacing: Theme.space-2;
                                            ActionBtn { label: @tr("falcon" => "Choose PNG…"); variant: 2; clicked => { root.choose-watermark(); } }
                                            Text { text: root.wm-image-name == "" ? @tr("falcon" => "no logo chosen") : root.wm-image-name;
                                                   color: root.wm-image-name == "" ? Theme.text-mute : Theme.text; font-size: Theme.font-sm;
                                                   vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                        }
                                        if root.wm-type == 2 : VerticalLayout {
                                            spacing: Theme.space-2;
                                            Rectangle {
                                                height: 34px; border-radius: Theme.radius-ctrl; background: Theme.well;
                                                // v0.8.50 (G3, owner): text fields get the brightened-OUTLINE hover —
                                                // the buttons' hover brightness (Theme.hover, 15% white) on the border
                                                // ONLY, no fill change (text-heavy; readability). The hover host is an
                                                // ANCESTOR TouchArea: its has-hover sets in the before-children filter,
                                                // so the child TextInput keeps every press (caret/selection untouched).
                                                border-width: 1px;
                                                border-color: wtin.has-focus ? Theme.accent
                                                            : (wmtxta.has-hover ? Theme.hover : Theme.border-strong);
                                                animate border-color { duration: Theme.anim; easing: ease; }
                                                wmtxta := TouchArea {
                                                    mouse-cursor: text;
                                                    wtin := TextInput {
                                                        x: 10px; width: parent.width - 20px; height: 100%; vertical-alignment: center;
                                                        color: Theme.text; font-size: Theme.font-md; single-line: true;
                                                        text <=> root.wm-text;
                                                        edited => { root.wm-text-changed(); }
                                                        // v0.9.21 (item 1): a REAL text field — IME follows its focus
                                                        // (CJK watermark text must compose; macOS-only Rust body).
                                                        changed has-focus => { root.set-ime(self.has-focus); }
                                                    }
                                                }
                                                if wtin.text == "" : Text { x: 10px; text: @tr("falcon" => "Your name or @handle…"); color: Theme.text-mute;
                                                                            font-size: Theme.font-md; vertical-alignment: center; }
                                            }
                                            // font picker — opens the centred font list (installed system fonts)
                                            HorizontalLayout {
                                                spacing: Theme.space-2;
                                                exlfont := Text { text: @tr("falcon" => "Font"); color: Theme.text-mute; font-size: Theme.font-md; vertical-alignment: center; width: exov.lbl-left-w; }
                                                Rectangle {
                                                    height: 30px; border-radius: Theme.radius-ctrl; background: Theme.well;
                                                    // v0.8.50 (G3, owner): the Font selector joins the brightened-outline
                                                    // hover family (same Theme.hover brightness, border only, no fill).
                                                    border-width: 1px;
                                                    border-color: root.wm-font-open ? Theme.accent
                                                                : (fontta.has-hover ? Theme.hover : Theme.border-strong);
                                                    animate border-color { duration: Theme.anim; easing: ease; }
                                                    horizontal-stretch: 1;
                                                    HorizontalLayout {
                                                        padding-left: Theme.space-2h; padding-right: Theme.space-2h; spacing: Theme.space-1h;
                                                        Text { text: root.wm-font == "" ? @tr("falcon" => "Default (system UI)") : root.wm-font;
                                                               color: Theme.text; font-size: Theme.font-md; vertical-alignment: center;
                                                               horizontal-stretch: 1; overflow: elide; }
                                                        // Vector chevron for the font DROPDOWN — points DOWN when closed, UP when open
                                                        // (standard dropdown affordance). Intentionally the OPPOSITE of the EXIF panel's
                                                        // chevron, which points UP when closed because that panel EXPANDS UPWARD.
                                                        // ── v0.8.191 (S2-A): THE SHARED `ChevronGlyph`, AND THE ASYMMETRY IT
                                                        //    CARRIES OUT WITH IT. ───────────────────────────────────
                                                        // This was the app's LAST inline chevron polyline — a fourth copy of a
                                                        // drawing edges.slint's own banner already claimed was retired — and it
                                                        // still carried the pre-v0.8.143 C3 asymmetry the shared glyph exists to
                                                        // fix: the CLOSED arm spanned viewbox y 6.5..10.5 against the open arm's
                                                        // 6..10, so the ink sat 0.33px low while closed and MOVED half a device
                                                        // pixel at 150% on every open and close of the picker. Same 12px box, same
                                                        // 16 viewbox, same `Theme.icon-stroke`, same tint, same direction in both
                                                        // states (`points-down` while CLOSED is the dropdown affordance, which is
                                                        // deliberately the opposite of the EXIF panel's) — one drawing.
                                                        // The centring is left EXACTLY as it was (a 16px box, so x = 2): the
                                                        // S2-B even-floor sweep below is bounded to ≤ 1px only where the raw
                                                        // centre is an integer, and this row's height is layout-derived.
                                                        Rectangle {
                                                            width: 16px;
                                                            ChevronGlyph {
                                                                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                                                width: 12px; height: 12px;
                                                                points-down: !root.wm-font-open;
                                                                tint: Theme.text-mute;
                                                            }
                                                        }
                                                    }
                                                    fontta := TouchArea { mouse-cursor: pointer; clicked => { root.wm-font-open = true; } }
                                                }
                                            }
                                            // N18: the chosen family isn't installed on THIS machine — the render
                                            // falls back to a system font, so the export would differ from what the
                                            // preset promised. Say so instead of silently rendering the wrong font.
                                            if root.wm-font-missing : HorizontalLayout {
                                                spacing: Theme.space-2;
                                                exlwarn := Rectangle { width: exov.lbl-left-w; } // under the label column, so the warning lines up with the controls
                                                Text {
                                                    // v0.8.121 (F16): the SAME sentence the list and
                                                    // the export-time warn use — this line used to
                                                    // say "a system font is used" for the fact the
                                                    // other two called "a substitute typeface".
                                                    text: @tr("falcon" => "⚠ {0}", root.wm-font-warn);
                                                    color: Theme.warn; font-size: Theme.font-sm; wrap: word-wrap;
                                                    horizontal-stretch: 1;
                                                }
                                            }
                                            HorizontalLayout {
                                                spacing: Theme.space-2;
                                                exlcolour := Text { text: @tr("falcon" => "Colour"); color: Theme.text-mute; font-size: Theme.font-md; vertical-alignment: center; width: exov.lbl-left-w; }
                                                Rectangle { width: 30px; height: 30px; border-radius: 7px; background: #ffffff; // FUNCTIONAL: the actual "white" watermark-text colour the user applies (not UI chrome — keep pure white)
                                                    border-width: root.wm-text-color == 0 ? 2px : 1px;
                                                    border-color: root.wm-text-color == 0 ? Theme.accent : Theme.border-strong;
                                                    TouchArea { clicked => { root.wm-text-color = 0; root.wm-text-changed(); } } }
                                                Rectangle { width: 30px; height: 30px; border-radius: 7px; background: #141414; // FUNCTIONAL: near-black watermark-text colour the user applies (not UI chrome)
                                                    border-width: root.wm-text-color == 1 ? 2px : 1px;
                                                    // the near-black swatch needs a visible rest outline on the dark panel (audit)
                                                    border-color: root.wm-text-color == 1 ? Theme.accent
                                                                : (Theme.divider);
                                                    TouchArea { clicked => { root.wm-text-color = 1; root.wm-text-changed(); } } }
                                                Rectangle { width: 30px; height: 30px; border-radius: 7px; background: #8a8f98; // FUNCTIONAL: mid-gray watermark-text colour the user applies (not UI chrome)
                                                    border-width: root.wm-text-color == 2 ? 2px : 1px;
                                                    border-color: root.wm-text-color == 2 ? Theme.accent : Theme.border-strong;
                                                    TouchArea { clicked => { root.wm-text-color = 2; root.wm-text-changed(); } } }
                                                Rectangle { horizontal-stretch: 1; }
                                            }
                                        }
                                        Rectangle { vertical-stretch: 1; } // push the source up; balance the columns
                                    }
                                    // ── RIGHT column: placement + output. A min-width + extra stretch so the
                                    //    slider hint text ("original resolution, no downscale", etc.) fits
                                    //    without clipping/"…", at the cost of a slightly narrower preview. ──
                                    VerticalLayout {
                                        width: 372px; spacing: Theme.space-2; // STATIC (see the left column note)
                                        if root.wm-type != 0 : VerticalLayout {
                                            spacing: Theme.space-2;
                                            SectionLabel { text: @tr("falcon" => "PLACEMENT"); }
                                            HorizontalLayout {
                                                spacing: Theme.space-2;
                                                exrop := Text { text: @tr("falcon" => "Opacity"); color: Theme.text-mute; font-size: Theme.font-md; vertical-alignment: center; width: exov.lbl-right-w; }
                                                VerticalLayout {
                                                    horizontal-stretch: 1; spacing: Theme.space-1h;
                                                    HorizontalLayout {
                                                        spacing: Theme.space-2;
                                                        Text { text: root.wm-opacity-pct > 0 ? @tr("falcon" => "Custom") : [@tr("falcon" => "Faint"), @tr("falcon" => "Subtle"), @tr("falcon" => "Medium"), @tr("falcon" => "Solid")][root.wm-opacity-tier];
                                                               color: Theme.text; font-size: Theme.font-md; font-weight: 600; vertical-alignment: center; }
                                                        Text { text: root.wm-opacity-pct > 0 ? "" : [@tr("falcon" => "ghosted, barely there"), @tr("falcon" => "light but legible"), @tr("falcon" => "clearly visible"), @tr("falcon" => "fully opaque logo")][root.wm-opacity-tier];
                                                               color: Theme.text-mute; font-size: Theme.font-sm; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                                    }
                                                    CustomSeg {
                                                        stops: ["30", "55", "80", "100"]; // = WM_OPACITY_TIERS (%)
                                                        index: root.wm-opacity-tier;
                                                        custom: root.wm-opacity-pct;
                                                        picked(i) => { root.wm-opacity-tier = i; root.wm-opacity-pct = 0; root.wm-changed(); }
                                                        custom-committed(t) => { if (t != "") { root.set-wm-custom(0, t); } keys.focus(); }
                                                    }
                                                }
                                            }
                                            HorizontalLayout {
                                                spacing: Theme.space-2;
                                                exrsize := Text { text: @tr("falcon" => "Size"); color: Theme.text-mute; font-size: Theme.font-md; vertical-alignment: center; width: exov.lbl-right-w; }
                                                VerticalLayout {
                                                    horizontal-stretch: 1; spacing: Theme.space-1h;
                                                    HorizontalLayout {
                                                        spacing: Theme.space-2;
                                                        Text { text: root.wm-size-pct > 0 ? @tr("falcon" => "Custom") : [@tr("falcon" => "Small"), @tr("falcon" => "Medium"), @tr("falcon" => "Large"), @tr("falcon" => "XL")][root.wm-size-tier];
                                                               color: Theme.text; font-size: Theme.font-md; font-weight: 600; vertical-alignment: center; }
                                                        Text { text: root.wm-size-pct > 0 ? "" : [@tr("falcon" => "discreet corner mark"), @tr("falcon" => "balanced"), @tr("falcon" => "prominent"), @tr("falcon" => "dominant, ~⅓ of the frame")][root.wm-size-tier];
                                                               color: Theme.text-mute; font-size: Theme.font-sm; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                                    }
                                                    CustomSeg {
                                                        stops: ["10", "15", "22", "32"]; // = WM_SIZE_TIERS (% of long edge)
                                                        index: root.wm-size-tier;
                                                        custom: root.wm-size-pct;
                                                        picked(i) => { root.wm-size-tier = i; root.wm-size-pct = 0; root.wm-changed(); }
                                                        custom-committed(t) => { if (t != "") { root.set-wm-custom(1, t); } keys.focus(); }
                                                    }
                                                }
                                            }
                                            // quick-position grid (compact 3:2) — fine-tune by dragging the preview
                                            HorizontalLayout {
                                                spacing: Theme.space-2;
                                                exrpos := Text { text: @tr("falcon" => "Position"); color: Theme.text-mute; font-size: Theme.font-md; vertical-alignment: center; width: exov.lbl-right-w; }
                                                // ── v0.8.139 (AA/H2): THE CENTRE CELL WAS THE ODD ONE OUT. ──────────────
                                                // The block was 132x88 with 3px spacing and nine STRETCH cells, which is
                                                // the one construction that cannot be reasoned about: Slint distributes
                                                // stretch space in f32, so the columns came out (132 - 6)/3 = 42px on a
                                                // pitch of 45 (ODD -> device 0 / 67.5 / 135) and the rows came out
                                                // 27.333px on a pitch of 30.333 (device 0 / 45.5 / 91). The middle column
                                                // and the middle row each landed on a half device pixel while the outer
                                                // two did not, so the CENTRE cell was offset in BOTH axes, the four
                                                // edge-midpoint cells in one axis each, and the corners in neither. Their
                                                // 1px rims rasterised at three visibly different weights — and the centre
                                                // cell is the DEFAULT watermark position, i.e. the one most often shown
                                                // lit in accent. The 5px dots inherited it: (42 - 5)/2 = 18.5 within each
                                                // cell put the middle dot of every row on a different phase (.25) from its
                                                // two neighbours (.75).
                                                //
                                                // Every number here is now EXPLICIT and EVEN — no stretch, so there is no
                                                // f32 distribution left to reason about. Cells 44x28 on 2px gaps: pitch 46
                                                // across (origins 0 / 46 / 92) and 30 down (origins 0 / 30 / 60), all even,
                                                // and 3*44 + 2*2 = 136 / 3*28 + 2*2 = 88 exactly fill the block, so nothing
                                                // is left over to distribute. The dot is 4px (was 5px, odd) and centres to
                                                // (44 - 4)/2 = 20 and (28 - 4)/2 = 12 — even inside an even cell origin, so
                                                // all nine dots sit at even absolute coordinates and rasterise identically.
                                                // THE PRICE, STATED: the block grows 132px -> 136px wide (the height is
                                                // unchanged at 88px, and 132 cannot hold three even columns at any even
                                                // gap); the growth is absorbed by the trailing stretch spacer in this row.
                                                Rectangle {
                                                    width: 136px; height: 88px; // 3 x 44 + 2 x 2 across, 3 x 28 + 2 x 2 down
                                                    VerticalLayout {
                                                        spacing: 2px;
                                                        for ry in [0.12, 0.5, 0.88] : HorizontalLayout {
                                                            height: 28px; spacing: 2px;
                                                            for rx in [0.08, 0.5, 0.92] : Rectangle {
                                                                width: 44px;
                                                                property <bool> on: abs(root.wm-pos-x - rx) < 0.06 && abs(root.wm-pos-y - ry) < 0.06;
                                                                border-radius: Theme.radius-xs;
                                                                background: self.on ? Theme.accent-soft : (pcell.has-hover ? Theme.well-hover : Theme.well);
                                                                border-width: 1px; border-color: self.on ? Theme.accent : Theme.border-strong;
                                                                Rectangle { width: 4px; height: 4px; border-radius: 2px;
                                                                            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                                                            background: parent.on ? Theme.accent : Theme.text-mute; }
                                                                pcell := TouchArea { clicked => { root.wm-pos-x = rx; root.wm-pos-y = ry; root.wm-changed(); } }
                                                            }
                                                        }
                                                    }
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                            }
                                        }
                                        // OUTPUT
                                        // v1.0.0-rc EXPORT FORMAT (F4): the section opens with
                                        // FORMAT, then Size, then Quality, then the static Colour
                                        // row. Format leads because it decides what the next two
                                        // rows mean: a PNG has no quality tier, and the Quality row
                                        // below dims (never unmounts -- ledger L4/L49) to say so.
                                        SectionLabel { text: @tr("falcon" => "OUTPUT"); }
                                        HorizontalLayout {
                                            spacing: Theme.space-2;
                                            exrfmt := Text { text: @tr("falcon" => "Format"); color: Theme.text-mute; font-size: Theme.font-md; vertical-alignment: center; width: exov.lbl-right-w; }
                                            VerticalLayout {
                                                horizontal-stretch: 1; spacing: Theme.space-1h;
                                                HorizontalLayout {
                                                    spacing: Theme.space-2;
                                                    Text { text: ["JPG", "PNG"][root.out-format];
                                                           color: Theme.text; font-size: Theme.font-md; font-weight: 600; vertical-alignment: center; }
                                                    // THE SENTENCE THE ROUND EXISTS FOR: every ./export
                                                    // file is MANUFACTURED from the original, whatever
                                                    // the original was.
                                                    //
                                                    // v1.0.0-rc tail (§R-B B-R1/B-R2): composed in RUST
                                                    // (`support::out_format_caption`), not as the array
                                                    // literal that shipped. Both shipped stops carried a
                                                    // clause that is false for real inputs ("converted
                                                    // from every source", over a run that skips two
                                                    // documented classes; "lossless", over a decoder that
                                                    // flattens alpha onto white and strips 16-bit), and a
                                                    // sentence written here is one no row can measure --
                                                    // including its WIDTH, which matters in a column whose
                                                    // `overflow: elide` fails silently. `fmtcap` is named
                                                    // so the caption-fit row can read this Text's SOLVED
                                                    // slot.
                                                    fmtcap := Text { text: root.out-format-caption;
                                                           color: Theme.text-mute; font-size: Theme.font-sm; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                                }
                                                // The plain `Seg` (segs.slint), not `CustomSeg`:
                                                // there is no custom entry to make -- a format is one
                                                // of two, not a number on a scale -- and `Seg` is the
                                                // component the app already uses for exactly that
                                                // (the Settings mode pickers). No component minted.
                                                Seg {
                                                    opts: ["JPG", "PNG"];
                                                    sel: root.out-format;
                                                    changed(i) => { root.out-format = i; }
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: Theme.space-2;
                                            exrosize := Text { text: @tr("falcon" => "Size"); color: Theme.text-mute; font-size: Theme.font-md; vertical-alignment: center; width: exov.lbl-right-w; }
                                            outbox := VerticalLayout {
                                                horizontal-stretch: 1; spacing: Theme.space-1h;
                                                // header display state: -1 = custom px value, else the named stop index
                                                property <int> osel: root.out-long == 1080 ? 0 : root.out-long == 2048 ? 1
                                                                   : root.out-long == 4096 ? 2 : root.out-long == 100000 ? 3 : -1;
                                                HorizontalLayout {
                                                    spacing: Theme.space-2;
                                                    Text { text: outbox.osel < 0 ? @tr("falcon" => "{0} px", root.out-long) : [@tr("falcon" => "{0} px", 1080), @tr("falcon" => "{0} px", 2048), @tr("falcon" => "{0} px", 4096), @tr("falcon" => "Full size")][outbox.osel];
                                                           color: Theme.text; font-size: Theme.font-md; font-weight: 600; vertical-alignment: center; }
                                                    Text { text: outbox.osel < 0 ? @tr("falcon" => "custom long edge")
                                                               : [@tr("falcon" => "fast, social-first"), @tr("falcon" => "crisp on most screens"), @tr("falcon" => "lots of detail"), @tr("falcon" => "original resolution, no downscale")][outbox.osel];
                                                           color: Theme.text-mute; font-size: Theme.font-sm; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                                }
                                                CustomSeg {
                                                    stops: ["1080", "2048", "4096", @tr("falcon" => "Full")];
                                                    index: outbox.osel < 0 ? 2 : outbox.osel;
                                                    custom: outbox.osel < 0 ? root.out-long : 0;
                                                    picked(i) => { root.out-long = i == 0 ? 1080 : (i == 1 ? 2048 : (i == 2 ? 4096 : 100000)); }
                                                    custom-committed(t) => { if (t != "") { root.set-outlong-custom(t); } keys.focus(); }
                                                }
                                            }
                                        }
                                        // v1.0.0-rc EXPORT FORMAT (F4): ON A PNG THIS ROW STAYS
                                        // MOUNTED, KEEPS ITS VALUE, and goes INERT. Not `visible:`
                                        // and not `if` -- unmounting it would jump the two rows below
                                        // it on every format flip (L4's cost, paid for nothing), and a
                                        // user who picks Max and then tries PNG has not abandoned the
                                        // quality he chose: switching back must find it where he left
                                        // it. The VALUE lives in `out-quality-tier`, never in the
                                        // control, so keeping it costs nothing here.
                                        //
                                        // v1.0.0-rc tail (§R-B B-O1/B-O2) -- TWO CORRECTIONS TO HOW
                                        // THIS ROW SAYS "not now":
                                        //  1. IT IS INERT NOW. The round dimmed a fully LIVE row: the
                                        //     CustomSeg had no `enabled` property at all, so a click
                                        //     or a drag across the dimmed row wrote `out-quality-tier`
                                        //     for real, invisibly, under a caption that says the
                                        //     quality is not used. Every other 0.35 in this tree pairs
                                        //     the mute with a refusal to act -- `IconBtn`'s own doc
                                        //     calls it "the P5 mute, which dims and still swallows" --
                                        //     so signal and behaviour disagreed, and the disagreement
                                        //     was discoverable only by clicking: the exact failure
                                        //     v0.8.121 (F10) wrote the mute+hit-gate pairing to
                                        //     prevent. `CustomSeg` has `enabled` now and swallows
                                        //     exactly as `IconBtn` swallows.
                                        //  2. NO `opacity:` HERE. `Opacity::need_layer` (i-slint-core
                                        //     items.rs) is TRUE for any value below 1 on an item with
                                        //     more than one child, and this row has two -- so the dim
                                        //     turned the whole row into an offscreen LAYER, blitted at
                                        //     its accumulated UNROUNDED device origin with linear
                                        //     filtering (ledger L48). This sheet is CENTRED, so that
                                        //     origin inherits the window width's parity (L46's 09-02
                                        //     addendum): at an unlucky width the label, the value, the
                                        //     caption and the Seg's pill would all be bilinearly
                                        //     smeared -- which reads as a rendering fault, not as "not
                                        //     now", inverting the one lens the dim exists to satisfy.
                                        //     This file already made exactly this move 400 lines up at
                                        //     v0.8.191 (H10): mute the COLOUR, not the element.
                                        //     `.with-alpha(0.35)` over an opaque row is the same
                                        //     composite the opacity produced, with no Opacity item and
                                        //     no layer in either state.
                                        // The caption is still the evidence a row can read (see
                                        // `out_quality_caption`); the inertness has one of its own now
                                        // (`the_quality_seg_is_inert_while_png_is_chosen`).
                                        qrow := HorizontalLayout {
                                            spacing: Theme.space-2;
                                            property <bool> off: root.out-format == 1;
                                            exrq := Text { text: @tr("falcon" => "Quality"); color: qrow.off ? Theme.text-mute.with-alpha(0.35) : Theme.text-mute;
                                                   font-size: Theme.font-md; vertical-alignment: center; width: exov.lbl-right-w;
                                                   animate color { duration: Theme.anim; easing: ease; } }
                                            VerticalLayout {
                                                horizontal-stretch: 1; spacing: Theme.space-1h;
                                                HorizontalLayout {
                                                    spacing: Theme.space-2;
                                                    Text { text: root.out-quality-custom > 0 ? @tr("falcon" => "Custom") : [@tr("falcon" => "Web"), @tr("falcon" => "Social"), @tr("falcon" => "Print"), @tr("falcon" => "Max")][root.out-quality-tier];
                                                           color: qrow.off ? Theme.text.with-alpha(0.35) : Theme.text; font-size: Theme.font-md; font-weight: 600; vertical-alignment: center;
                                                           animate color { duration: Theme.anim; easing: ease; } }
                                                    // `qcap` is named for the caption-fit row, like `fmtcap`.
                                                    qcap := Text { text: root.out-quality-caption;
                                                           color: qrow.off ? Theme.text-mute.with-alpha(0.35) : Theme.text-mute; font-size: Theme.font-sm; vertical-alignment: center; horizontal-stretch: 1; overflow: elide;
                                                           animate color { duration: Theme.anim; easing: ease; } }
                                                }
                                                qseg := CustomSeg {
                                                    stops: ["75", "80", "90", "97"]; // = OUT_QUALITY_TIERS (JPEG q, Figma values)
                                                    index: root.out-quality-tier;
                                                    custom: root.out-quality-custom;
                                                    // §R-B B-O1: PNG has no quality tier, so while PNG is
                                                    // chosen this control is dead -- muted AND swallowing,
                                                    // which is the app's one meaning for that state.
                                                    enabled: !qrow.off;
                                                    picked(i) => { root.out-quality-tier = i; root.out-quality-custom = 0; }
                                                    custom-committed(t) => { if (t != "") { root.set-wm-custom(2, t); } keys.focus(); }
                                                }
                                            }
                                        }
                                        // v0.8.104 (Round-A C1, owner ruling): the OUTPUT section
                                        // itemised size and quality and stayed SILENT about the one
                                        // property v0.8.100 made the app mutate — every ./export file is
                                        // now converted to sRGB and tagged. STATIC by ruling: always
                                        // shown, no per-shot counting, no run-summary tally. Drops
                                        // into the existing bold-value + muted-caption grammar of the
                                        // rows above, no new components, no new state.
                                        // v1.0.0-rc EXPORT FORMAT (F4): this row stays exactly as it
                                        // was — it is about COLOUR, and both stops convert to sRGB
                                        // (the JPG embeds the profile, the PNG writes the `sRGB`
                                        // chunk). The FORMAT row three above it is the one that
                                        // names the container, and its caption carries the other
                                        // half of the same sentence: every deliverable is converted
                                        // from its source, whatever that source was.
                                        HorizontalLayout {
                                            spacing: Theme.space-2;
                                            exrcol := Text { text: @tr("falcon" => "Colour"); color: Theme.text-mute; font-size: Theme.font-md; vertical-alignment: center; width: exov.lbl-right-w; }
                                            HorizontalLayout {
                                                horizontal-stretch: 1; spacing: Theme.space-2;
                                                Text { text: "sRGB"; color: Theme.text; font-size: Theme.font-md;
                                                       font-weight: 600; vertical-alignment: center; }
                                                Text { text: @tr("falcon" => "converted for web & social"); color: Theme.text-mute;
                                                       font-size: Theme.font-sm; vertical-alignment: center;
                                                       horizontal-stretch: 1; overflow: elide; }
                                            }
                                        }
                                        Rectangle { vertical-stretch: 1; } // balance the two columns' height
                                    }
                                }
                            }
                        }
                        HRule { }
                        edactrow := HorizontalLayout {   // named for the tail's T-1 row: this is what must stay on screen
                            spacing: Theme.space-2;
                            Rectangle {
                                height: 34px; horizontal-stretch: 1; border-radius: Theme.radius-ctrl;
                                background: Theme.well; border-width: 1px;
                                // v0.8.50 (G3, owner): the preset-name field joins the brightened-outline
                                // hover family (ancestor-TA host — see the watermark text field's note).
                                border-color: pin.has-focus ? Theme.accent
                                            : (pinta.has-hover ? Theme.hover : Theme.border-strong);
                                animate border-color { duration: Theme.anim; easing: ease; }
                                pinta := TouchArea {
                                    mouse-cursor: text;
                                    pin := TextInput {
                                        x: 10px; width: parent.width - 20px; height: 100%; vertical-alignment: center;
                                        color: Theme.text; font-size: Theme.font-md; single-line: true;
                                        text <=> root.wm-preset-name; // bound so the edit button can pre-fill it
                                        // v0.9.21 (item 1): a REAL text field — IME follows its focus
                                        // (CJK preset names must compose; macOS-only Rust body).
                                        changed has-focus => { root.set-ime(self.has-focus); }
                                    }
                                }
                                if root.wm-preset-name == "" : Text { x: 10px; text: @tr("falcon" => "Preset name…"); color: Theme.text-mute;
                                                           font-size: Theme.font-md; vertical-alignment: center; }
                            }
                            ActionBtn { label: @tr("falcon" => "Cancel"); variant: 2;
                                // v0.8.120 (design-sweep O10 / L17): Cancel now CANCELS. The editor
                                // mutates the live export config directly, so "Cancel" used to mean
                                // "keep every edit and go back": the list returned showing
                                // "Instagram ✓" in accent while Export would write 300 files at the
                                // settings the user had just abandoned, and the preset file on disk
                                // still said something else again. The restore is Rust-side (one
                                // body, shared with Esc and the sheet's X) and puts the TICKED
                                // preset back too — otherwise the ✓ and the live recipe would still
                                // disagree, which is the same defect one step smaller.
                                clicked => { root.export-editor-cancel(); } }
                            ActionBtn { label: @tr("falcon" => "Save preset"); variant: 0; primary: true;
                                // v0.8.119 (design-sweep O11): honest disable — `wm-name-ok` is the
                                // TRIMMED emptiness test (see the property's note), so a name of
                                // spaces greys the button instead of being silently dropped Rust-side.
                                enabled: root.wm-name-ok;
                                clicked => { if (root.wm-preset-name != "") { root.save-preset(root.wm-preset-name, root.wm-edit-orig); root.wm-preset-name = ""; } } }
                        }
                        // ── v0.8.187 (X9): WHY Save IS GREY, WHERE THE NAME IS TYPED ───────────────
                        // `wm-name-ok` grew four rules this round (the name is written into the
                        // exported filename now), and a greyed primary with no explanation is the
                        // L15 defect. Mount-gated on there being something to say, warn-coloured
                        // like the sheet's other advisory lines, composed in Rust from the SAME
                        // chokepoint that publishes the enablement so the two cannot disagree.
                        // It also carries the legacy case: a preset saved under an illegal name by
                        // an older build opens here with Save inert, and this is what says why.
                        if root.wm-name-problem != "" : Text {
                            text: @tr("falcon" => "⚠ {0}", root.wm-name-problem);
                            color: Theme.warn; font-size: Theme.font-sm; wrap: word-wrap;
                        }
                    }
                }
            }
        }

        // ───────── W3b: watermark LARGE preview — the composited photo at stage size ─────────
        // Opened by the magnifier button on the sheet's small preview (the sample re-decodes at
        // ~2176 px for this view); drag positions the mark, the wheel resizes it (sets the same
        // CUSTOM size % the slider's Custom cell uses), the shared MinimizeIcon returns to the
        // sheet (sample back to 720 px). Auto-hides with the sheet (gated on export-open too).
        if root.export-open && root.wm-large : Rectangle {
            y: root.content-top;
            height: parent.height - self.y;
            width: 100%;
            background: #000000e2; // full-screen watermark-editor backdrop — heavy pure-black dim; one-off, distinct from the #0a0a0a scrim-* family
            TouchArea {} // swallow — nothing behind is interactive while the large view is up
            lgbox := Rectangle {
                x: 14px; y: 14px;
                width: parent.width - 28px;
                height: parent.height - 28px;
                // v0.8.120 (design-sweep O14): the small preview's gate, verbatim. The magnifier
                // that opens this view is mounted unconditionally, so with Watermark = None (or Text
                // with an empty field) a full-screen surface used to open that INSTRUCTS a gesture
                // producing zero visible result — while silently writing wm-pos-x/y and, on a wheel
                // notch, flipping the sheet's Size row from "Medium / balanced" to a Custom override
                // the user never chose. The view stays enterable (the photo is worth seeing at
                // stage size); it just stops pretending there is a mark to drag.
                property <bool> can-drag: (root.wm-type == 1 && root.wm-image-name != "") || (root.wm-type == 2 && root.wm-text != "");
                property <bool> wbound: (self.width / self.height) < root.wm-aspect;
                property <length> iw: self.wbound ? self.width : self.height * root.wm-aspect;
                property <length> ih: self.wbound ? self.width / root.wm-aspect : self.height;
                property <length> ix: (self.width - self.iw) / 2;
                property <length> iy: (self.height - self.ih) / 2;
                // the CURRENT effective size % (custom override, else the tier) — mirrors
                // eff_pct(WM_SIZE_TIERS); the wheel steps from here into the custom override.
                property <int> eff-size: root.wm-size-pct != 0 ? root.wm-size-pct
                    : (root.wm-size-tier == 0 ? 10 : root.wm-size-tier == 1 ? 15 : root.wm-size-tier == 2 ? 22 : 32);
                // base photo (static texture) + the watermark overlay, clipped to the image rect —
                // same GPU-composite as the small preview, so the stage-sized drag is pure element
                // movement (no recomposite) and an oversized mark crops at the image edge.
                Rectangle {
                    x: lgbox.ix; y: lgbox.iy; width: lgbox.iw; height: lgbox.ih; clip: true;
                    Image { source: root.wm-photo; image-fit: fill; width: 100%; height: 100%; }
                    if root.wm-box-show : Image {
                        source: root.wm-logo; image-fit: fill; opacity: root.wm-logo-op;
                        x: root.wm-box-x * parent.width;
                        y: root.wm-box-y * parent.height;
                        width: root.wm-logo-w * parent.width;
                        height: root.wm-logo-h * parent.height;
                    }
                }
                // centre snap guides + the accent bounding box — same grammar as the small preview
                // (v0.8.120 / O14: including its `can-drag` gate — accent guides used to flash
                // across the photo as the pointer crossed the middle with nothing being positioned)
                // v0.8.191 (H10): the large preview's pair — the small preview's banner carries the
                // reasoning; these two are the same instrument on the same float bases.
                if lgbox.can-drag && root.wm-pos-x == 0.5 : AaHairline {
                    x: lgbox.ix + lgbox.iw / 2 - 0.5px; y: lgbox.iy; width: 1px; height: lgbox.ih;
                    vertical: true; tint: Theme.accent.with-alpha(0.7);
                }
                if lgbox.can-drag && root.wm-pos-y == 0.5 : AaHairline {
                    x: lgbox.ix; y: lgbox.iy + lgbox.ih / 2 - 0.5px; width: lgbox.iw; height: 1px;
                    tint: Theme.accent.with-alpha(0.7);
                }
                if root.wm-box-show : Rectangle {
                    x: lgbox.ix + root.wm-box-x * lgbox.iw;
                    y: lgbox.iy + root.wm-box-y * lgbox.ih;
                    width: root.wm-box-w * lgbox.iw;
                    height: root.wm-box-h * lgbox.ih;
                    background: transparent;
                    border-width: 1px; border-color: Theme.accent;
                    border-radius: 2px;
                }
                lgta := TouchArea {
                    enabled: lgbox.can-drag; // v0.8.120 (O14): the small preview's `pvta.enabled` twin
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            root.wm-pos-x = abs((self.mouse-x - lgbox.ix) / lgbox.iw - 0.5) < 0.04 ? 0.5 : clamp((self.mouse-x - lgbox.ix) / lgbox.iw, 0.0, 1.0);
                            root.wm-pos-y = abs((self.mouse-y - lgbox.iy) / lgbox.ih - 0.5) < 0.04 ? 0.5 : clamp((self.mouse-y - lgbox.iy) / lgbox.ih, 0.0, 1.0);
                            root.wm-changed();
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            root.wm-pos-x = abs((self.mouse-x - lgbox.ix) / lgbox.iw - 0.5) < 0.04 ? 0.5 : clamp((self.mouse-x - lgbox.ix) / lgbox.iw, 0.0, 1.0);
                            root.wm-pos-y = abs((self.mouse-y - lgbox.iy) / lgbox.ih - 0.5) < 0.04 ? 0.5 : clamp((self.mouse-y - lgbox.iy) / lgbox.ih, 0.0, 1.0);
                            root.wm-changed();
                        }
                    }
                    scroll-event(e) => {
                        // wheel = resize (user decision: drag AND scroll) — steps the CUSTOM size %
                        // v0.8.127: a horizontal tilt is not a resize gesture on this surface (there
                        // is no second dimension to spend it on), so it is IGNORED rather than folded
                        // into "shrink" — which is what the bare delta-y ternary did with it.
                        if (root.wheel-zoom-delta(e.delta-x, e.delta-y) != 0) {
                            root.wm-size-pct = clamp(lgbox.eff-size + (root.wheel-zoom-delta(e.delta-x, e.delta-y) > 0 ? 1 : -1), 4, 60);
                            root.wm-changed();
                        }
                        accept
                    }
                }
                // the interaction hint (user request: one line explaining both gestures)
                Rectangle {
                    x: (parent.width - self.width) / 2; y: parent.height - 34px;
                    height: 24px; width: lghint.preferred-width + 18px;
                    border-radius: Theme.radius-xs; background: Theme.badge-bg;
                    // v0.8.120 (O14): the hint states what is actually available, in the small
                    // preview's own wording ("choose a PNG…" / "type your watermark text…"),
                    // re-pointed at the sheet because the controls are not on this surface.
                    lghint := Text { x: 9px;
                                     text: lgbox.can-drag ? @tr("falcon" => "Drag to position · scroll to resize")
                                         : (root.wm-type == 1 ? @tr("falcon" => "Choose a PNG in the sheet to add a watermark")
                                         : (root.wm-type == 2 ? @tr("falcon" => "Type your watermark text in the sheet")
                                         : @tr("falcon" => "No watermark — pick Image or Text in the sheet")));
                                     color: Theme.text-mute; font-size: Theme.font-sm;
                                     vertical-alignment: center; }
                }
            }
            // minimise back to the sheet (the shared mark, same as the EXIF/RAW folds)
            Rectangle {
                x: parent.width - 54px; y: 10px; width: 40px; height: 40px;
                border-radius: Theme.radius-sm;
                background: lgminta.has-hover ? Theme.well-hover : Theme.base;
                animate background { duration: Theme.anim; easing: ease; }
                MinimizeIcon { hot: lgminta.has-hover; box: 40px; } // v0.8.138 (X1): floored centring, 40px square
                lgminta := TouchArea {
                    clicked => { root.wm-large = false; root.wm-request-sample(720); }
                }
            }
        }

        // ── v0.8.67 (D): the WELCOME / onboarding panel (the approved Figma 262:2 prototype) ──
        // A modal overlay on the dimmed stage: scrim + centred SolidPanel — the confirm-dialog
        // scaffold (Theme.base fill, Theme.radius 13px corners). Shown ONCE on first primary launch
        // (Rust arms welcome-open off the persisted onboarding_shown latch); reopened on demand by
        // the Settings footer's "Show welcome". NO WIZARD STATE: every control applies the moment
        // it's used — the live wheel-nav ToggleRow, the real benchmark machinery, the same
        // set-output-gamut / detect-monitor-icc paths Settings drives — and Skip / Done / Esc are
        // all the same plain close (the changed-observer latches the shown flag). Mount-gated
        // (`if`) so it can never click-steal while hidden; the scrim TouchArea blocks everything
        // behind (title bar stays live above, the other-modals rule).
        if root.welcome-open : Rectangle {
            y: root.content-top;
            height: parent.height - self.y;
            width: 100%;
            background: Theme.scrim;
            TouchArea {} // block everything behind (title bar stays live above)
            SolidPanel {
                // v0.8.81 hotfix (owner ruling): fixed-width HUG, centred — 3 Settings-width columns
                // (Theme.section-w, the SAME source the Settings panel renders from) + the 2 gutters
                // (space-4, the mock's gap-16) + the mock's 18px side margins = 1028px. The old
                // min(1080px, parent.width − 24px) was window-COUPLED: it tracked the window below
                // 1104px, and above that parked the columns at (1080−68)/3 ≈ 337px — a third width
                // regime next to Settings' 320 (the owner-caught KEYS right-gutter). The panel now
                // never resizes with the window; the 24px clamp remains ONLY as the narrow-window
                // honest degradation (columns keep their width, wcflick pans horizontally, below).
                property <length> hug-w: 3 * Theme.section-w + 2 * Theme.space-4 + 2 * 18px;
                width: min(self.hug-w, parent.width - 24px);
                x: (parent.width - self.width) / 2;
                height: min(wcbox.preferred-height, parent.height - 12px);
                // v0.8.46 (Item 2) device-pixel snap — the bottom-anchored footer ActionBtns' top
                // edge (panel bottom − padding 18 − button 34 = −52px) parked on an integer device
                // pixel; the confirm-dialog arithmetic with this panel's own padding tier.
                property <float> sfx: max(root.win-sf, 0.5);
                property <length> raw-y: (parent.height - self.height) / 2;
                property <length> btn-top: parent.y + self.raw-y + self.height - 52px;
                y: self.raw-y + Math.round(self.btn-top / 1px * self.sfx) / self.sfx * 1px - self.btn-top;
                wcbox := VerticalLayout {
                    // Figma 262:3: p-18 / gap-16 (18 is the mock's measured margin — deliberately
                    // off the spacing scale; the gutters and section gaps are space-4).
                    padding: 18px; spacing: Theme.space-4;
                    // header (262:4): titles left, the X close right (the shared panel-dismiss
                    // idiom — IconBtn + CloseGlyph, exactly the PanelHeader mode-0 pair).
                    // v0.8.143 (C2): "exactly the PanelHeader mode-0 pair" is TRUE NOW. The claim
                    // was written when both drew 12px; X2 moved PanelHeader to 16-in-28 and this
                    // twin stayed behind, so the comment went on asserting a parity the code had
                    // quietly lost — and 12-in-a-16-viewbox puts the ink at logical 11..17, half a
                    // device pixel at each end at the owner's 150 % (L41). Same 28px button, same
                    // (28 − 16) / 2 = 6 offset as the header it claims to match.
                    HorizontalLayout {
                        spacing: Theme.space-2;
                        VerticalLayout {
                            horizontal-stretch: 1; spacing: Theme.space-1;
                            Text { text: @tr("falcon" => "Welcome to Falcon"); color: Theme.text; font-size: Theme.display-md; font-weight: 600; }
                            Text { text: @tr("falcon" => "Three quick set-ups — all optional, all changeable later in Settings.");
                                   color: Theme.text-mute; font-size: Theme.font-md; wrap: word-wrap; }
                        }
                        VerticalLayout {
                            alignment: start;
                            IconBtn {
                                width: Theme.hit-primary; height: Theme.hit-primary;
                                clicked => { root.welcome-open = false; }
                                CloseGlyph {
                                    x: (parent.width - 16px) / 2; y: (parent.height - 16px) / 2;
                                    width: 16px; height: 16px;
                                }
                            }
                        }
                    }
                    // the three columns (262:10, gap-16). v0.8.81 hotfix: each column is FIXED at
                    // Theme.section-w (the Settings section width, owner ruling) — the equal-split
                    // stretch mechanics are retired with the stretch (see WcCol), and the panel's
                    // hug-w is sized so this row fits EXACTLY (3×section-w + 2 gutters), no surplus.
                    // v0.8.68 (D-audit FIX 3): the columns scroll when the window is too short for
                    // them (below ~450px tall the footer used to fall off — Slint layouts don't clip).
                    // This Flickable is the wcbox absorber (stretch-1, min 0, explicit preferred =
                    // the columns' own height): it HUGS the columns when there's room (so wcbox's
                    // preferred height — and the SolidPanel hug above — are unchanged, no scroll), and
                    // shrinks + scrolls when the fixed-height panel is smaller, keeping the pinned
                    // header + footer on-screen. Interactive ONLY while overflowing → the cards' own
                    // clicks are never stolen when it all fits (the not-scrollable rule).
                    // v0.8.81 hotfix: the viewport now covers the HORIZONTAL edge too — when the
                    // window is narrower than the panel hug (the 24px clamp bites, window < ~1052),
                    // fixed-width columns can no longer reflow, so the row keeps its 992px and PANS
                    // inside this same Flickable (which clips — never the layouts-don't-clip
                    // click-steal). At/above the hug, viewport-width == width → no pan, untouched.
                    wcflick := Flickable {
                        animate viewport-y { duration: 80ms; easing: ease-out; }
                        vertical-stretch: 1;
                        max-height: 100000px;
                        preferred-height: wccols.preferred-height;
                        viewport-height: wccols.preferred-height;
                        viewport-width: max(self.width, wccols.preferred-width);
                        interactive: wccols.preferred-height > self.height
                                  || wccols.preferred-width > self.width;
                    wccols := HorizontalLayout {
                        width: wcflick.viewport-width;
                        spacing: Theme.space-4;
                        // ── COLUMN 1 · THE KEYS (262:11) — read-only rows off the LIVE keymap:
                        // the kb-* basic tokens + the CONTROLS model by pinned index (a rebound
                        // key shows its current binding — intended, owner-confirmed; main.rs
                        // welcome_panel_keybind_indices_pinned guards the ACTIONS order). Rate =
                        // FIVE SEPARATE keycaps (owner tweak — never a "1…5" range cap). Arrow
                        // tokens render as glyphs only at their defaults.
                        WcCol {
                            SectionLabel { text: @tr("falcon" => "1 · THE KEYS"); }
                            SettingsGroup {
                                VerticalLayout {
                                    // v0.8.116 (D-B, owner ruling "use real components for better
                                    // consistency"): the REAL Settings card. Columns 1 and 3 rendered on
                                    // the welcome-local `WcCard` — a hand-built Theme.block/radius-ctrl
                                    // rectangle with its own 16/14/16 insets — while column 2 had been
                                    // migrated to `SettingsGroup` in v0.8.81, so one panel showed two
                                    // card grammars side by side and a future change to the Settings card
                                    // would have reached only the middle column. The body hangs the
                                    // Settings 12px side padding on its own wrapper (the `title == ""`
                                    // pass-through form SettingsGroup documents, and exactly what the
                                    // column-2 cards do), so every row in this panel now sits on the
                                    // same 296px group-child inner as every row in Settings.
                                    // v0.8.117 (F6/F9 + the owner question): the FULL Settings titled-card
                                    // rhythm — pt16 / pb12 / sp9, the values panels.slint's SettingsGroup
                                    // uses for a titled card and that column 2's "Quick benchmark" card
                                    // already ran. v0.8.116 unified the CONTAINER and the HORIZONTAL inset
                                    // only, which left the panel showing three vertical rhythms after a
                                    // change whose stated purpose was that one Settings-card edit reaches
                                    // every column. The before→after table, recorded because v0.8.116
                                    // moved the top inset silently:
                                    //   side   16 → 12  (v0.8.116, the ruling; 288 → 296 inner)
                                    //   top    14 → 16  (v0.8.116, UNRECORDED — the mock's measured 14,
                                    //                    Figma 262:11/15, became the Settings card's 16)
                                    //   bottom 16 → 12  (v0.8.117)
                                    //   spacing 12 → 9  (v0.8.117; Theme.space-3 → the group's own 9px)
                                    // The mock's looser rhythm is deliberately retired ON THE WELCOME: a
                                    // welcome row and a Settings row are now indistinguishable, which is
                                    // what "use real components for better consistency" asks for. The rig
                                    // row pins BOTH columns' top inset, content pitch AND bottom inset
                                    // alongside the horizontal one, so none of them can drift back silently.
                                    // (v0.8.118, V2: v0.8.117 claimed all of that but measured only the KEYS
                                    // column's top and pitch -- WkRow exists in column 1 alone -- so restoring
                                    // either wrapper's pb16/sp12 failed nothing on the COLOUR card, and nothing
                                    // anywhere measured a bottom inset. Both columns, all three insets, now.)
                                    padding-left: 12px; padding-right: 12px; padding-top: 16px; padding-bottom: 12px;
                                    spacing: 9px; // the Settings titled-card content rhythm (panels.slint SettingsGroup)
                                    WkRow { label: @tr("falcon" => "Browse");
                                        KeyHint { text: root.kb-prev == "Left" ? "←" : root.key-name(root.kb-prev); }
                                        KeyHint { text: root.kb-next == "Right" ? "→" : root.key-name(root.kb-next); }
                                    }
                                    // v0.8.119 (design-sweep Y54): the only hardcoded BEHAVIOUR
                                    // claim in a column whose every other cell reads live state.
                                    // Settings INPUT → "Press current rating again to clear"
                                    // turns it off; the guide then taught a gesture that does
                                    // nothing. Common-case copy: the default is ON, so the
                                    // fuller label is the resting one and the OFF state gets the
                                    // plain verb.
                                    WkRow { label: root.same-key-clear ? @tr("falcon" => "Rate — same key clears") : @tr("falcon" => "Rate");
                                        KeyHint { text: root.keybinds[0].key; }
                                        KeyHint { text: root.keybinds[1].key; }
                                        KeyHint { text: root.keybinds[2].key; }
                                        KeyHint { text: root.keybinds[3].key; }
                                        KeyHint { text: root.keybinds[4].key; }
                                    }
                                    wkmarks := WkRow { label: @tr("falcon" => "Flag · Reject · Unmark");
                                        KeyHint { text: root.keybinds[6].key; }
                                        KeyHint { text: root.keybinds[7].key; }
                                        KeyHint { text: root.keybinds[8].key; }
                                    }
                                    // v0.8.184 (D1, OWNER RULING): the chord, taught where every
                                    // other key in the app is taught.
                                    //
                                    // THE CAPS COME FROM THE PLATFORM TABLE (v0.8.184 review W2).
                                    // Not being rebindable is why these are absent from the live
                                    // keymap the rows above read — it is NOT a reason to hardcode
                                    // them, because the axis that matters here is the OTHER one:
                                    // the chord is spelled Ctrl+Z on Windows and ⌘Z on macOS, and
                                    // `sc-undo` / `sc-redo` are exactly the published pair (the
                                    // `sc-copy` precedent). "Click", the arrows and Esc stay
                                    // literal because they are the SAME on both platforms.
                                    wkundo := WkRow { label: @tr("falcon" => "Undo · Redo");
                                        KeyHint { text: root.sc-undo; }
                                        KeyHint { text: root.sc-redo; }
                                    }
                                    wkcompare := WkRow { label: @tr("falcon" => "Compare A|B");
                                        KeyHint { text: root.keybinds[10].key; }
                                    }
                                    WkRow { label: @tr("falcon" => "Compare: swap · pin");
                                        KeyHint { text: root.key-name(root.kb-cmpswap); }
                                        KeyHint { text: root.key-name(root.kb-cmppin); }
                                    }
                                    WkRow { label: @tr("falcon" => "Zoom 1:1 — {0} resets", root.keybinds[13].key);
                                        KeyHint { text: @tr("falcon" => "Click"); }
                                    }
                                    WkRow { label: @tr("falcon" => "Immersive full screen");
                                        KeyHint { text: root.keybinds[14].key; }
                                    }
                                    wkdelete := WkRow { label: @tr("falcon" => "Delete (always confirms)");
                                        KeyHint { text: root.key-name(root.kb-del); }
                                    }
                                    // ── v1.0.0-rc (queue item 27, sheet 2.1 B8, OWNER RULING): THE CARD
                                    // ── SAYS THE RIGHT-CLICK MENU EXISTS. ────────────────────────────
                                    // "the welcome-card line 'Right-click a photo for everything else'."
                                    // This column teaches eleven keys and has never mentioned the surface
                                    // that carries every command they cannot reach — the L25 class one
                                    // level up: not a recovery gap but a DISCOVERABILITY one, on the app's
                                    // one first-run teaching surface.
                                    //
                                    // The card's own grammar is caps LEFT, label right, so the sentence
                                    // reads across the row as [Right-click] a photo for everything else —
                                    // which is the owner's sentence, unbroken. The cap is a LITERAL like
                                    // "Click" and the arrows two rows up, and for the same reason: a
                                    // right-click is the same gesture on both platforms and is not a
                                    // rebindable action, so there is no keymap or platform field to read.
                                    wkmenu := WkRow { label: @tr("falcon" => "a photo for everything else");
                                        KeyHint { text: @tr("falcon" => "Right-click"); }
                                    }
                                    // footer link → Settings (262:69; no scroll-to machinery exists for the
                                    // settings Flickable — opening Settings is the whole action). v0.8.77:
                                    // 22px → 16px (the mock's link line is 13px on the card's 12px gap; 16
                                    // keeps a hair of hit height over the text without the old +9px pitch).
                                    // v0.8.119 (design-sweep Y76): the link named a DESTINATION the
                                    // click does not reach. Settings is one Flickable, remounted per
                                    // open so viewport-y resets to 0, and CONTROLS is the seventh
                                    // SectionLabel of eight — the first-run reader was dropped at
                                    // INPUT, ~2500-3000px above it, having been promised
                                    // "Settings · Controls" (L17: a label is a contract).
                                    // ROUTE TAKEN — the ruling's honest-label fallback, not the
                                    // anchor. Anchoring needs the CONTROLS SectionLabel's y, and that
                                    // id lives inside the panel's mount-gated `if`, which nothing
                                    // outside can read (the same scope wall documented on hudclip's
                                    // `path-shown`); the panel does not exist yet when this click
                                    // runs, so there is no element to write viewport-y on, and every
                                    // shape that works around it (an init/`changed` handler that
                                    // fires off the first layout pass, or a Timer) is new machinery
                                    // riding on layout timing. The label now states what happens and
                                    // the muted sub-line says where to look — the same two-line
                                    // shape the ruling names for the macOS Help twin.
                                    Rectangle {
                                        height: 16px;
                                        wclink := Text {
                                            width: 100%; height: 100%;
                                            text: @tr("falcon" => "All shortcuts + change keys → Settings");
                                            color: Theme.accent; font-size: Theme.font-sm; font-weight: 600;
                                            vertical-alignment: center; horizontal-alignment: left;
                                        }
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.welcome-open = false; root.settings-open = true; }
                                        }
                                    }
                                    Text {
                                        text: @tr("falcon" => "in the CONTROLS section");
                                        color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap;
                                    }

                                }
                            }
                            // ── v0.8.169 (item 8, OWNER, from his annotated screenshot): THE WHEEL
                            // ── CARD MOVES FROM COLUMN 2 INTO COLUMN 1. ─────────────────────────
                            // One-click setup uses the existing platform association callbacks.
                            if root.file-assoc-visible || root.assoc-mac-mode : SettingsGroup {
                                title: @tr("falcon" => "File associations");
                                VerticalLayout {
                                    padding-left: 12px; padding-right: 12px; spacing: Theme.space-2;
                                    Text { text: @tr("falcon" => "Falcon is compatible with JPEG, PNG, TIFF, HEIC/HEIF, WebP, GIF, BMP, JPEG XL and camera RAW.");
                                           color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap; }
                                    welcome-assoc-all := ActionBtn { label: @tr("falcon" => "Apply to all"); primary: true;
                                        clicked => { root.apply-all-associations(); } }
                                    if root.assoc-status != "" : Text { text: root.assoc-status;
                                        color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap; }
                                }
                            }
                        }
                        // ── COLUMN 2 · THE FEEL (262:13) — the REAL ToggleRow on the live
                        // wheel-nav setting, the Quick-benchmark block (existing machinery +
                        // bench-running guard; the worker's v0.8.67 panic guard means a failed
                        // run can never strand this panel), and the RECOMMENDED sub-card fed by
                        // Rust's bench_recommendation.
                        // v0.8.81 (owner: "broken down into separate sections like in the setting
                        // panel"): the column is TWO sibling Settings cards under the floating
                        // label, replacing the single WcCard + HRule separator:
                        //   1. the wheel toggle = a SettingsGroup hosting the STOCK flush ToggleRow
                        //      + the 12px-side caption subline — the Adaptive Hi-Res grammar
                        //      VERBATIM (~3003). ToggleRow's own comment documents the split:
                        //      captioned/related rows ride transparent inside the group's block
                        //      card; the lone bg:block standalone form never carries a caption
                        //      anywhere in Settings, so this captioned toggle takes the group
                        //      form. The v0.8.79 x:-pad-h escape hack dies here — the group IS
                        //      the card now, there is no host padding to escape (the L7 class
                        //      closed structurally; composed label-x stays 12px from the card
                        //      edge, identical to every Settings row).
                        //   2. Quick benchmark = the G12 titled tuner-card (SettingsGroup title
                        //      slot: pt16/pb12/sp9, title at font-body/12px sides/7px below,
                        //      children hang their own 12px sides — the Settings Fast View card
                        //      ~3040 is the reference; it hosts the same Run-benchmark machinery
                        //      there). The old hand-styled font-body/500 sub-header is ABSORBED
                        //      by the title slot (font-body/regular — the Settings titled-card
                        //      weight). The RECOMMENDED sub-card KEEPS its 262:80 nesting (one
                        //      surface step back DOWN, base-on-block + rim) inside this card:
                        //      Settings has NO recommendation-card grammar at all (its bench
                        //      result is a plain inline text), so the owner-approved Figma
                        //      nesting stands.
                        WcCol {
                            SectionLabel { text: @tr("falcon" => "2 · THE FEEL"); }
                            SettingsGroup {
                                VerticalLayout {
                                    padding-top: 0px; padding-bottom: 12px; spacing: 0px;
                                    ToggleRow {
                                        label: @tr("falcon" => "Mouse wheel changes photo"); on: root.wheel-nav;
                                        toggled => { root.wheel-nav = !root.wheel-nav; }
                                    }
                                    VerticalLayout {
                                        padding-left: 12px; padding-right: 12px;
                                        Text { text: @tr("falcon" => "Off = wheel zooms. Trackpads: two-finger scroll browses when on.");
                                               color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap; }
                                    }
                                }
                            }
                            // v0.8.169 (item 8): the wheel card LEFT this column for column 1 (see
                            // the note at its new site). The Adaptive Hi-Res inner grammar it wore
                            // — pt0 so the 44px stock row IS the card's top inset, caption flush
                            // under it at the row's own 12px label inset, pb12 card bottom — moved
                            // with it, unchanged.
                            SettingsGroup {
                                title: @tr("falcon" => "Quick benchmark");
                                VerticalLayout {
                                    padding-left: 12px; padding-right: 12px;
                                    // v0.8.81 hotfix 2: the intro stays honest per state — with no folder
                                    // open the run measures generated frames, not "your own photos".
                                    // v0.8.119 (design-sweep O37): keyed on `bench-synth-eff`, the
                                    // SAME predicate Rust runs (force_synthetic || the persisted seg),
                                    // not on empty-state alone. With a folder open and Settings →
                                    // "Benchmark with" on Target size this card promised "~30 s on your
                                    // own photos" and then measured generated frames.
                                    Text { text: root.bench-synth-eff
                                            ? @tr("falcon" => "~30 s. Finds this machine's honest speed limit and the sharpest preview it can hold.")
                                            : @tr("falcon" => "~30 s on your own photos. Finds this machine's honest speed limit and the sharpest preview it can hold.");
                                           color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap; }
                                }
                                // v0.8.81 hotfix 2 (owner): the app opened directly (no folder) is the
                                // COMMON first-launch case — the marquee action must work there. The
                                // Settings target-size FIELD (Fast View card ~3102: same TextField
                                // grammar, the SAME bench-target-mp-text property + set-bench-target-mp
                                // callback — one shared setting, not a copy that can drift) auto-shows
                                // when no folder is open, and Run forces the synthetic path for THAT run
                                // only. Owner layout ruling: the field rides INLINE in the button row's
                                // free width in the COMPACT form (field + "MP", no "Target size" label —
                                // the label form doesn't fit beside the fixed 150px button; the hint line
                                // below carries the naming instead). Occupancy at the 296px group-child
                                // inner: 150 button + 12 gap + 64 field + 8 + ~17 "MP" ≈ 251px → ~45px
                                // slack into the trailing stretch spacer.
                                HorizontalLayout {
                                    padding-left: 12px; padding-right: 12px; spacing: 12px;
                                    ActionBtn {
                                        width: 150px;
                                        label: root.bench-running ? @tr("falcon" => "Benchmarking…") : @tr("falcon" => "Run benchmark");
                                        variant: 0; primary: true;
                                        // v0.8.68 (D-audit FIX 1) honest-disabled this with no folder open
                                        // (the bench guard would silently no-op). v0.8.81 hotfix 2 RETIRES
                                        // the disable: empty-state now runs the Settings "Target size"
                                        // synthetic bench (run-benchmark(true) — force-synthetic for this
                                        // run only, the persisted seg untouched), so the marquee action
                                        // works on a true first launch. A folder open → today's real-photos
                                        // run, unchanged (false = honor the Settings seg).
                                        enabled: !root.bench-running;
                                        clicked => { if (!root.bench-running) { root.run-benchmark(root.empty-state); } }
                                    }
                                    if root.empty-state : HorizontalLayout {
                                        spacing: 8px;
                                        // the 30px field centred in the 34px button row (the codebase's
                                        // standard fixed-height cross-axis centring wrapper).
                                        VerticalLayout {
                                            alignment: center;
                                            TextField { field-width: 64px; value: root.bench-target-mp-text;
                                                accepted(t) => { if (t != "") { root.set-bench-target-mp(t); } keys.focus(); } }
                                        }
                                        Text { text: @tr("falcon" => "MP"); color: Theme.text-mute; font-size: Theme.font-md; vertical-alignment: center; }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                // v0.8.81 hotfix 2: the empty-state hint now explains the synthetic source
                                // AND names the inline size field (replaces v0.8.68's "Open a folder
                                // first" line — the run works now).
                                // v0.8.119 (design-sweep O37): …and the OTHER synthetic route says so
                                // too. With a folder open the inline MP field is not mounted (the size
                                // lives on the Settings card), so that state gets its own sentence
                                // naming where the setting is, instead of inheriting a "No folder
                                // open" line that would be flatly untrue.
                                if root.bench-synth-eff : VerticalLayout {
                                    padding-left: 12px; padding-right: 12px;
                                    Text {
                                        text: root.empty-state
                                            ? @tr("falcon" => "No folder open — it benchmarks generated photos at this target size, then deletes them.")
                                            : @tr("falcon" => "Settings → Fast View → “Benchmark with” is set to Target size, so this measures generated photos at that size, not this folder.");
                                        color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap;
                                    }
                                }
                                // live progress WHILE running ("generating test images…" / "benchmarking…");
                                // otherwise the last bench-text. v0.8.81 hotfix 2: empty-state results show
                                // too — the welcome's synthetic run lands its breakdown here (the old
                                // !empty-state guard predates empty-state being able to run at all). The
                                // recommendation lands in the card below (full detail on the Settings card).
                                if root.bench-running || root.bench-text != "" : VerticalLayout {
                                    padding-left: 12px; padding-right: 12px;
                                    Text { text: root.bench-text; color: Theme.text-mute;
                                           font-size: Theme.font-sm; wrap: word-wrap; }
                                }
                                // v0.8.119 (design-sweep O37): the provenance caption, on the IDENTICAL
                                // gate the Settings Fast View card uses (v0.8.119 Y64 made that gate
                                // symmetric). The welcome could already display a result whose source
                                // contradicts the live seg — it is where the forced-synthetic run is
                                // launched from — and it was the one surface with no way to say so.
                                if root.bench-synthetic != root.bench-use-synthetic && root.bench-synth-note != "" : VerticalLayout {
                                    padding-left: 12px; padding-right: 12px;
                                    Text { text: root.bench-synth-note; color: Theme.text-mute;
                                           font-size: Theme.font-sm; wrap: word-wrap; }
                                }
                                // v0.8.174 (F2c): the Full tier's clamp caption, on the IDENTICAL
                                // mount the Settings Fast View card uses — this is the surface the
                                // welcome's Quick benchmark reports into, so it is the one that
                                // must not print a Full number as if the frame were the camera's.
                                if root.bench-clamp-note != "" : VerticalLayout {
                                    padding-left: 12px; padding-right: 12px;
                                    Text { text: root.bench-clamp-note; color: Theme.text-mute;
                                           font-size: Theme.font-sm; wrap: word-wrap; }
                                }
                                // the RECOMMENDED sub-card (262:80): one surface step back DOWN
                                // (base-on-block) + the hairline rim; small-caps label at font-xs.
                                // 12px-side wrapper = the group-child inset every sibling row uses.
                                // v0.8.156 (C2): the shape itself is now `BenchRecCard` (declared at
                                // the top of this file) because Settings → Fast View mounts the same
                                // card. Same properties, same callback, same host (a SettingsGroup
                                // child behind the same 12px wrapper) — this instance renders what
                                // it always did; the second host is what is new.
                                VerticalLayout {
                                    padding-left: 12px; padding-right: 12px;
                                    // v0.9.66: `hint` carries this branch's Rust-composed
                                    // placeholder line (`support::bench_rec_card`).
                                    BenchRecCard {
                                        rec-text: root.bench-rec-text;
                                        applied: root.bench-rec-applied;
                                        hint: root.bench-rec-hint;
                                        apply => { root.apply-bench-rec(); }
                                    }
                                }
                            }
                        }
                        // ── COLUMN 3 · THE COLOUR (262:15) — SHORT panel copy (the long
                        // OS-concept paragraph belongs to the Settings card only), ONE primary
                        // accent auto-detect with a bare muted "Recommended" marker BESIDE it
                        // (v0.8.154 / ruling Q4 — it used to be baked into the label; the SAME
                        // detect-monitor-icc path Settings drives, the column's most prominent
                        // action), COMPACT hugging gamut chips hand-wrapped into two left-packed
                        // rows (Slint has no wrap primitive; the trailing spacer absorbs the
                        // surplus so hug-chips never stretch), and two short live status lines.
                        WcCol {
                            SectionLabel { text: @tr("falcon" => "3 · THE COLOUR"); }
                            SettingsGroup {
                                VerticalLayout {
                                    // v0.8.116 (D-B): the REAL Settings card — see column 1. The
                                    // chips, the primary button and the status lines were already the
                                    // shared components (OptionChip / ActionBtn / Theme text tiers);
                                    // this was the last hand-built shape in the column.
                                    // v0.8.117 (F6/F9 + the owner question): the FULL Settings titled-card
                                    // rhythm — pt16 / pb12 / sp9, the values panels.slint's SettingsGroup
                                    // uses for a titled card and that column 2's "Quick benchmark" card
                                    // already ran. v0.8.116 unified the CONTAINER and the HORIZONTAL inset
                                    // only, which left the panel showing three vertical rhythms after a
                                    // change whose stated purpose was that one Settings-card edit reaches
                                    // every column. The before→after table, recorded because v0.8.116
                                    // moved the top inset silently:
                                    //   side   16 → 12  (v0.8.116, the ruling; 288 → 296 inner)
                                    //   top    14 → 16  (v0.8.116, UNRECORDED — the mock's measured 14,
                                    //                    Figma 262:11/15, became the Settings card's 16)
                                    //   bottom 16 → 12  (v0.8.117)
                                    //   spacing 12 → 9  (v0.8.117; Theme.space-3 → the group's own 9px)
                                    // The mock's looser rhythm is deliberately retired ON THE WELCOME: a
                                    // welcome row and a Settings row are now indistinguishable, which is
                                    // what "use real components for better consistency" asks for. The rig
                                    // row pins BOTH columns' top inset, content pitch AND bottom inset
                                    // alongside the horizontal one, so none of them can drift back silently.
                                    // (v0.8.118, V2: v0.8.117 claimed all of that but measured only the KEYS
                                    // column's top and pitch -- WkRow exists in column 1 alone -- so restoring
                                    // either wrapper's pb16/sp12 failed nothing on the COLOUR card, and nothing
                                    // anywhere measured a bottom inset. Both columns, all three insets, now.)
                                    padding-left: 12px; padding-right: 12px; padding-top: 16px; padding-bottom: 12px;
                                    spacing: 9px; // the Settings titled-card content rhythm (panels.slint SettingsGroup)
                                    Text { text: @tr("falcon" => "Photos are judged in colour. Match Falcon to this display once — it applies to every photo and the interface itself.");
                                           color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap; }
                                    // ── v0.8.154 (A2, owner ruling Q4): THE MARKER CONVERGES ON THE
                                    //    SETTINGS FORM. ────────────────────────────────────────────
                                    // Settings renders "Recommended" as BARE MUTED TEXT beside the
                                    // action (its row is ~40 lines up in this file: PillBtn + a
                                    // text-mute font-sm Text, vertically centred). This card baked
                                    // the same word INTO the button label — the one form ledger L8
                                    // names ("for hints/annotations, default to bare Text"), and the
                                    // owner has already corrected this exact marker twice on the
                                    // Settings side (v0.8.76 Chip → text, v0.8.77 → font-sm). Same
                                    // word, same ramp, same colour, same vertical centring; the
                                    // BUTTON keeps its accent primary variant, which is this
                                    // column's deliberate "most prominent action" and is not what
                                    // the ruling touched.
                                    //
                                    // L5 (widest-state row arithmetic — this row has exactly ONE
                                    // state, both strings are literals, so the widest state IS the
                                    // only state): card inner width = 296px (padding-left/right 12
                                    // on the 320px column). "Recommended" at font-sm 11 hugs at
                                    // ~67px; spacing = Theme.space-2 = 8. The button is the row's
                                    // stretch carrier, so it takes 296 − 8 − 67 ≈ 221px, and its own
                                    // label "Auto-detect this monitor" at font-md 12 / 600 measures
                                    // ~166px — ~55px of slack, and ActionBtn centres its Text, so
                                    // the label cannot clip the way the old 38-character one would
                                    // have if the card had ever narrowed.
                                    HorizontalLayout {
                                        spacing: Theme.space-2;
                                        ActionBtn {
                                            horizontal-stretch: 1; // the row's absorber (the marker hugs)
                                            label: @tr("falcon" => "Auto-detect this monitor");
                                            variant: 0; primary: true;
                                            clicked => { root.detect-monitor-icc(); }
                                        }
                                        Text {
                                            text: @tr("falcon" => "Recommended"); color: Theme.text-mute; font-size: Theme.font-sm;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Text { text: @tr("falcon" => "or pick the gamut yourself:"); color: Theme.text-mute; font-size: Theme.font-sm; }
                                    HorizontalLayout {
                                        spacing: Theme.space-1h;
                                        // v0.8.119 (Y66/Y77): the shared label array — see the Settings twin.
                                        OptionChip { stretch: false; label: root.gamut-labels[0]; active: root.output-gamut == 0; clicked => { root.set-output-gamut(0); } }
                                        OptionChip { stretch: false; label: root.gamut-labels[1]; active: root.output-gamut == 1; clicked => { root.set-output-gamut(1); } }
                                        OptionChip { stretch: false; label: root.gamut-labels[5]; active: root.output-gamut == 5; clicked => { root.set-output-gamut(5); } }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                    HorizontalLayout {
                                        spacing: Theme.space-1h;
                                        OptionChip { stretch: false; label: root.gamut-labels[2]; active: root.output-gamut == 2; clicked => { root.set-output-gamut(2); } }
                                        OptionChip { stretch: false; label: root.gamut-labels[3]; active: root.output-gamut == 3; clicked => { root.set-output-gamut(3); } }
                                        // v0.8.82 (tester issue 1): the CUSTOM chip — the welcome card
                                        // mirrors the Settings grammar exactly (same component, same
                                        // active binding, same label source, same select-or-pick click),
                                        // so Auto-detect's arm (gamut 4, "Custom: <desc>") LIGHTS a chip
                                        // right here instead of leaving the click's only feedback in the
                                        // muted "Now:" line. Shown unconditionally like Settings
                                        // ("Custom…" until a profile is armed). A LONG armed label
                                        // ("Custom: <profile>", Rust-gated custom-gamut-long) moves to
                                        // its OWN full row below — the Settings v0.8.76 wrap approach,
                                        // never a sibling crush (mount-gated `if`, no space-holders).
                                        if !root.custom-gamut-long : OptionChip {
                                            stretch: false;
                                            label: root.custom-gamut-label;
                                            active: root.output-gamut == 4;
                                            dimmed: root.custom-icc-failed; // v0.8.104 (owner ruling)
                                            // v0.8.106: no `tip:` — OptionChip is not a Tip host (no cy
                                            // plumbing → the tip drew at the title bar). This card's
                                            // failure-warning row already names the recovery in place.
                                            clicked => {
                                                if (root.custom-icc-path != "" && !root.custom-icc-failed) { root.set-output-gamut(4); }
                                                else { root.pick-custom-icc(); }
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                    if root.custom-gamut-long : HorizontalLayout {
                                        spacing: Theme.space-1h;
                                        // the spanning long-label chip STRETCHES across the card row
                                        // (the Settings spanning-cell behaviour verbatim) — options are
                                        // cells, only actions hug.
                                        OptionChip {
                                            label: root.custom-gamut-label;
                                            active: root.output-gamut == 4;
                                            dimmed: root.custom-icc-failed; // v0.8.104 (owner ruling)
                                            // v0.8.106: no `tip:` — see the short-label chip above.
                                            clicked => {
                                                if (root.custom-icc-path != "" && !root.custom-icc-failed) { root.set-output-gamut(4); }
                                                else { root.pick-custom-icc(); }
                                            }
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: Theme.space-1;
                                        // Figma 262:98: the status stack sits 6px further off the chips (pt-6)
                                        // than the card's 12px rhythm alone (v0.8.77 spacing pass).
                                        padding-top: Theme.space-1h;
                                        // v0.8.68 (D-audit FIX 2): the DCI-P3-vs-Display-P3 caption, sat with
                                        // the status lines directly under the chips (same string as Settings).
                                        // v0.8.77 (owner): standard description size, not the badge-only font-xs.
                                        Text {
                                            text: root.dci-p3-caption;
                                            color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap;
                                        }
                                        Text {
                                            // live status (262:99): the CURRENT output leads; the laptop
                                            // reassurance line only fits the sRGB default.
                                            // v0.8.104 (Round-A C13): the reassurance is STATE-GATED.
                                            // In a boot-failure session output-gamut == 0 is a FALLBACK,
                                            // and the user is by definition not "most laptops" - they are
                                            // the person who loaded a calibrated profile. The card was
                                            // rendering a reassurance and its own contradiction back to
                                            // back (the warn row is the very next sibling). COMMON-CASE
                                            // COPY inverted: a rare state that IS live gets state-derived
                                            // wording, and only while it lasts.
                                            // v0.8.105 (W8): gated on the FALLBACK LATCH, not on the
                                            // failure flag. `custom-icc-failed` arms for ANY remembered
                                            // profile that fails to install — including the reachable
                                            // case "the user picked sRGB while a profile stayed
                                            // remembered, then the profile went missing", where sRGB is
                                            // exactly what he chose and nothing fell back. The card was
                                            // then calling his own choice a fallback while the warn row
                                            // directly below (deliberately worded to say nothing about
                                            // this session) said the opposite. `custom-icc-hold-gamut ==
                                            // 4` is set ONLY in the persisted-Custom arm, i.e. only when
                                            // this session really did drop to sRGB.
                                            text: root.output-gamut == 0 ? (root.custom-icc-hold-gamut == 4
                                                    ? @tr("falcon" => "Now: sRGB (fallback).")
                                                    : @tr("falcon" => "Now: sRGB — right for most laptops."))
                                                : @tr("falcon" => "Now: {0}.", root.output-gamut == 4 ? root.custom-gamut-label
                                                : root.gamut-labels[root.output-gamut]);
                                            color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap;
                                        }
                                        // v0.8.100 (A4): the same honest failure line as the Settings
                                        // card, on the sibling surface — without it the "Now: sRGB —
                                        // right for most laptops." line above reads as a normal default
                                        // to a photographer whose calibrated profile just failed to load.
                                        if root.custom-icc-failed : Text {
                                            // v0.8.104 (Round-A C12): this column's only picker
                                            // affordance is the Auto-detect button ABOVE - there is no
                                            // "below" here, so the direction points where the control is.
                                            text: root.custom-icc-warn + " " + @tr("falcon" => "Or use Auto-detect above.");
                                            color: Theme.warn; font-size: Theme.font-sm; wrap: word-wrap;
                                        }
                                        // v0.8.120 (design-sweep O39): the auto-detect / load-profile
                                        // RESULT, in the panel that owns the button. Both failure
                                        // paths were toast-only, and this panel's scrim + its mount
                                        // order put the toast layer UNDERNEATH it — so clicking the
                                        // card's one accented "(recommended)" action on a display
                                        // whose profile is not a matrix/TRC ICC (or where WCS/GDI
                                        // detection returns nothing) produced no chip change, no
                                        // change to the "Now:" line, and an explanation the
                                        // first-run user could not read or reach. This is the third
                                        // line of the card's own status stack (the sweep's smaller
                                        // route: keep the feedback where the action is). Rust
                                        // clears it on success, and `changed welcome-open` clears it
                                        // on close so it can never greet the next open.
                                        if root.gamut-detect-note != "" : Text {
                                            text: root.gamut-detect-note;
                                            color: Theme.warn; font-size: Theme.font-sm; wrap: word-wrap;
                                        }
                                        Text { text: @tr("falcon" => "Wide-gamut or calibrated screen? Use Auto-detect.");
                                               color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap; }
                                        // v0.8.107 (owner ruling D3): the card is otherwise unchanged — it
                                        // configures the display this window is on, which is exactly what
                                        // "this display" has always meant. This ONE line is added, and only
                                        // when a second display is really there (COMMON-CASE COPY: a
                                        // single-display machine reads nothing about multi-display setups).
                                        // Mount-gated with `if`, never `visible:`.
                                        if root.display-multi : Text {
                                            text: @tr("falcon" => "More than one screen? Each display keeps its own setting — set the others up in Settings → Output colour gamut.");
                                            color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap;
                                        }
                                    }
                            
                                }
                            }
                        }
                    }
                    } // wcflick (D-audit FIX 3)
                    // footer (262:101): the quiet reopen note left; Skip for now (ghost) + Done
                    // (accent) right — all closes equivalent (Esc included; no wizard state).
                    HorizontalLayout {
                        spacing: Theme.space-2;
                        Text { text: @tr("falcon" => "Reopen anytime: Settings → “Show welcome”"); color: Theme.text-mute;
                               font-size: Theme.font-sm; vertical-alignment: center; horizontal-stretch: 1; }
                        // Settings → Developer → Widen controls to fit text: each button grows by as much
                        // as its label is wider than the English it was tuned for, so English keeps its
                        // width either way. ONE width binding per button, off = exactly 110 / 88 (L47).
                        wcskip := ActionBtn { width: max(110px, Theme.fit-text ? 110px + self.label-width - wcskip-en.preferred-width : 0px);
                            label: @tr("falcon" => "Skip for now"); variant: 2; clicked => { root.welcome-open = false; } }
                        wcdone := ActionBtn { width: max(88px, Theme.fit-text ? 88px + self.label-width - wcdone-en.preferred-width : 0px);
                            label: @tr("falcon" => "Done"); variant: 0; primary: true; clicked => { root.welcome-open = false; } }
                    }
                }
                // The two footer labels in the English they were tuned for, never drawn: the
                // widening above measures a translation against these (ActionBtn's font).
                wcskip-en := Text { visible: false; text: "Skip for now"; font-size: Theme.font-md; font-weight: 600; }
                wcdone-en := Text { visible: false; text: "Done"; font-size: Theme.font-md; font-weight: 600; }
                // v0.8.68 (D-audit FIX 3): the bottom-edge fade over the scroll region (paints AFTER
                // wcbox), sized to the Flickable's bottom edge; `more` hides it unless the columns
                // actually continue below (short content never wears a permanent smudge). Pure paint —
                // wheel/clicks reach the Flickable. wcbox fills this SolidPanel at (0,0), so wcflick's
                // own coords are panel-relative (the Settings setflick/PanelBottomFade pattern).
                PanelBottomFade {
                    x: wcflick.x; width: wcflick.width;
                    y: wcflick.y + wcflick.height - self.height;
                    more: wcflick.viewport-height + wcflick.viewport-y > wcflick.height + 1px;
                }
                // v0.8.120 (design-sweep O38): the SAME rule on the horizontal seam. The panel is a
                // fixed 1028px hug clamped to `parent.width - 24px`; below that the three columns
                // keep their fixed Theme.section-w and PAN inside wcflick, which clips — so on a
                // 1920x1080 laptop at 175% scaling (a 1097x617 logical desktop → a 965px boot
                // window) ~87px of "3 · THE COLOUR" is cut off, and at 200% roughly two thirds of
                // it, with the panel's ONLY overflow affordance covering the BOTTOM edge. `more`
                // uses viewport-x against the same +1px tolerance the bottom twin uses against
                // viewport-y, so a panel that fits wears no smudge.
                PanelRightFade {
                    y: wcflick.y; height: wcflick.height;
                    x: wcflick.x + wcflick.width - self.width;
                    more: wcflick.viewport-width + wcflick.viewport-x > wcflick.width + 1px;
                }
            }
        }

        // ── v0.9.16 (Round B assoc): the Mac FIRST-LAUNCH association popup (exactly once) ──
        // Mounted only on macOS (Rust opens it — directly at boot when the welcome was already
        // shown, else armed to follow the welcome's close; never stacked with it). Three choice
        // BUTTONS — None | RAW + JPG/HEIC | All — per the visual-thinkers rule: no Enter-accept
        // (Enter falls through to the modal-gated key path, inert), Esc = None (the same plain
        // close; the changed-observer latches assoc-prompt-shown either way). The chosen set
        // applies through the capture-then-set LS path (assoc-prompt-choice → Rust). Scaffold =
        // the confirm-dialog grammar: scrim + SolidPanel + device-pixel-snapped footer.
        if root.assoc-prompt-open : Rectangle {
            y: root.content-top;
            height: parent.height - self.y;
            width: 100%;
            background: Theme.scrim;
            TouchArea {} // block everything behind (title bar stays live above)
            SolidPanel {
                width: 440px; height: apbox.preferred-height;
                x: (parent.width - self.width) / 2;
                // v0.8.46 (Item 2) device-pixel snap — the bottom-anchored footer buttons' top edge
                // parked on an integer device pixel (the confirm-dialog arithmetic; last child =
                // space-4 pad + 34px buttons → panel-bottom − 50px).
                property <float> sfx: max(root.win-sf, 0.5);
                property <length> raw-y: (parent.height - self.height) / 2;
                property <length> btn-top: parent.y + self.raw-y + self.height - 50px;
                y: self.raw-y + Math.round(self.btn-top / 1px * self.sfx) / self.sfx * 1px - self.btn-top;
                apbox := VerticalLayout {
                    padding: Theme.space-4; spacing: Theme.space-3;
                    Text { text: @tr("falcon" => "Open photos with Falcon?"); color: Theme.text;
                           font-size: Theme.font-lg; font-weight: 600; wrap: word-wrap; }
                    Text { text: @tr("falcon" => "Falcon can be the default app for your photos. You can change this anytime in Settings.");
                           color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap; }
                    // The three choices, prominence-ordered (primary first, the quiet None last —
                    // the owner's None | RAW+JPG/HEIC | All enumeration, laid out for scanning).
                    VerticalLayout {
                        spacing: Theme.space-2;
                        ActionBtn { label: "RAW + JPG/HEIC"; variant: 0; primary: true;
                                    clicked => { root.assoc-prompt-choice(1); root.assoc-prompt-open = false; } }
                        ActionBtn { label: @tr("falcon" => "All supported formats"); variant: 0;
                                    clicked => { root.assoc-prompt-choice(2); root.assoc-prompt-open = false; } }
                    }
                    HorizontalLayout {
                        spacing: Theme.space-2;
                        ActionBtn { label: @tr("falcon" => "None — just list Falcon in “Open With”"); variant: 2;
                                    clicked => { root.assoc-prompt-choice(0); root.assoc-prompt-open = false; } }
                    }
                }
            }
        }

        // ── v0.8.159 (B2, OWNER RULING Q19): THE FLOATING EXIF PANELS ────────────────────────────
        // WINDOW-ROOTED, and that is the whole placement decision:
        //   • ABOVE the stage and both docked panels — they are what the user just asked for;
        //   • BELOW the context menus, which follow this block: a menu the user opened over a panel
        //     is the more recent intent;
        //   • window coordinates, so the spawn point is the right-click point unmodified and the
        //     clamp is against the whole window rather than a stage whose left edge moves with the
        //     grid dock;
        //   • present in immersive (the ruling: immersive closes NONE), where the title bar is gone
        //     and `top-limit` opens the extra 44px to them.
        //
        // ── v0.8.160 (R1/U1): AND UNMOUNTED UNDER ANY MODAL SHEET — L14'S ARBITER, AS A GATE. ────
        // The comment above used to claim these panels paint BELOW "every modal". They do not, and
        // could not: this block sits AFTER six of the seven `modal-open` terms (settings, loading,
        // the confirm dialog, the rotation reminder, export and welcome), so the panels painted OVER
        // those sheets and their TouchAreas stole the sheets' clicks — the L4/L14 pair, shipped.
        // REORDERING IS UNREACHABLE: `sel-open`, the export-running overlay, the toast card and
        // `notif-open` all sit between the sheets, so there is no position in this file that puts
        // the panels under every modal without also putting them under a surface the ruling says
        // they must float above.
        // So the arbiter becomes a MOUNT GATE — the welcome sheet's own anti-click-steal idiom
        // ("mount-gated (`if`) so it can never click-steal while hidden"), one screen up. Rust owns
        // the list, so x / y / pin / rows all survive the unmount and the panels come back in
        // place — EXCEPT the EXIF list's own scroll offset (Flickable-internal, deliberately not
        // modelled): a long list rescrolls to the top after a modal round-trip.
        // ACCEPTED SIDE EFFECT: a panel VANISHES behind a sheet instead of dimming
        // under its scrim — modal means modal. It also makes `support::esc_route`'s one reported
        // deviation TRUE BY CONSTRUCTION: while a modal is open there is no panel mounted for Esc
        // to close.
        //
        // `avail` is the height budget the component cannot compute for itself: the window, less
        // the title bar, less this panel's own chrome (2x16 padding + 28 header + 11 + 1 rule + 11)
        // and its two 8px screen margins, floored at 120px so a very short window still shows rows.
        // v0.8.162: the gate is the hoisted `float-exif-mounted` (== `!modal-open` AND a non-empty
        // list), so `blur-sampler-mounted` reads the SAME property this `if` does and the backdrop
        // is rebuilt exactly while these panels are on screen. The added length term changes
        // nothing here — an empty `for` mounted nothing anyway.
        if root.float-exif-mounted : Rectangle {
            for p[i] in root.float-exif : FloatingExif {
                name: p.name; pinned: p.pinned; rows: p.rows; px: p.x; py: p.y;
                win-w: root.width; win-h: root.height;
                top-limit: root.content-top + 8px;
                avail: max(120px, root.height - (root.content-top) - 100px);
                backdrop: root.blur-backdrop;
                sw: root.content-w; sh: root.content-h; ox: 0px; oy: root.content-top;
                // v0.8.160 (Y6b/Y7): the pin says what it is and what a click will do. Both
                // sentences live on the root (one source, read back by the L22 clear below and by
                // Rust's own close paths).
                tip-pinned: root.fx-tip-pinned; tip-following: root.fx-tip-following;
                close => { root.float-exif-close(i); }
                toggle-pin => { root.float-exif-toggle-pin(i); }
                moved(nx, ny) => { root.float-exif-moved(i, nx, ny); }
            }
        }

        // ── v1.0.0-rc (queue item 31, sheet 2.5): THE REVIEW PANEL'S HOVER PREVIEW ─────────────
        // Declared AFTER the floating EXIF panels (so a preview raised over one paints above it —
        // it appeared last, and Esc takes them in that same order) and BEFORE the context menu, the
        // drag overlay and the tip layers, which must all stay above it. An `if` MOUNT, never
        // `visible:`: L4, and the rig can only prove an absence for an element that is genuinely
        // unmounted (L49). The gate is repeated here beside the published flag so a card can never
        // outlive a popup by a tick.
        if root.sel-preview-shown && root.hover-preview-live : HoverPreview {
            win-h: root.height;
            cy: root.sel-hover-cy;
            box-w: root.sel-preview-w;
            box-h: root.sel-preview-h;
            img: root.sel-preview-img;
            loading: root.sel-preview-loading;
            sf: root.win-sf;
        }

        // ── right-click context menu (glass, design-system styled prototype) ──
        if root.ctx-open : Rectangle {
            y: root.content-top;
            height: parent.height - self.y;
            width: 100%;
            TouchArea {
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) { root.ctx-open = false; }
                }
            }
            ctxpanel := GlassPanel {
                init => {
                    root.context-menu-x = self.x; root.context-menu-y = self.y;
                    root.context-menu-w = self.width; root.context-menu-h = self.height;
                }
                changed x => { root.context-menu-x = self.x; }
                changed y => { root.context-menu-y = self.y; }
                changed width => { root.context-menu-w = self.width; }
                changed height => { root.context-menu-h = self.height; }

                // v0.8.131 (F-P2 rule 2): 224px. The two menus are TWINNED and the Selection-tile
                // one needs the width for "Select new / edited (unreadable)"; this menu's widest
                // row is ~162px, so the extra 8px is free here and keeps the pair identical.
                // Language packs (round 2): with Settings → Developer → Widen controls to fit text on, the
                // menu grows to its widest row, capped at the window less the 8px margins the x
                // clamp keeps. Off: exactly 224px. Owner ruling (4 October): the rows set the width,
                // never the filename header (its preferred width is zeroed below; it elides).
                width: max(224px, Theme.fit-text ? min(ctxbox.preferred-width, root.width - 16px) : 0px);
                // v0.8.131 (F-P2 rule 4): the max(8px, …) FLOOR the sort/path/open menus all carry.
                // The one-sided form pins the right edge and goes NEGATIVE on a window narrower
                // than the menu, parking it off the left edge with its labels unreachable.
                x: max(8px, min(root.ctx-x, root.width - self.width - 8px));
                // ctx-y is stage-relative and this overlay now starts at the stage top → use it directly.
                // v0.8.121 (Round-B fix F11 = audit A20, L5): a DEFENSIVE clamp. Y56's three new rows
                // grew this menu 517px → 616px, and the y binding is one-sided: it pins the BOTTOM
                // and has no top floor, so once the menu is taller than the overlay the else-arm goes
                // negative and EVERY right-click parks it above the window edge, silently clipping
                // the Rating stars and the new rows off the top — at boot on a 1080p laptop at 175%
                // scaling (the configuration this file's own O38 comment reasons from) and on any
                // window shortened toward the deliberate 400px minimum. `max(0px, …)` is the floor;
                // the height cap plus the Flickable below is the absorber, and it ENGAGES ONLY when
                // it would overflow: while the menu fits, height == ctxbox.preferred-height ==
                // viewport-height and the Flickable cannot scroll, so a normal-height window renders
                // exactly as it does today.
                y: max(0px, root.ctx-y < parent.height - self.height - 8px
                   ? root.ctx-y
                   : parent.height - self.height - 8px);
                height: min(ctxbox.preferred-height, parent.height - 16px);
                backdrop: root.menu-blur-covers ? root.menu-backdrop : root.blur-backdrop;
                // ── v0.8.169 (item 1, OWNER RULING): THE MENU'S BASE IS THE FLOATING PANELS' FROST ──
                // "the blurred glass effect worked quite well on the floating exif panels, also change
                // the base texture of the context menu to the same blurred glass."
                //
                // THE PANEL WAS ALREADY A `GlassPanel` AND THAT CHANGED NOTHING, which is exactly why
                // this is a one-word edit and not a restyle. `GlassPanel`'s frosted `Image` is
                // `visible: root.glassy`, and `glassy == hover-glass` — so every call site that leaves
                // the flag at its default is handed a backdrop it never samples and renders the flat
                // `Theme.base` fill instead (panels.slint records this; it is also why
                // `blur-sampler-mounted` exists). Turning the flag on IS the ruling: same component,
                // same tint recipe (#1c1c1cc8 over the stage-aligned blur), same border, same shadow
                // as `FloatingExif`, which is the reference surface the owner named.
                //
                // `hot` IS DELIBERATELY LEFT FALSE, and that is a judgment worth stating. On the EXIF
                // panels `hot` fades the opaque surface in while the pointer is over them — a panel
                // you are READING should stop being translucent. A menu is the opposite case: the
                // pointer is inside it for the whole of its life (it opens AT the cursor), so wiring
                // `hot` to a hover would solidify it on the first frame and the ruling would render as
                // a no-op. Rows keep their own `Theme.hover` wash, which is what actually tracks the
                // pointer here.
                //
                // THE OFFSETS ARE ALREADY LIVE, and the v0.8.162 contract is why. `ox`/`oy` state where
                // the STAGE origin sits in the PARENT's coordinate space, and `GlassPanel` lands the
                // canvas at `ox - root.x` / `oy - root.y` — so the menu's own moving `x`/`y` bindings
                // are subtracted per frame and the backdrop stays pinned to the stage while the menu
                // follows the cursor (`FloatingExif` proves the mechanism: it is DRAGGED and its
                // offsets are constants too). The two values below are correct for THIS host and were
                // derived, not inherited: the overlay this panel sits in is window-rooted at x = 0 and
                // y = `immersive ? 0 : 44`, and the stage's own window-space origin is
                // (`stage.x`, `immersive ? 0 : 44`) — so the x offset is `stage-x` and the y offset is
                // 0 in BOTH immersive states. (Contrast the window-rooted floating panels, which are
                // NOT inside this overlay and therefore pass `oy: immersive ? 0px : 44px`.)
                hover-glass: true;
                sw: root.menu-blur-covers ? root.menu-blur-w : root.content-w;
                sh: root.menu-blur-covers ? root.menu-blur-h : root.content-h;
                ox: root.menu-blur-covers ? root.menu-blur-x : 0px;
                oy: root.menu-blur-covers ? root.menu-blur-y : 0px;
                TouchArea {}
                ctxflick := Flickable {
                    // v0.8.121 (F11): the notifflick absorber pattern — viewport-height is the
                    // body's own preferred height, so this is inert (nothing to scroll) at every
                    // window tall enough for the menu, and becomes the only way the clipped rows
                    // are reachable at every window that is not.
                    viewport-height: ctxbox.preferred-height;
                    ctxbox := VerticalLayout {
                        padding-top: 3px; padding-bottom: 3px; padding-left: 0px; padding-right: 0px; spacing: 3px; // v0.8.40 (FIX 1): 3px body padding + 3px gaps — with the full-cell MenuItem wash every visible gap around a wash is exactly 3px (the user rule)
                        // ── v0.8.158 (B1a, OWNER RULING Q31): the SUBJECT first, the controls after.
                        // `ctx-header` is composed in Rust by `on_ctx_populate` (support::ctx_menu_header)
                        // — the filename of the resolved target, or "3 images" when the menu's verbs are
                        // the BULK ones. It is the same published-string discipline every counted row in
                        // this menu already follows (Slint has no int+string concatenation), and the same
                        // ONE predicate `ctx-rate-armed` renders from decides the header's plural form,
                        // so the header and the star row can never disagree about the menu's scope.
                        // v0.8.163 (§7 item 2): …and the singular header COPIES the name it shows,
                        // the EXIF panel's own affordance on the app's other filename header. The
                        // plural "[n] images" form has no single name to copy, so `clickable` is
                        // off there — as it is on the empty (out-of-range target) header, which
                        // would otherwise offer to copy nothing. The menu STAYS OPEN [VD].
                        MenuHeader { extra-inset: 3px;
                            preferred-width: 0px; // the rows size the menu, not the filename
                            text: root.ctx-header;
                            clickable: !root.ctx-plural && root.ctx-header != "";
                            clicked => { root.copy-ctx-name(); }
                        }
                        MenuSep { extra-inset: 3px; }
                        HorizontalLayout {
                            padding-left: Theme.space-2h + 3px; padding-right: 11px; height: 32px; spacing: Theme.space-1h;
                            // v0.8.163 (§7 item 3, OWNER RULING): "the rating text shouldn't be
                            // faded out as it is still functional". While the menu is plural this
                            // label names a live bulk control — the stars beside it ask about the
                            // whole selection — so it renders at FULL text strength and BOLD, and
                            // says what it will do to how many ("Rate 3", published Rust-side).
                            // Unarmed it is the muted "Rating" caption it has always been: there
                            // the stars are a single photograph's, and the row is a caption over a
                            // control, not a counted command.
                            // v0.8.164 (§7 item 6, owner): font-md like every MenuItem label — the
                            // rating row must not read smaller than its siblings. elide is the L5
                            // guard: ~50px of label slack holds "Rate 999"; an absurd count elides
                            // instead of overflowing the fixed-width star host.
                            Text { text: root.ctx-rate-label;
                                   color: root.ctx-plural ? Theme.text : Theme.text-mute;
                                   font-size: Theme.font-md; overflow: elide;
                                   font-weight: root.ctx-plural ? 700 : 400;
                                   vertical-alignment: center; horizontal-stretch: 1; }
                            // ── v0.8.136 (V3): a RECTANGLE host, so the plural signal can be placed
                            // absolutely behind the cluster without a layout able to move a star.
                            //
                            // ── v0.8.137 (W2): the signal is the star PILL, and the host reserves
                            // its 8px flanks in both states — 128px of cluster (5x24 + 4x2) inside a
                            // 144px host, spent as real padding on the VerticalLayout so `cstars`
                            // still hugs at exactly 128. THE MENU'S HEIGHT DOES NOT MOVE and neither
                            // natural (593/494 on the twin, 692 here) is re-pinned: the row is a
                            // fixed 32px, the cluster is 22px centred in it (y 5..27), and the pill
                            // is 26px centred in the same 32 (y 3..29) — it lives in slack the row
                            // already had, exactly as the underline did. Its 6px halo blooms into
                            // the 3px inter-row gap and the neighbouring rows' own padding, which is
                            // the one visual difference from the EXIF mount and is accepted: a menu
                            // row is 32px tall and there is nowhere else for a halo to go.
                            // WIDTH BUDGET, checked: the menu is 224px, less 2x3 body padding, less
                            // this row's 10px + 8px insets and its 6px spacing = 194px for the
                            // "Rating" label plus the host, and 144 of that is the host — the 11px
                            // label needs ~38.
                            Rectangle {
                            width: cstars.preferred-width + 2 * Theme.space-2;
                            // Declared FIRST so it paints BEHIND the stars.
                            ctxstarpill := StarBulkPill {
                                // v0.8.164 (§7 item 6, owner): the counted "Rate n" label carries the
                                // bulk signal while plural — the pill would say it twice. It still
                                // arms on the one edge with no counted label: an explicit selection
                                // of ONE (the menu stays single-target, ctx-plural false).
                                armed: root.ctx-rate-armed && !root.ctx-plural;
                                x: 0px; y: (parent.height - self.height) / 2;
                                width: 100%; height: 26px;
                            }
                            VerticalLayout { alignment: center;   // centre the 22px stars in the 32px row
                            padding-left: Theme.space-2; padding-right: Theme.space-2;
                            cstars := HorizontalLayout {
                                spacing: 2px;
                                property <int> hov: c1.hov ? 1 : c2.hov ? 2 : c3.hov ? 3 : c4.hov ? 4 : c5.hov ? 5 : 0;
                                // v0.8.133 (C-2): while the explicit-surface predicate is armed this row
                                // rates the WHOLE selection — so it shows the GROUP's uniform rating (-1
                                // = mixed ⇒ nothing filled), every star carries the 4px halo, and the
                                // click goes to the same ask the keyboard digits raise. Unarmed, the two
                                // single-photo arms below are byte-identical to v0.8.132.
                                // v0.8.134 (ORANGE-2): `ctx-rate-armed`, not `bulk-actions-armed` -
                                // the armed arm additionally requires THE TARGET PHOTO to be in the
                                // selection. See the property's own note.
                                property <int> shown: root.ctx-rate-armed ? root.bulk-uniform-rating : root.ctx-rating;
                                c1 := Star { index: 1; rating: cstars.shown; preview: cstars.hov; clicked => { root.menu-action("rate1", false); root.ctx-open = false; } }
                                c2 := Star { index: 2; rating: cstars.shown; preview: cstars.hov; clicked => { root.menu-action("rate2", false); root.ctx-open = false; } }
                                c3 := Star { index: 3; rating: cstars.shown; preview: cstars.hov; clicked => { root.menu-action("rate3", false); root.ctx-open = false; } }
                                c4 := Star { index: 4; rating: cstars.shown; preview: cstars.hov; clicked => { root.menu-action("rate4", false); root.ctx-open = false; } }
                                c5 := Star { index: 5; rating: cstars.shown; preview: cstars.hov; clicked => { root.menu-action("rate5", false); root.ctx-open = false; } }
                            } }
                            }
                        }
                        // ── v0.8.158 (B1a, RULING Q31): THE SEPARATOR v0.8.134 ADDED HERE IS GONE.
                        // It fenced the rating row off from Flag/Reject; the ruling puts the rating
                        // row INTO that category ("the ratings row moves DOWN into the same category
                        // as flag/reject"). One group now reads rating · Flag · Reject · Unmark —
                        // the four verbs that mark a photograph — and the header above it, not a
                        // control, is what the menu opens on. The twin below drops the same rule for
                        // the same reason, so the two menus stay TWINNED (v0.8.134's whole point).
                        // v0.8.120 (design-sweep Y56): the menu could RATE its target but not flag,
                        // reject or unmark it — and on the filmstrip this menu is the ONLY per-thumb
                        // affordance (FilmThumb exposes clicked/ctx and nothing else), so spotting an
                        // obvious reject four thumbs back meant navigating AWAY from the shot under
                        // judgement and pressing x: the THINKING-FLOW cost, paid to reach a command the
                        // macOS Photo menu ranks alongside rating and a grid tile does in one click.
                        // Target-scoped like the star row above (sel-toggle-* take an index), checked
                        // from ctx-populate. NO chips: p / x act on the CURRENT shot, so on a thumb-
                        // scoped row a keycap would teach the same false equivalence v0.8.119 removed
                        // from the rotate/delete/copy rows.
                        // v0.8.121 (Round-B fix F12 = audit A21): the STAGE-TARGET branch the star row
                        // directly above has and these three did not. `sel-toggle-*` dispatch through
                        // `apply_mark_idx`, which carries neither the G1 cull gate nor the M8 immersive
                        // confirmation chip — so in full screen (where this menu explicitly mounts, and
                        // where nothing else renders flagged/rejected) right-click → Reject wrote the
                        // mark with no chip, no badge and no toast, while right-click → 5 stars one row
                        // up flashed the chip; and on a still-loading shot the p key was refused with
                        // "Still loading — press again" while this row succeeded silently. Routed to the
                        // current-shot verbs, the stage case rides `set_mark_bit` with both.
                        // ── v0.8.163 (§7 item 3, OWNER RULING): THE PLURAL MENU'S ACTION ROWS ────
                        // "when multiple images are selected, the context menu should say rate
                        // [n], flag [n], reject [n] with bold text."
                        //
                        // AND THE LABEL HAD TO BRING THE DISPATCH WITH IT. Premise-check at tip:
                        // these three rows were target-scoped in EVERY state — `sel-toggle-flag`
                        // takes an index and `apply_mark_idx` writes exactly that one photograph —
                        // while the star row directly above them has switched to the whole
                        // selection since v0.8.133 and the header above THAT has said "[n] images"
                        // since v0.8.158. So a bare "Flag 3" over the old body would have promised
                        // three and marked one: the L20/L21 lie in its purest form. The plural arm
                        // is therefore the SELECTION-TILE MENU'S OWN ROW, verbatim — same
                        // published label (`ctx-bulk-flag-label`, direction-derived: "Flag 3" /
                        // "Unflag 3"), same `bulk-mark` dispatch, same `bulk-actions-armed`
                        // enablement — which is also what makes the two twinned menus agree in the
                        // one state where both are plural. Unmark's `bulk-mark(2)` is the `u`
                        // key's own plural (`BulkOp::Clear`), the same body by the same route.
                        //
                        // ENABLEMENT (L21): the plural rows mirror THEIR handler's guard
                        // (`bulk_actions_allowed`, re-asked Rust-side in `on_bulk_mark`), not the
                        // clicked photo's marks — a plural Unmark greyed by the one photo under
                        // the cursor while four selected ones carry marks would be the same
                        // enablement-from-the-wrong-state defect L21 exists for. The SINGULAR rows
                        // below are byte-identical to v0.8.162, enablement included.
                        //
                        // ── v0.8.169 (item 4, OWNER): THE THREE MARK ROWS GET THEIR KEYCAPS ──────
                        // "Flag and Reject are missing their shortcut previews." They were missing
                        // on purpose — the v0.8.120 note above says so — and the reason had TWO
                        // clauses. Both had to be answered.
                        //
                        // CLAUSE 1, TARGET SCOPE (v0.8.120's own words): "p / x act on the CURRENT
                        // shot, so on a thumb-scoped row a keycap would teach the same false
                        // equivalence v0.8.119 removed from the rotate/delete/copy rows." Answered
                        // by the ROTATE rows' condition, `ctx-target == -1`.
                        //
                        // CLAUSE 2, PLURALITY (v0.8.137's [VD], and it is the one a hasty fix
                        // misses — this wave's first draft did, and the doctrine test caught it):
                        // with a selection ARMED, p / x / u go PLURAL (`main.rs` "flag" arm:
                        // `if bulk_armed { bulk_apply_k(…); return }`), and `bulk_armed` does NOT
                        // require the menu's target to be in that selection — so on a stage
                        // right-click beside a 12-photo selection the SINGULAR row is what mounts
                        // (`ctx-plural` additionally requires membership AND n > 1) while the key
                        // would mark twelve. Answered by `!bulk-actions-armed`, which IS the key's
                        // own gate (`bulk_armed` → `support::bulk_actions_allowed`), exactly as the
                        // "Delete…" row's chip has carried it since v0.8.137.
                        //
                        // Two terms, one per split, both of them facts about the KEY. The v0.8.137
                        // note concluded "no single chip condition can be honest across both
                        // splits"; the conjunction is honest across both, which is what the Delete
                        // row had already demonstrated one group down.
                        //
                        // PREMISE CORRECTION, with evidence: the wave's brief named Flag = S. It is
                        // NOT. `main.rs` ACTIONS: ("flag", "Flag / pick photo", "p"), ("reject",
                        // "Reject photo", "x"), ("unflag", "Clear flag + reject", "u") — S is
                        // ("selpanel", "Toggle Review panel", "s"). The welcome panel's own key card
                        // renders `keybinds[6/7/8]`, i.e. these three, so P · X · U is what that
                        // list already shows. All three are REBINDABLE, so the caps are live keymap
                        // strings published by `support::refresh_menu_shortcuts` (the `sc-rotcw`
                        // sourcing, verbatim) — never literals, which is the v0.8.120 O21 lesson
                        // that cost `sc-delete` its hardcoded "Del".
                        //
                        // THE PLURAL ROWS TAKE THE CAP UNCONDITIONALLY-WHILE-ENABLED, and that is a
                        // different derivation, not a shortcut. Their dispatch is `bulk-mark`, whose
                        // handler is the SAME body the key runs when a selection is armed
                        // (main.rs "flag"/"reject"/"unflag" → `bulk_apply_k(BulkOp::…, bulk_targets)`
                        // vs `on_bulk_mark`'s identical match), and it acts on the SELECTION — there
                        // is no target for a thumb-scoped open to lie about, exactly as with "Clear
                        // selection". The cap therefore rides the row's own `bulk-actions-armed`
                        // enablement, which IS the key's gate (`bulk_armed` → `bulk_actions_allowed`).
                        if root.ctx-plural : MenuItem { edge-to-edge: true; text: root.ctx-bulk-flag-label; bold: true; enabled: root.bulk-actions-armed;
                                   shortcut: root.bulk-actions-armed ? root.sc-flag : "";
                                   clicked => { root.menu-action("flag", false); root.ctx-open = false; } }
                        if !root.ctx-plural : MenuItem { edge-to-edge: true; text: @tr("falcon" => "Flag"); checked: root.ctx-flag;
                                   shortcut: root.sc-flag;
                                   clicked => { root.menu-action("flag", false); root.ctx-open = false; } }
                        if root.ctx-plural : MenuItem { edge-to-edge: true; text: root.ctx-bulk-reject-label; bold: true; enabled: root.bulk-actions-armed;
                                   shortcut: root.bulk-actions-armed ? root.sc-reject : "";
                                   clicked => { root.menu-action("reject", false); root.ctx-open = false; } }
                        if !root.ctx-plural : MenuItem { edge-to-edge: true; text: @tr("falcon" => "Reject"); checked: root.ctx-reject;
                                   shortcut: root.sc-reject;
                                   clicked => { root.menu-action("reject", false); root.ctx-open = false; } }
                        // [VD] the ruling names three rows; Unmark takes the same treatment
                        // because a menu whose other mark verbs act on three photographs cannot
                        // carry a fourth that silently acts on one (one menu, one scope — J2).
                        // v0.8.169 (item 4, EXECUTOR-INITIATED — the owner may veto): Unmark takes
                        // the same cap, on the same two derivations, for the reason the [VD] above
                        // gives about its LABEL. The brief named Flag and Reject; leaving the third
                        // mark verb bare would ship the defect the item exists to close, one row
                        // down, in the same group — and `unflag` (default "u") is one of the three
                        // keys the welcome card teaches on one line ("Flag · Reject · Unmark").
                        // Its singular enablement (`ctx-flag || ctx-reject`) is a SUBSET of the u
                        // key's own arm, so wherever this row can be pressed the key performs it.
                        if root.ctx-plural : MenuItem { edge-to-edge: true; text: root.ctx-bulk-unmark-label; bold: true; enabled: root.bulk-actions-armed;
                                   shortcut: root.bulk-actions-armed ? root.sc-unmark : "";
                                   clicked => { root.menu-action("unflag", false); root.ctx-open = false; } }
                        if !root.ctx-plural : MenuItem { edge-to-edge: true; text: @tr("falcon" => "Unmark"); enabled: root.ctx-flag || root.ctx-reject;
                                   shortcut: root.sc-unmark;
                                   clicked => { root.menu-action("unflag", false); root.ctx-open = false; } }
                        // ── v1.0.0-rc (queue item 27, sheet 2.1 B1 i, OWNER RULING): THE FOURTH ROW. ────
                        // "add 'Delete N photos…' to the stage/filmstrip menu and rename the single row
                        // 'Delete this photo…'". The three mark verbs above have been counted and
                        // set-scoped since v0.8.163 while the menu's ONLY delete row was a bare, target-
                        // scoped "Delete…" at the bottom — under a header that has read "[n] images" since
                        // v0.8.158, beside a Del key that has opened the PLURAL confirm since v0.8.135.
                        //
                        // NOT BOLD, and that is the tile menu's own [VD] applied here: the ellipsis
                        // promises the count-naming confirm, and a destructive row is not something to draw
                        // the eye to with weight. Its three counted siblings above are bold; this one is not.
                        //
                        // THE CHIP IS HONEST, on the same two derivations "Flag N" carries: the stage case
                        // (`ctx-target == -1`, because a filmstrip thumb re-targets everything else in this
                        // menu), not in compare (`delete_key_allowed` hard-refuses there), and
                        // `bulk-actions-armed` — which IS the Del key's own gate, and the state in which the
                        // key performs exactly THIS row rather than the single one below.
                        if root.ctx-plural : MenuItem { edge-to-edge: true; text: root.ctx-bulk-delete-label;
                                   enabled: root.bulk-actions-armed;
                                   shortcut: root.sc-delete;
                                   clicked => { root.menu-action("delete", false); root.ctx-open = false; } }
                        // ── v0.8.184 (D1, OWNER RULING): CULL HISTORY, AS ITS OWN GROUP. ─────
                        // "add the Undo/Redo options in the context menu and events panel, plus
                        // the BASIC SHORTCUTS addition." The chord has existed since v0.3.x with
                        // NO visible affordance anywhere — the L25 class one level up (a
                        // keyboard-only pathway is hidden-by-default for a visual user), and the
                        // one reversal a culling session leans on hardest.
                        //
                        // SINGULAR, NEVER COUNTED, NEVER BOLD: the v0.8.163 plurality rule bolds
                        // the rows whose SUBJECT is the selection ("Flag 12"). These two are
                        // FOLDER-scoped — `undo()` takes no index and pops one stack entry, which
                        // may itself be a grouped bulk edit — so they mount on BOTH `ctx-plural`
                        // states unchanged, exactly like "Select new / edited" two groups down.
                        //
                        // ENABLEMENT IS THE HANDLER'S OWN GATE (L21/L26): `can-cull-undo` is
                        // published each tick from `support::cull_undo_armed`, which mirrors
                        // `on_undo`'s empty-stack + delete-record branch INCLUDING the folder
                        // check `on_recover_delete` performs — so a record left behind in another
                        // folder greys this row instead of lighting a control whose only possible
                        // answer is the "another folder" refusal.
                        //
                        // THE CAPS ARE HONEST HERE, UNCONDITIONALLY, and that is the v0.8.119
                        // doctrine satisfied rather than excepted: the chord performs EXACTLY what
                        // the row performs, on the same folder-scoped subject, at every target and
                        // in every mode this menu can be opened in.
                        MenuSep { extra-inset: 3px; }
                        // v0.8.184 (review W3a): "Undo last change", not "Undo". A context menu
                        // is opened ON a photograph and every other row here acts on THAT subject;
                        // a bare verb read as "undo this photo". The longer form names what the
                        // row really pops — one entry off the folder's history, which may be a
                        // rating, a rotation, a grouped bulk edit or a recoverable delete — and it
                        // also ends the collision with the Events header's own "Undo" pill.
                        // ── v0.8.186 (fix wave, lens finding 4): …AND IT TAKES THE STATE-DERIVED
                        // NAME TOO. The spec ruled "labels unchanged" here; the lens overturned it.
                        // A context menu is the surface most likely to be OPEN when a move tops the
                        // history — it is where "Move rejected" is invoked from — and "Undo last
                        // change" for an operation that moved twelve files on disk names a change,
                        // not the change. When the published arm is the move, the row says so; in
                        // every other state it keeps the v0.8.184 wording verbatim. The test is
                        // `cull-undo-label`, the SAME property the header pill renders, so the two
                        // surfaces can never disagree about which arm is armed (one publisher, L44).
                        // Redo is untouched: its stack holds only cull entries by construction (no
                        // re-move, no re-delete), so it has exactly one thing to be called.
                        MenuItem { edge-to-edge: true; text: root.cull-undo-label == "Undo move" ? @tr("falcon" => "Undo move") : @tr("falcon" => "Undo last change");
                                   enabled: root.can-cull-undo; shortcut: root.sc-undo;
                                   clicked => { root.menu-action("undo", false); root.ctx-open = false; } }
                        MenuItem { edge-to-edge: true; text: @tr("falcon" => "Redo last change"); enabled: root.can-cull-redo; shortcut: root.sc-redo;
                                   clicked => { root.menu-action("redo", false); root.ctx-open = false; } }
                        MenuSep { extra-inset: 3px; }
                        // v0.8.129 (W1-5): clear the transient selection from the photo menu. L21 —
                        // the enablement mirrors the handler's own guard (clearing nothing is a
                        // no-op), and the COUNT is PUBLISHED by on_ctx_populate
                        // (support::clear_selection_label), never composed here: Slint has no
                        // int+string concatenation, and a counted entry is exactly the class this
                        // codebase publishes rather than re-derives UI-side.
                        // v0.8.137 (W3): THE CHIP THE OWNER NAMED. Under the v0.8.119 doctrine this
                        // is the one row in either menu whose key equivalence is unconditional:
                        // `clear-selection()` takes NO index, so the target-scope question that
                        // keeps chips off rotate/delete/copy here does not arise — there is nothing
                        // for a filmstrip or grid-dock reuse of this menu to re-target. And the
                        // states line up in the safe direction: the row is enabled on
                        // `bulk-actions-armed` (count>0 && !compare && !immersive) while Ctrl+D's
                        // own arm refuses compare and immersive and its handler no-ops on an empty
                        // set — so wherever this row can be pressed, the chord does exactly it.
                        // ── v0.8.169 (item 5, OWNER RULING): THE SELECTION GESTURE, AS A ROW. ────
                        // "add a select entry with the shortcut of ctrl or shift (show both,
                        // separated by '/')."
                        //
                        // GROUNDED FIRST, and the grounding decided the semantics. There is exactly
                        // one selection classifier in the app — `sel-gesture-kind(ctrl, shift)`,
                        // declared at the top of this file and read by ALL FOUR tile surfaces
                        // (filmstrip, grid dock, Review tile, stage): Ctrl ⇒ 0 (TOGGLE this photo in
                        // or out), Shift ⇒ 1 (RANGE from the origin), Ctrl+Shift ⇒ 2, and −1 = "not
                        // a selection gesture at all". A menu row has no origin and no anchor, so
                        // the range arm has nothing to range FROM; the Ctrl arm is the one that
                        // means something about the single photograph this menu is about. Kind 0,
                        // on this menu's resolved target.
                        //
                        // THE THIRD ARGUMENT IS `false` BY EVIDENCE, not by default: every non-panel
                        // call site passes false (the grid `sel-gesture(item.idx, …, false)` and the
                        // stage's own `sel-gesture(root.cur-idx, …, false)`), and only the Review
                        // panel's two tiles pass true. This menu opens from the stage, the filmstrip
                        // and the grid dock.
                        //
                        // ENABLEMENT IS THE GATE ITSELF (L21, by construction rather than by
                        // mirroring): the row asks `sel-gesture-kind(true, false) >= 0` — literally
                        // the predicate every other invoker consults before dispatching — so the
                        // dormancy rule (inert in compare, in immersive and under a modal) can never
                        // be transcribed differently here. `ctx-idx >= 0` is the target term: the
                        // stage case resolves it to the current shot, but an out-of-range menu (the
                        // empty header state) has nothing to select.
                        //
                        // THE CHIP IS THE RULING'S, AND IT IS A DELIBERATE DOCTRINE EXCEPTION,
                        // stated so no later audit has to guess. Every other cap in this menu names
                        // a KEY that performs the row. These name the two MODIFIERS that, WITH A
                        // CLICK, build a selection — a gesture family, not a key equivalence — and
                        // the row performs the first of them. The owner asked for both, slash-
                        // separated, and both are true of the gesture the row is teaching. Composed
                        // Rust-side from the one platform string table
                        // (`support::sel_gesture_chord_display` → "Ctrl / Shift", "⌘ / ⇧" on the Mac
                        // arm) exactly as `sc-copy` and `sc-deselect` are, so it can never drift
                        // from `sel_toggle_chord`'s own wording of the same modifier.
                        // ── v1.0.0-rc (queue item 27, sheet 2.1 B1 iii, OWNER RULING): THE WORD IS THE
                        // ── STATE. "the 'Select' row reads 'Select' / 'Deselect' by state." The dispatch
                        // is kind 0, a TOGGLE, and the label always said "Select" — so on a photograph
                        // already in the set the row stated the opposite of what the click does (L20).
                        // `ctx-tile-selected` is `sel_ctx_set.contains(t)` for the RESOLVED target (the
                        // stage case resolves -1 to the current shot), i.e. exactly the membership the
                        // toggle flips. A two-literal state ternary is the `immersive ? …` precedent two
                        // groups down; there is no count, so nothing is composed in Rust. Enablement and
                        // chip are byte-unchanged.
                        MenuItem { edge-to-edge: true; text: root.ctx-tile-selected ? @tr("falcon" => "Deselect") : @tr("falcon" => "Select"); shortcut: root.sc-select;
                                   enabled: root.sel-gesture-kind(true, false) >= 0 && root.ctx-idx >= 0;
                                   clicked => { root.sel-gesture(root.ctx-idx, 0, false); root.ctx-open = false; } }
                        // ── v1.0.0-rc (queue item 27, sheet 2.1 B7, OWNER RULING): "Select all". ───────
                        // The Ctrl+A ladder has existed since v0.8.129 with no menu row anywhere — the
                        // L25 class one level up (a keyboard-only pathway is hidden by default for a
                        // visual user). Placed second in the Select group, before the counted Clear row,
                        // so the group reads Select/Deselect · Select all · Clear selection (N) · Select
                        // new / edited: one photograph, then all of them, then none.
                        //
                        // ENABLEMENT IS THE LADDER'S OWN GATE (L21/L26). Ctrl+A's arm asks
                        // `!modal-open && !capture-armed && !compare && !immersive`;
                        // `sel-gesture-kind(true, false) >= 0` IS `!compare && !immersive && !modal-open`
                        // (the one selection classifier), `capture-armed` is the ladder's own extra term
                        // (a chord sits ABOVE the capture funnel, so it must state it), and the last term
                        // is "there is something DISPLAYED to select" — the handler's own early return,
                        // mirrored rather than left as a lit no-op (L15).
                        //
                        // v1.0.0-rc TAIL (item 27, skeptic Y4): that last term was `count-all > 0` alone,
                        // which is the FOLDER's emptiness. `on_select_all_displayed` returns early on the
                        // DISPLAYED order — `sel_displayed_order`, which is the Review panel's filtered
                        // feed while the panel is open and the whole folder while it is not — so with the
                        // panel open on a filter that matches nothing (Rejects in a folder with none) the
                        // row was LIT and its click was the silent no-op the comment claimed to have
                        // closed. `sel-rows` IS that feed, published: the panel's own empty-state copy
                        // mounts on `sel-rows.length == 0` (search `sel-rows.length`), so no publisher is
                        // minted here — the row, the panel's own words and the handler read one term. The
                        // `!immersive` half is written out rather than leaned on the classifier's copy of
                        // it, because it is the handler's `panel` term SPELLED, and a mirror that reads
                        // differently from what it mirrors is how the two drift.
                        //
                        // THE MAC MENU BAR DELIBERATELY HAS NO TWIN (L26, answered): an NSMenuItem with a
                        // ⌘A key equivalent would intercept the chord from the FocusScope ladder
                        // (menubar_model.rs, the v0.9.63 note), and a context-menu row registers no key
                        // equivalent at all — so that reason does not reach here and the bar's absence stands.
                        MenuItem { edge-to-edge: true; text: @tr("falcon" => "Select all"); shortcut: root.sc-select-all;
                                   enabled: root.sel-gesture-kind(true, false) >= 0 && !root.capture-armed
                                            && (root.sel-open && !root.immersive ? root.sel-rows.length > 0 : root.count-all > 0);
                                   clicked => { root.select-all-displayed(); root.ctx-open = false; } }
                        // v0.8.194 (§1F4, OWNER ORDER 08-18): BOLD EXACTLY WHILE THE LABEL COUNTS.
                        // `clear_selection_label` publishes "Clear selection (12)" at n > 0 and the
                        // bare verb at zero, so this row already changes CATEGORY with the
                        // selection — it is the counted, set-scoped kind of row while a set exists.
                        // The weight now says so, on the same grammar the plural mark/copy rows
                        // use. The term is `count-selected` itself — the tick-published property the
                        // Selected chip mounts on — never a re-derivation, and deliberately NOT
                        // `bulk-actions-armed`: in compare or immersive the row greys but the label
                        // still carries its count, and a greyed row that also lost its weight would
                        // be saying the selection had gone.
                        MenuItem { edge-to-edge: true; text: root.ctx-clear-sel-label; enabled: root.bulk-actions-armed; shortcut: root.sc-deselect; bold: root.count-selected > 0; // v0.8.133 (ruling 5): the promoted predicate — five inline copies of these three terms lived here // v0.8.131 (J1): the handler refuses in immersive and the photo menu IS reachable there (L21)
                                   clicked => { root.clear-selection(); root.ctx-open = false; } }
                        // v0.8.130 (W2-4): the twin of the Selection-tile menu's row — same
                        // published label, same availability, same shared handler. FOLDER-scoped,
                        // so it belongs on both menus rather than only on the panel's.
                        MenuItem { edge-to-edge: true; text: root.ctx-sel-new-label; enabled: root.ctx-has-manifest && !root.compare && !root.immersive;
                                   clicked => { root.select-new-edited(); root.ctx-open = false; } }
                        MenuSep { extra-inset: 3px; }
                        // v0.8.38 (G2): send the target shot to a compare half (reuses the Selection menu's machinery/wording)
                        // v0.8.119 (design-sweep Y55): gated on the handler's own guard
                        // (on_sel_to_compare returns silently when the folder holds < 2 shots).
                        MenuItem { edge-to-edge: true; text: @tr("falcon" => "Compare — send to A (left)"); enabled: root.count-all >= 2; clicked => { root.sel-to-compare(root.ctx-idx, 0); root.ctx-open = false; } }
                        MenuItem { edge-to-edge: true; text: @tr("falcon" => "Compare — send to B (right)"); enabled: root.count-all >= 2; clicked => { root.sel-to-compare(root.ctx-idx, 1); root.ctx-open = false; } }
                        MenuSep { extra-inset: 3px; }
                        // ── dedicated Copy-to-clipboard section (3 cases; each dims when not applicable) ──
                        // v0.8.119 (design-sweep O17/O19/O23): the Ctrl+C chip lands on the row the
                        // KEY really performs. Two separate lies lived here. (1) TARGET SCOPE: this
                        // menu is reused verbatim by the filmstrip and the grid dock with
                        // ctx-target = the CLICKED thumb, while Ctrl+C acts on the CURRENT shot — so
                        // the chip taught a false equivalence on two of the menu's three hosts
                        // (the Selection menu removed its chips for exactly this in v0.8.42).
                        // (2) WHICH ROW: even in the honest stage case (target -1) the chip sat on
                        // the fixed mode-0 row, while Ctrl+C walks the §33 ranked priority list and
                        // copies the first APPLICABLE enabled mode — on a RAW+JPG shot at the
                        // default ranking that is "Copy both", two rows down. Rust publishes the
                        // walk's answer for this shot as `ctx-rank-mode` (support::ranked_copy_mode,
                        // the SAME helper on_copy_shortcut dispatches through — one predicate, so
                        // they cannot drift), and each row shows the chip only when it IS that
                        // answer. Every label and every dispatch is left exactly as it was: the row
                        // named "Copy JPG" still copies the JPG.
                        // ── v0.8.194 (FIX 2026-08-18 §1D1): …AND THEY LEARN THE SELECTION. ───────
                        // Owner report: "when selected multiple images, the right-click context
                        // menu did not have copy[n], and both it and the keyboard shortcuts only
                        // copy the current image instead of all selected." The MARK rows took their
                        // counted, set-scoped twins in v0.8.163; these three never did, so a menu
                        // headed "5 images" offered three rows that copied one photograph.
                        //
                        // THE MARK ROWS' EXACT PATTERN, one group up: conditional siblings on
                        // `ctx-plural` (never a ternary on the mount — L47 is about class
                        // promotion, but the exclusivity is the same reason: two arms, one
                        // mounted), the plural arm BOLD like every other counted row, its label
                        // published by `on_ctx_populate`, its dispatch the index-free
                        // `copy-selected`, its enablement the row's own count AND the shared
                        // `bulk-actions-armed` gate — which is `bulk_armed`, which is what Rust
                        // re-checks before it copies (L21: the row and the handler, one predicate).
                        //
                        // THE CAP IS HONEST IN THE PLURAL ARM, and that is not an exception to the
                        // v0.8.119 doctrine but the doctrine re-scoped: in the stage case
                        // (`ctx-target == -1`) an armed Ctrl+C now copies the SELECTION, through
                        // the same §33 walk `ctx-rank-mode` is published from — which
                        // `on_ctx_populate` computes over the SELECTION while plural. Row and key
                        // perform the identical act on the identical subject. On a filmstrip thumb
                        // (`ctx-target != -1`) the caps stay off exactly as before.
                        //
                        // v1.0.0-rc TAIL (item 27, skeptic Y1, L21) — AND THE SINGLE ARM NEEDS THE OTHER
                        // HALF OF THAT SENTENCE, which v0.8.194 did not write. `bulk_armed` does not
                        // require the menu's target to be IN the selection, so on a stage right-click
                        // beside a 12-photo selection whose clicked photograph is outside it,
                        // `ctx-plural` is false — these three rows mount — while Ctrl+C copies the
                        // twelve. The `!bulk-actions-armed` term is the same one the mark rows have
                        // carried since v0.8.137, the delete row since v0.8.169 and the single ROTATE
                        // rows since this round; block 3b of `ctx_menu_keycaps_…` is the falsifier.
                        if !root.ctx-plural : MenuItem { edge-to-edge: true; text: root.ctx-copy-fmt-label; enabled: root.ctx-has-finished;
                                   shortcut: (root.ctx-rank-mode == 0) ? root.sc-copy : "";
                                   clicked => { root.menu-action("copy-fin", false); root.ctx-open = false; } }
                        if root.ctx-plural : MenuItem { edge-to-edge: true; text: root.ctx-bulk-copy-fin-label; bold: true;
                                   enabled: root.ctx-bulk-copy-fin-on && root.bulk-actions-armed;
                                   shortcut: root.ctx-rank-mode == 0 ? root.sc-copy : "";
                                   clicked => { root.menu-action("copy-fin", false); root.ctx-open = false; } }
                        if !root.ctx-plural : MenuItem { edge-to-edge: true; text: @tr("falcon" => "Copy RAW"); enabled: root.ctx-has-raw;
                                   shortcut: (root.ctx-rank-mode == 1) ? root.sc-copy : "";
                                   clicked => { root.menu-action("copy-raw", false); root.ctx-open = false; } }
                        if root.ctx-plural : MenuItem { edge-to-edge: true; text: root.ctx-bulk-copy-raw-label; bold: true;
                                   enabled: root.ctx-bulk-copy-raw-on && root.bulk-actions-armed;
                                   shortcut: root.ctx-rank-mode == 1 ? root.sc-copy : "";
                                   clicked => { root.menu-action("copy-raw", false); root.ctx-open = false; } }
                        if !root.ctx-plural : MenuItem { edge-to-edge: true; text: @tr("falcon" => "Copy both"); enabled: root.ctx-has-finished && root.ctx-has-raw;
                                   shortcut: (root.ctx-rank-mode == 2) ? root.sc-copy : "";
                                   clicked => { root.menu-action("copy-both", false); root.ctx-open = false; } }
                        if root.ctx-plural : MenuItem { edge-to-edge: true; text: root.ctx-bulk-copy-both-label; bold: true;
                                   enabled: root.ctx-bulk-copy-both-on && root.bulk-actions-armed;
                                   shortcut: root.ctx-rank-mode == 2 ? root.sc-copy : "";
                                   clicked => { root.menu-action("copy-both", false); root.ctx-open = false; } }
                        MenuSep { extra-inset: 3px; }
                        // v0.8.119 (design-sweep O20/O22): "Reset zoom (100%)" named the one thing
                        // this row does NOT do. on_pan_reset sets zoom = 1.0, and in Falcon's own
                        // vocabulary zoom 1.0 is FIT (the stage badge reads "Fit" there; 100% means
                        // 1:1, main_window.slint:167). The macOS View twin, same dispatch, is already
                        // titled "Zoom to Fit" — one dispatch, one name, on both trunks now. Its
                        // enablement mirrors that twin too: at fit with pan 0 the row was a lit
                        // no-op (L15/L21). Compare keeps it live — pan-reset also clears cmp-pan.
                        MenuItem { edge-to-edge: true; text: @tr("falcon" => "Zoom to fit"); enabled: root.compare || !root.at-fit; shortcut: root.sc-zoom; clicked => { root.pan-reset(); root.ctx-open = false; } }
                        // v0.8.119 (design-sweep O17/O19/O23): target-scoped rows keep their chip
                        // only in the stage case — the r / Shift+R keys rotate the CURRENT shot, not
                        // the right-clicked thumb.
                        // v0.8.187 (W6, OWNER RULING D25): greyed over an animated GIF — the
                        // playback lane cannot turn one, so the row must not promise it. Still
                        // GIFs are unaffected (`ctx-rotate-blocked` is the lane's >= 2-frame
                        // datum, not the format). The chord path speaks instead; see
                        // `on_rotate_shot`.
                        // ── v1.0.0-rc (queue item 27, sheet 2.1 B2 b, OWNER RULING): ROTATE THE SET. ───
                        // "Rotate acts on all selected with one Undo for the batch and a note for skipped
                        // animated GIFs." The mark rows took their counted twins in v0.8.163 and the copy
                        // rows in v0.8.194; rotate is the last verb in this menu that acted on one
                        // photograph while the header named twelve. Conditional siblings on `ctx-plural`,
                        // never a ternary on the mount (L47's exclusivity, the copy rows' own shape).
                        //
                        // ENABLEMENT IS `bulk-actions-armed`, NOT `ctx-rotate-blocked`. That property
                        // describes the ONE resolved target, and a set holding a single animated GIF still
                        // rotates the others — the handler skips what it cannot turn and the sentence SAYS
                        // what it skipped, which is the honest answer where greying the row would refuse
                        // eleven photographs because of the twelfth.
                        //
                        // THE CAPS ARE HONEST HERE for the plural copy rows' reason, re-scoped: while a
                        // selection is armed the R / Shift+R keys go through this same door (main.rs's
                        // `on_key_typed`, the P-key pattern), so row and key perform the identical act on
                        // the identical subject. On a filmstrip thumb (`ctx-target != -1`) they stay off,
                        // exactly as on the single rows below.
                        if root.ctx-plural : MenuItem { edge-to-edge: true; text: root.ctx-bulk-rot-cw-label; icon: 1; bold: true; enabled: root.bulk-actions-armed;
                                   shortcut: root.sc-rotcw;
                                   clicked => { root.menu-action("rotcw", false); root.ctx-open = false; } }
                        // v1.0.0-rc (item 27, L21) — A THIRD TERM ON THE SINGLE ROWS' CAPS, and this
                        // round is what makes it necessary. `bulk_armed` does NOT require the menu's
                        // target to be in the selection, so on a stage right-click beside a 12-photo
                        // selection whose clicked photograph is OUTSIDE it, `ctx-plural` is false — these
                        // SINGLE rows mount — while R now turns twelve. That is the v0.8.137 W3 defect
                        // exactly, and `!bulk-actions-armed` is its own answer: the term IS the key's gate,
                        // so the cap is present in precisely the states where R still means this row. The
                        // three mark rows and "Delete this photo…" have carried it since v0.8.137/v0.8.169.
                        if !root.ctx-plural : MenuItem { edge-to-edge: true; text: @tr("falcon" => "Rotate right"); icon: 1; enabled: !root.ctx-rotate-blocked; shortcut: root.sc-rotcw; clicked => { root.menu-action("rotcw", false); root.ctx-open = false; } }
                        if root.ctx-plural : MenuItem { edge-to-edge: true; text: root.ctx-bulk-rot-ccw-label; icon: 2; bold: true; enabled: root.bulk-actions-armed;
                                   shortcut: root.sc-rotccw;
                                   clicked => { root.menu-action("rotccw", false); root.ctx-open = false; } }
                        if !root.ctx-plural : MenuItem { edge-to-edge: true; text: @tr("falcon" => "Rotate left"); icon: 2; enabled: !root.ctx-rotate-blocked; shortcut: root.sc-rotccw; clicked => { root.menu-action("rotccw", false); root.ctx-open = false; } }
                        // v0.8.92 (L25): three honest states (L17/L20 — a static verb over a multi-state
                        // toggle always lies in some state):
                        //   fully-off      → "Show panels"         (v0.8.97 ruling 5: the shared recovery
                        //                     brings BOTH floating panels back, open + expanded, so the
                        //                     row says so — "Show info panel" only in the LEGACY pair,
                        //                     where the develop panel is already visible and untouched)
                        //   minimized stub → "Expand info panel"   (info-min=false)
                        //   expanded/folded→ "Minimise info panel" (info-min=true)
                        // The two ON titles stay singular on purpose: they are the INFO panel's own
                        // controls, and per-panel independence is the point of the v0.8.97 ruling.
                        // The shortcut chip only shows while the panel is ON — that is when ONE press of
                        // the i key performs this item's action. Fully-off the key now REVEALS the
                        // transient stub and takes a second press to restore (v0.8.93 ruling 1), so a chip
                        // there would still teach a false one-press equivalence (the L20 class).
                        // v0.8.93: the body is the shared `toggle-info-panel` callback, so any other
                        // surface that grows this command drives the IDENTICAL path (single dispatch).
                        // v0.8.94 (audit C14/C20): the TEXT is the shared `info-cmd-title` property, so
                        // the words are single-sourced too — the rig pins it against Rust's
                        // support::info_menu_title, which is what the macOS View row renders.
                        // v0.8.95 (v0.8.94-audit V1/V5/V6): the LOCAL mirror of the C21 gate. The body is
                        // inert while immersive (see toggle-info-panel above), and this menu mounts +
                        // opens there (the stage/film right-click sites subtract the 44px title bar only
                        // when NOT immersive — that math exists to place it correctly in immersive), so
                        // without `enabled` the row rendered full-brightness, hover-highlit and clickable
                        // beside a correctly-dimmed "Copy RAW" and did absolutely nothing. Enablement
                        // mirrors the dispatch gate — the same rule menubar_model::enabled_for applies to
                        // the macOS View row, now applied to the surface that OWNS the body.
                        // The chip drops with it: while immersive the i key is inert too
                        // (support::info_key_action → Nothing), so a keycap there taught a dead key.
                        MenuItem { edge-to-edge: true; text: root.info-cmd-title;
                                   enabled: !root.immersive;
                                   shortcut: root.info-open && !root.immersive ? root.sc-info : "";
                                   clicked => { root.toggle-info-panel(); root.ctx-open = false; } }
                        MenuItem { edge-to-edge: true; text: root.immersive ? @tr("falcon" => "Exit immersive") : @tr("falcon" => "Immersive (fullscreen)"); shortcut: root.sc-full;
                                   clicked => { root.toggle-fullscreen(); root.ctx-open = false; } }
                        MenuSep { extra-inset: 3px; }
                        // ── v0.8.159 (B2, OWNER RULING Q19): "View EXIF", UNIVERSALLY. ───────────
                        //
                        // ── v0.8.169 (items 2+3, OWNER RULING) — THIS GROUP IS RE-CUT. ───────────
                        // "move the view EXIF to the same category as open in Explorer", and "Show
                        // log file" LEAVES the menu entirely for Settings → Developer (a dev tool
                        // has no business on a photographer's right-click). The v0.8.159 placement
                        // argued from "show me something about this photograph"; the ruling reads
                        // the group the other way — these two rows are the ones that open the FILE,
                        // one as its metadata and one as its place on disk — and that is a category
                        // a user can name, where "zoom · rotate · panels · immersive" is what the
                        // VIEW does to the picture on screen.
                        //
                        // ORDER WITHIN THE GROUP [VD], by the lenses: View EXIF FIRST. Both rows are
                        // about this one file, and the IN-APP one comes before the one that hands
                        // the photographer to another application — the same in-then-out reading
                        // every other group in this menu has (mark before select, copy before
                        // leave). PHOTO-FIRST breaks the tie the same way: the panel that answers
                        // "what is this photograph" is the one a cull actually reaches for, and
                        // Explorer is the escape hatch under it.
                        //
                        // Group order now, top to bottom: [subject header] · [rating · flag ·
                        // reject · unmark · SELECT · clear selection · select new/edited] ·
                        // [compare A/B] · [copy] · [zoom · rotate · info panel · immersive] ·
                        // [VIEW EXIF · reveal] · [delete].
                        //
                        // DISABLED WHEN THE MENU IS PLURAL (mechanism 10): EXIF is a single-shot
                        // concept, so the row is grey in exactly the states where the menu's other
                        // verbs act on a set. `MenuItem` carries no row tooltip channel, so this is
                        // the spec's plain-disabled fallback; the header one group up already states
                        // the plural scope in words.
                        //
                        // v0.8.181 (pre-merge review): the predicate is `ctx-plural`, NOT
                        // `ctx-rate-armed`. B2 reached for the rating arm because it was the nearest
                        // set-scope-looking flag, but `ctx-rate-armed` is true at a selection of ONE
                        // that contains the target — see `ctx-plural`'s own declaration above, which
                        // spells that out — so Ctrl-click one photograph and right-click it and this
                        // row greyed while the header still named the FILE, the mark rows were still
                        // singular, and `on_float_exif_open` carried no plural gate at all and would
                        // have opened the panel. The rating pill one group up already took this
                        // correction at v0.8.163; the two EXIF rows are the pair that did not.
                        // L21/L26: the enablement mirrors the scope the rest of the menu is in.
                        //
                        // ENABLED IN IMMERSIVE, deliberately, unlike the info-panel row above it:
                        // that row is greyed because its BODY is inert in immersive (L21/L26),
                        // while these panels float above immersive by the ruling's own close-matrix
                        // ("entering/leaving compare and immersive close NONE"). The SPAWN POINT
                        // still carries the `+44px` re-add, unchanged by the move: `ctx-y` is
                        // stage-relative and `float-exif-open` takes WINDOW coordinates.
                        MenuItem { edge-to-edge: true; text: @tr("falcon" => "View EXIF"); enabled: !root.ctx-plural;
                                   clicked => { root.float-exif-open(root.ctx-target, root.ctx-x, root.ctx-y + (root.content-top)); root.ctx-open = false; } }
                        // ── v1.0.0-rc (queue item 27, sheet 2.1 B3 b, OWNER RULING): REVEAL THE SET. ───
                        // "'Reveal 5 in Explorer' opens one window with all selected files highlighted."
                        // ONE file per shot (`jpg` else `raw` — the single row's own rule, applied over
                        // the selection by `support::reveal_paths`), and ONE shell call, because five
                        // `explorer /select` spawns would open five windows. The label is composed in Rust
                        // from the platform table's `file_manager` noun, so the counted verb and the
                        // single one below can never name two different applications.
                        // NO CAP: reveal has no key on either menu, and never has.
                        if root.ctx-plural : MenuItem { edge-to-edge: true; text: root.ctx-reveal-label; bold: true; enabled: root.bulk-actions-armed;
                                   clicked => { root.reveal-selected(); root.ctx-open = false; } }
                        if !root.ctx-plural : MenuItem { edge-to-edge: true; text: root.reveal-verb; clicked => { root.reveal-shot(root.ctx-target); root.ctx-open = false; } }
                        MenuSep { extra-inset: 3px; }
                        // v0.8.119 (design-sweep O17/O19/O23 + Y41): BOTH conditions must hold for a
                        // chip. Target scope — the Del key deletes the CURRENT shot, so a thumb-scoped
                        // row must not teach it. Compare — delete_key_allowed() hard-refuses in
                        // compare (main.rs), while the ITEM still works there by design (a menu acts
                        // on an explicit shot), so the chip would teach a key that is dead in the very
                        // mode it was read in.
                        //
                        // v0.8.137 (W3) — A THIRD CONDITION, AND IT IS A BUG FIX. v0.8.135 sent the
                        // Del key PLURAL whenever a selection exists: `delete-key` checks the same
                        // armed gate the two menus' bulk rows use and opens the "Delete 12 photos…"
                        // confirm instead of the single one. So from the moment anything was
                        // selected this chip has been teaching that Del deletes THIS photograph,
                        // while Del actually offered to delete twelve — the exact false equivalence
                        // the doctrine exists to prevent, introduced two waves after the doctrine
                        // was written. The term is `bulk-actions-armed`, which IS the key's gate
                        // (main.rs `bulk_armed`), so the chip is present in precisely the states
                        // where Del still means this row.
                        // v1.0.0-rc (queue item 27, sheet 2.1 B1 i): "Delete…" → "Delete this photo…".
                        // The tile menu named its own scope in v0.8.131 (J2 / F3 L-5) for exactly this
                        // reason, and this menu now carries the counted row too: a bare verb one group
                        // above "Delete 12 photos…" is the one row whose scope the user has to infer.
                        // The chip condition is UNCHANGED — `!bulk-actions-armed`, because while armed the
                        // Del key opens the plural confirm and this row must not wear it.
                        MenuItem { edge-to-edge: true; text: @tr("falcon" => "Delete this photo…"); shortcut: !root.ctx-plural ? root.sc-delete : ""; clicked => { root.menu-action("delete-one", false); root.ctx-open = false; } }
                    }
                }
                // v0.8.122 (M5 = the v0.8.121 verify's S1 finding): the owner's panel-bottom
                // gradient rule, applied to the surface F11 just made scrollable. F11 capped the
                // menu's height and put a Flickable inside it, so on a short window the body
                // scrolls — with nothing whatsoever to say so, which is the exact "a scrollable
                // body that hard-clips gives no sign that content continues" case the rule exists
                // for. The row that clips first is "Delete…", the one command in this menu that is
                // destructive. Positioned off `ctxflick`'s own edges and `more:`-gated by the
                // identical viewport expression the events panel uses (the notifflick site below),
                // so a menu that fits wears no smudge; PURE PAINT (no TouchArea), painted AFTER the
                // scroll body so wheel/clicks pass through to it.
                ctxfade := PanelBottomFade {
                    x: ctxflick.x; width: ctxflick.width;
                    y: ctxflick.y + ctxflick.height - self.height;
                    more: ctxflick.viewport-height + ctxflick.viewport-y > ctxflick.height + 1px;
                }
            }
        }

        // selection-tile RIGHT-CLICK menu → send the tile to compare half A or B (positioned at the
        // cursor in window coords). Robust path that works even with the panel over the left half.
        if root.sel-ctx-open : Rectangle {
            y: root.content-top;
            height: parent.height - self.y;
            width: 100%;
            TouchArea {
                pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.sel-ctx-open = false; } }
            }
            sctxpanel := GlassPanel {
                init => {
                    root.context-menu-x = self.x; root.context-menu-y = self.y;
                    root.context-menu-w = self.width; root.context-menu-h = self.height;
                }
                changed x => { root.context-menu-x = self.x; }
                changed y => { root.context-menu-y = self.y; }
                changed width => { root.context-menu-w = self.width; }
                changed height => { root.context-menu-h = self.height; }

                // v0.8.131 (F-P2 rule 2): 184px → 224px, twinned with the photo menu. This round's
                // labels ("Select new / edited (unreadable)", "Compare — send to B (right)") do not
                // fit 184px, MenuItem sets no elide and nothing here clips, so they simply ran off
                // the glass (L5: audit every row's WIDEST state).
                // Language packs (round 2): the photo menu's fit-text rule, twinned.
                width: max(224px, Theme.fit-text ? min(sctxbox.preferred-width, root.width - 16px) : 0px);
                x: max(8px, min(root.sel-ctx-x, root.width - self.width - 8px)); // v0.8.131 (F-P2 rule 4): the sort/path/open floor
                // v0.8.131 (F-P2 rule 3) — THE ctxbox TREATMENT, PORTED. This menu grew to 15 items
                // + 5 separators this round with NO floor, NO cap and NO Flickable: on any window
                // under ~600px the y binding's else-arm went negative and every right-click parked
                // the menu above the window edge, silently clipping the top rows off-screen. Its
                // sibling got exactly this fix in v0.8.121 and the re-pinned rig row covered only
                // the sibling.
                //
                // THE COORDINATE-SPACE CORRECTION: `sel-ctx-y` is WINDOW coords (it comes from
                // absolute-position), so the `- parent.y` term must survive in BOTH arms — the
                // sibling's expression is stage-relative and cannot be copied verbatim.
                y: max(0px, root.sel-ctx-y - parent.y < parent.height - self.height - 8px
                   ? root.sel-ctx-y - parent.y
                   : parent.height - self.height - 8px);
                height: min(sctxbox.preferred-height, parent.height - 16px);
                backdrop: root.menu-blur-covers ? root.menu-backdrop : root.blur-backdrop;
                // v0.8.169 (item 1): the twin's frost, same flag, same reasoning — see the photo
                // menu's note. The two context menus have been TWINNED since v0.8.131 and a material
                // that reached only one of them would be the first thing the owner saw.
                // OFFSETS: this menu's overlay is the SAME window-rooted `y: immersive ? 0 : 44` /
                // x = 0 shape, so the pair is identical — and note that this is independent of
                // `sel-ctx-x/y` being WINDOW coordinates while `ctx-x/y` are stage-relative: the
                // offsets describe the HOST, and the panel's own live `x`/`y` (whatever they are
                // computed from) are what `GlassPanel` subtracts.
                hover-glass: true;
                sw: root.menu-blur-covers ? root.menu-blur-w : root.content-w;
                sh: root.menu-blur-covers ? root.menu-blur-h : root.content-h;
                ox: root.menu-blur-covers ? root.menu-blur-x : 0px;
                oy: root.menu-blur-covers ? root.menu-blur-y : 0px;
                TouchArea {}
                sctxflick := Flickable {
                    // The notifflick absorber pattern: viewport-height is the body's own preferred
                    // height, so this is inert at every window tall enough for the menu and is the
                    // only way the clipped rows are reachable at every window that is not.
                    viewport-height: sctxbox.preferred-height;
                sctxbox := VerticalLayout {
                    padding-top: 3px; padding-bottom: 3px; padding-left: 0px; padding-right: 0px; spacing: 3px; // v0.8.40 (FIX 1): 3px body padding + 3px gaps — with the full-cell MenuItem wash every visible gap around a wash is exactly 3px (the user rule)
                    // v0.8.158 (B1a, RULING Q31): the twin's header — the SAME component and the
                    // SAME published string as the photo menu's (this menu's open site calls the
                    // same `ctx-populate`), so the two cannot word the subject differently.
                    // v0.8.163 (§7 item 2): the twin's header carries the same copy affordance off
                    // the same two properties — one populate fills both menus.
                    MenuHeader { extra-inset: 3px;
                        preferred-width: 0px; // the rows size the menu, not the filename
                        text: root.ctx-header;
                        clickable: !root.ctx-plural && root.ctx-header != "";
                        clicked => { root.copy-ctx-name(); }
                    }
                    MenuSep { extra-inset: 3px; }
                    // v0.8.158 (B1a, RULING Q31): the rating row used to open this menu; it now
                    // sits with the mark verbs further down (search `sstars`). See the note there.
                    // v0.8.119 (design-sweep Y55): the same gate on the Selection-tile twin.
                    MenuItem { edge-to-edge: true; text: @tr("falcon" => "Compare — send to A (left)"); enabled: root.count-all >= 2; clicked => { root.sel-to-compare(root.sel-ctx-idx, 0); root.sel-ctx-open = false; } }
                    MenuItem { edge-to-edge: true; text: @tr("falcon" => "Compare — send to B (right)"); enabled: root.count-all >= 2; clicked => { root.sel-to-compare(root.sel-ctx-idx, 1); root.sel-ctx-open = false; } }
                    MenuSep { extra-inset: 3px; }
                    // v0.8.42 (Item 2): the same Copy set as the stage/film menu, acting on the CLICKED
                    // tile — the ctx() open site runs root.ctx-populate(idx) (the v0.8.38 G2 pattern), so
                    // ctx-copy-fmt-label / ctx-has-finished / ctx-has-raw describe THIS tile's shot. NO
                    // shortcut-peek chips anywhere in this menu (see the rotate/delete note below):
                    // Ctrl+C copies the CURRENT shot via the ranked Settings priority, not the clicked
                    // tile — a chip here would teach a false equivalence.
                    // ── v0.8.194 (FIX 2026-08-18 §1D2): the twin's counted arm. ─────────────────
                    // THE PREDICATE IS THIS MENU'S OWN, not the photo menu's: its other set-scoped
                    // rows (Flag / Reject / Delete, below) mount on `ctx-tile-selected`, so these
                    // do too — one menu, one scope (J2), and a right-click on an UNSELECTED tile
                    // beside a live selection keeps offering the tile-scoped copies it always has.
                    // The consequence, deliberate and shared with its neighbours: at a selection of
                    // ONE containing this tile the counted rows mount — and `bulk_copy_row_label`
                    // drops the parenthetical at n <= 1, so they read exactly as the single rows do
                    // (the finished row's text IS the single row's published string) while copying
                    // that one photograph through the set-scoped door. The toast follows the same
                    // rule from the other end: `tick::bulk_copy_toast` falls back to the file-NAMING
                    // single sentence whenever exactly one photograph yielded files, so a set of one
                    // is indistinguishable from a single copy anywhere the user can see — which is
                    // the owner's standing "filename + type, not a bare file count" ruling.
                    // NO CAPS HERE, per this menu's blanket v0.8.42 rule (see the note above): the
                    // rule is about rows whose key targets a different subject, and while the photo
                    // menu's plural arm now satisfies that test, this menu's own convention is that
                    // only its index-free rows (Clear selection, Undo/Redo) carry one.
                    // ── v1.0.0-rc (queue item 27, sheet 2.1 B4, OWNER RULING): THE GATE IS `ctx-plural`. ─
                    // "counted rows only from two selected." Every counted row in this menu mounted on
                    // `ctx-tile-selected`, which is TRUE at a selection of ONE — so ctrl-clicking one
                    // photograph and right-clicking it offered "Flag 1" / "Delete 1 photo…" / a counted
                    // copy row whose own `bulk_copy_row_label` then dropped the count again, in a menu
                    // whose header named the FILE. The gate is now the photo menu's own predicate
                    // (`bulk_scoped && n_sel > 1`, which already includes tile membership), so the twins
                    // are twinned in their SCOPE too and not only in their strings.
                    if !root.ctx-plural : MenuItem { edge-to-edge: true; text: root.ctx-copy-fmt-label; enabled: root.ctx-has-finished;
                               shortcut: root.ctx-rank-mode == 0 ? root.sc-copy : ""; clicked => { root.menu-action("copy-fin", false); root.sel-ctx-open = false; } }
                    if root.ctx-plural : MenuItem { edge-to-edge: true; text: root.ctx-bulk-copy-fin-label; bold: true;
                               enabled: root.ctx-bulk-copy-fin-on && root.bulk-actions-armed;
                               shortcut: root.ctx-rank-mode == 0 ? root.sc-copy : ""; clicked => { root.menu-action("copy-fin", false); root.sel-ctx-open = false; } }
                    if !root.ctx-plural : MenuItem { edge-to-edge: true; text: @tr("falcon" => "Copy RAW"); enabled: root.ctx-has-raw;
                               shortcut: root.ctx-rank-mode == 1 ? root.sc-copy : ""; clicked => { root.menu-action("copy-raw", false); root.sel-ctx-open = false; } }
                    if root.ctx-plural : MenuItem { edge-to-edge: true; text: root.ctx-bulk-copy-raw-label; bold: true;
                               enabled: root.ctx-bulk-copy-raw-on && root.bulk-actions-armed;
                               shortcut: root.ctx-rank-mode == 1 ? root.sc-copy : ""; clicked => { root.menu-action("copy-raw", false); root.sel-ctx-open = false; } }
                    if !root.ctx-plural : MenuItem { edge-to-edge: true; text: @tr("falcon" => "Copy both"); enabled: root.ctx-has-finished && root.ctx-has-raw;
                               shortcut: root.ctx-rank-mode == 2 ? root.sc-copy : ""; clicked => { root.menu-action("copy-both", false); root.sel-ctx-open = false; } }
                    if root.ctx-plural : MenuItem { edge-to-edge: true; text: root.ctx-bulk-copy-both-label; bold: true;
                               enabled: root.ctx-bulk-copy-both-on && root.bulk-actions-armed;
                               shortcut: root.ctx-rank-mode == 2 ? root.sc-copy : ""; clicked => { root.menu-action("copy-both", false); root.sel-ctx-open = false; } }
                    MenuSep { extra-inset: 3px; }
                    MenuItem { edge-to-edge: true; text: @tr("falcon" => "Open in viewer"); clicked => { root.sel-jump(root.sel-ctx-idx); root.sel-ctx-open = false; } }
                    // v0.8.169 (item 5): the twin's Select row — same classifier, same kind, and
                    // the ONE difference the evidence demands: the third argument is `true` here,
                    // because this menu opens from a REVIEW-PANEL TILE and both of that panel's
                    // tiles pass `true` at their own `sel-gesture` call sites. See the photo menu's
                    // note for the semantics and the chip's doctrine exception.
                    // v1.0.0-rc (item 27, B1 iii): the twin's state word — same property, same reason;
                    // see the photo menu's note. The third `sel-gesture` argument stays `true` (this menu
                    // opens from a Review-panel tile).
                    MenuItem { edge-to-edge: true; text: root.ctx-tile-selected ? @tr("falcon" => "Deselect") : @tr("falcon" => "Select"); shortcut: root.sc-select;
                               enabled: root.sel-gesture-kind(true, false) >= 0 && root.sel-ctx-idx >= 0;
                               clicked => { root.sel-gesture(root.sel-ctx-idx, 0, true); root.sel-ctx-open = false; } }
                    // v1.0.0-rc (item 27, B7): the twin's "Select all", in the same place in the group
                    // and on the same ladder gate — see the photo menu's note. THE CAP IS HERE, on a menu
                    // whose v0.8.42 rule strips caps, for that rule's own reason: it bans caps on
                    // TILE-SCOPED rows, whose key targets a different subject, and
                    // `select-all-displayed()` takes no index at all — the same exemption "Clear
                    // selection" and Undo/Redo already hold here.
                    MenuItem { edge-to-edge: true; text: @tr("falcon" => "Select all"); shortcut: root.sc-select-all;
                               enabled: root.sel-gesture-kind(true, false) >= 0 && !root.capture-armed
                                        && (root.sel-open && !root.immersive ? root.sel-rows.length > 0 : root.count-all > 0);
                               clicked => { root.select-all-displayed(); root.sel-ctx-open = false; } }
                    // v0.8.129 (W1-5): the Selection-tile menu's twin of the photo menu's row — same
                    // published label, same L21 enablement, same shared handler.
                    // v0.8.137 (W3): the twin's chip. This menu's blanket "no chips" rule (v0.8.42)
                    // is a rule about TILE-SCOPED rows — every other action here targets
                    // `sel-ctx-idx` while its key targets the current shot. This row is
                    // FOLDER-scoped and index-free, so the rule's own reason does not reach it.
                    // v0.8.194 (§1F4): the twin's weight, same term, same reasoning — see the photo
                    // menu's note. The two menus are twinned and a weight that reached only one of
                    // them is exactly the drift twinning exists to prevent.
                    MenuItem { edge-to-edge: true; text: root.ctx-clear-sel-label; enabled: root.bulk-actions-armed; shortcut: root.sc-deselect; bold: root.count-selected > 0; // v0.8.133 (ruling 5): the promoted predicate — five inline copies of these three terms lived here // v0.8.131 (J1): the handler refuses in immersive and the photo menu IS reachable there (L21)
                               clicked => { root.clear-selection(); root.sel-ctx-open = false; } }
                    // v0.8.130 (W2-4): folder-scope, beside the other selection row. Greyed AND
                    // SELF-EXPLAINING where Falcon left no export record (the label says so).
                    MenuItem { edge-to-edge: true; text: root.ctx-sel-new-label; enabled: root.ctx-has-manifest && !root.compare && !root.immersive;
                               clicked => { root.select-new-edited(); root.sel-ctx-open = false; } }
                    MenuSep { extra-inset: 3px; }
                    // v0.8.130 (W2-2, owner ruling Q1): the BULK rows. Counted and state-derived
                    // (published by ctx-populate — "Flag 12 photos" vs "Unflag 12 photos" is the
                    // same uniform-state predicate the P key applies). Compare and immersive stay
                    // dormant (A-2/A-3) — the enablement mirrors the handler.
                    //
                    // v0.8.131 (J17) — THE OLD [VD] CLAIM WAS FALSE. It said these rows were
                    // "available regardless of panel state" because they are self-describing. They
                    // are self-describing, but this menu OPENS FROM A REVIEW-PANEL TILE: there is
                    // no panel state in which it can be reached with the panel shut, so the [VD]
                    // was a permission nobody could exercise. The rows' real scope gate is J2's
                    // `ctx-tile-selected` above. (Recorded owner note, not fixed here: a selection
                    // built with the panel CLOSED shows tile rims but no count anywhere.)
                    // v0.8.131 (J2 [VD]): they MOUNT only when the clicked tile is itself selected.
                    // Right-clicking an UNSELECTED tile beside a 12-photo selection used to offer
                    // "Flag 12 photos" directly under "Open in viewer" — two scopes in one menu,
                    // with the photo under the cursor in neither of them. One menu, one scope.
                    //
                    // ── v0.8.158 (B1a, OWNER RULING Q31): THE RATING ROW, MOVED HERE FROM THE TOP ──
                    // "the ratings row moves DOWN into the same category as flag/reject". On the
                    // PHOTO menu that category is Flag · Reject · Unmark; on THIS menu the mark
                    // verbs are the three counted BULK rows below, so this is where the ruling puts
                    // it — at the head of the group whose other members mark photographs.
                    // It stays UNCONDITIONALLY mounted while those three are `ctx-tile-selected`-
                    // gated (v0.8.131 J2), because it is the one row here that is honest in BOTH
                    // scopes: armed it shows the group's uniform rating and asks about the whole
                    // selection, unarmed it rates the CLICKED tile like every other row in this menu.
                    // Markup below is v0.8.133/v0.8.136/v0.8.137 VERBATIM — same 24px Star, same 2px
                    // pitch, same host Rectangle, same pill behind it; only its position moved.
                    HorizontalLayout {
                        padding-left: Theme.space-2h + 3px; padding-right: 11px; height: 32px; spacing: Theme.space-1h;
                        // v0.8.163 (§7 item 3): the twin's label, same property, same rule.
                        // v0.8.164 (§7 item 6): font-md + elide, the twin's rule — see the photo menu's note.
                        Text { text: root.ctx-rate-label;
                               color: root.ctx-plural ? Theme.text : Theme.text-mute;
                               font-size: Theme.font-md; overflow: elide;
                               font-weight: root.ctx-plural ? 700 : 400;
                               vertical-alignment: center; horizontal-stretch: 1; }
                        // v0.8.136 (V3) / v0.8.137 (W2): the twin's Rectangle host — same 128px
                        // cluster inside a 144px host, same absolutely-placed pill behind it, same
                        // zero height cost. See the photo menu's note above.
                        Rectangle {
                        width: sstars.preferred-width + 2 * Theme.space-2;
                        sctxstarpill := StarBulkPill {
                            // v0.8.164 (§7 item 6): the twin's rule — no pill while the label counts.
                            armed: root.ctx-rate-armed && !root.ctx-plural;
                            x: 0px; y: (parent.height - self.height) / 2;
                            width: 100%; height: 26px;
                        }
                        VerticalLayout { alignment: center;
                        padding-left: Theme.space-2; padding-right: Theme.space-2;
                        sstars := HorizontalLayout {
                            spacing: 2px;
                            property <int> hov: t1.hov ? 1 : t2.hov ? 2 : t3.hov ? 3 : t4.hov ? 4 : t5.hov ? 5 : 0;
                            // v0.8.134 (ORANGE-2): the twin's term. This menu opens FROM a Review
                            // tile, and J2 already gates the three bulk rows below on
                            // `ctx-tile-selected`; the star row was the one that did not.
                            property <int> shown: root.ctx-rate-armed ? root.bulk-uniform-rating : root.ctx-rating;
                            t1 := Star { index: 1; rating: sstars.shown; preview: sstars.hov; clicked => { root.menu-action("rate1", false); root.sel-ctx-open = false; } }
                            t2 := Star { index: 2; rating: sstars.shown; preview: sstars.hov; clicked => { root.menu-action("rate2", false); root.sel-ctx-open = false; } }
                            t3 := Star { index: 3; rating: sstars.shown; preview: sstars.hov; clicked => { root.menu-action("rate3", false); root.sel-ctx-open = false; } }
                            t4 := Star { index: 4; rating: sstars.shown; preview: sstars.hov; clicked => { root.menu-action("rate4", false); root.sel-ctx-open = false; } }
                            t5 := Star { index: 5; rating: sstars.shown; preview: sstars.hov; clicked => { root.menu-action("rate5", false); root.sel-ctx-open = false; } }
                        } }
                        }
                    }
                    // v0.8.163 (§7 item 3): these two ARE the ruling's plural rows on this menu —
                    // same published labels the photo menu's plural arm now binds — so they take
                    // the same bold. The Delete row below deliberately does not: it keeps the
                    // longer "Delete n photos…" form (the ellipsis promises the confirm) and a
                    // destructive row is not something to draw the eye to with weight. [VD]
                    // ── v1.0.0-rc (queue item 27, sheet 2.1 B1 ii + B4, OWNER RULINGS). ─────────────────
                    // B1 ii: *"'Unmark N' in the Review-panel tile menu's counted group"* — the fourth row,
                    // `bulk-mark(2)` (`BulkOp::Clear`, the u key's own plural), bold like its two counted
                    // siblings, on the property `on_ctx_populate` already published for the photo menu.
                    //
                    // B4 gives the group its `ctx-plural` gate, and that CREATES the `!ctx-plural` arm
                    // below. This menu never had single mark rows — the counted trio was its only mark
                    // surface, and at n = 1 it read "Flag 1" / "Reject 1" / "Delete 1 photo…" — so without
                    // the three twins B4 would leave a one-photo selection with no way to flag from its
                    // own tile menu, which is a REGRESSION from a row that worked. They are the photo
                    // menu's own single-target rows, tile-scoped: `sel-toggle-flag` / `sel-toggle-reject` /
                    // `sel-unmark` at `sel-ctx-idx`, with the third argument `true` this menu passes
                    // everywhere (see the Select row's note above). NO CAPS — the v0.8.42 rule, which
                    // these rows are squarely inside: p / x / u act on the CURRENT shot, not the clicked
                    // tile. They sit exactly where the counted rows sit, under the star row, so the
                    // group's position on the glass does not move between scopes.
                    if root.ctx-plural : MenuItem { edge-to-edge: true; text: root.ctx-bulk-flag-label; bold: true; enabled: root.bulk-actions-armed; // v0.8.133 (ruling 5): the promoted predicate — five inline copies of these three terms lived here
                               shortcut: root.sc-flag; clicked => { root.menu-action("flag", false); root.sel-ctx-open = false; } }
                    if !root.ctx-plural : MenuItem { edge-to-edge: true; text: @tr("falcon" => "Flag"); checked: root.ctx-flag;
                               shortcut: root.sc-flag; clicked => { root.menu-action("flag", false); root.sel-ctx-open = false; } }
                    if root.ctx-plural : MenuItem { edge-to-edge: true; text: root.ctx-bulk-reject-label; bold: true; enabled: root.bulk-actions-armed; // v0.8.133 (ruling 5): the promoted predicate — five inline copies of these three terms lived here
                               shortcut: root.sc-reject; clicked => { root.menu-action("reject", false); root.sel-ctx-open = false; } }
                    if !root.ctx-plural : MenuItem { edge-to-edge: true; text: @tr("falcon" => "Reject"); checked: root.ctx-reject;
                               shortcut: root.sc-reject; clicked => { root.menu-action("reject", false); root.sel-ctx-open = false; } }
                    if root.ctx-plural : MenuItem { edge-to-edge: true; text: root.ctx-bulk-unmark-label; bold: true; enabled: root.bulk-actions-armed;
                               shortcut: root.sc-unmark; clicked => { root.menu-action("unflag", false); root.sel-ctx-open = false; } }
                    if !root.ctx-plural : MenuItem { edge-to-edge: true; text: @tr("falcon" => "Unmark"); enabled: root.ctx-flag || root.ctx-reject;
                               shortcut: root.sc-unmark; clicked => { root.menu-action("unflag", false); root.sel-ctx-open = false; } }
                    if root.ctx-plural : MenuItem { edge-to-edge: true; text: root.ctx-bulk-delete-label; enabled: root.bulk-actions-armed; // v0.8.133 (ruling 5): the promoted predicate — five inline copies of these three terms lived here
                               shortcut: root.sc-delete; clicked => { root.menu-action("delete", false); root.sel-ctx-open = false; } }
                    MenuSep { extra-inset: 3px; }
                    // v0.8.184 (D1): the twin's history rows — see the photo menu's note for the
                    // ruling, the plurality reading and the enablement derivation. The leading
                    // separator is the bulk trio's own (a second one would be a Sep-Sep run); the
                    // trailing one below opens the Rotate group, so history stands alone here too.
                    //
                    // THESE CARRY CAPS ON A MENU THAT DELIBERATELY HAS NONE, and the v0.8.42 rule
                    // one comment down is exactly why they may: R / Shift+R / Del were stripped
                    // here because they act on the CURRENT shot while every row targets the
                    // CLICKED tile. `undo()` / `redo()` take no index at all — there is no target
                    // for a tile-scoped open to lie about, which is the same reasoning that gave
                    // "Clear selection" its Ctrl+D on this menu's twin.
                    // v0.8.186 (fix wave, lens finding 4): the twin takes the same state-derived
                    // name, from the same property — see the photo menu's note.
                    MenuItem { edge-to-edge: true; text: root.cull-undo-label == "Undo move" ? @tr("falcon" => "Undo move") : @tr("falcon" => "Undo last change");
                               enabled: root.can-cull-undo; shortcut: root.sc-undo;
                               clicked => { root.menu-action("undo", false); root.sel-ctx-open = false; } }
                    MenuItem { edge-to-edge: true; text: @tr("falcon" => "Redo last change"); enabled: root.can-cull-redo; shortcut: root.sc-redo;
                               clicked => { root.menu-action("redo", false); root.sel-ctx-open = false; } }
                    MenuSep { extra-inset: 3px; }
                    // v0.8.42 (Item 2): shortcut-peek chips REMOVED from this menu — R / Shift+R / Del
                    // act on the CURRENT shot, but every action here targets the CLICKED tile; the chips
                    // taught a false equivalence (the same rule keeps the new Copy items chip-free).
                    // v0.8.187 (W6, OWNER RULING D25): the SAME greying as the photo menu's — this
                    // menu's open site calls the same `ctx-populate`, so `ctx-rotate-blocked`
                    // describes THIS tile's target and the two menus cannot disagree.
                    // v1.0.0-rc (item 27, B2 b): the twin's counted rotate rows — same door, same
                    // enablement reasoning as the photo menu's (see its note). NO CAPS here: this menu's
                    // v0.8.42 rule stands for the plural arm too, because a tile-scoped open is exactly
                    // the case the rule was written for and the plural rows are the ones the R key would
                    // agree with only sometimes.
                    if root.ctx-plural : MenuItem { edge-to-edge: true; text: root.ctx-bulk-rot-cw-label; icon: 1; bold: true; enabled: root.bulk-actions-armed;
                               shortcut: root.sc-rotcw; clicked => { root.menu-action("rotcw", false); root.sel-ctx-open = false; } }
                    if !root.ctx-plural : MenuItem { edge-to-edge: true; text: @tr("falcon" => "Rotate right"); icon: 1; enabled: !root.ctx-rotate-blocked; shortcut: root.sc-rotcw; clicked => { root.menu-action("rotcw", false); root.sel-ctx-open = false; } }
                    if root.ctx-plural : MenuItem { edge-to-edge: true; text: root.ctx-bulk-rot-ccw-label; icon: 2; bold: true; enabled: root.bulk-actions-armed;
                               shortcut: root.sc-rotccw; clicked => { root.menu-action("rotccw", false); root.sel-ctx-open = false; } }
                    if !root.ctx-plural : MenuItem { edge-to-edge: true; text: @tr("falcon" => "Rotate left"); icon: 2; enabled: !root.ctx-rotate-blocked; shortcut: root.sc-rotccw; clicked => { root.menu-action("rotccw", false); root.sel-ctx-open = false; } }
                    // v0.8.169 (item 2): the twin's "View EXIF", MOVED here from the view/navigation
                    // group so it sits beside `reveal-verb` on both menus — the ruling is about the
                    // CATEGORY ("the same category as open in Explorer"), and the two menus have
                    // been twinned since v0.8.131, so a category that reached only one of them
                    // would be exactly the drift twinning exists to prevent. Same in-app-then-out
                    // order as the photo menu. Same enablement predicate, same callback, TILE-scoped
                    // target (this menu's whole point), so the panel opens PINNED to the clicked
                    // tile's photograph. `sel-ctx-x/y` are already WINDOW coordinates here (they
                    // come from absolute-position at the open site), so no 44px correction applies.
                    // v0.8.181 (pre-merge review): same predicate as the twin, and it is `ctx-plural`
                    // now for the reason spelled out at the photo menu's row.
                    MenuItem { edge-to-edge: true; text: @tr("falcon" => "View EXIF"); enabled: !root.ctx-plural;
                               clicked => { root.float-exif-open(root.sel-ctx-idx, root.sel-ctx-x, root.sel-ctx-y); root.sel-ctx-open = false; } }
                    // v1.0.0-rc (item 27, B3 b): the twin's counted reveal — one window, every selected
                    // file highlighted, through the same index-free door. See the photo menu's note.
                    if root.ctx-plural : MenuItem { edge-to-edge: true; text: root.ctx-reveal-label; bold: true; enabled: root.bulk-actions-armed;
                               clicked => { root.reveal-selected(); root.sel-ctx-open = false; } }
                    if !root.ctx-plural : MenuItem { edge-to-edge: true; text: root.reveal-verb; clicked => { root.reveal-shot(root.sel-ctx-idx); root.sel-ctx-open = false; } }
                    MenuSep { extra-inset: 3px; }
                    // v0.8.131 (J2 / F3 L-5): TILE-SCOPED, and it says so. In a menu that also
                    // carries "Delete 12 photos…" a bare "Delete…" is the one row whose scope the
                    // user has to infer, and the two are one row apart.
                    MenuItem { edge-to-edge: true; text: @tr("falcon" => "Delete this photo…"); shortcut: !root.ctx-plural ? root.sc-delete : ""; clicked => { root.menu-action("delete-one", false); root.sel-ctx-open = false; } }
                }
                }
                // The clipped-content smudge, off the flick's own edges (the ctxflick site above).
                sctxfade := PanelBottomFade {
                    x: sctxflick.x; width: sctxflick.width;
                    y: sctxflick.y + sctxflick.height - self.height;
                    more: sctxflick.viewport-height + sctxflick.viewport-y > sctxflick.height + 1px;
                }
            }
        }

        // ── v0.8.49: position-chip SORT menu (anchored under the title-bar position chip) ──
        // Same glass/dismissal grammar as the two context menus above (pointer-down anywhere closes;
        // Esc via the Rust cascade; a folder swap closes it at the apply_scan choke point). The
        // ACTIVE method and direction are marked via MenuItem.checked (accent label, colour-only).
        // Method/direction rows do NOT self-close: Rust's pick handler closes the menu (single
        // owner), so a no-op pick (the already-active row) also just dismisses.
        // ── Settings → LANGUAGE's dropdown (owner ruling during the round-1 review: "Use a
        // dropdown", in the app's menu style, scrolling when needed). One MenuItem per language,
        // its own name, the current one checked. It hangs under its trigger at the trigger's width,
        // so a long native name has the whole row. Same dismissal grammar as the sort menu below
        // (pointer-down anywhere closes); Esc closes it before Settings, and closing Settings tears
        // it down. The sctxbox treatment from the start: a y floor, a height cap, a Flickable and
        // the bottom fade, so any number of language packs stays reachable in a short window.
        if root.language-menu-open : Rectangle {
            y: root.content-top;
            height: parent.height - self.y;
            width: 100%;
            TouchArea {
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) { root.language-menu-open = false; }
                }
            }
            langpanel := GlassPanel {
                hover-glass: true;
                width: max(160px, root.language-menu-w);
                x: max(8px, min(root.language-menu-x, root.width - self.width - 8px));
                y: max(0px, min(root.language-menu-y - parent.y, parent.height - self.height - 8px));
                height: min(langbox.preferred-height, parent.height - 16px);
                backdrop: root.blur-backdrop;
                sw: root.content-w; sh: root.content-h; ox: 0px; oy: 0px;
                TouchArea {}
                langflick := Flickable {
                    viewport-height: langbox.preferred-height;
                    langbox := VerticalLayout {
                        padding-top: 3px; padding-bottom: 3px; padding-left: 0px; padding-right: 0px; spacing: 3px;
                        for name[i] in root.language-options : MenuItem {
                            edge-to-edge: true; text: name; checked: i == root.language-sel;
                            clicked => { root.language-sel = i; root.language-menu-open = false; root.language-picked(i); }
                        }
                    }
                }
                langfade := PanelBottomFade {
                    x: langflick.x; width: langflick.width;
                    y: langflick.y + langflick.height - self.height;
                    more: langflick.viewport-height + langflick.viewport-y > langflick.height + 1px;
                }
            }
        }

        if root.sort-open : Rectangle {
            y: root.content-top;
            height: parent.height - self.y;
            width: 100%;
            TouchArea {
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) { root.sort-open = false; }
                }
            }
            sortpanel := GlassPanel {
                // Same single-menu crop owner as the photo context menus.
                init => {
                    root.context-menu-x = self.x; root.context-menu-y = self.y;
                    root.context-menu-w = self.width; root.context-menu-h = self.height;
                }
                changed x => { root.context-menu-x = self.x; }
                changed y => { root.context-menu-y = self.y; }
                changed width => { root.context-menu-w = self.width; }
                changed height => { root.context-menu-h = self.height; }
                hover-glass: true;
                width: 190px;
                x: max(8px, min(root.sort-menu-x, root.width - self.width - 8px));
                y: root.sort-menu-y; // same 3px inset, converted for a native-hosted toolbar
                height: sortbox.preferred-height;
                backdrop: root.menu-blur-covers ? root.menu-backdrop : root.blur-backdrop;
                sw: root.menu-blur-covers ? root.menu-blur-w : root.content-w;
                sh: root.menu-blur-covers ? root.menu-blur-h : root.content-h;
                ox: root.menu-blur-covers ? root.menu-blur-x : 0px;
                oy: root.menu-blur-covers ? root.menu-blur-y : 0px;
                TouchArea {}
                sortbox := VerticalLayout {
                    padding-top: 3px; padding-bottom: 3px; padding-left: 0px; padding-right: 0px; spacing: 3px;
                    // v0.8.132 (F-P2 rule 6, RIDER RECORDED IN CODE WHERE IT BINDS): this menu is
                    // the ONE of the three that has no height cap and no Flickable — it is
                    // `height: sortbox.preferred-height` and nothing else. Measured at the fix
                    // wave: its twelve rows + two separators fit the app's deliberate 400px
                    // minimum window height with ZERO pixels to spare. THE NEXT ROW ADDED HERE
                    // OVERFLOWS at that size — so adding one means porting the ctxbox treatment
                    // first (the `max(0px, …)` y floor, `min(preferred, parent.height - 16px)`,
                    // the Flickable + PanelBottomFade), exactly as sctxbox got it in v0.8.131.
                    // v0.8.119 (design-sweep Y52): on_film_recenter does exactly two things —
                    // re-engage the filmstrip follow and poke the grid dock's recenter cell — and
                    // both targets are user-hideable from the chip cluster this menu hangs off.
                    // With neither on screen the row was fully lit and moved nothing observable.
                    // KNOWN AND DELIBERATE: the film half is not eternally inert — `film_follow`
                    // persists, so clicking this with the strip hidden used to re-arm the follow
                    // for the NEXT time the strip was shown. That latent effect is discarded on
                    // purpose: a command whose only result is invisible now and surprising later
                    // is worse than an honest grey row (showing the strip recentres it anyway).
                    MenuItem { edge-to-edge: true; text: @tr("falcon" => "Scroll to current"); enabled: root.film-visible || root.grid-open; clicked => { root.film-recenter(); root.sort-open = false; } }
                    MenuSep { extra-inset: 3px; }
                    MenuItem { edge-to-edge: true; text: @tr("falcon" => "Name"); enabled: !root.opening-photo; checked: root.sort-method == 0; clicked => { root.sort-pick(0); } }
                    MenuItem { edge-to-edge: true; text: @tr("falcon" => "Date taken"); enabled: !root.opening-photo; checked: root.sort-method == 1; clicked => { root.sort-pick(1); } }
                    MenuItem { edge-to-edge: true; text: @tr("falcon" => "Date modified"); enabled: !root.opening-photo; checked: root.sort-method == 2; clicked => { root.sort-pick(2); } }
                    MenuItem { edge-to-edge: true; text: @tr("falcon" => "Date created"); enabled: !root.opening-photo; checked: root.sort-method == 3; clicked => { root.sort-pick(3); } }
                    MenuItem { edge-to-edge: true; text: @tr("falcon" => "Size"); enabled: !root.opening-photo; checked: root.sort-method == 4; clicked => { root.sort-pick(4); } }
                    MenuItem { edge-to-edge: true; text: @tr("falcon" => "Type"); enabled: !root.opening-photo; checked: root.sort-method == 5; clicked => { root.sort-pick(5); } }
                    MenuItem { edge-to-edge: true; text: @tr("falcon" => "Rating"); enabled: !root.opening-photo; checked: root.sort-method == 6; clicked => { root.sort-pick(6); } }
                    MenuSep { extra-inset: 3px; }
                    MenuItem { edge-to-edge: true; text: @tr("falcon" => "Ascending"); enabled: !root.opening-photo; checked: !root.sort-desc; clicked => { root.sort-dir-pick(false); } }
                    MenuItem { edge-to-edge: true; text: @tr("falcon" => "Descending"); enabled: !root.opening-photo; checked: root.sort-desc; clicked => { root.sort-dir-pick(true); } }
                }
            }
        }

        // ── TOMBSTONE — the title-bar path context menu ("Copy path") stood here, v0.8.50 (G1,
        // owner option (b)) to v0.8.192. RETIRED by owner order 2026-08-16: "the app already has a
        // dedicated button for opening/closing the grid view", so the pill's LEFT click is
        // click-to-copy again (see pathta above) and the one-row menu it displaced has no reason to
        // exist. Its `path-ctx-open` / `path-ctx-x` properties, its `popup-open` term, its
        // `close-bar-menus` row and its Rust Esc/apply_scan rows went with it.

        // ── v0.8.65 (C3/M6): the Open… menu — Image | Folder ──
        // rfd 0.15.4 has no combined file-or-folder dialog (its Windows IFileDialog backend sets
        // FOS_PICKFOLDERS exclusively for folder mode), so the Open button offers the two honest
        // paths: "Image…" = today's filtered file picker (navigating into any folder still works),
        // "Folder…" = a true folder picker that opens the folder directly (the drag-drop path).
        // Same glass/dismissal grammar as the sort menu (pointer-down anywhere closes; Esc via
        // the Rust cascade; a folder swap closes it at the apply_scan choke point). Anchored under
        // its trigger — the title-bar Open button, or the empty-state button (open-menu-x/y).
        if root.open-menu-open : Rectangle {
            y: root.content-top;
            height: parent.height - self.y;
            width: 100%;
            TouchArea {
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) { root.open-menu-open = false; }
                }
            }
            GlassPanel {
                width: 160px;
                x: max(8px, min(root.open-menu-x, root.width - self.width - 8px));
                y: root.open-menu-y;
                height: openmbox.preferred-height;
                backdrop: root.blur-backdrop;
                sw: root.content-w; sh: root.content-h; ox: 0px; oy: 0px;
                TouchArea {}
                openmbox := VerticalLayout {
                    padding: 3px; spacing: 3px; // the v0.8.40 menu rule: 3px body padding + 3px gaps
                    MenuItem { text: @tr("falcon" => "Image…"); clicked => { root.open-menu-open = false; root.open-folder(); } }
                    MenuItem { text: @tr("falcon" => "Folder…"); clicked => { root.open-menu-open = false; root.open-folder-direct(); } }
                }
            }
        }

        // selection-tile DRAG: dim the screen and show two big centred A/B drop zones (so you never
        // have to hit the panel-occluded half); the dragged thumbnail follows the cursor; dropping on
        // a zone sends the tile to that compare half. A full-window CAPTURING TouchArea sits under the
        // visuals so NO input leaks to the stage below (else releasing over the photo would trigger
        // click-to-zoom). It also TRACKS + FINALISES as a safety net: if the tile loses the pointer
        // grab mid-drag (it lives in a Flickable), this still updates the cursor + drops on release.
        if root.sel-dragging : Rectangle {
            width: 100%; height: 100%;
            background: #00000070; // compare-drag dim — pure-black overlay; one-off, predates the neutral scrim-* tokens (kept to avoid a visual change)
            block := TouchArea {
                mouse-cursor: grabbing;
                moved => {
                    root.sel-drag-x = self.mouse-x;
                    root.sel-drag-y = self.mouse-y;
                    root.sel-drag-zone = root.drop-zone-at(self.mouse-x, self.mouse-y);
                }
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.up && root.sel-dragging) {
                        if (root.sel-drag-zone >= 0) { root.sel-to-compare(root.sel-drag-idx, root.sel-drag-zone); }
                        root.sel-dragging = false;
                        root.sel-drag-zone = -1;
                    }
                }
            }
            DropZone {
                x: root.dropa-x; y: root.drop-y; width: root.drop-w; height: root.drop-h;
                active: root.sel-drag-zone == 0; letter: "A"; caption: @tr("falcon" => "drop on left half");
            }
            DropZone {
                x: root.dropb-x; y: root.drop-y; width: root.drop-w; height: root.drop-h;
                active: root.sel-drag-zone == 1; letter: "B"; caption: @tr("falcon" => "drop on right half");
            }
            // floating preview of the dragged thumbnail (follows the cursor)
            Rectangle {
                x: root.sel-drag-x - 52px; y: root.sel-drag-y - 39px; width: 104px; height: 78px;
                border-radius: Theme.radius-sm; border-width: 2px; border-color: Theme.accent;
                background: Theme.block; clip: true;
                Image { source: root.sel-drag-thumb; image-fit: cover; width: 100%; height: 100%; }
            }
        }

        // Text-watermark FONT PICKER — a centred, scrollable list of installed system fonts. A
        // separate top-level popup (not inline in the export sheet) so it never grows that modal
        // past the window. Rendered last → above everything.
        if root.wm-font-open : Rectangle {
            y: root.content-top;
            height: parent.height - self.y;
            width: 100%;
            background: Theme.scrim;
            TouchArea { clicked => { root.wm-font-open = false; } } // click-away closes
            GlassPanel {
                width: 320px;
                height: min(440px, root.height - 88px);
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2 > 0px ? (parent.height - self.height) / 2 : 0px;
                backdrop: root.blur-backdrop; sw: root.content-w; sh: root.content-h; ox: 0px; oy: 0px;
                TouchArea {}
                VerticalLayout {
                    padding: Theme.space-4; spacing: Theme.space-2;
                    PanelHeader { title: @tr("falcon" => "Choose a font"); dismiss => { root.wm-font-open = false; } }
                    Flickable {
                        max-height: 100000px; // stretch-class absorber (v0.8.3 rule): defensive opt-out (fixed-height panel + content-capped Flickable)
                        viewport-height: fontcol.preferred-height;
                        fontcol := VerticalLayout {
                            padding: 2px; spacing: 1px;
                            Rectangle {
                                height: 30px; border-radius: Theme.radius-sm;
                                background: root.wm-font == "" ? Theme.accent-soft : (dfta.has-hover ? Theme.hover : transparent);
                                HorizontalLayout { padding-left: 8px; padding-right: 8px;
                                    Text { text: @tr("falcon" => "Default (system UI)"); color: Theme.text; font-size: Theme.font-md;
                                           vertical-alignment: center; horizontal-stretch: 1; } }
                                dfta := TouchArea { clicked => { root.set-wm-font(""); root.wm-font-open = false; } }
                            }
                            // v0.8.90: each family row shows the plain name UNTIL its own-typeface
                            // preview strip lands, then swaps to the Image — MOUNT-GATED `if` both ways
                            // (ledger L4: never both, no space held, no click-steal). Symbol fonts /
                            // failed renders never set has-preview, so they keep the plain name (L15's
                            // progressive first-open: names swap in as the producer streams — no layout
                            // shift, the row is a fixed 30px and both branches paint INSIDE it).
                            for fam in root.wm-fonts : Rectangle {
                                height: 30px; border-radius: Theme.radius-sm;
                                background: fam.name == root.wm-font ? Theme.accent-soft : (fmrow.has-hover ? Theme.hover : transparent);
                                if !fam.has-preview : HorizontalLayout { padding-left: 8px; padding-right: 8px;
                                    Text { text: fam.name; color: Theme.text; font-size: Theme.font-md;
                                           vertical-alignment: center; horizontal-stretch: 1; overflow: elide; } }
                                if fam.has-preview : Rectangle {
                                    // v0.8.91: an over-long strip arrives CAPPED by the producer at this
                                    // frame's width budget with a baked right-edge alpha FADE-OUT
                                    // (render_text_strip_picker) — the image-native equivalent of the plain
                                    // rows' elide, never a mid-glyph hard cut. This clip frame is defensive
                                    // only (a capped strip exactly fits it). No TouchArea in this subtree —
                                    // clip gates painting only, clicks stay on fmrow below.
                                    x: 8px; width: parent.width - 16px; height: parent.height; clip: true;
                                    Image {
                                        // strips render at 2x (24px glyphs) and display at HALF their
                                        // physical size → 12px-glyph optical size, matching the plain
                                        // rows' font-md text; crisp on displays up to 200% scale.
                                        // v0.8.91: every strip shares ONE fixed canvas height with the
                                        // baseline at a constant y (render_text_strip_picker), so this
                                        // own-height centering puts every row's baseline in the same place —
                                        // no descender wobble, no plain→preview baseline jump.
                                        x: 0px; y: (parent.height - self.height) / 2;
                                        width: fam.pw / 2 * 1px; height: fam.ph / 2 * 1px;
                                        source: fam.preview;
                                    }
                                }
                                fmrow := TouchArea { clicked => { root.set-wm-font(fam.name); root.wm-font-open = false; } }
                            }
                        }
                    }
                }
            }
        }

        // ── Delete-preset confirmation (modal) — rendered last so it sits above the
        //    export sheet + font picker. Destructive, so Delete OWNS the danger colour; Cancel is the quiet ghost (v0.8.38 G5). ──
        if root.wm-del-confirm >= 0 : Rectangle {
            y: root.content-top;
            height: parent.height - self.y;
            width: 100%;
            background: Theme.scrim;
            TouchArea {} // block everything behind (incl. the export sheet; title bar stays live)
            SolidPanel {
                width: 392px; height: dcbox.preferred-height;
                x: (parent.width - self.width) / 2;
                // v0.8.46 (Item 2): device-pixel snap — same bottom-anchored-footer arithmetic as the
                // confirm dialog (button top edge = panel-bottom − 50px, onto an integer device px).
                property <float> sfx: max(root.win-sf, 0.5);
                property <length> raw-y: (parent.height - self.height) / 2;
                property <length> btn-top: parent.y + self.raw-y + self.height - 50px;
                y: self.raw-y + Math.round(self.btn-top / 1px * self.sfx) / self.sfx * 1px - self.btn-top;
                dcbox := VerticalLayout {
                    padding: Theme.space-4; spacing: Theme.space-3;
                    Text { text: @tr("falcon" => "Delete this preset?"); color: Theme.text; font-size: Theme.title-size; font-weight: 600; }
                    Text { text: root.wm-del-name; color: Theme.accent; font-size: Theme.font-md; font-weight: 700;
                           overflow: elide; }
                    Text { text: @tr("falcon" => "Removes the saved preset only — your photos and last-used export settings are untouched.");
                           color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: Theme.space-2;
                        // v0.8.38 (G5): ONE ladder — danger OWNS the destructive act (Delete = solid danger);
                        // Cancel is the quiet ghost (Esc AND Enter both cancel; the target ring was owner-revoked, v0.8.46).
                        ActionBtn { label: @tr("falcon" => "Cancel"); variant: 2; clicked => { root.wm-del-confirm = -1; } }
                        ActionBtn { label: @tr("falcon" => "Delete preset"); variant: 1; primary: true;
                            clicked => { root.delete-preset(root.wm-del-confirm); root.wm-del-confirm = -1; } }
                    }
                }
            }
        }

        // ── v0.8.108 (owner ruling 9): FORGET-a-display confirmation (modal). The delete-preset
        //    shape verbatim — one house grammar for "forget a saved named thing": danger owns the
        //    destructive act, Cancel is the quiet ghost, and both Esc AND Enter cancel. Rendered
        //    beside its sibling so it sits above the Settings panel it is launched from. ──
        if root.display-del-confirm : Rectangle {
            y: root.content-top;
            height: parent.height - self.y;
            width: 100%;
            background: Theme.scrim;
            TouchArea {} // block everything behind (the Settings panel); title bar stays live
            SolidPanel {
                width: 392px; height: ddbox.preferred-height;
                x: (parent.width - self.width) / 2;
                // Device-pixel snap, the v0.8.46 bottom-anchored-footer arithmetic.
                property <float> sfx: max(root.win-sf, 0.5);
                property <length> raw-y: (parent.height - self.height) / 2;
                property <length> btn-top: parent.y + self.raw-y + self.height - 50px;
                y: self.raw-y + Math.round(self.btn-top / 1px * self.sfx) / self.sfx * 1px - self.btn-top;
                ddbox := VerticalLayout {
                    padding: Theme.space-4; spacing: Theme.space-3;
                    Text { text: @tr("falcon" => "Forget this display?"); color: Theme.text; font-size: Theme.title-size; font-weight: 600; }
                    Text { text: root.display-del-name; color: Theme.accent; font-size: Theme.font-md; font-weight: 700;
                           overflow: elide; }
                    Text { text: @tr("falcon" => "Removes its remembered colour setting and monitor profile from Falcon. Your photos and the profile file itself are untouched — plug the display in again to set it up.");
                           color: Theme.text-mute; font-size: Theme.font-sm; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: Theme.space-2;
                        ActionBtn { label: @tr("falcon" => "Cancel"); variant: 2; clicked => { root.display-del-confirm = false; } }
                        dsecdel := ActionBtn { label: @tr("falcon" => "Forget display"); variant: 1; primary: true;
                            clicked => { root.remove-display(root.display-del-key); root.display-del-confirm = false; } }
                    }
                }
            }
        }
        // ── G11 (v0.8.44): the shared delayed tooltip — ONE renderer for every Tip-reporting host
        // (the five unlabeled title-bar buttons + the HUD chips + the path pill + the Selection
        // XMP toggle). Hosts write Tip.text/cx on hover; this layer waits a ~600ms dwell, then
        // fades in a badge-bg pill. v0.8.84 — TWO y paths: cy 0 (the sentinel every pre-existing
        // host leaves untouched) keeps the title-bar line VERBATIM (y 47 = the 44px bar + the 3px
        // gap rule); cy > 0 is a positioned host's window-space top edge, clamped to the window
        // bottom exactly like x clamps to the 3px side insets. DISPLAY-ONLY:
        // no TouchArea (it can never steal pointer events), and it never renders in immersive (hosts
        // are hit-gated there; the `target` term is belt-and-suspenders + changed-immersive clears
        // the latch). Always-mounted — an `if` would remount mid-dwell and defeat the delay. Hide is
        // INSTANT (tooltip convention); an A→B hover move while shown just re-labels in place. The
        // cache-meter keeps its bespoke tip (its text live-updates while hovered — this layer
        // snapshots at hover-in) and the colour-chip note stays a bespoke ELEMENT (wide, wrapping,
        // panel-anchored) — wearing this pill's exact look since v0.8.45 (Fix 4).
        tiplayer := Rectangle {
            property <float> target: (Tip.text != "" && !root.immersive) ? 1.0 : 0.0;
            property <float> reveal: self.target;
            animate reveal { delay: self.target > 0.5 ? 600ms : 0ms; duration: self.target > 0.5 ? 90ms : 0ms; easing: ease; }
            visible: self.reveal > 0.01 && Tip.text != "";
            opacity: self.reveal;
            x: max(3px, min(Tip.cx - self.width / 2, root.width - self.width - 3px));
            // v0.8.84: the sentinel arm is the LITERAL pre-existing 47px (byte-identical title-bar
            // rendering); the positioned arm clamps inside the window bottom (3px inset rule).
            y: Tip.cy > 0px ? min(Tip.cy, root.height - self.height - 3px) : 47px;
            width: tiplab.preferred-width + 16px;
            height: tiplab.preferred-height + 8px;
            background: Theme.badge-bg;
            border-radius: Theme.radius-sm;
            tiplab := Text { text: Tip.text; color: Theme.text; font-size: Theme.font-sm; x: 8px; y: 4px; }
        }
        // v0.8.120 (design-sweep Y74): the cache meter's tooltip, at the WINDOW ROOT so it paints
        // above every top-left panel instead of under them. Kept as its OWN twin rather than folded
        // into `tiplayer` for the reason tiplayer's note already records: the meter's text
        // LIVE-UPDATES while hovered (tiplayer snapshots at hover-in) and the meter is a
        // continuously-changing readout, so it takes no ~600 ms dwell either. Always mounted (no
        // `if`) like tiplayer; display-only — no TouchArea, so it can never steal a pointer event —
        // and never in immersive, where the meter's own TouchArea is hit-gated and `changed
        // immersive` clears the flag. Geometry is the pre-existing one, re-expressed in window
        // space: 47px = the 44px bar + the 3px gap rule, centred on the meter, clamped to the same
        // 3px side insets tiplayer uses.
        Rectangle {
            visible: root.cache-meter-hover && !root.immersive && root.cache-meter-tip != "";
            x: max(3px, min(root.cache-meter-cx - self.width / 2, root.width - self.width - 3px));
            y: root.cache-meter-cy;
            width: cmtiplab.preferred-width + 16px;
            height: cmtiplab.preferred-height + 8px;
            background: Theme.badge-bg;
            border-radius: Theme.radius-sm;
            cmtiplab := Text { text: root.cache-meter-tip; color: Theme.text; font-size: Theme.font-sm; x: 8px; y: 4px; }
        }
        if root.mac-full-candidate : Rectangle {
            x: 10px; y: root.height - 24px; height: 20px; width: 205px;
            background: Theme.badge-bg;
            Text { text: @tr("falcon" => "Mac candidate · Diagnostics"); color: Theme.text-dim; font-size: 11px; vertical-alignment: center; }
            TouchArea { clicked => { root.mac-diagnostics-open = !root.mac-diagnostics-open; } }
        }
        if root.mac-experiment-label != "" && (!root.mac-full-candidate || root.mac-diagnostics-open) : MacExperimentStatus {
            x: 10px; y: max(10px, root.height - 205px); width: min(root.width - 20px, 780px); height: 112px;
            build: root.mac-experiment-label;
            status: root.mac-experiment-status;
            log-path: root.mac-experiment-log-path;
            command(s) => { if s == "hide" { root.mac-diagnostics-open = false; } else { root.mac-experiment-command(s); } }
        }
        if root.mac-experiment-label != "" && !root.mac-full-candidate && !root.immersive : AaHairline {
            y: root.titlebar-h - 1px; height: 1px; width: 100%; tint: #70d2a0;
        }
        if root.mac-experiment-label != "" && !root.immersive : MacExperimentPopup {
            width: parent.width; height: parent.height;
            open <=> root.mac-experiment-popup-open;
            anchor-x: root.mac-experiment-popup-x; anchor-y: root.mac-experiment-popup-y;
            action(s) => { root.mac-experiment-popup-action(s); }
        }
        // Last-mounted modal; Settings remains underneath so closing returns to its position.
        if root.about-open : Rectangle {
            y: root.content-top; width: root.width; height: root.height - self.y;
            background: Theme.scrim;
            about-outside := TouchArea { clicked => { root.about-open = false; } }
            about-card := AboutCard {
                width: min(440px, parent.width - 24px); height: min(self.preferred-card-height, parent.height - 24px);
                property <float> sf: max(root.win-sf, 0.5);
                x: Math.round((parent.width - self.width) / 2 / 1px * self.sf) / self.sf * 1px;
                y: Math.round((parent.y + (parent.height - self.height) / 2) / 1px * self.sf) / self.sf * 1px - parent.y;
                version: @tr("falcon" => "v{0}", root.app-version);
                repository: root.about-repository;
                error: root.about-error;
                close-requested => { root.about-open = false; }
                link-requested(kind) => { root.about-link-requested(kind); }
            }
        }
        } // winroot (v0.7.0 rounded window clip)

    }
